# Maintainer: Gustavo Alvarez <sl1pkn07@gmail.com
# Contributor: Tom Newsom <Jeepster@gmx.co.uk>

pkgname=lha
pkgver=1.14i_ac20260722
pkgrel=2
epoch=1
pkgdesc="A compression and archive utility for LH-7 format archives"
arch=('x86_64')
url='http://lha.osdn.jp'
license=('LicenseRef-lha')
depends=('glibc')
makedepends=('git')
# upstream doesn't provide git tags..
_commit=16619b066b189ef289bb8b07b37d1c38d550da99
source=(
  "git+https://github.com/jca02266/lha.git#commit=${_commit}"
  'LICENSE'
)
sha256sums=('8d8c526f2b9027d58882c99c79a62e0186d982b3cb163705a53a098bb0a5cb31'
            'c88f52b7b6b223d1347c6721c24b63ba947baa1756e3713e1fff220e974b9120')

prepare() {
  mkdir -p build

  cd lha
  autoreconf -vfi
}

build() {
  cd build
  ../lha/configure \
    --prefix=/usr
  make
}

check() {
  make -C build check
}

package() {
  make -C build DESTDIR="${pkgdir}" install

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
