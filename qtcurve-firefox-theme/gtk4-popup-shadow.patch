+     */
+    const Nodes m_nodes;
     /** The colours of each selector that a label pin of the sheet reaches. */
     QMap<QString, Pin> m_pins;
     /** The background of the window rule, for a child that paints none. */
@@ -1856,6 +1860,14 @@ Writer::decoration()
                    .arg(rgba(QColor(0, 0, 0), 0.35)));
     box.more << QStringLiteral("margin: 10px");
     put(QStringLiteral("decoration"), box);
+    // GTK 3 draws the decoration node under a popup and under a window that
+    // paints its own frame. The override below reaches a popup alone, so a
+    // window keeps the shadow of the rule above.
+    if (m_opts.popupShadow) {
+        return;
+    }
+    box.shadow = QStringLiteral("none");
+    put(QStringLiteral(".popup decoration, tooltip decoration"), box);
 }
 
