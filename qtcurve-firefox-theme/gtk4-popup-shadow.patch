diff --git a/gtk4/check/assert-shadow.sh b/gtk4/check/assert-shadow.sh
new file mode 100644
index 00000000..dea02425
--- /dev/null
+++ b/gtk4/check/assert-shadow.sh
@@ -0,0 +1,171 @@
+#!/bin/sh
+# assert-shadow.sh ON3 OFF3 ON4 OFF4 SHIPPED3: the shadow setting must reach
+# the popup rule of the GTK 3 sheet and no other rule. ON3 and OFF3 are the
+# GTK 3 sheets of the two arms, ON4 and OFF4 are the GTK 4 sheets of the same
+# two arms, and SHIPPED3 is the GTK 3 sheet of the fallback theme. The run
+# then breaks each contract in a copy of a sheet, and it fails if the check
+# passes the broken copy.
+set -eu
+usage='usage: assert-shadow.sh ON3 OFF3 ON4 OFF4 SHIPPED3'
+on3=${1:?$usage}
+off3=${2:?$usage}
+on4=${3:?$usage}
+off4=${4:?$usage}
+shipped3=${5:?$usage}
+
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+
+popup='.popup decoration'
+tip='tooltip decoration'
+
+# rule_shadow SHEET SELECTOR: prints the box-shadow value of the rule of
+# SELECTOR, and prints nothing when the sheet holds no such rule.
+rule_shadow() {
+    awk -v want="$2 {" '
+        $0 == want { in_rule = 1; next }
+        in_rule && $0 == "}" { in_rule = 0 }
+        in_rule && sub(/^  box-shadow: /, "") { sub(/;$/, ""); print }
+    ' "$1"
+}
+
+# deco_selectors SHEET: prints the selector of every rule that holds the token
+# decoration. A selector stands at column one and it ends with a brace.
+deco_selectors() {
+    sed -n '/^[^[:space:]].* {$/ s/ {$//p' "$1" | grep decoration || true
+}
+
+# set_shadow SHEET SELECTOR VALUE: prints SHEET with the box-shadow of the
+# rule of SELECTOR at VALUE. The run builds a broken copy with it.
+set_shadow() {
+    awk -v want="$2 {" -v val="$3" '
+        $0 == want { in_rule = 1 }
+        in_rule && /^  box-shadow: / { print "  box-shadow: " val ";"; next }
+        in_rule && $0 == "}" { in_rule = 0 }
+        { print }
+    ' "$1"
+}
+
+# rename_rule SHEET FROM TO: prints SHEET with the selector FROM at TO. The
+# run builds a broken copy with it.
+rename_rule() {
+    awk -v from="$2 {" -v to="$3 {" '$0 == from { print to; next } { print }' \
+        "$1"
+}
+
+# check ON3 OFF3 ON4 OFF4 SHIPPED3: gives 0 when the five contracts hold. It
+# names the first contract that fails on the standard error.
+check() {
+    c_on3=$1
+    c_off3=$2
+    c_on4=$3
+    c_off4=$4
+    c_shipped3=$5
+
+    # 1. The on arm gives the decoration node a shadow.
+    keep=$(rule_shadow "$c_on3" decoration)
+    if [ -z "$keep" ]; then
+        echo "assert-shadow: $c_on3 holds no decoration rule" >&2
+        return 1
+    fi
+    if [ "$keep" = none ]; then
+        echo "assert-shadow: $c_on3 gives the decoration node no shadow" >&2
+        return 1
+    fi
+
+    # 2. The on arm holds the decoration rule alone, and it names no popup.
+    if [ "$(deco_selectors "$c_on3")" != decoration ]; then
+        echo "assert-shadow: $c_on3 holds a second decoration rule" >&2
+        return 1
+    fi
+    if grep -qF "$popup" "$c_on3" || grep -qF "$tip" "$c_on3"; then
+        echo "assert-shadow: $c_on3 names a popup of the decoration node" >&2
+        return 1
+    fi
+
+    # 3. The off arm holds one popup rule of no shadow, and the selector of
+    # that rule reads a popup and a tooltip.
+    sel=$(deco_selectors "$c_off3" | grep -vx decoration || true)
+    if [ "$(printf '%s\n' "$sel" | grep -c . || true)" -ne 1 ]; then
+        echo "assert-shadow: $c_off3 holds no single popup rule" >&2
+        return 1
+    fi
+    case $sel in
+        *"$popup"*) ;;
+        *) echo "assert-shadow: $c_off3 misses '$popup'" >&2; return 1;;
+    esac
+    case $sel in
+        *"$tip"*) ;;
+        *) echo "assert-shadow: $c_off3 misses '$tip'" >&2; return 1;;
+    esac
+    if [ "$(rule_shadow "$c_off3" "$sel")" != none ]; then
+        echo "assert-shadow: $c_off3 gives '$sel' a shadow" >&2
+        return 1
+    fi
+
+    # 4. The off arm keeps the shadow of the window.
+    if [ "$(rule_shadow "$c_off3" decoration)" != "$keep" ]; then
+        echo "assert-shadow: $c_off3 moves the shadow of the window" >&2
+        return 1
+    fi
+
+    # 5. The on arm gives the shipped sheet, and the setting moves no GTK 4
+    # rule.
+    if ! cmp -s "$c_on3" "$c_shipped3"; then
+        echo "assert-shadow: $c_on3 differs from $c_shipped3" >&2
+        return 1
+    fi
+    if ! cmp -s "$c_on4" "$c_off4"; then
+        echo "assert-shadow: $c_on4 differs from $c_off4" >&2
+        return 1
+    fi
+    return 0
+}
+
+if ! check "$on3" "$off3" "$on4" "$off4" "$shipped3"; then
+    echo "assert-shadow: the two arms fail the check" >&2
+    exit 1
+fi
+
+# The controls below. Each one breaks one contract in a copy of a sheet, and
+# the check must fail over that copy.
+psel=$(deco_selectors "$off3" | grep -vx decoration)
+broken=0
+
+# control NAME ON3 OFF3 ON4 OFF4 SHIPPED3: the check must fail over the sheets
+# that the caller gives.
+control() {
+    name=$1
+    shift
+    if check "$@" 2> "$tmp/control.log"; then
+        echo "assert-shadow: the check passed the broken sheet of $name" >&2
+        exit 1
+    fi
+    broken=$((broken + 1))
+}
+
+# A popup rule in the on arm, which the setting must keep out of it.
+cp "$on3" "$tmp/paste.css"
+printf '%s {\n  box-shadow: none;\n}\n' "$psel" >> "$tmp/paste.css"
+control paste "$tmp/paste.css" "$off3" "$on4" "$off4" "$shipped3"
+
+# The shadow of the window over the popup rule of the off arm.
+set_shadow "$off3" "$psel" "$(rule_shadow "$on3" decoration)" \
+    > "$tmp/keep.css"
+control keep "$on3" "$tmp/keep.css" "$on4" "$off4" "$shipped3"
+
+# No shadow over the decoration rule of the off arm, which drops the shadow of
+# the window with the shadow of the popup.
+set_shadow "$off3" decoration none > "$tmp/drop.css"
+control drop "$on3" "$tmp/drop.css" "$on4" "$off4" "$shipped3"
+
+# The popup half of the selector alone, which misses a tooltip.
+rename_rule "$off3" "$psel" "$popup" > "$tmp/half.css"
+control half "$on3" "$tmp/half.css" "$on4" "$off4" "$shipped3"
+
+# One byte of the on arm that no row above reads.
+sed 's/margin: 10px/margin: 11px/' "$on3" > "$tmp/byte.css"
+control byte "$tmp/byte.css" "$off3" "$on4" "$off4" "$shipped3"
+
+echo "assert-shadow: the two arms hold the contract of '$psel', and the" \
+     "check fails each of the $broken broken sheets"
diff --git a/gtk4/check/shadow-off.qtcurve b/gtk4/check/shadow-off.qtcurve
new file mode 100644
index 00000000..923bfba2
--- /dev/null
+++ b/gtk4/check/shadow-off.qtcurve
@@ -0,0 +1,6 @@
+# The off arm of assert-shadow.sh, where the setting drops the shadow of a
+# popup. The version key stops the migration clause of the parser, so this arm
+# and the on arm differ in the popup rule alone.
+[Settings]
+version=1.9.0
+popupShadow=false
diff --git a/gtk4/check/shadow-on.qtcurve b/gtk4/check/shadow-on.qtcurve
new file mode 100644
index 00000000..e1a5057e
--- /dev/null
+++ b/gtk4/check/shadow-on.qtcurve
@@ -0,0 +1,7 @@
+# The on arm of assert-shadow.sh, where the setting keeps the shadow of a
+# popup. The parser runs a migration clause over a settings file that holds no
+# version key, and that clause moves two rules of the sheet. The version key
+# below stops the clause, so this arm gives the shipped sheet byte for byte.
+[Settings]
+version=1.9.0
+popupShadow=true
