+ *   License along with this library. If not,                                *
+ *   see <http://www.gnu.org/licenses/>.                                     *
+ *****************************************************************************/
+
+#include "reexec.h"
+
+#include "lock.h"
+
+#include <QFileInfo>
+#include <QFileSystemWatcher>
+#include <QProcess>
+
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+namespace QtCurve {
+namespace Gtk {
+
+namespace {
+
+/**
+ * The debounce of the binary watch, in milliseconds. The step covers the
+ * events of one extract of a package, so one replacement gives one read.
+ */
+const int debounceMs = 500;
+
+/**
+ * The wait before another read of a path that is absent or not executable, in
+ * milliseconds. The extract of a package holds such a path for a short time.
+ */
+const int retryMs = 2000;
+
+/** The longest wait for one probe run of a new image, in milliseconds. */
+const int probeMs = 5000;
+
+/** The longest wait for a probe run that took a signal, in milliseconds. */
+const int reapMs = 1000;
+
+/** The count of the attempts that fail before the binary watch stops. */
+const int maxAttempts = 5;
+
+/** Returns true when two results of stat(2) name one image of one content. */
+bool
+sameStat(const struct stat &one, const struct stat &two)
+{
+    return one.st_dev == two.st_dev && one.st_ino == two.st_ino &&
+        one.st_size == two.st_size &&
+        one.st_mtim.tv_sec == two.st_mtim.tv_sec &&
+        one.st_mtim.tv_nsec == two.st_mtim.tv_nsec;
+}
+
+}
+
+Reexec::Reexec(const QString &exePath,
+               const std::vector<std::string> &savedArgs, int lockFd,
+               QObject *parent)
+    : QObject(parent), m_exePath(exePath), m_savedArgs(savedArgs),
+      m_lockFd(lockFd), m_files(new QFileSystemWatcher(this)),
+      m_haveFailedStat(false), m_attempts(0)
+{
+    memset(&m_startupStat, 0, sizeof(m_startupStat));
+    memset(&m_failedStat, 0, sizeof(m_failedStat));
+    stat(m_exePath.toLocal8Bit().constData(), &m_startupStat);
+
+    m_debounce.setSingleShot(true);
+    m_debounce.setInterval(debounceMs);
+    connect(&m_debounce, &QTimer::timeout, this, &Reexec::fire);
+    m_retry.setSingleShot(true);
+    m_retry.setInterval(retryMs);
+    connect(&m_retry, &QTimer::timeout, this, &Reexec::schedule);
+
+    addPaths();
+    connect(m_files, &QFileSystemWatcher::fileChanged,
+            this, &Reexec::schedule);
+    connect(m_files, &QFileSystemWatcher::directoryChanged,
+            this, &Reexec::schedule);
+}
+
+void
+Reexec::addPaths()
+{
+    const QString dir = QFileInfo(m_exePath).absolutePath();
+    if (!m_files->directories().contains(dir) && QFileInfo::exists(dir)) {
+        m_files->addPath(dir);
+    }
+    if (!m_files->files().contains(m_exePath) &&
+        QFileInfo::exists(m_exePath)) {
+        m_files->addPath(m_exePath);
+    }
+}
+
+void
+Reexec::schedule()
+{
+    addPaths();
+    m_debounce.start();
+}
+
+bool
+Reexec::probe()
+{
+    QProcess run;
+    run.setStandardOutputFile(QProcess::nullDevice());
+    run.setStandardErrorFile(QProcess::nullDevice());
+    run.start(m_exePath, { QStringLiteral("--stdout"),
+                           QStringLiteral("--default") });
+    if (!run.waitForFinished(probeMs)) {
+        run.kill();
+        run.waitForFinished(reapMs);
+        return false;
+    }
+    return run.exitStatus() == QProcess::NormalExit && run.exitCode() == 0;
+}
+
+void
+Reexec::keepOldImage(const struct stat &failed)
+{
+    m_failedStat = failed;
+    m_haveFailedStat = true;
+    ++m_attempts;
+    if (m_attempts == maxAttempts) {
+        fprintf(stderr, "qtcurve-gtk-writer: the writer keeps this image and"
+                " stops the binary watch\n");
+    }
+}
+
+void
+Reexec::fire()
+{
+    if (m_attempts >= maxAttempts) {
+        return;
+    }
+    const QByteArray path = m_exePath.toLocal8Bit();
+    struct stat now;
+    if (stat(path.constData(), &now) != 0) {
+        if (!m_retry.isActive()) {
+            m_retry.start();
+        }
+        return;
+    }
+    if (sameStat(now, m_startupStat)) {
+        return;
+    }
+    if (m_haveFailedStat && sameStat(now, m_failedStat)) {
+        return;
+    }
+    if (access(path.constData(), X_OK) != 0) {
+        if (!m_retry.isActive()) {
+            m_retry.start();
+        }
+        return;
+    }
+    if (!probe()) {
+        fprintf(stderr, "qtcurve-gtk-writer: the new image of %s fails the"
+                " probe, and the writer keeps the old image\n",
+                path.constData());
+        keepOldImage(now);
+        return;
+    }
+    printf("qtcurve-gtk-writer: the writer starts the new image of %s\n",
+           path.constData());
+    fflush(stdout);
+    prepareLockFdForExec(m_lockFd);
+    std::vector<char*> args;
+    for (std::string &arg : m_savedArgs) {
+        args.push_back(&arg[0]);
+    }
+    args.push_back(nullptr);
+    ::execv(path.constData(), args.data());
+    restoreLockFdAfterExecFailure(m_lockFd);
+    fprintf(stderr, "qtcurve-gtk-writer: the exec of %s fails, and the writer"
+            " keeps the old image\n", path.constData());
+    keepOldImage(now);
+}
+
+}
+}
