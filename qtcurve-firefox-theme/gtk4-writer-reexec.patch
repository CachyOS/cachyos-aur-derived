+
+#ifndef QTC_GTK4_REEXEC_H
+#define QTC_GTK4_REEXEC_H
+
+#include <QObject>
+#include <QString>
+#include <QTimer>
+
+#include <sys/stat.h>
+
+#include <string>
+#include <vector>
+
+class QFileSystemWatcher;
+
+namespace QtCurve {
+namespace Gtk {
+
+/**
+ * The half of the daemon that follows a change of the binary of the writer.
+ * It holds one QFileSystemWatcher over the file of the image and over the
+ * directory of that file. A package manager unlinks the old file and extracts
+ * a new inode, and a watch of the file alone dies with the old one. The
+ * object runs in the thread of the event loop of the daemon.
+ */
+class Reexec : public QObject {
+    Q_OBJECT
+public:
+    /**
+     * Builds the watch over one image path, and reads the state of that path
+     * one time.
+     *
+     * \param exePath the path of the running image, from
+     *     QCoreApplication::applicationFilePath() at startup. The daemon runs
+     *     this path again, so the path is the contract of the operator: a
+     *     different program at that path also runs.
+     * \param savedArgs the raw arguments of main(), which the caller copies
+     *     before the constructor of QCoreApplication reads argv.
+     * \param lockFd the descriptor of the daemon lock. It crosses the exec,
+     *     so the lock stays held with no open window.
+     */
+    Reexec(const QString &exePath, const std::vector<std::string> &savedArgs,
+           int lockFd, QObject *parent = nullptr);
+
+private Q_SLOTS:
+    /** Starts the debounce timer and adds every lost watch path again. */
+    void schedule();
+    /**
+     * Reads the image path one time, and runs a new image on success. A path
+     * that did not change, an image that failed before, an absent path and a
+     * path that is not executable start no new image. An image that fails the
+     * probe keeps the old image, and the writer reads the path again only
+     * after another change of the file. The watch stops after 5 attempts that
+     * fail.
+     */
+    void fire();
+
+private:
+    /**
+     * Adds the image path and its directory again when the watcher lost them.
+     * Only a path that exists at that moment joins the watcher.
+     */
+    void addPaths();
+    /**
+     * Runs the image one time with --stdout and --default, and returns true
+     * when that run gives 0 inside 5 s. The sheet mode reads no bus, takes no
+     * lock, needs no display and writes no file without --out. The probe
+     * therefore costs the state of the user nothing.
+     */
+    bool probe();
+    /**
+     * Keeps the old image after a new image that failed, and counts that
+     * attempt. The function prints the one line of the attempt that stops the
+     * watch, and the caller prints the line of the failure itself.
+     *
+     * \param failed the state of the image that failed. A later pass over the
+     *     same state gives no action.
+     */
+    void keepOldImage(const struct stat &failed);
+
+    QString m_exePath;
+    std::vector<std::string> m_savedArgs;
+    int m_lockFd;
+    QFileSystemWatcher *m_files;
+    QTimer m_debounce;
+    QTimer m_retry;
+    /** The state of the image at startup, which no pass runs again. */
+    struct stat m_startupStat;
+    /** The state of the last image that failed, valid with m_haveFailedStat. */
+    struct stat m_failedStat;
+    /** True after the first image that failed. */
+    bool m_haveFailedStat;
+    /** The count of the attempts that failed, capped at 5. */
+    int m_attempts;
+};
+
+}
+}
+
+#endif
