diff --git a/gtk4/check/assert-reexec.sh b/gtk4/check/assert-reexec.sh
new file mode 100644
index 00000000..2f9ad07d
--- /dev/null
+++ b/gtk4/check/assert-reexec.sh
@@ -0,0 +1,184 @@
+#!/bin/sh
+# assert-reexec.sh WRITER WORKDIR: the watch mode must run a new image of its
+# own binary, and it must keep the old image when the new one fails. The run
+# copies the writer into a private directory and starts the watch mode over
+# that copy. It then replaces the copy as a package manager does: unlink, and
+# then a new inode at the same path. An exec keeps the pid, so a pid that stays
+# with a new link of /proc/PID/exe is the proof of the exec. HOME,
+# XDG_CONFIG_HOME and QTCURVE_CONFIG_DIR point into WORKDIR, because the writer
+# rewrites the files of the caller. Every wait is a counted poll of steps of
+# one second, so no arm can stop the build.
+set -eu
+usage='usage: assert-reexec.sh WRITER WORKDIR'
+writer=${1:?$usage}
+work=${2:?$usage}
+
+conf=$work/config
+qtc=$work/qtcurve
+bin=$work/bin/writer
+lock=$conf/qtcurve-gtk-writer.lock
+log=$work/watch.log
+pids=
+last=
+code=0
+
+clean() {
+    for p in $pids; do
+        kill "$p" 2>/dev/null || true
+    done
+}
+
+# A signal that stops the run leaves a writer of the run alive. The trap takes
+# it away, and SIGKILL runs no trap.
+trap clean EXIT
+trap 'clean; exit 1' HUP INT QUIT TERM
+
+rm -rf "$work"
+mkdir -p "$conf/gtk-3.0" "$conf/gtk-4.0" "$qtc" "$work/bin"
+printf '[Settings]\nappearance=gradient\n' > "$qtc/stylerc"
+ulimit -c 0
+
+fail() {
+    echo "assert-reexec: $1" >&2
+    exit 1
+}
+
+# running PID: gives 0 while the process PID runs. A process that ended and
+# waits for its parent holds the state Z, and it does not run.
+running() {
+    state=$(sed -n 's/^State:[[:space:]]*//p' "/proc/$1/status" 2>/dev/null) ||
+        return 1
+    case $state in
+        Z*|'') return 1;;
+        *) return 0;;
+    esac
+}
+
+# start IMAGE LOG ARGS...: starts one run of IMAGE over the private home, and
+# holds the pid of that run in the variable last.
+start() {
+    image=$1
+    out=$2
+    shift 2
+    HOME=$work XDG_CONFIG_HOME=$conf QTCURVE_CONFIG_DIR=$qtc \
+        "$image" "$@" > "$out" 2>&1 &
+    last=$!
+    pids="$pids $last"
+}
+
+# wait_exit PID LIMIT NAME: waits at most LIMIT seconds for the run PID to
+# end, and holds the exit code of that run in the variable code. A run that
+# stays at the limit takes a signal, and the check fails.
+wait_exit() {
+    i=0
+    while [ "$i" -lt "$2" ]; do
+        if ! running "$1"; then
+            code=0
+            wait "$1" || code=$?
+            return 0
+        fi
+        sleep 1
+        i=$((i + 1))
+    done
+    kill "$1" 2>/dev/null || true
+    fail "$3 runs after $2 seconds"
+}
+
+# wait_file LIMIT FILE NAME: waits at most LIMIT seconds for the file FILE to
+# hold a byte.
+wait_file() {
+    i=0
+    while [ "$i" -lt "$1" ]; do
+        if [ -s "$2" ]; then
+            return 0
+        fi
+        sleep 1
+        i=$((i + 1))
+    done
+    fail "$3"
+}
+
+# wait_count LIMIT FILE TEXT COUNT NAME: waits at most LIMIT seconds for the
+# file FILE to hold COUNT lines of the text TEXT.
+wait_count() {
+    i=0
+    while [ "$i" -lt "$1" ]; do
+        n=$(grep -cF "$3" "$2" 2>/dev/null) || n=0
+        if [ "$n" -ge "$4" ]; then
+            return 0
+        fi
+        sleep 1
+        i=$((i + 1))
+    done
+    fail "$5"
+}
+
+# link PID: prints the target of /proc/PID/exe. The kernel adds the text
+# " (deleted)" to the target of an image that no directory holds.
+link() {
+    readlink "/proc/$1/exe" 2>/dev/null || true
+}
+
+# 1. The watch mode runs over a copy of the writer in a private directory.
+cp "$writer" "$bin"
+chmod 0755 "$bin"
+start "$bin" "$log" --watch --force
+daemon=$last
+sleep 2
+running "$daemon" || fail "the watch mode stopped at the first pass"
+wait_file 15 "$lock" "the watch mode wrote no pid into the daemon lock"
+
+# 2. An image path that is absent for a moment, as an extract of a package
+# holds it, must not stop the watch mode.
+rm -f "$bin"
+sleep 1
+running "$daemon" || fail "the watch mode stopped at an absent image"
+
+# 3. A new inode at the image path gives a new image, and the exec keeps the
+# pid. The link of /proc/PID/exe names the new inode.
+cp "$writer" "$bin.new"
+chmod 0755 "$bin.new"
+mv -f "$bin.new" "$bin"
+wait_count 15 "$log" "starts the new image" 1 \
+    "the watch mode started no new image"
+running "$daemon" || fail "the watch mode stopped at the new image"
+if [ "$(link "$daemon")" != "$bin" ]; then
+    fail "the watch mode holds no new image after the exec"
+fi
+
+# 4. The daemon lock crossed the exec, so a second watch instance stops.
+start "$writer" "$work/watch2.log" --watch --force
+wait_exit "$last" 10 "the second watch instance"
+if [ "$code" -ne 0 ]; then
+    fail "the second watch instance gave the code $code and not 0"
+fi
+grep -qF "a watch instance runs with the pid" "$work/watch2.log" ||
+    fail "the daemon lock did not cross the exec"
+
+# 5. An image that gives a code other than 0 fails the probe, and the watch
+# mode keeps the old image. A design with no probe runs this image and dies.
+printf '#!/bin/sh\nexit 1\n' > "$bin.bad"
+chmod 0755 "$bin.bad"
+mv -f "$bin.bad" "$bin"
+wait_count 15 "$log" "keeps the old image" 1 \
+    "the watch mode kept no old image over the image that fails"
+running "$daemon" || fail "the watch mode stopped at the image that fails"
+case $(link "$daemon") in
+    *" (deleted)") ;;
+    *) fail "the watch mode does not hold the old image after the probe";;
+esac
+
+# 6. The next change of the image path runs the probe again, which proves the
+# loop of the image after the exec is alive.
+cp "$writer" "$bin.new2"
+chmod 0755 "$bin.new2"
+mv -f "$bin.new2" "$bin"
+wait_count 15 "$log" "starts the new image" 2 \
+    "the watch mode started no new image after the image that fails"
+running "$daemon" || fail "the watch mode stopped at the second new image"
+if [ "$(link "$daemon")" != "$bin" ]; then
+    fail "the watch mode holds no new image after the second exec"
+fi
+
+echo "assert-reexec: the watch mode started 2 new images under one pid, and" \
+     "it kept the old image over the control image that gives the code 1"
