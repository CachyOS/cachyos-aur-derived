Carry the whole password character code point

The password character key holds a code point of any plane, and the
dialog moved that value through 16 bits. setPasswordChar() built the
button text with QChar, which holds one 16 bit unit, so a stored 0x1F600
showed as U+F600. toInt() read that unit back, and the next save wrote
0xF600 over the file.

The button text now holds the whole code point, as a surrogate pair
where one is needed, and toInt() joins the pair. The character selector
takes and returns a code point through its unsigned interface, so both
ends of the comparison hold the same unit. A character of the basic
plane keeps its old value on every path.

The change sits on the branch work/dialog-state of the local tree, as commit 8 of 12.
A new merge request on system/qtcurve takes that branch.

Drop this patch when upstream merges the change.

diff --git a/qt6/config/qtcurveconfig.cpp b/qt6/config/qtcurveconfig.cpp
index d84c073a..8a247d1e 100644
--- a/qt6/config/qtcurveconfig.cpp
+++ b/qt6/config/qtcurveconfig.cpp
@@ -338,7 +338,7 @@ public:
                            ->pixelMetric(QStyle::PM_LayoutVerticalSpacing));
 
         m_selector = new KCharSelect(page, nullptr);
-        m_selector->setCurrentChar(QChar(v));
+        m_selector->setCurrentCodePoint((uint)v);
         layout->addWidget(m_selector);
 
         mainLayout->addWidget(page);
@@ -346,9 +346,9 @@ public:
     }
 
     int
-    currentChar() const
+    currentCodePoint() const
     {
-        return m_selector->currentChar().unicode();
+        return (int)m_selector->currentCodePoint();
     }
 private:
     KCharSelect *m_selector;
@@ -514,9 +514,22 @@ kdeHome(bool kde3)
     return kdeHome[kde3 ? 0 : 1];
 }
 
+/**
+ * Gives the code point of the first character of the text. A text of fewer
+ * than two characters gives 0. The function joins a surrogate pair, so a
+ * character above the basic plane keeps its value.
+ * \param str the button text, which holds the character and then its number.
+ * \return the code point, or 0.
+ */
 static int toInt(const QString &str)
 {
-    return str.length()>1 ? str[0].unicode() : 0;
+    if(str.length()<2)
+        return 0;
+
+    if(str[0].isHighSurrogate() && str[1].isLowSurrogate())
+        return (int)QChar::surrogateToUcs4(str[0], str[1]);
+
+    return str[0].unicode();
 }
 
 static int getHideFlags(const QCheckBox *kbd, const QCheckBox *kwin)
@@ -1497,9 +1510,9 @@ void QtCurveConfig::passwordCharClicked()
     int              cur(toInt(passwordChar->text()));
     CharSelectDialog dlg(this, cur);
 
-    if(QDialog::Accepted==dlg.exec() && dlg.currentChar()!=cur)
+    if(QDialog::Accepted==dlg.exec() && dlg.currentCodePoint()!=cur)
     {
-        setPasswordChar(dlg.currentChar());
+        setPasswordChar(dlg.currentCodePoint());
         updateChanged();
     }
 }
@@ -2547,11 +2560,12 @@ bool QtCurveConfig::diffImages(const Options &opts)
 
 void QtCurveConfig::setPasswordChar(int ch)
 {
-    QString     str;
-    QTextStream s(&str);
+    QString        str;
+    QTextStream    s(&str);
+    const char32_t cp(ch);
 
     s.setIntegerBase(16);
-    s << QChar(ch) << " (" << ch << ')';
+    s << QString::fromUcs4(&cp, 1) << " (" << ch << ')';
     passwordChar->setText(str);
 }
 
