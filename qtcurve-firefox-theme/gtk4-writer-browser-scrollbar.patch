+void
+Writer::browserScrollBar()
+{
+    if (!m_nodes.browserScrollBar) {
+        return;
+    }
+    // A browser takes the colours of this node chain while the trough of the
+    // chain holds no ground. It paints the background colour of the chain and
+    // no border and no image of it, so each rule below states one colour and
+    // drops the image that the rule of the widget paints.
+    const ScrollSpec spec = scrollSpec(m_opts, m_pal);
+    const QString bar = QStringLiteral("#MozillaGtkWidget scrollbar");
+    m_sheet.rule(bar, flatFill(tv(QStringLiteral("moz-sbar-bgnd"),
+                                  scrollTone(spec.track))));
+    m_sheet.rule(bar + QStringLiteral(" trough"),
+                 flatFill(QStringLiteral("transparent")));
+    m_sheet.rule(bar + QStringLiteral(" slider"),
+                 flatFill(tv(QStringLiteral("moz-sbar-slider"),
+                             scrollTone(spec.rest))));
+    // The Qt style paints a thumb under the button as a thumb under the
+    // pointer, so the two states take one colour.
+    const QString hover = tv(QStringLiteral("moz-sbar-slider-hover"),
+                             scrollTone(spec.hover));
+    m_sheet.rule(bar + QStringLiteral(" slider:hover"), colourFill(hover));
+    m_sheet.rule(bar + QStringLiteral(" slider:active"), colourFill(hover));
+}
