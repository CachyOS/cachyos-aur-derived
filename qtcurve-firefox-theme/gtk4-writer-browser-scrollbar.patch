diff --git a/gtk4/check/assert-browser.sh b/gtk4/check/assert-browser.sh
new file mode 100644
index 00000000..f7f2fe66
--- /dev/null
+++ b/gtk4/check/assert-browser.sh
@@ -0,0 +1,297 @@
+#!/bin/sh
+# assert-browser.sh WRITER WORKDIR SCHEME: the scroll bar block of the browser
+# must stand in the GTK 3 sheet alone, hold a trough of no ground, follow the
+# slider keys of the settings, and hold one ground under every groove key.
+# Each rule of the block that a rule of the widget grounds must also drop the
+# image of that rule. The run writes one settings file and one sheet for each
+# arm under WORKDIR, over the colour file SCHEME. It then breaks one contract
+# in a copy of an arm, and it fails if the check passes the broken copy.
+set -eu
+usage='usage: assert-browser.sh WRITER WORKDIR SCHEME'
+writer=${1:?$usage}
+work=${2:?$usage}
+scheme=${3:?$usage}
+
+# A relative path leaves the sheets outside the directory that the caller
+# names, because the writer runs in a directory of its own.
+case $work in
+    /*) ;;
+    *) work=$PWD/$work;;
+esac
+
+bar='#MozillaGtkWidget scrollbar'
+# The colour of the custom arm, which the rest row must carry byte for byte.
+custom='#ff8800'
+# Every arm of the GTK 3 dialect, in the order that the run writes them.
+arms='none darken selected blend custom mo thin wide page corner square'
+
+rm -rf "$work"
+mkdir -p "$work/arm" "$work/broken"
+
+# settings NAME BODY: writes the settings file of the arm NAME, which holds
+# the keys of BODY over the shipped preset. BODY carries one escape of a new
+# line for each key.
+settings() {
+    printf '[Settings]\n%b' "$2" > "$work/$1.qtcurve"
+}
+
+# sheet NAME DIALECT: writes the sheet of the arm NAME in the dialect DIALECT.
+sheet() {
+    "$writer" --stdout --force --settings "$work/$1.qtcurve" \
+        --scheme "$scheme" --dialect "$2" --asset-base "../assets/" \
+        --out "$work/arm/$1.css"
+}
+
+# The five slider keys, one arm each. The reader takes a colour value of the
+# key as the custom colour of the slider.
+settings none 'shadeSliders=none\n'
+settings darken 'shadeSliders=darken\n'
+settings selected 'shadeSliders=origselected\n'
+settings blend 'shadeSliders=selected\n'
+settings custom "shadeSliders=$custom\\n"
+# The pointer key, which the reader keeps under the three ladder keys alone.
+settings mo 'shadeSliders=origselected\ncolorSliderMouseOver=true\n'
+# The five groove arms, which hold the four corners of the groove keys and the
+# square corner of no button. No one of them may move the ground of the bar.
+settings thin 'flatSbarButtons=true\nthinSbarGroove=true\n'
+settings wide 'flatSbarButtons=true\nthinSbarGroove=false\n'
+settings page 'flatSbarButtons=false\nthinSbarGroove=true\n'
+settings corner 'flatSbarButtons=false\nthinSbarGroove=true\nscrollbarType=none\n'
+settings square \
+    'flatSbarButtons=false\nthinSbarGroove=true\nscrollbarType=none\nround=none\n'
+
+for arm in $arms; do
+    sheet "$arm" gtk3
+done
+# The GTK 4 sheet of one arm, which must carry no rule of the block.
+"$writer" --stdout --force --settings "$work/none.qtcurve" \
+    --scheme "$scheme" --dialect gtk4 --asset-base "../assets/" \
+    --out "$work/arm/gtk4.css"
+
+# row DIR ARM SELECTOR PROP: prints the value of the property PROP of the rule
+# SELECTOR in the sheet of ARM under DIR. It prints nothing for a rule or a
+# property that the sheet does not hold.
+row() {
+    r_sel=$(printf '%s' "$3" | sed 's/[]\/$*.^[]/\\&/g')
+    sed -n "/^$r_sel {\$/,/^}\$/p" "$1/$2.css" |
+        sed -n "s/^  $4: \(.*\);\$/\1/p"
+}
+
+# check DIR: gives 0 while the seven contracts hold over the arm sheets of
+# DIR. It names the first contract that fails on the standard error.
+check() {
+    d=$1
+
+    # 1. Each arm of GTK 3 holds the five rules of the block, and the sheet of
+    # GTK 4 holds no rule of it.
+    for c_arm in $arms; do
+        for c_tail in '' ' trough' ' slider' ' slider:hover' ' slider:active'
+        do
+            if [ -z "$(row "$d" "$c_arm" "$bar$c_tail" background-color)" ]
+            then
+                echo "assert-browser: $c_arm holds no rule '$bar$c_tail'" >&2
+                return 1
+            fi
+        done
+    done
+    if grep -qF "$bar" "$d/gtk4.css"; then
+        echo "assert-browser: the GTK 4 sheet holds the block" >&2
+        return 1
+    fi
+
+    # 2. The trough of each arm holds no ground, which is the one state that
+    # lets the browser read the colours of the theme.
+    for c_arm in $arms; do
+        if [ "$(row "$d" "$c_arm" "$bar trough" background-color)" \
+             != transparent ]; then
+            echo "assert-browser: the trough of $c_arm paints a ground" >&2
+            return 1
+        fi
+    done
+
+    # 3. The five slider keys give five colours of their own, and each one
+    # takes the ladder that Style::sliderColors() holds.
+    c_none=$(row "$d" none "$bar slider" background-color)
+    c_darken=$(row "$d" darken "$bar slider" background-color)
+    c_sel=$(row "$d" selected "$bar slider" background-color)
+    c_blend=$(row "$d" blend "$bar slider" background-color)
+    c_custom=$(row "$d" custom "$bar slider" background-color)
+    if [ "$c_none" != '@theme_button_background_normal_breeze' ]; then
+        echo "assert-browser: the none arm rests on '$c_none'" >&2
+        return 1
+    fi
+    case $c_darken in
+        'shade(@theme_button_background_normal_breeze, '*')') ;;
+        *) echo "assert-browser: the darken arm rests on '$c_darken'" >&2
+           return 1;;
+    esac
+    if [ "$c_sel" != '@theme_selected_bg_color_breeze' ]; then
+        echo "assert-browser: the selected arm rests on '$c_sel'" >&2
+        return 1
+    fi
+    case $c_blend in
+        '#'[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
+        *) echo "assert-browser: the blend arm rests on '$c_blend'" >&2
+           return 1;;
+    esac
+    if [ "$c_custom" != "$custom" ]; then
+        echo "assert-browser: the custom arm rests on '$c_custom'" >&2
+        return 1
+    fi
+    if [ "$(printf '%s\n' "$c_none" "$c_darken" "$c_sel" "$c_blend" \
+            "$c_custom" | sort -u | wc -l)" -ne 5 ]; then
+        echo "assert-browser: two slider keys give one colour" >&2
+        return 1
+    fi
+
+    # 4. The pointer key moves the rest row to the button ladder and it keeps
+    # the hover row on the slider ladder.
+    if [ "$(row "$d" mo "$bar slider" background-color)" != "$c_none" ]; then
+        echo "assert-browser: the pointer key holds the rest row" >&2
+        return 1
+    fi
+    if [ "$(row "$d" mo "$bar slider:hover" background-color)" != \
+         "$(row "$d" selected "$bar slider:hover" background-color)" ]; then
+        echo "assert-browser: the pointer key moves the hover row" >&2
+        return 1
+    fi
+
+    # 5. Each arm takes one ladder step for the pointer, and the button state
+    # takes the colour of the pointer state.
+    for c_arm in $arms; do
+        c_rest=$(row "$d" "$c_arm" "$bar slider" background-color)
+        c_hover=$(row "$d" "$c_arm" "$bar slider:hover" background-color)
+        c_down=$(row "$d" "$c_arm" "$bar slider:active" background-color)
+        if [ "$c_rest" = "$c_hover" ]; then
+            echo "assert-browser: $c_arm holds one colour for two states" >&2
+            return 1
+        fi
+        if [ "$c_hover" != "$c_down" ]; then
+            echo "assert-browser: $c_arm paints the button state apart" >&2
+            return 1
+        fi
+    done
+
+    # 6. The ground of the bar takes one step of the base ladder under every
+    # setting, which is the step that each groove path of the Qt style paints.
+    for c_arm in $arms; do
+        c_gnd=$(row "$d" "$c_arm" "$bar" background-color)
+        case $c_gnd in
+            'shade(@theme_base_color_breeze, '*')') ;;
+            *) echo "assert-browser: $c_arm grounds on '$c_gnd'" >&2
+               return 1;;
+        esac
+    done
+    if [ "$(for c_arm in $arms; do
+                row "$d" "$c_arm" "$bar" background-color
+            done | sort -u | wc -l)" -ne 1 ]; then
+        echo "assert-browser: a key of the settings moves the ground" >&2
+        return 1
+    fi
+
+    # 7. The ground, the trough and the rest row drop the image that a rule of
+    # the widget paints on the same node. A colour row alone leaves that image
+    # in place, and a trough of an image holds a ground.
+    for c_arm in $arms; do
+        for c_tail in '' ' trough' ' slider'; do
+            if [ "$(row "$d" "$c_arm" "$bar$c_tail" background-image)" \
+                 != none ]; then
+                echo "assert-browser: $c_arm keeps an image on" \
+                     "'$bar$c_tail'" >&2
+                return 1
+            fi
+        done
+    done
+    return 0
+}
+
+if ! check "$work/arm"; then
+    echo "assert-browser: the arms fail the check" >&2
+    exit 1
+fi
+
+# The controls below. Each one breaks one contract in a copy of the arms, and
+# the check must fail over that copy.
+broken=0
+
+# control NAME: the check must fail over the copy under the broken directory.
+control() {
+    if check "$work/broken" 2> "$work/control.log"; then
+        echo "assert-browser: the check passed the broken copy of $1" >&2
+        exit 1
+    fi
+    broken=$((broken + 1))
+}
+
+# paste ARM SELECTOR PROP VALUE: writes the copy of the arms with the property
+# PROP of the rule SELECTOR of ARM at VALUE.
+paste() {
+    rm -rf "$work/broken"
+    cp -r "$work/arm" "$work/broken"
+    awk -v want="$2 {" -v prop="  $3: " -v val="$4" '
+        $0 == want { in_rule = 1 }
+        in_rule && index($0, prop) == 1 { print prop val ";"; next }
+        in_rule && $0 == "}" { in_rule = 0 }
+        { print }' "$work/arm/$1.css" > "$work/broken/$1.css"
+}
+
+# The block cut out of one arm, which is the sheet before this check shipped.
+rm -rf "$work/broken"
+cp -r "$work/arm" "$work/broken"
+sed "/^$bar/,/^}\$/d" "$work/arm/none.css" > "$work/broken/none.css"
+control 'the block of an arm'
+
+# The block in the GTK 4 sheet, which no browser reads and whose names would
+# move the floors of that dialect.
+rm -rf "$work/broken"
+cp -r "$work/arm" "$work/broken"
+sed -n "/^$bar/,/^}\$/p" "$work/arm/none.css" >> "$work/broken/gtk4.css"
+control 'the block in the GTK 4 sheet'
+
+# A trough of a ground, which takes the block back to the state that leaves
+# the browser on the colours of its own.
+paste none "$bar trough" background-color '@theme_base_color_breeze'
+control 'the ground of the trough'
+
+# The rest row of the darken arm at the colour of the none arm, which drops
+# the darker pair of ladder steps.
+paste darken "$bar slider" background-color \
+    '@theme_button_background_normal_breeze'
+control 'the ladder of the darken arm'
+
+# The hover row at the rest row, which drops the step of the pointer.
+paste selected "$bar slider:hover" background-color \
+    '@theme_selected_bg_color_breeze'
+control 'the step of the pointer'
+
+# The button row apart from the pointer row, which the Qt style paints as one.
+paste selected "$bar slider:active" background-color \
+    '@theme_button_background_normal_breeze'
+control 'the button state'
+
+# The rest row of the pointer arm at the slider ladder, which is the row of
+# the arm that holds the key at false.
+paste mo "$bar slider" background-color '@theme_selected_bg_color_breeze'
+control 'the rest row of the pointer key'
+
+# The ground of one arm at the seed of the ladder, which is the row that a
+# branch on the groove keys writes.
+paste thin "$bar" background-color '@theme_base_color_breeze'
+control 'the seed of the ground'
+
+# The ground of one arm on the window ladder, which is another ladder of the
+# palette.
+paste page "$bar" background-color 'shade(@theme_bg_color_breeze, 0.900)'
+control 'the ladder of the ground'
+
+# The colour of the custom arm at another value, which is a doctored sheet.
+paste custom "$bar slider" background-color '#ff0000'
+control 'the colour of the custom arm'
+
+rm -rf "$work/broken"
+echo "assert-browser: the block stands in the GTK 3 sheet of $(echo $arms |
+     wc -w) arms and in no GTK 4 sheet, it holds the slider keys and the" \
+     "pointer key of the settings, it grounds on one step of the base ladder" \
+     "under every groove key, it drops the image of the rule of the widget" \
+     "on the ground, the trough and the rest row, and the check rejects each" \
+     "of the $broken control copies"
