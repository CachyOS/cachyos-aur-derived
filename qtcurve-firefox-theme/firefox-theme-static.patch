@@ -0,0 +1,233 @@
+/*****************************************************************************
+ *   Copyright 2026 QtCurve authors                                          *
+ *                                                                           *
+ *   This program is free software; you can redistribute it and/or modify    *
+ *   it under the terms of the GNU Lesser General Public License as          *
+ *   published by the Free Software Foundation; either version 2.1 of the    *
+ *   License, or (at your option) version 3, or any later version accepted   *
+ *   by the membership of KDE e.V. (or its successor approved by the         *
+ *   membership of KDE e.V.), which shall act as a proxy defined in          *
+ *   Section 6 of version 3 of the license.                                  *
+ *                                                                           *
+ *   This program is distributed in the hope that it will be useful,         *
+ *   but WITHOUT ANY WARRANTY; without even the implied warranty of          *
+ *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU       *
+ *   Lesser General Public License for more details.                         *
+ *                                                                           *
+ *   You should have received a copy of the GNU Lesser General Public        *
+ *   License along with this library. If not,                                *
+ *   see <http://www.gnu.org/licenses/>.                                     *
+ *****************************************************************************/
+
+#include "manifest.h"
+
+#include "ffmap.h"
+
+#include <emit.h>
+
+#include <QStringList>
+
+namespace QtCurve {
+namespace Firefox {
+
+using Gtk::Palette;
+
+const char *const geckoId = "qtcurve-firefox-theme@wyn.invent.kde.org";
+
+namespace {
+
+/** The name of the add-on, which about:addons shows. */
+const char *const themeName = "QtCurve";
+
+/**
+ * The line under the name on the card of about:addons. The card of a theme
+ * holds the name, this line and the preview image, and it holds no icon.
+ */
+const char *const themeDescription =
+    "This theme paints the Firefox window, the tabs and the address bar in"
+    " the colours of QtCurve. On its own it uses the default QtCurve colours,"
+    " light or dark to match your system. With QtCurve on Linux, the colours"
+    " can follow your own settings.";
+
+/** The author of the add-on, which the open card of about:addons shows. */
+const char *const themeAuthor = "Wyn Sun";
+
+/**
+ * The alignment of the gradient image, which the manifest carries beside the
+ * image. The gradient covers the tool box, so it starts at the top left.
+ */
+const char *const backgroundAlignment = "left top";
+
+/**
+ * The tiling of the gradient image. The stops run down the tool box, so the
+ * image repeats to the right of it.
+ */
+const char *const backgroundTiling = "repeat";
+
+/** Returns one string in the JSON form, with no escape of its own. */
+QString
+text(const QString &value)
+{
+    return QLatin1Char('"') + value + QLatin1Char('"');
+}
+
+/** Returns one row of an object, at the depth depth of two spaces. */
+QString
+row(int depth, const QString &key, const QString &value, bool last)
+{
+    return QString(depth * 2, QLatin1Char(' ')) + text(key) +
+        QStringLiteral(": ") + value + (last ? QString() :
+                                        QStringLiteral(",")) +
+        QLatin1Char('\n');
+}
+
+/** Returns one line of a list or of a block, at the depth depth. */
+QString
+line(int depth, const QString &value)
+{
+    return QString(depth * 2, QLatin1Char(' ')) + value + QLatin1Char('\n');
+}
+
+/**
+ * Returns the stop list of the tool box gradient, with no function name and
+ * no bracket. A titlebar appearance that carries no gradient gives an empty
+ * string, and the sheet reads the same source.
+ */
+QString
+gradientStops(const Options &opts, const QColor &base)
+{
+    const QString image = Gtk::gradientImage(opts, opts.titlebarAppearance,
+                                             Gtk::fixedTone(base));
+    const QString head = QStringLiteral("linear-gradient(");
+    if (!image.startsWith(head) || !image.endsWith(QLatin1Char(')'))) {
+        return QString();
+    }
+    return image.mid(head.size(), image.size() - head.size() - 1);
+}
+
+/** Returns the colours object of one half, at the depth depth. */
+QString
+colours(const Options &opts, const Palette &pal, int depth)
+{
+    QStringList keys;
+    QStringList values;
+    int count = 0;
+    const FfRow *const map = ffRows(count);
+    for (int at = 0;at < count;++at) {
+        const QColor col = ffColour(opts, pal, map[at].role);
+        const QString value = col.alpha() == 255 ? Gtk::hex(col) :
+            Gtk::rgba(col, col.alphaF());
+        for (int i = 0;i < map[at].keyCount;++i) {
+            keys << QLatin1String(map[at].keys[i]);
+            values << value;
+        }
+    }
+    QString out = line(depth, text(QStringLiteral("colors")) +
+                       QStringLiteral(": {"));
+    for (int at = 0;at < keys.size();++at) {
+        out += row(depth + 1, keys.at(at), text(values.at(at)),
+                   at + 1 == keys.size());
+    }
+    out += line(depth, QStringLiteral("},"));
+    return out;
+}
+
+/**
+ * Returns the theme object of one half, at the depth depth. The scheme scheme
+ * is light or dark, and it reaches properties.color_scheme.
+ */
+QString
+half(const Options &opts, const Palette &pal, const QString &scheme,
+     int depth, bool last)
+{
+    const QString stops = gradientStops(opts, pal.titlebar);
+    QString out = line(depth, text(scheme == QLatin1String("dark") ?
+                                   QStringLiteral("dark_theme") :
+                                   QStringLiteral("theme")) +
+                       QStringLiteral(": {"));
+    out += colours(opts, pal, depth + 1);
+    if (!stops.isEmpty()) {
+        out += line(depth + 1, text(QStringLiteral("images")) +
+                    QStringLiteral(": {"));
+        out += line(depth + 2, text(QStringLiteral("additional_backgrounds")) +
+                    QStringLiteral(": ["));
+        out += line(depth + 3, QStringLiteral("{"));
+        out += row(depth + 4, QStringLiteral("linear-gradient"), text(stops),
+                   true);
+        out += line(depth + 3, QStringLiteral("}"));
+        out += line(depth + 2, QStringLiteral("]"));
+        out += line(depth + 1, QStringLiteral("},"));
+    }
+    out += line(depth + 1, text(QStringLiteral("properties")) +
+                QStringLiteral(": {"));
+    out += row(depth + 2, QStringLiteral("color_scheme"), text(scheme),
+               stops.isEmpty());
+    if (!stops.isEmpty()) {
+        out += line(depth + 2,
+                    text(QStringLiteral("additional_backgrounds_alignment")) +
+                    QStringLiteral(": ["));
+        out += line(depth + 3, text(QLatin1String(backgroundAlignment)));
+        out += line(depth + 2, QStringLiteral("],"));
+        out += line(depth + 2,
+                    text(QStringLiteral("additional_backgrounds_tiling")) +
+                    QStringLiteral(": ["));
+        out += line(depth + 3, text(QLatin1String(backgroundTiling)));
+        out += line(depth + 2, QStringLiteral("]"));
+    }
+    out += line(depth + 1, QStringLiteral("}"));
+    out += line(depth, last ? QStringLiteral("}") : QStringLiteral("},"));
+    return out;
+}
+
+}
+
+QString
+buildManifest(const Options &opts, const Palette &light, const Palette &dark)
+{
+    QString out = QStringLiteral("{\n");
+    out += row(1, QStringLiteral("manifest_version"), QStringLiteral("2"),
+               false);
+    out += row(1, QStringLiteral("name"), text(QLatin1String(themeName)),
+               false);
+    out += row(1, QStringLiteral("version"),
+               text(QStringLiteral(QTC_FIREFOX_VERSION)), false);
+    out += row(1, QStringLiteral("description"),
+               text(QLatin1String(themeDescription)), false);
+    out += row(1, QStringLiteral("author"), text(QLatin1String(themeAuthor)),
+               false);
+    out += line(1, text(QStringLiteral("browser_specific_settings")) +
+                QStringLiteral(": {"));
+    out += line(2, text(QStringLiteral("gecko")) + QStringLiteral(": {"));
+    out += row(3, QStringLiteral("id"), text(QLatin1String(geckoId)), true);
+    out += line(2, QStringLiteral("}"));
+    out += line(1, QStringLiteral("},"));
+    out += half(opts, light, QStringLiteral("light"), 1, false);
+    out += half(opts, dark, QStringLiteral("dark"), 1, true);
+    out += QStringLiteral("}\n");
+    return out;
+}
+
+QString
+buildMap()
+{
+    QString out;
+    int count = 0;
+    const FfRow *const map = ffRows(count);
+    for (int at = 0;at < count;++at) {
+        QStringList vars;
+        for (int i = 0;i < map[at].varCount;++i) {
+            vars << QLatin1String(map[at].vars[i]);
+        }
+        QStringList keys;
+        for (int i = 0;i < map[at].keyCount;++i) {
+            keys << QLatin1String(map[at].keys[i]);
+        }
+        out += QStringLiteral("%1|%2|%3\n")
+            .arg(QLatin1String(ffRoleName(map[at].role)),
+                 vars.join(QLatin1Char(',')), keys.join(QLatin1Char(',')));
+    }
+    return out;
+}
+
+}
+}
