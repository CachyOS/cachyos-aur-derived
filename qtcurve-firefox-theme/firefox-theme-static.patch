diff --git a/firefox/check/assert-ff-agree.sh b/firefox/check/assert-ff-agree.sh
new file mode 100644
index 00000000..aad204e9
--- /dev/null
+++ b/firefox/check/assert-ff-agree.sh
@@ -0,0 +1,168 @@
+#!/bin/sh
+# assert-ff-agree.sh WRITER MAP LIGHT DARK MANIFEST LIGHTCOLORS DARKCOLORS
+# MINROWS: the two arms of the theme must hold one palette. LIGHT and DARK are
+# the sheets of the build and MANIFEST is the manifest of the build. The run
+# reads each one against a fresh run of the writer, then reads every row of
+# MAP: the value of a custom property of a sheet must equal the value of every
+# colour key of the matching half. The run repeats over two colour files that
+# give the halves their own values, and it doctors a copy of the manifest at
+# the end.
+set -eu
+usage='usage: assert-ff-agree.sh WRITER MAP LIGHT DARK MANIFEST LIGHTCOLORS DARKCOLORS MINROWS'
+writer=${1:?$usage}
+map=${2:?$usage}
+light=${3:?$usage}
+dark=${4:?$usage}
+manifest=${5:?$usage}
+lightcolors=${6:?$usage}
+darkcolors=${7:?$usage}
+minrows=${8:?$usage}
+
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+status=0
+
+fail() {
+    echo "assert-ff-agree: $1" >&2
+    status=1
+}
+
+rows=$(grep -c '|' "$map" || true)
+if [ "$rows" -lt "$minrows" ]; then
+    fail "$map holds $rows rows, under $minrows"
+fi
+
+# bake NAME LIGHTCOLORS DARKCOLORS: writes the two sheets and the manifest of
+# one pair of colour files into the temporary directory.
+bake() {
+    "$writer" --stdout --default --force --scheme "$2" \
+        --out "$tmp/$1-light.css"
+    "$writer" --stdout --default --force --scheme "$3" \
+        --out "$tmp/$1-dark.css"
+    "$writer" --manifest --default --force --scheme "$2" --scheme-dark "$3" \
+        --out "$tmp/$1-manifest.json"
+}
+
+# halves FILE: splits the manifest FILE into the two halves of the temporary
+# directory.
+halves() {
+    h_at=$(grep -n '"dark_theme": {' "$1" | cut -d: -f1)
+    if [ -z "$h_at" ]; then
+        echo "assert-ff-agree: $1 holds no dark half" >&2
+        return 1
+    fi
+    sed -n "1,$((h_at - 1))p" "$1" > "$tmp/light.half"
+    sed -n "$h_at,\$p" "$1" > "$tmp/dark.half"
+    return 0
+}
+
+# value FILE NAME: prints the value of the custom property NAME of the sheet
+# FILE, and prints nothing when the sheet does not set it.
+value() {
+    sed -n "s/^  $2: \\(.*\\) !important;\$/\\1/p" "$1"
+}
+
+# colour FILE KEY: prints the value of the colour key KEY of the manifest half
+# FILE, and prints nothing when the half does not hold it.
+colour() {
+    sed -n "s/^ *\"$2\": \"\\([^\"]*\\)\",\\{0,1\\}\$/\\1/p" "$1"
+}
+
+# agree NAME LIGHTSHEET DARKSHEET MANIFEST: gives 0 when every row of the map
+# binds one value in the sheet and in the manifest of each half.
+agree() {
+    a_name=$1
+    halves "$4" || return 1
+    a_bad=0
+    while IFS='|' read -r a_role a_vars a_keys; do
+        [ -n "$a_role" ] || continue
+        a_light=
+        a_dark=
+        if [ -n "$a_vars" ]; then
+            for a_var in $(printf '%s\n' "$a_vars" | tr ',' ' '); do
+                a_one=$(value "$2" "$a_var")
+                a_two=$(value "$3" "$a_var")
+                if [ -z "$a_one" ] || [ -z "$a_two" ]; then
+                    echo "assert-ff-agree: $a_name: the sheets set no" \
+                         "$a_var of the row $a_role" >&2
+                    a_bad=1
+                    continue
+                fi
+                if [ -z "$a_light" ]; then
+                    a_light=$a_one
+                    a_dark=$a_two
+                fi
+                if [ "$a_one" != "$a_light" ] || [ "$a_two" != "$a_dark" ]
+                then
+                    echo "assert-ff-agree: $a_name: $a_var holds another" \
+                         "value of the row $a_role" >&2
+                    a_bad=1
+                fi
+            done
+        fi
+        for a_key in $(printf '%s\n' "$a_keys" | tr ',' ' '); do
+            [ -n "$a_key" ] || continue
+            a_one=$(colour "$tmp/light.half" "$a_key")
+            a_two=$(colour "$tmp/dark.half" "$a_key")
+            if [ -z "$a_one" ] || [ -z "$a_two" ]; then
+                echo "assert-ff-agree: $a_name: the manifest holds no" \
+                     "$a_key of the row $a_role" >&2
+                a_bad=1
+                continue
+            fi
+            if [ -z "$a_light" ]; then
+                a_light=$a_one
+                a_dark=$a_two
+            fi
+            if [ "$a_one" != "$a_light" ] || [ "$a_two" != "$a_dark" ]; then
+                echo "assert-ff-agree: $a_name: $a_key holds $a_one and" \
+                     "$a_two, and the row $a_role holds $a_light and" \
+                     "$a_dark" >&2
+                a_bad=1
+            fi
+        done
+    done < "$map"
+    return $a_bad
+}
+
+# 1. The build products must equal a fresh run of the writer.
+bake shipped "$lightcolors" "$darkcolors"
+cmp -s "$tmp/shipped-light.css" "$light" ||
+    fail "the light sheet of the build differs from a fresh run"
+cmp -s "$tmp/shipped-dark.css" "$dark" ||
+    fail "the dark sheet of the build differs from a fresh run"
+cmp -s "$tmp/shipped-manifest.json" "$manifest" ||
+    fail "the manifest of the build differs from a fresh run"
+
+# 2. Every row of the map holds one value in the two arms of the shipped
+# schemes.
+agree shipped "$light" "$dark" "$manifest" || status=1
+
+# 3. The same rows, over two colour files that give the halves their own
+# values. A swap of two roles or of the two halves fails here.
+distinct=$(dirname "$0")
+bake distinct "$distinct/distinct-light.colors" \
+    "$distinct/distinct-dark.colors"
+agree distinct "$tmp/distinct-light.css" "$tmp/distinct-dark.css" \
+    "$tmp/distinct-manifest.json" || status=1
+
+# The control below swaps the value of one colour key of the light half, so
+# that key leaves its row. The check must fail over the copy.
+frame=$(colour "$tmp/light.half" frame)
+toolbar=$(colour "$tmp/light.half" toolbar)
+if [ "$frame" = "$toolbar" ]; then
+    fail "the distinct colour files give the frame and the toolbar one value"
+fi
+sed "s|\"frame\": \"$frame\"|\"frame\": \"$toolbar\"|" \
+    "$tmp/distinct-manifest.json" > "$tmp/swapped.json"
+if agree control "$tmp/distinct-light.css" "$tmp/distinct-dark.css" \
+        "$tmp/swapped.json" 2> "$tmp/control.log"; then
+    fail "the check passed the control copy of the swapped key"
+fi
+
+if [ $status -eq 0 ]; then
+    echo "assert-ff-agree: the $rows rows of the map hold one value in the" \
+         "sheet and in the manifest of each half, over two colour file" \
+         "pairs, and the check rejects the swapped copy"
+fi
+exit $status
diff --git a/firefox/check/assert-ff-manifest.cmake b/firefox/check/assert-ff-manifest.cmake
new file mode 100644
index 00000000..957f0879
--- /dev/null
+++ b/firefox/check/assert-ff-manifest.cmake
@@ -0,0 +1,158 @@
+# assert-ff-manifest.cmake MANIFEST KEYS VERSION ID: the manifest of the
+# static theme must be valid JSON, and every colour key of it must stand in
+# the pinned list KEYS. The loader of Firefox drops a key that it does not
+# know without a word, so a name outside the list paints nothing.
+#
+# The manifest must also hold a description and an author, which the card of
+# about:addons shows under the name of the theme. The run then doctors five
+# copies of the manifest, and it fails if the check passes a copy. cmake -P
+# takes the four names as -D definitions, and the usage message below names
+# them.
+
+if(NOT MANIFEST OR NOT KEYS OR NOT VERSION OR NOT ID)
+  message(FATAL_ERROR
+    "usage: cmake -DMANIFEST=<file> -DKEYS=<file> -DVERSION=<version>"
+    " -DID=<identifier> -P assert-ff-manifest.cmake")
+endif()
+
+file(READ "${MANIFEST}" qtc_text)
+file(STRINGS "${KEYS}" qtc_pin REGEX "^[a-z]")
+
+# The two keys that the schema of Firefox marks as aliases of another key.
+# Firefox 70 and later drop the pair, so the manifest must not carry it.
+set(qtc_dead accentcolor textcolor)
+
+# qtc_colour_ok VALUE OUT: sets OUT to true when VALUE is a hexadecimal colour
+# or an rgba() colour.
+function(qtc_colour_ok value out)
+  set(digit "[0-9a-fA-F]")
+  set(hex "^#${digit}${digit}${digit}${digit}${digit}${digit}$")
+  set(rgba "^rgba\\([0-9]+,[0-9]+,[0-9]+,[0-9.]+\\)$")
+  if(value MATCHES "${hex}" OR value MATCHES "${rgba}")
+    set("${out}" True PARENT_SCOPE)
+  else()
+    set("${out}" False PARENT_SCOPE)
+  endif()
+endfunction()
+
+# qtc_check TEXT FAULT: reads the manifest TEXT and sets FAULT to the first
+# contract that fails, or to an empty string when every contract holds.
+function(qtc_check text fault)
+  set("${fault}" "" PARENT_SCOPE)
+  string(JSON version ERROR_VARIABLE bad GET "${text}" version)
+  if(bad)
+    set("${fault}" "the manifest is no JSON object: ${bad}" PARENT_SCOPE)
+    return()
+  endif()
+  if(NOT version STREQUAL "${VERSION}")
+    set("${fault}" "the version is ${version} and not ${VERSION}"
+      PARENT_SCOPE)
+    return()
+  endif()
+  string(JSON kind ERROR_VARIABLE bad GET "${text}" manifest_version)
+  if(bad OR NOT kind EQUAL 2)
+    set("${fault}" "the manifest version is ${kind} and not 2" PARENT_SCOPE)
+    return()
+  endif()
+  string(JSON gecko ERROR_VARIABLE bad GET "${text}"
+    browser_specific_settings gecko id)
+  if(bad OR NOT gecko STREQUAL "${ID}")
+    set("${fault}" "the identifier is ${gecko} and not ${ID}" PARENT_SCOPE)
+    return()
+  endif()
+  # The card of about:addons reads these two fields of the top object. A card
+  # of a theme shows no icon, so the two lines carry the whole text of it.
+  foreach(field description author)
+    string(JSON line ERROR_VARIABLE bad GET "${text}" "${field}")
+    if(bad OR line STREQUAL "")
+      set("${fault}" "the manifest holds no ${field}" PARENT_SCOPE)
+      return()
+    endif()
+  endforeach()
+  foreach(half theme dark_theme)
+    if(half STREQUAL "theme")
+      set(scheme light)
+    else()
+      set(scheme dark)
+    endif()
+    string(JSON colours ERROR_VARIABLE bad GET "${text}" "${half}" colors)
+    if(bad)
+      set("${fault}" "the half ${half} holds no colours: ${bad}" PARENT_SCOPE)
+      return()
+    endif()
+    string(JSON mode ERROR_VARIABLE bad GET "${text}" "${half}" properties
+      color_scheme)
+    if(bad OR NOT mode STREQUAL "${scheme}")
+      set("${fault}" "the half ${half} names the scheme ${mode}" PARENT_SCOPE)
+      return()
+    endif()
+    string(JSON count LENGTH "${colours}")
+    if(count LESS 1)
+      set("${fault}" "the half ${half} holds no colour key" PARENT_SCOPE)
+      return()
+    endif()
+    math(EXPR last "${count} - 1")
+    foreach(at RANGE ${last})
+      string(JSON key MEMBER "${colours}" ${at})
+      if(NOT key IN_LIST qtc_pin)
+        set("${fault}"
+          "the half ${half} holds the key ${key}, outside the pin"
+          PARENT_SCOPE)
+        return()
+      endif()
+      if(key IN_LIST qtc_dead)
+        set("${fault}" "the half ${half} holds the dead key ${key}"
+          PARENT_SCOPE)
+        return()
+      endif()
+      string(JSON value GET "${colours}" "${key}")
+      qtc_colour_ok("${value}" ok)
+      if(NOT ok)
+        set("${fault}" "the key ${key} holds the value ${value}" PARENT_SCOPE)
+        return()
+      endif()
+    endforeach()
+  endforeach()
+endfunction()
+
+qtc_check("${qtc_text}" qtc_fault)
+if(qtc_fault)
+  message(FATAL_ERROR "assert-ff-manifest: ${qtc_fault}")
+endif()
+
+# The controls below doctor a copy of the manifest, and the check must fail
+# over each copy.
+set(qtc_broken 0)
+function(qtc_control name text)
+  qtc_check("${text}" fault)
+  if(NOT fault)
+    message(FATAL_ERROR
+      "assert-ff-manifest: the check passed the control copy of ${name}")
+  endif()
+  math(EXPR qtc_broken "${qtc_broken} + 1")
+  set(qtc_broken "${qtc_broken}" PARENT_SCOPE)
+endfunction()
+
+set(qtc_dead_row "\"colors\": {\n      \"accentcolor\": \"#000000\",")
+string(REPLACE "\"colors\": {" "${qtc_dead_row}" qtc_dead_copy "${qtc_text}")
+qtc_control(accentcolor "${qtc_dead_copy}")
+
+string(REPLACE "\"version\": \"${VERSION}\"" "\"version\": \"0.0.1\""
+  qtc_version_copy "${qtc_text}")
+qtc_control(version "${qtc_version_copy}")
+
+string(REPLACE "\"frame\":" "\"qtc_no_such_key\":" qtc_key_copy "${qtc_text}")
+qtc_control(key "${qtc_key_copy}")
+
+# The two controls below rename a field of the card, so the copy holds no
+# field of that name.
+string(REPLACE "\"description\":" "\"qtc_no_description\":" qtc_line_copy
+  "${qtc_text}")
+qtc_control(description "${qtc_line_copy}")
+
+string(REPLACE "\"author\":" "\"qtc_no_author\":" qtc_who_copy "${qtc_text}")
+qtc_control(author "${qtc_who_copy}")
+
+message(STATUS
+  "assert-ff-manifest: ${MANIFEST} ok, the two halves hold keys of the pin"
+  " alone, and the check rejects each of the ${qtc_broken} control copies")
diff --git a/firefox/check/assert-ff-repeat.sh b/firefox/check/assert-ff-repeat.sh
new file mode 100644
index 00000000..a55ea9c1
--- /dev/null
+++ b/firefox/check/assert-ff-repeat.sh
@@ -0,0 +1,84 @@
+#!/bin/sh
+# assert-ff-repeat.sh CMAKE WRITER XPI MANIFEST LIGHT DARK PREVIEW: one source
+# tree must give one manifest. The upload of a release names the bytes of one
+# build. A rebuild that moved a byte would give a second add-on of one
+# version.
+#
+# The run writes the manifest two times from the colour files LIGHT and DARK.
+# It reads the two texts against each other and against the manifest MANIFEST
+# of the build. It also reads the two members of the archive XPI against that
+# file and against the card image PREVIEW of the tree.
+#
+# The run then doctors a manifest and an image, and it fails if a compare
+# passes a copy.
+set -eu
+ulimit -c 0
+usage='usage: assert-ff-repeat.sh CMAKE WRITER XPI MANIFEST LIGHT DARK'
+usage="$usage PREVIEW"
+cmake=${1:?$usage}
+writer=${2:?$usage}
+xpi=${3:?$usage}
+manifest=${4:?$usage}
+light=${5:?$usage}
+dark=${6:?$usage}
+preview=${7:?$usage}
+
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+status=0
+
+fail() {
+    echo "assert-ff-repeat: $1" >&2
+    status=1
+}
+
+# emit NAME DARKFILE: writes one manifest of the light file and DARKFILE.
+emit() {
+    "$writer" --manifest --default --force --scheme "$light" \
+        --scheme-dark "$2" --out "$tmp/$1.json" > "$tmp/$1.log" 2>&1
+}
+
+# 1. Two runs of one tree give one manifest.
+emit one "$dark"
+emit two "$dark"
+cmp -s "$tmp/one.json" "$tmp/two.json" ||
+    fail "two runs of the manifest mode gave two texts"
+
+# 2. That manifest is the manifest of the build.
+cmp -s "$tmp/one.json" "$manifest" ||
+    fail "a fresh run does not give the manifest of the build"
+
+# 3. The archive carries those bytes. A zip container holds the times of its
+# file, so the container repeats no build; each member must.
+mkdir -p "$tmp/out"
+( cd "$tmp/out" && "$cmake" -E tar xf "$xpi" ) > "$tmp/unpack.log" 2>&1
+cmp -s "$tmp/out/manifest.json" "$manifest" ||
+    fail "the member of the archive is not the manifest of the build"
+
+# 4. The card image of the archive is the image of the tree. A build copies
+# that file and writes no byte of it, so the two must agree.
+cmp -s "$tmp/out/preview.png" "$preview" ||
+    fail "the card image of the archive is not the image of the tree"
+
+# The control below writes a manifest of two light halves. The compare must
+# reject it, so a run of this check cannot pass a text that moved.
+emit control "$light"
+if cmp -s "$tmp/control.json" "$tmp/one.json"; then
+    fail "the compare passed the control manifest of two light halves"
+fi
+
+# The control below moves the first bytes of a copy of the card image. The
+# magic of a PNG makes that copy differ, and the compare must reject it.
+cp "$preview" "$tmp/control.png"
+dd if="$preview" of="$tmp/control.png" bs=1 skip=1 seek=0 count=4 \
+    conv=notrunc > "$tmp/control.log" 2>&1
+if cmp -s "$tmp/control.png" "$preview"; then
+    fail "the compare passed the control image of a doctored header"
+fi
+
+if [ $status -eq 0 ]; then
+    echo "assert-ff-repeat: two runs give one manifest, which the build and" \
+         "the member of $(basename "$xpi") hold, the archive carries the" \
+         "card image of the tree, and the check rejects the 2 control copies"
+fi
+exit $status
diff --git a/firefox/check/assert-ff-xpi.sh b/firefox/check/assert-ff-xpi.sh
new file mode 100644
index 00000000..04caafa7
--- /dev/null
+++ b/firefox/check/assert-ff-xpi.sh
@@ -0,0 +1,140 @@
+#!/bin/sh
+# assert-ff-xpi.sh CMAKE XPI MANIFEST ID: the package of the static theme must
+# hold the manifest and the card image, and no other file. The card of
+# about:addons reads that image under the literal name preview.png at the root
+# of the package. The file name of the package must carry the identifier of
+# the add-on.
+#
+# The run then builds three faulty packages, and it fails if the check passes
+# one of them.
+set -eu
+usage='usage: assert-ff-xpi.sh CMAKE XPI MANIFEST ID'
+cmake=${1:?$usage}
+xpi=${2:?$usage}
+manifest=${3:?$usage}
+id=${4:?$usage}
+
+# The width of the card image in pixels, which aboutaddons.css of Firefox 155
+# gives. Another width still shows, and it takes a warning of the console.
+width=680
+
+# The height of the card image in pixels, which the same file gives.
+height=92
+
+# The first eight bytes of a PNG file, in hexadecimal. Firefox takes the type
+# of the image from the name of the member, so an image of other bytes shows
+# nothing on the card.
+magic=89504e470d0a1a0a
+
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+status=0
+
+fail() {
+    echo "assert-ff-xpi: $1" >&2
+    status=1
+}
+
+# listing FILE: prints the names of the files of the package FILE, sorted.
+listing() {
+    "$cmake" -E tar tf "$1" | sed 's|/$||' | sort
+}
+
+# two_members FILE: gives 0 when the package FILE holds the manifest and the
+# card image, and no other file.
+two_members() {
+    listing "$1" > "$tmp/listing"
+    if [ "$(cat "$tmp/listing")" != "manifest.json
+preview.png" ]; then
+        echo "assert-ff-xpi: $1 holds:" >&2
+        cat "$tmp/listing" >&2
+        return 1
+    fi
+    return 0
+}
+
+# be32 FILE AT: prints the whole number of the four bytes at the offset AT of
+# FILE. A number of a PNG file stands in the order of the network, which puts
+# the highest byte first.
+be32() {
+    set -- $(od -An -tu1 -j "$2" -N 4 "$1")
+    echo $(( $1 * 16777216 + $2 * 65536 + $3 * 256 + $4 ))
+}
+
+# png_ok FILE: gives 0 when FILE starts with the magic of a PNG and its header
+# names the size of the card image. The header chunk stands at the offset 8 of
+# the file, and it holds the type, the width and the height, each of four
+# bytes.
+png_ok() {
+    if [ ! -f "$1" ]; then
+        echo "assert-ff-xpi: the package holds no $(basename "$1")" >&2
+        return 1
+    fi
+    start=$(od -An -tx1 -N 8 "$1" | tr -d ' \n')
+    if [ "$start" != "$magic" ]; then
+        echo "assert-ff-xpi: $1 starts with '$start' and not with $magic" >&2
+        return 1
+    fi
+    kind=$(dd if="$1" bs=1 skip=12 count=4 2> /dev/null)
+    got_w=$(be32 "$1" 16)
+    got_h=$(be32 "$1" 20)
+    if [ "$kind" != IHDR ] || [ "$got_w" != "$width" ] ||
+        [ "$got_h" != "$height" ]; then
+        echo "assert-ff-xpi: $1 holds the chunk $kind of $got_w by $got_h," \
+             "and not IHDR of $width by $height" >&2
+        return 1
+    fi
+    return 0
+}
+
+two_members "$xpi" || status=1
+
+mkdir -p "$tmp/out"
+( cd "$tmp/out" && "$cmake" -E tar xf "$xpi" ) > "$tmp/unpack.log" 2>&1
+png_ok "$tmp/out/preview.png" || status=1
+
+# The file name of the package must be the identifier of the add-on.
+name=$(basename "$xpi")
+if [ "$name" != "$id.xpi" ]; then
+    fail "the file name is $name and not $id.xpi"
+fi
+
+# The identifier inside the manifest must be the same text.
+inside=$(sed -n 's/^ *"id": "\(.*\)"$/\1/p' "$manifest")
+if [ "$inside" != "$id" ]; then
+    fail "the manifest holds the identifier $inside and not $id"
+fi
+
+# The controls below build a package of one file and a package of three files,
+# and the check must fail over each one.
+mkdir -p "$tmp/pack"
+cp "$manifest" "$tmp/pack/manifest.json"
+cp "$tmp/out/preview.png" "$tmp/pack/preview.png"
+printf 'a stray file\n' > "$tmp/pack/icon.svg"
+( cd "$tmp/pack" && "$cmake" -E tar cf "$tmp/one.xpi" --format=zip -- \
+    manifest.json ) > "$tmp/pack.log" 2>&1
+if two_members "$tmp/one.xpi" 2>> "$tmp/pack.log"; then
+    fail "the check passed the control package of the manifest alone"
+fi
+( cd "$tmp/pack" && "$cmake" -E tar cf "$tmp/three.xpi" --format=zip -- \
+    manifest.json preview.png icon.svg ) >> "$tmp/pack.log" 2>&1
+if two_members "$tmp/three.xpi" 2>> "$tmp/pack.log"; then
+    fail "the check passed the control package of three files"
+fi
+
+# The control below writes the first four bytes of the file over the four
+# bytes of the width. The header of the copy then names another size, because
+# no width of a real PNG holds the magic.
+cp "$tmp/out/preview.png" "$tmp/bad.png"
+dd if="$tmp/out/preview.png" of="$tmp/bad.png" bs=1 skip=0 seek=16 count=4 \
+    conv=notrunc >> "$tmp/pack.log" 2>&1
+if png_ok "$tmp/bad.png" 2>> "$tmp/pack.log"; then
+    fail "the check passed the control image of a doctored header"
+fi
+
+if [ $status -eq 0 ]; then
+    echo "assert-ff-xpi: $name holds manifest.json and one PNG of $width by" \
+         "$height, the name and the manifest hold the identifier $id, and" \
+         "the check rejects each of the 3 control copies"
+fi
+exit $status
