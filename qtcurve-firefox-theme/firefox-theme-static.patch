+#ifndef QTC_FIREFOX_MANIFEST_H
+#define QTC_FIREFOX_MANIFEST_H
+
+#include <palette.h>
+
+#include <QString>
+
+namespace QtCurve {
+namespace Firefox {
+
+/**
+ * The identifier of the add-on. The file name of the XPI holds the same text,
+ * and a check reads the two against each other. The text is an opaque name:
+ * no host of it must resolve.
+ */
+extern const char *const geckoId;
+
+/**
+ * Returns the text of the static theme manifest. The two halves take the
+ * colours of the two palettes, and each half names its own colour scheme. The
+ * frame colour is flat in each half, and a titlebar appearance that carries a
+ * gradient adds one gradient image beside it.
+ *
+ * \param opts   the QtCurve settings, which give the appearance and the
+ *     ladders of both halves.
+ * \param light  the palette of the light half.
+ * \param dark   the palette of the dark half.
+ * \return the whole manifest, which ends with one newline.
+ */
+QString buildManifest(const Options &opts, const Gtk::Palette &light,
+                      const Gtk::Palette &dark);
+
+/**
+ * Returns the map of the two emitters as text, one row per line. A row holds
+ * the name of the palette source, the custom properties and the colour keys,
+ * and one vertical bar stands between the three fields. The build writes this
+ * text to ff-map.txt, so no check reads a hand written copy of the table.
+ */
+QString buildMap();
+
+}
+}
+
+#endif
