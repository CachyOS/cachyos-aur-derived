+#!/usr/bin/env python3
+"""Writes preview.png, which about:addons shows on the card of the theme.
+
+The image takes the colours of the dark half of the manifest of a build. No
+rule of the build and no check of the tree runs this program, so python and
+Pillow are tools of a maintainer. The image holds flat colour alone; it
+carries no gradient of the title bar and no text.
+
+Usage:
+    python3 firefox/preview/render.py --manifest MANIFEST --out PNG
+"""
+
+import argparse
+import json
+import re
+
+from PIL import Image, ImageDraw
+
+# The width of the card image in pixels. aboutaddons.css of Firefox 155 sizes
+# the image of a card at this width.
+WIDTH = 680
+
+# The height of the card image in pixels. Another height still shows, and it
+# takes a warning in the console of Firefox.
+HEIGHT = 92
+
+# The factor of the supersample. The program draws at this multiple of the
+# size and then averages each block of pixels, which gives a smooth edge. A
+# whole number keeps that average a plain mean of the block.
+SCALE = 4
+
+# The half of the manifest that the image takes. A card holds one image, and
+# Firefox cannot switch that image with the mode of the desktop.
+HALF = "dark_theme"
+
+# The shape of an rgba colour of the manifest, which holds three bytes and one
+# fraction.
+RGBA = re.compile(r"^rgba\((\d+),(\d+),(\d+),[0-9.]+\)$")
+
+# The shape of a hexadecimal colour of the manifest.
+HEX = re.compile(r"^#[0-9a-fA-F]{6}$")
+
+
+def colour(value):
+    """Returns the red, the green and the blue byte of one colour.
+
+    Args:
+        value: one colour of the manifest, as #rrggbb or as rgba(r,g,b,a).
+
+    Returns:
+        The three bytes of that colour. The alpha of an rgba colour drops,
+        because the image holds flat colour alone.
+
+    Raises:
+        ValueError: the text holds neither shape.
+    """
+    if HEX.match(value):
+        return (int(value[1:3], 16), int(value[3:5], 16), int(value[5:7], 16))
+    found = RGBA.match(value)
+    if found:
+        return (int(found.group(1)), int(found.group(2)), int(found.group(3)))
+    raise ValueError("the colour %s is no hexadecimal and no rgba" % value)
+
+
+def palette(path):
+    """Returns the colours of the dark half of one manifest.
+
+    Args:
+        path: the manifest.json of a build.
+
+    Returns:
+        A map of each colour key of that half to the three bytes of the
+        colour.
+
+    Raises:
+        KeyError: the manifest holds no dark half, or that half holds no
+            colours.
+        ValueError: one colour of that half holds an unknown shape.
+    """
+    with open(path, "r", encoding="utf-8") as handle:
+        text = json.load(handle)
+    return {key: colour(value)
+            for key, value in text[HALF]["colors"].items()}
+
+
+def box(pen, place, fill=None, radius=0, edge=None, width=0):
+    """Draws one rectangle at SCALE times the place place.
+
+    Args:
+        pen: the pen of the image.
+        place: the left, the top, the right and the bottom of the rectangle,
+            in the pixels of the card. The right edge and the bottom edge
+            stand outside the shape.
+        fill: the colour inside the rectangle, or None for no fill.
+        radius: the radius of each corner, in the pixels of the card.
+        edge: the colour of the border, or None for no border.
+        width: the width of the border, in the pixels of the card.
+
+    Returns:
+        None.
+    """
+    left, top, right, bottom = place
+    at = [left * SCALE, top * SCALE, right * SCALE - 1, bottom * SCALE - 1]
+    if radius:
+        pen.rounded_rectangle(at, radius=radius * SCALE, fill=fill,
+                              outline=edge, width=width * SCALE)
+    else:
+        pen.rectangle(at, fill=fill, outline=edge, width=width * SCALE)
+
+
+def dot(pen, centre, radius, edge, width):
+    """Draws one circle of the line colour edge at SCALE times the size.
+
+    Args:
+        pen: the pen of the image.
+        centre: the x and the y of the centre, in the pixels of the card.
+        radius: the radius of the circle, in the pixels of the card.
+        edge: the colour of the line.
+        width: the width of the line, in the pixels of the card. A fraction
+            takes the nearest whole number of the pixels of the draw.
+
+    Returns:
+        None.
+    """
+    centre_x, centre_y = centre
+    at = [(centre_x - radius) * SCALE, (centre_y - radius) * SCALE,
+          (centre_x + radius) * SCALE - 1, (centre_y + radius) * SCALE - 1]
+    pen.ellipse(at, outline=edge, width=round(width * SCALE))
+
+
+def strip(pal):
+    """Returns the card image of the palette pal.
+
+    The shapes follow the preview of a theme of Firefox: one tab row over one
+    tool bar, with the address bar inside the tool bar. Each shape stands at
+    SCALE times the size of the card.
+
+    Args:
+        pal: the colours of the dark half, from palette().
+
+    Returns:
+        The image, at SCALE times the size of the card.
+
+    Raises:
+        KeyError: the palette holds no colour that a shape needs.
+    """
+    image = Image.new("RGB", (WIDTH * SCALE, HEIGHT * SCALE), pal["frame"])
+    pen = ImageDraw.Draw(image)
+
+    # The selected tab, with the accent line of the theme at its head.
+    box(pen, (28, 5, 194, 39), radius=4, fill=pal["tab_line"])
+    box(pen, (28, 8, 194, 39), radius=4, fill=pal["tab_selected"])
+    # The title of the selected tab and the title of one background tab.
+    box(pen, (51, 20, 172, 24), radius=2, fill=pal["tab_text"])
+    box(pen, (221, 20, 342, 24), radius=2, fill=pal["tab_background_text"])
+
+    # The tool bar and the line under it.
+    box(pen, (0, 44, WIDTH, HEIGHT), fill=pal["toolbar"])
+    box(pen, (0, HEIGHT - 1, WIDTH, HEIGHT),
+        fill=pal["toolbar_bottom_separator"])
+
+    # The two navigation buttons and the menu button.
+    dot(pen, (24, 68), 6, pal["icons"], 1.5)
+    dot(pen, (60, 68), 6, pal["icons"], 1.5)
+    for top in (61, 67, 73):
+        box(pen, (649, top, 664, top + 2), fill=pal["icons"])
+
+    # The address bar, the icon of the site and the address itself.
+    box(pen, (114, 52, 602, 84), radius=4, fill=pal["toolbar_field"],
+        edge=pal["toolbar_field_border"], width=1)
+    dot(pen, (130, 68), 6, pal["icons"], 1.5)
+    box(pen, (146, 66, 454, 70), radius=2, fill=pal["toolbar_field_text"])
+    return image
+
+
+def main():
+    """Reads the manifest of the command line and writes the card image.
+
+    Two runs over one manifest give one file, byte for byte. A maintainer runs
+    this program after a change of a shipped scheme, and commits the image.
+
+    Returns:
+        None.
+    """
+    parse = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parse.add_argument("--manifest", required=True,
+                       help="the manifest.json of a build")
+    parse.add_argument("--out", required=True,
+                       help="the preview.png to write")
+    args = parse.parse_args()
+    image = strip(palette(args.manifest))
+    image.resize((WIDTH, HEIGHT), Image.BOX).save(args.out, "PNG")
+
+
+if __name__ == "__main__":
+    main()
