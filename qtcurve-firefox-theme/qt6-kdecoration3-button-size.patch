+//! draw the sunken ground of a title bar button group
+/*! drawSunkenBevel() in qt6/kwin/qtcurveclient.cpp drew the same shape under
+    each button group of the KDE4 decoration.
+    \param painter the painter to draw with.
+    \param rect the area of the ground.
+    \param base the colour under the ground. The two alpha values of the
+    gradient follow the value of this colour.
+    \param opts the settings of the style. The round flag of the
+    titlebarButtons key and the round key select the corner radius. */
+void
+drawSunkenBevel(QPainter *painter, const QRectF &rect, const QColor &base,
+                const Options &opts)
+{
+    const qreal radius =
+        (opts.titlebarButtons & TITLEBAR_BUTTON_ROUND) ? rect.height() / 2.0 :
+        opts.round > ROUND_FULL ? 5.0 : opts.round > ROUND_SLIGHT ? 3.0 : 2.0;
+    QColor dark(Qt::black);
+    QColor light(Qt::white);
+    dark.setAlphaF(SUNKEN_BEVEL_DARK_ALPHA(base));
+    light.setAlphaF(SUNKEN_BEVEL_LIGHT_ALPHA(base));
+    QLinearGradient gradient(rect.topLeft(), rect.bottomLeft());
+    gradient.setColorAt(0, dark);
+    gradient.setColorAt(1, light);
+    QPainterPath path;
+    path.addRoundedRect(rect, radius, radius);
+    painter->fillPath(path, QBrush(gradient));
+}
+
+//! the area behind the buttons of one group
+/*! \param group the button group, or a null pointer.
+    \return the union of the squares of the visible buttons. A spacer and a
+    custom button count for nothing. A null pointer, and a group of one
+    button, gives an empty rectangle. paintEvent() in
+    qt6/kwin/qtcurveclient.cpp drew no ground under a lone button. */
+QRectF
+buttonGround(const KDecoration3::DecorationButtonGroup *group)
+{
+    if (!group) {
+        return QRectF();
+    }
+    QRectF ground;
+    int count = 0;
+    const auto buttons = group->buttons();
+    for (const KDecoration3::DecorationButton *button : buttons) {
+        if (!button->isVisible() ||
+            button->type() == KDecoration3::DecorationButtonType::Spacer ||
+            button->type() == KDecoration3::DecorationButtonType::Custom) {
+            continue;
+        }
+        count++;
+        ground =
+            ground.united(static_cast<const QtCurve::Button*>(button)
+                          ->squareGeometry());
+    }
+    return count > 1 ? ground : QRectF();
+}
+
 }
 
