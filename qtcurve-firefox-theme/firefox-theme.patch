+
+const char *const varsToolbar[] = {
+    "--toolbar-background-color",
+    "--tab-background-color-selected"
+};
+const char *const keysToolbar[] = { "toolbar", "tab_selected",
+                                    "ntp_background" };
+
+const char *const varsToolbarText[] = {
+    "--toolbar-text-color",
+    "--tab-selected-textcolor",
+    "--toolbarbutton-icon-fill"
+};
