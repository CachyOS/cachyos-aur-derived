+};
+const char *const keysSelectedText[] = { "popup_highlight_text",
+                                         "sidebar_highlight_text",
+                                         "toolbar_field_highlight_text" };
+
+const char *const varsPanel[] = { "--panel-background-color" };
+const char *const keysPanel[] = { "popup" };
