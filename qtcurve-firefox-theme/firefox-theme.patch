+ *   This program is distributed in the hope that it will be useful,         *
+ *   but WITHOUT ANY WARRANTY; without even the implied warranty of          *
+ *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU       *
+ *   Lesser General Public License for more details.                         *
+ *                                                                           *
+ *   You should have received a copy of the GNU Lesser General Public        *
+ *   License along with this library. If not,                                *
+ *   see <http://www.gnu.org/licenses/>.                                     *
+ *****************************************************************************/
+
+#include "profiles.h"
+
+#include <userfile.h>
+
+#include <qtcurve-utils/dirs.h>
+
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+
+#include <stdio.h>
+
+namespace QtCurve {
+namespace Firefox {
+
+using Gtk::writerName;
+
+namespace {
+
+/** The name of the file of a root that lists the profiles of that root. */
+const char *const iniName = "profiles.ini";
+
+/** One section of a profiles.ini file that names a profile directory. */
+struct Section {
+    QString path;
+    bool relative = true;
+};
+
+/**
+ * Returns the directory of the section section, against the directory dir of
+ * the ini file. A relative section takes dir as its base, and an absolute
+ * section takes its own path whole.
+ */
+QString
+sectionDir(const Section &section, const QString &dir)
+{
+    if (section.path.isEmpty()) {
+        return QString();
+    }
+    if (!section.relative) {
+        return section.path;
+    }
+    return dir + QLatin1Char('/') + section.path;
+}
+
+/**
+ * Reads the sections of the ini file ini that name a profile directory, in the
+ * order of the file. A line outside a profile section gives no section, and a
+ * file that does not open gives one line on standard error.
+ */
+QList<Section>
+readSections(const QString &ini)
+{
+    QList<Section> out;
+    QFile file(ini);
+    if (!file.open(QIODevice::ReadOnly | QIODevice::Text)) {
+        fprintf(stderr, "%s: cannot read %s\n", writerName,
+                ini.toLocal8Bit().constData());
+        return out;
+    }
+    bool inProfile = false;
+    while (!file.atEnd()) {
+        const QByteArray line = file.readLine().trimmed();
+        if (line.startsWith('[')) {
+            inProfile = line.startsWith("[Profile");
+            if (inProfile) {
+                out.append(Section());
+            }
+            continue;
+        }
+        if (!inProfile || out.isEmpty()) {
+            continue;
+        }
+        Section &section = out.last();
+        if (line.startsWith("Path=")) {
+            section.path = QString::fromLocal8Bit(line.mid(5));
+        } else if (line.startsWith("IsRelative=")) {
+            section.relative = line.mid(11) != QByteArray("0");
+        }
+    }
+    return out;
+}
+
+}
+
+QStringList
+roots()
+{
+    QStringList out;
+    const QString config = QString::fromLocal8Bit(getXDGConfigHome()) +
+        QStringLiteral("mozilla/firefox");
+    const QString home = QDir::homePath() +
+        QStringLiteral("/.mozilla/firefox");
+    out << config;
+    if (home != config) {
+        out << home;
+    }
+    return out;
+}
+
+QStringList
+profiles(bool notices)
+{
+    QStringList out;
+    for (const QString &root : roots()) {
+        const QString ini = root + QLatin1Char('/') +
+            QString::fromLatin1(iniName);
+        if (!QFile::exists(ini)) {
+            continue;
+        }
+        for (const Section &section : readSections(ini)) {
+            const QString dir = sectionDir(section, root);
+            if (dir.isEmpty()) {
+                continue;
+            }
+            const QFileInfo info(dir);
+            if (!info.isDir()) {
+                if (notices) {
+                    printf("%s: the profile directory %s of %s is gone, and"
+                           " this pass skips it\n", writerName,
+                           dir.toLocal8Bit().constData(),
+                           ini.toLocal8Bit().constData());
+                }
+                continue;
+            }
+            const QString real = info.canonicalFilePath();
+            if (!real.isEmpty() && !out.contains(real)) {
+                out << real;
+            }
+        }
+    }
+    return out;
+}
+
+}
+}
