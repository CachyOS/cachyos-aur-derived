+# The custom properties of the Firefox chrome that the generated sheet sets,
+# pinned against Firefox 155. The chrome reads a declaration of a name that it
+# knows, and a name outside this list paints nothing at all.
+# Derivation: every name below stands in a token file of the chrome of Firefox
+# 155.0, which omni.ja and browser/omni.ja hold. The files are
+# tokens-shared.css, tokens-platform.css, browser-colors.css, toolbar.css,
+# tab.tokens.css, toolbarbuttons.css, common-shared.css and
+# urlbar/urlbarview.tokens.css. A refresh of the pin reads the same files of
+# the next major.
+--toolbox-background-color
+--toolbox-text-color
+--toolbox-background-color-inactive
+--toolbox-text-color-inactive
+--toolbar-background-color
+--tab-background-color-selected
+--toolbar-text-color
+--tab-selected-textcolor
+--toolbarbutton-icon-fill
+--toolbar-field-background-color
+--toolbar-field-background-color-focus
+--sidebar-background-color
+--toolbar-field-text-color
+--toolbar-field-text-color-focus
+--sidebar-text-color
+--toolbar-field-border-color
+--chrome-content-separator-color
+--focus-outline-color
+--urlbarview-background-color-selected
+--urlbarview-text-color-selected
+--panel-background-color
+--panel-text-color
+--panel-border-color
+--toolbarbutton-background-color-hover
+--tab-background-color-hover
+--toolbarbutton-background-color-active
diff --git a/firefox/check/mkfloors.sh b/firefox/check/mkfloors.sh
new file mode 100644
index 00000000..165abdf6
--- /dev/null
+++ b/firefox/check/mkfloors.sh
@@ -0,0 +1,9 @@
+#!/bin/sh
+# mkfloors.sh SHEET: prints the floor of assert-ff-varnames.sh from one build.
+# SHEET is a sheet of the build tree. The CMake file holds the number that this
+# script prints, so no floor of the build comes from a hand count.
+set -eu
+sheet=${1:?usage: mkfloors.sh SHEET}
+count=$(grep -o -- '--[A-Za-z0-9-]*:' "$sheet" | sed 's/:$//' | sort -u |
+            wc -l)
+printf 'set(qtc_ff_names %s)\n' "$count"
