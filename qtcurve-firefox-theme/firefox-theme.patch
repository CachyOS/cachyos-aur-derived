diff --git a/firefox/CMakeLists.txt b/firefox/CMakeLists.txt
new file mode 100644
index 00000000..7599770a
--- /dev/null
+++ b/firefox/CMakeLists.txt
@@ -0,0 +1,178 @@
+# The Firefox theme generator and the checks of the files that it writes. The
+# binary compiles the palette, the owned file, the lock, the watch and the
+# re-exec code of the GTK writer. It holds names and a watch set of its own.
+
+set(CMAKE_AUTOMOC True)
+
+set(QTC_FIREFOX_WRITER_PATH
+  "${CMAKE_INSTALL_FULL_BINDIR}/qtcurve-firefox-writer")
+
+find_package(ECM 1.2.0 REQUIRED NO_MODULE)
+set(CMAKE_MODULE_PATH ${CMAKE_MODULE_PATH} ${ECM_MODULE_PATH})
+find_package(Qt6 REQUIRED COMPONENTS Core Gui Widgets Svg)
+find_package(KF6 REQUIRED COMPONENTS ColorScheme Config CoreAddons)
+
+set(qtc_gtk_writer_dir "${CMAKE_CURRENT_SOURCE_DIR}/../gtk4/writer")
+set(qtc_gtk_check "${CMAKE_CURRENT_SOURCE_DIR}/../gtk4/check")
+set(qtc_schemes "${CMAKE_CURRENT_SOURCE_DIR}/../gtk4/schemes")
+
+set(qtcurve_firefox_writer_SRCS
+  writer/main.cpp
+  writer/ffmap.cpp
+  writer/profiles.cpp
+  writer/sheet.cpp
+  "${qtc_gtk_writer_dir}/palette.cpp"
+  "${qtc_gtk_writer_dir}/emit.cpp"
+  "${qtc_gtk_writer_dir}/userfile.cpp"
+  "${qtc_gtk_writer_dir}/watch.cpp"
+  "${qtc_gtk_writer_dir}/lock.cpp"
+  "${qtc_gtk_writer_dir}/reexec.cpp"
+  "${CMAKE_CURRENT_SOURCE_DIR}/../qt6/common/common.cpp"
+  "${CMAKE_CURRENT_SOURCE_DIR}/../qt6/common/config_file.cpp")
+
+add_executable(qtcurve-firefox-writer ${qtcurve_firefox_writer_SRCS})
+# The gate of this writer is a settings key, and its colour watch is a watched
+# path. The shared watch file therefore drops its session bus arm. The target
+# names no DBus module of Qt, and KF6::ConfigCore still brings that library
+# in.
+target_compile_definitions(qtcurve-firefox-writer PRIVATE
+  QTC_UTILS_QT6 QTC_UTILS_QT)
+# qt6/common/common.h includes QApplication, so the writer needs the QtWidgets
+# headers. It calls no function of the library and it links none.
+target_include_directories(qtcurve-firefox-writer PRIVATE
+  "${CMAKE_CURRENT_SOURCE_DIR}/writer"
+  "${qtc_gtk_writer_dir}"
+  "${CMAKE_CURRENT_SOURCE_DIR}/../qt6/common"
+  "${CMAKE_BINARY_DIR}"
+  ${Qt6Widgets_INCLUDE_DIRS})
+# qt6/common/config_file.cpp reads a pixmap of the settings through
+# QSvgRenderer, so the writer links the SVG module of Qt.
+target_link_libraries(qtcurve-firefox-writer
+  Qt6::Core Qt6::Gui Qt6::Svg
+  KF6::ColorScheme KF6::ConfigCore KF6::CoreAddons
+  qtcurve-utils)
+
+# A cross build cannot run a host tool. The checks below read a sheet of the
+# build, so the configure step fails in place of a silent skip.
+if(CMAKE_CROSSCOMPILING AND NOT QTC_FIREFOX_WRITER)
+  message(FATAL_ERROR
+    "A cross build needs -DQTC_FIREFOX_WRITER=<path of a host"
+    " qtcurve-firefox-writer>")
+endif()
+if(QTC_FIREFOX_WRITER)
+  set(qtc_ff_command "${QTC_FIREFOX_WRITER}")
+  set(qtc_ff_depends "${QTC_FIREFOX_WRITER}")
+else()
+  set(qtc_ff_command "$<TARGET_FILE:qtcurve-firefox-writer>")
+  set(qtc_ff_depends qtcurve-firefox-writer)
+endif()
+
+add_custom_target(qtcurve-firefox-theme ALL DEPENDS ${qtc_ff_depends})
+
+set(qtc_ff_check "${CMAKE_CURRENT_SOURCE_DIR}/check")
+set(qtc_ff_work "${CMAKE_CURRENT_BINARY_DIR}/check")
+set(qtc_ff_light "${qtc_schemes}/QtCurveLight.colors")
+set(qtc_ff_dark "${qtc_schemes}/QtCurveDark.colors")
+
+# The floor of assert-ff-varnames.sh. A check that reads an empty sheet finds
+# no fault, so the run states the count that it must read. check/mkfloors.sh
+# prints this line from one build, and no floor comes from a hand count.
+set(qtc_ff_names 26)
+
+# The two sheets of the shipped schemes, which the checks below read. A run of
+# a user writes the same text into a profile.
+add_custom_command(TARGET qtcurve-firefox-theme POST_BUILD
+  COMMAND "${CMAKE_COMMAND}" -E make_directory "${qtc_ff_work}"
+  COMMAND "${qtc_ff_command}" --stdout --default --force
+          --scheme "${qtc_ff_light}" --out "${qtc_ff_work}/light.css"
+  COMMAND "${qtc_ff_command}" --stdout --default --force
+          --scheme "${qtc_ff_dark}" --out "${qtc_ff_work}/dark.css"
+  COMMAND sh "${qtc_ff_check}/assert-ff-varnames.sh" -n ${qtc_ff_names}
+          "${qtc_ff_work}/light.css" "${qtc_ff_check}/ff-varnames.txt"
+  COMMAND sh "${qtc_ff_check}/assert-ff-varnames.sh" -n ${qtc_ff_names}
+          "${qtc_ff_work}/dark.css" "${qtc_ff_check}/ff-varnames.txt"
+  VERBATIM)
+
+# The two writers must hold no lock name in common, because each one runs a
+# watch instance of its own.
+add_custom_command(TARGET qtcurve-firefox-theme POST_BUILD
+  COMMAND sh "${qtc_ff_check}/assert-locks-distinct.sh"
+          "${qtc_gtk_writer_dir}/main.cpp"
+          "${CMAKE_CURRENT_SOURCE_DIR}/writer/main.cpp"
+  COMMAND sh "${qtc_ff_check}/assert-ff-dialog-spawn.sh"
+          "${CMAKE_CURRENT_SOURCE_DIR}/../qt6/config/qtcurveconfig.cpp"
+  VERBATIM)
+
+# The rows below run the writer over the files of a user, and not over a sheet
+# of the build. Each row holds a private HOME and XDG_CONFIG_HOME, so the run
+# leaves the files of the caller alone.
+set(qtc_ff_run "${CMAKE_CURRENT_BINARY_DIR}/check/writer")
+add_custom_command(TARGET qtcurve-firefox-theme POST_BUILD
+  COMMAND sh "${qtc_ff_check}/assert-ff-profiles.sh" "${qtc_ff_command}"
+          "${qtc_ff_run}/profiles"
+  COMMAND sh "${qtc_ff_check}/assert-ff-import.sh" "${qtc_ff_command}"
+          "${qtc_ff_run}/import"
+  COMMAND sh "${qtc_ff_check}/assert-ff-gate.sh" "${qtc_ff_command}"
+          "${qtc_ff_run}/gate"
+  COMMAND sh "${qtc_ff_check}/assert-ff-notice.sh" "${qtc_ff_command}"
+          "${qtc_ff_run}/notice"
+  COMMAND sh "${qtc_ff_check}/assert-ff-keep.sh" "${qtc_ff_command}"
+          "${qtc_ff_run}/keep"
+  COMMAND sh "${qtc_ff_check}/assert-ff-toolbox.sh" "${qtc_ff_command}"
+          "${qtc_ff_run}/toolbox"
+  # The two runs below are the lock and the re-exec checks of the GTK writer,
+  # over the binary and the lock names of this one.
+  COMMAND sh "${qtc_gtk_check}/assert-lock.sh" "${qtc_ff_command}"
+          "${qtc_ff_run}/lock" qtcurve-firefox-writer.lock
+  COMMAND sh "${qtc_gtk_check}/assert-reexec.sh" "${qtc_ff_command}"
+          "${qtc_ff_run}/reexec" qtcurve-firefox-writer.lock
+  VERBATIM)
+
+# The generator of xdg-autostart builds a transient unit of the autostart
+# file, and that unit starts the writer one time and never again. The unit
+# below takes its place, and the skip key of the autostart file stops the
+# generator. A session of Plasma with no systemd keeps the autostart file.
+option(QTC_FIREFOX_SYSTEMD_UNIT
+  "Install a systemd user unit and a start symlink for the Firefox writer."
+  ON)
+if(QTC_FIREFOX_SYSTEMD_UNIT)
+  set(QTC_SYSTEMD_SKIP_LINE "X-systemd-skip=true")
+  find_package(PkgConfig)
+  if(PKG_CONFIG_FOUND)
+    pkg_get_variable(qtc_systemd_user_dir systemd systemduserunitdir)
+  endif()
+  if(NOT qtc_systemd_user_dir)
+    set(qtc_systemd_user_dir "${CMAKE_INSTALL_PREFIX}/lib/systemd/user")
+  endif()
+  set(QTC_SYSTEMD_USER_UNIT_DIR "${qtc_systemd_user_dir}" CACHE PATH
+    "Directory of the systemd user units.")
+  configure_file(autostart/qtcurve-firefox-writer.service.in
+    "${CMAKE_CURRENT_BINARY_DIR}/qtcurve-firefox-writer.service" @ONLY)
+  install(FILES
+    "${CMAKE_CURRENT_BINARY_DIR}/qtcurve-firefox-writer.service"
+    DESTINATION "${QTC_SYSTEMD_USER_UNIT_DIR}")
+  # The unit carries no [Install] section, because the symlink below is the
+  # start wiring. systemctl --user start takes the unit by name.
+  install(CODE "
+    file(MAKE_DIRECTORY \"\$ENV{DESTDIR}${QTC_SYSTEMD_USER_UNIT_DIR}/plasma-workspace.target.wants\")
+    execute_process(COMMAND \"${CMAKE_COMMAND}\" -E create_symlink ../qtcurve-firefox-writer.service \"\$ENV{DESTDIR}${QTC_SYSTEMD_USER_UNIT_DIR}/plasma-workspace.target.wants/qtcurve-firefox-writer.service\")
+  ")
+  # The check of the unit pair is the check of the GTK writer, over the two
+  # files of this one.
+  add_custom_command(TARGET qtcurve-firefox-theme POST_BUILD
+    COMMAND sh "${qtc_gtk_check}/assert-unit.sh"
+            "${CMAKE_CURRENT_BINARY_DIR}/qtcurve-firefox-writer.desktop"
+            "${CMAKE_CURRENT_BINARY_DIR}/qtcurve-firefox-writer.service"
+            "${QTC_FIREFOX_WRITER_PATH}"
+    VERBATIM)
+else()
+  set(QTC_SYSTEMD_SKIP_LINE "")
+endif()
+
+configure_file(autostart/qtcurve-firefox-writer.desktop.in
+  "${CMAKE_CURRENT_BINARY_DIR}/qtcurve-firefox-writer.desktop" @ONLY)
+
+install(TARGETS qtcurve-firefox-writer
+  DESTINATION "${CMAKE_INSTALL_FULL_BINDIR}")
+install(FILES "${CMAKE_CURRENT_BINARY_DIR}/qtcurve-firefox-writer.desktop"
+  DESTINATION "${CMAKE_INSTALL_FULL_SYSCONFDIR}/xdg/autostart")
