+    { FfRole::Clear, QTC_FF_NONE, QTC_FF_LIST(keysTopSeparator) },
+    { FfRole::ButtonFocus, QTC_FF_LIST(varsFocus), QTC_FF_LIST(keysFocus) },
+    { FfRole::Highlight, QTC_FF_LIST(varsSelected),
+      QTC_FF_LIST(keysSelected) },
+    { FfRole::HighlightText, QTC_FF_LIST(varsSelectedText),
+      QTC_FF_LIST(keysSelectedText) },
+    { FfRole::Menu, QTC_FF_LIST(varsPanel), QTC_FF_LIST(keysPanel) },
+    { FfRole::MenuText, QTC_FF_LIST(varsPanelText),
+      QTC_FF_LIST(keysPanelText) },
+    { FfRole::MenuBorder, QTC_FF_LIST(varsPanelBorder), QTC_FF_NONE },
+    { FfRole::ButtonHover, QTC_FF_LIST(varsHover), QTC_FF_LIST(keysHover) },
+    { FfRole::ButtonActive, QTC_FF_LIST(varsActive), QTC_FF_LIST(keysActive) }
+};
+
+/** The name of each row, in the order of FfRole. */
+const char *const roleNames[] = {
+    "titlebar", "titlebarText", "titlebarInactive", "titlebarInactiveText",
+    "window", "windowText", "base", "text", "windowBorder", "buttonFocus",
+    "highlight", "highlightText", "menu", "menuText", "menuBorder",
+    "buttonHover", "buttonActive", "clear"
+};
+
+}
+
+const FfRow *
+ffRows(int &count)
+{
+    count = (int)(sizeof(rows) / sizeof(*rows));
+    return rows;
+}
+
+const char *
+ffRoleName(FfRole role)
+{
+    const int at = (int)role;
+    if (at < 0 || at >= (int)(sizeof(roleNames) / sizeof(*roleNames))) {
+        Gtk::failUnknown("FfRole", at);
+        return "none";
+    }
+    return roleNames[at];
+}
+
+QColor
+ffColour(const Options &opts, const Palette &pal, FfRole role)
+{
+    switch (role) {
+    case FfRole::Titlebar:
+        return pal.titlebar;
+    case FfRole::TitlebarText:
+        return pal.titlebarText;
+    case FfRole::TitlebarInactive:
+        return pal.titlebarInactive;
+    case FfRole::TitlebarInactiveText:
+        return pal.titlebarInactiveText;
+    case FfRole::Window:
+        return pal.window;
+    case FfRole::WindowText:
+        return pal.windowText;
+    case FfRole::Base:
+        return pal.base;
+    case FfRole::Text:
+        return pal.text;
+    case FfRole::WindowBorder:
+        return pal.win[QTC_STD_BORDER];
+    case FfRole::ButtonFocus:
+        return pal.buttonFocus;
+    case FfRole::Highlight:
+        return pal.highlight;
+    case FfRole::HighlightText:
+        return pal.highlightText;
+    case FfRole::Menu:
+        return pal.menu[ORIGINAL_SHADE];
+    case FfRole::MenuText:
+        return Gtk::menuRole(opts) == Role::Base ? pal.text : pal.windowText;
+    case FfRole::MenuBorder:
+        return pal.menu[QTC_STD_BORDER];
+    case FfRole::ButtonHover:
+        return pal.btn[hoverShade];
+    case FfRole::ButtonActive:
+        return pal.btn[activeShade];
+    case FfRole::Clear:
+        return QColor(0, 0, 0, 0);
+    }
+    Gtk::failUnknown("FfRole", (int)role);
+    return QColor();
+}
+
+}
+}
