+const char *const keysActive[] = { "button_background_active" };
+
+/** Takes a table of names and the count of that table. */
+#define QTC_FF_LIST(a) (a), (int)(sizeof(a) / sizeof(*(a)))
+
+/** Takes the empty table of a row that reaches one arm alone. */
+#define QTC_FF_NONE nullptr, 0
+
+const FfRow rows[] = {
+    { FfRole::Titlebar, QTC_FF_LIST(varsFrame), QTC_FF_LIST(keysFrame) },
+    { FfRole::TitlebarText, QTC_FF_LIST(varsFrameText),
+      QTC_FF_LIST(keysFrameText) },
