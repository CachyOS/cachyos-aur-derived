+ *   License along with this library. If not,                                *
+ *   see <http://www.gnu.org/licenses/>.                                     *
+ *****************************************************************************/
+
+#include "sheet.h"
+
+#include "ffmap.h"
+
+#include <emit.h>
+#include <userfile.h>
+
+namespace QtCurve {
+namespace Firefox {
+
+using Gtk::Palette;
+
+namespace {
+
+/**
+ * Returns the background image of the tool box under the appearance app over
+ * the colour col. An appearance with no gradient gives an empty string. The
+ * stops come from the titlebar colour, so the sheet and the static manifest
+ * paint one ladder.
+ */
+QString
+toolboxImage(const Options &opts, EAppearance app, const QColor &col)
+{
+    const QString image = Gtk::gradientImage(opts, app, Gtk::fixedTone(col));
+    if (image == QLatin1String("none")) {
+        return QString();
+    }
+    return image;
+}
+
+/**
+ * Returns the background image rules of the tool box. Decoration::paint() of
+ * the QtCurve decoration fills the title bar from the appearance and the
+ * colour of the state of the window. An inactive window therefore takes a
+ * rule of its own. That rule holds the image at none while the inactive
+ * appearance carries no gradient, because the active image reaches every
+ * state without it.
+ */
+QString
+toolboxImages(const Options &opts, const Palette &pal)
+{
+    const QString live = toolboxImage(opts, opts.titlebarAppearance,
+                                      pal.titlebar);
+    const QString idle = toolboxImage(opts, opts.inactiveTitlebarAppearance,
+                                      pal.titlebarInactive);
+    QString out;
+    if (!live.isEmpty()) {
+        out += QStringLiteral("\n#navigator-toolbox {\n"
+                              "  background-image: %1 !important;\n"
+                              "}\n").arg(live);
+    }
+    if (!idle.isEmpty()) {
+        out += QStringLiteral("\n#navigator-toolbox:-moz-window-inactive {\n"
+                              "  background-image: %1 !important;\n"
+                              "}\n").arg(idle);
+    } else if (!live.isEmpty()) {
+        out += QStringLiteral("\n#navigator-toolbox:-moz-window-inactive {\n"
+                              "  background-image: none !important;\n"
+                              "}\n");
+    }
+    return out;
+}
+
+}
+
+QString
+buildSheet(const Options &opts, const Palette &pal)
+{
+    QString out = QStringLiteral("/* %1 writes this file, and it takes every"
+                                 " byte of it. */\n")
+        .arg(QLatin1String(Gtk::writerName));
+    out += QStringLiteral(":root {\n");
+    int count = 0;
+    const FfRow *const rows = ffRows(count);
+    for (int row = 0;row < count;++row) {
+        const QColor col = ffColour(opts, pal, rows[row].role);
+        for (int i = 0;i < rows[row].varCount;++i) {
+            out += QStringLiteral("  %1: %2 !important;\n")
+                .arg(QLatin1String(rows[row].vars[i]), Gtk::hex(col));
+        }
+    }
+    out += QStringLiteral("}\n");
+    out += toolboxImages(opts, pal);
+    return out;
+}
+
+}
+}
