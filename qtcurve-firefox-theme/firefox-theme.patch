index 00000000..6304205b
--- /dev/null
+++ b/firefox/writer/main.cpp
@@ -0,0 +1,556 @@
+/*****************************************************************************
+ *   Copyright 2026 QtCurve authors                                          *
+ *                                                                           *
+ *   This program is free software; you can redistribute it and/or modify    *
+ *   it under the terms of the GNU Lesser General Public License as          *
+ *   published by the Free Software Foundation; either version 2.1 of the    *
+ *   License, or (at your option) version 3, or any later version accepted   *
+ *   by the membership of KDE e.V. (or its successor approved by the         *
+ *   membership of KDE e.V.), which shall act as a proxy defined in          *
+ *   Section 6 of version 3 of the license.                                  *
+ *                                                                           *
+ *   This program is distributed in the hope that it will be useful,         *
+ *   but WITHOUT ANY WARRANTY; without even the implied warranty of          *
+ *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU       *
+ *   Lesser General Public License for more details.                         *
+ *                                                                           *
+ *   You should have received a copy of the GNU Lesser General Public        *
+ *   License along with this library. If not,                                *
+ *   see <http://www.gnu.org/licenses/>.                                     *
+ *****************************************************************************/
+
+#include "ffmap.h"
+#include "profiles.h"
+#include "sheet.h"
+
+#include <emit.h>
+#include <lock.h>
+#include <palette.h>
+#include <reexec.h>
+#include <userfile.h>
+#include <watch.h>
+
+#include <config_file.h>
+#include <qtcurve-utils/dirs.h>
+
+#include <QCoreApplication>
+#include <QDir>
+#include <QFile>
+#include <QTextStream>
+
+#include <unistd.h>
+
+#include <functional>
+#include <string>
+#include <vector>
+
+using namespace QtCurve;
+using namespace QtCurve::Firefox;
+
+using Gtk::Palette;
+using Gtk::Placement;
+using Gtk::lockBusyCode;
+using Gtk::mergeImport;
+using Gtk::readPalette;
+using Gtk::removeImport;
+using Gtk::removeOwned;
+using Gtk::writeOwned;
+using Gtk::writerName;
+
+namespace QtCurve {
+namespace Gtk {
+
+// The name, the lock names and the import line of this binary, which lock.h
+// and userfile.h declare.
+const char *const writerName = "qtcurve-firefox-writer";
+const char *const daemonLockName = "qtcurve-firefox-writer.lock";
+const char *const writeLockName = "qtcurve-firefox-writer-write.lock";
+const char *const importStatement = "@import \"qtcurve-userChrome.css\";";
+
+}
+}
+
+namespace {
+
+/** The directory of a profile that holds the sheets of the user. */
+const char *const chromeDir = "chrome";
+
+/** The file of a profile that holds the sheet of the writer. */
+const char *const ownedName = "qtcurve-userChrome.css";
+
+/** The file of a profile that holds the import line of the writer. */
+const char *const sharedName = "userChrome.css";
+
+/** The file of a profile that holds the preferences of the user. */
+const char *const prefsName = "prefs.js";
+
+/** The preference that Firefox reads before it takes the shared sheet. */
+const char *const styleSheetPref =
+    "toolkit.legacyUserProfileCustomizations.stylesheets";
+
+/** One parsed command line. */
+struct Args {
+    QString mode = QStringLiteral("--write");
+    QString settings;
+    QString scheme;
+    QString out;
+    bool useDefaults = false;
+    bool force = false;
+};
+
+void
+usage()
+{
+    fprintf(stderr,
+            "usage: qtcurve-firefox-writer [--write|--remove|--watch|\n"
+            "                               --stdout]\n"
+            "  --remove          delete the Firefox files of the writer\n"
+            "  --settings FILE   read the QtCurve settings from FILE\n"
+            "  --default         use the shipped preset\n"
+            "  --scheme FILE     read the colours from a KDE .colors file\n"
+            "  --out FILE        write the sheet to FILE and not to stdout\n"
+            "  --force           skip the settings gate\n");
+}
+
+/**
+ * Returns true while the file that QTC_GTK_TEST_FAULT names exists. The build
+ * time checks set the variable, and a run of a user leaves it unset. The two
+ * writers read one variable, because no check runs both binaries at one time.
+ */
+bool
+testFault()
+{
+    const QByteArray env = qgetenv("QTC_GTK_TEST_FAULT");
+    return !env.isEmpty() && QFile::exists(QString::fromLocal8Bit(env));
+}
+
+/**
+ * The longest wait for the write lock, in milliseconds. The deadline bounds
+ * the wait of a mode that meets a holder, and it leaves a pass that runs
+ * enough time to finish.
+ */
+const int writeLockDeadlineMs = 2000;
+
+/** The step of the wait of a test hold, in milliseconds. */
+const int testHoldStepMs = 100;
+
+/**
+ * The count of the steps of a test hold. The cap of 30 s stops a hold that
+ * outlives the check script that started it.
+ */
+const int testHoldSteps = 300;
+
+/**
+ * Holds the write lock while the file that QTC_GTK_TEST_HOLD names exists,
+ * for 30 s at most. The build time checks set the variable, and a run of a
+ * user leaves it unset.
+ */
+void
+testHold()
+{
+    const QByteArray env = qgetenv("QTC_GTK_TEST_HOLD");
+    if (env.isEmpty()) {
+        return;
+    }
+    const QString path = QString::fromLocal8Bit(env);
+    if (!QFile::exists(path)) {
+        return;
+    }
+    printf("%s: the test hold starts\n", writerName);
+    fflush(stdout);
+    for (int step = 0;step < testHoldSteps && QFile::exists(path);++step) {
+        usleep((useconds_t)testHoldStepMs * 1000);
+    }
+}
+
+/**
+ * Runs the body of one mode inside the write lock, and returns the exit code
+ * of that body. The lock holds every mode that rewrites the files of the user
+ * apart from each other.
+ *
+ * \param body the body of the mode, which runs one time on success.
+ * \return the exit code of body, or lockBusyCode when the lock stays with
+ *     another process up to the deadline. The body does not run in that case,
+ *     and one line on standard error names the holder.
+ */
+int
+lockedRun(const std::function<int()> &body)
+{
+    pid_t holder = 0;
+    const int fd = Gtk::acquireWriteLock(writeLockDeadlineMs, &holder);
+    if (fd < 0) {
+        fprintf(stderr, "%s: the pid %d holds the write lock after 2 s, and"
+                " this pass stops\n", writerName, (int)holder);
+        return lockBusyCode;
+    }
+    testHold();
+    const int code = body();
+    Gtk::releaseLock(fd);
+    return code;
+}
+
+/** Returns the chrome directory of the profile dir. */
+QString
+chromeOf(const QString &dir)
+{
+    return dir + QLatin1Char('/') + QString::fromLatin1(chromeDir);
+}
+
+/** Prints the path of one file that the writer deleted. */
+void
+printGone(const QString &path)
+{
+    printf("%s: removed %s\n", writerName, path.toLocal8Bit().constData());
+}
+
+/** Reads the settings of args into opts, and returns the exit code. */
+int
+readOptions(const Args &args, Options &opts)
+{
+    qtcDefaultSettings(&opts);
+    if (args.useDefaults) {
+        return 0;
+    }
+    if (!args.settings.isEmpty()) {
+        QFile file(args.settings);
+        if (!file.open(QIODevice::ReadOnly)) {
+            fprintf(stderr, "%s: cannot read %s\n", writerName,
+                    args.settings.toLocal8Bit().constData());
+            return 2;
+        }
+    }
+    Options def;
+    qtcDefaultSettings(&def);
+    if (!qtcReadConfig(args.settings, &opts, &def, false)) {
+        if (!args.settings.isEmpty()) {
+            fprintf(stderr, "%s: cannot read %s\n", writerName,
+                    args.settings.toLocal8Bit().constData());
+            return 2;
+        }
+    }
+    return 0;
+}
+
+/**
+ * Returns true when the file path holds the line line. A file that is not
+ * there and a file that does not open both give false.
+ */
+bool
+holdsLine(const QString &path, const QByteArray &line)
+{
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly)) {
+        return false;
+    }
+    return file.readAll().contains(line);
+}
+
+/**
+ * Prints one notice line when the prefs.js file of the profile dir holds no
+ * user_pref row of the style sheet preference. The writer reads that file and
+ * never writes it, so a torn read can print one notice that the user does not
+ * need.
+ */
+void
+noticePref(const QString &dir)
+{
+    const QString prefs = dir + QLatin1Char('/') +
+        QString::fromLatin1(prefsName);
+    QByteArray row("user_pref(\"");
+    row.append(styleSheetPref);
+    row.append("\", true);");
+    if (holdsLine(prefs, row)) {
+        return;
+    }
+    printf("%s: the profile %s needs %s true, which about:config sets\n",
+           writerName, dir.toLocal8Bit().constData(), styleSheetPref);
+}
+
+/**
+ * Writes the owned sheet of the profile dir and merges the import line into
+ * the shared sheet of that profile. The call writes no byte of a sheet that
+ * holds the content already.
+ *
+ * \param content the whole owned sheet, in UTF-8.
+ * \param dir the profile directory, which the call never makes.
+ * \return 0 on success, 1 when the owned sheet does not open, and 6 when the
+ *     shared sheet does not open.
+ */
+int
+writeProfile(const QByteArray &content, const QString &dir)
+{
+    const QString chrome = chromeOf(dir);
+    const QString owned = chrome + QLatin1Char('/') +
+        QString::fromLatin1(ownedName);
+    const QString shared = chrome + QLatin1Char('/') +
+        QString::fromLatin1(sharedName);
+    bool changed = true;
+    QFile old(owned);
+    if (old.open(QIODevice::ReadOnly) && old.readAll() == content) {
+        old.close();
+        changed = false;
+    } else {
+        const int written = writeOwned(owned, content);
+        if (written != 0) {
+            return written;
+        }
+    }
+    const bool hadImport = holdsLine(shared, QByteArray(Gtk::importStatement));
+    const int merged = mergeImport(shared, Placement::Front);
+    if (merged != 0) {
+        return merged;
+    }
+    if (changed || !hadImport) {
+        printf("%s: the profile %s holds the new sheet, and Firefox takes it"
+               " after a restart\n", writerName,
+               dir.toLocal8Bit().constData());
+    }
+    noticePref(dir);
+    return 0;
+}
+
+/**
+ * Takes the import line out of the shared sheet of the profile dir. It then
+ * deletes the owned sheet of that profile, and it prints each path that it
+ * deletes. A file that is absent is no error.
+ *
+ * \param dir the profile directory, which the call never removes.
+ * \return 0 on success, and 6 when the shared sheet does not open.
+ */
+int
+removeProfile(const QString &dir)
+{
+    const QString chrome = chromeOf(dir);
+    const QString shared = chrome + QLatin1Char('/') +
+        QString::fromLatin1(sharedName);
+    bool changed = false;
+    const int code = removeImport(shared, &changed);
+    if (changed) {
+        printf("%s: removed the import line of %s\n", writerName,
+               shared.toLocal8Bit().constData());
+    }
+    if (code != 0) {
+        return code;
+    }
+    const QString owned = chrome + QLatin1Char('/') +
+        QString::fromLatin1(ownedName);
+    if (removeOwned(owned)) {
+        printGone(owned);
+    }
+    return 0;
+}
+
+/**
+ * Deletes the owned files of every profile, and returns the first exit code
+ * that is not 0. A profile that fails does not stop the profiles after it.
+ */
+int
+removeAll()
+{
+    int status = 0;
+    for (const QString &dir : profiles(true)) {
+        const int code = removeProfile(dir);
+        if (code != 0 && status == 0) {
+            status = code;
+        }
+    }
+    return status;
+}
+
+/**
+ * Runs one write pass over every profile, and returns the first exit code
+ * that is not 0. A false gate and no --force run the remove pass. The files
+ * of the writer then leave a profile of a user who does not want them.
+ */
+int
+runWrite(const Args &args)
+{
+    Gtk::clearEmitError();
+    Options opts;
+    const int read = readOptions(args, opts);
+    if (read != 0) {
+        return read;
+    }
+    if (!args.force && !opts.firefoxTheme) {
+        return removeAll();
+    }
+    if (testFault()) {
+        Gtk::failTest();
+    }
+    Palette pal;
+    QString err;
+    const int bad = readPalette(args.scheme, opts, pal, err);
+    if (bad != 0) {
+        fprintf(stderr, "%s: %s\n", writerName,
+                err.toLocal8Bit().constData());
+        return bad;
+    }
+    const QByteArray content = buildSheet(opts, pal).toUtf8();
+    if (Gtk::emitError() != 0) {
+        return Gtk::emitError();
+    }
+    int status = 0;
+    for (const QString &dir : profiles(true)) {
+        const int code = writeProfile(content, dir);
+        if (code != 0 && status == 0) {
+            status = code;
+        }
+    }
+    return status;
+}
+
+/** Prints one sheet to standard output, and returns the exit code. */
+int
+runStdout(const Args &args)
+{
+    Gtk::clearEmitError();
+    Options opts;
+    const int read = readOptions(args, opts);
+    if (read != 0) {
+        return read;
+    }
+    Palette pal;
+    QString err;
+    const int bad = readPalette(args.scheme, opts, pal, err);
+    if (bad != 0) {
+        fprintf(stderr, "%s: %s\n", writerName,
+                err.toLocal8Bit().constData());
+        return bad;
+    }
+    const QString text = buildSheet(opts, pal);
+    if (Gtk::emitError() != 0) {
+        return Gtk::emitError();
+    }
+    if (!args.out.isEmpty()) {
+        return writeOwned(args.out, text.toUtf8());
+    }
+    QTextStream stream(stdout);
+    stream << text;
+    return 0;
+}
+
+/**
+ * Returns the paths that the watch mode reads. The set holds the settings of
+ * QtCurve, the colour file of KDE and the profile list of each root. It also
+ * holds the shared sheet of each profile that the roots hold at this moment.
+ * A profile that arrives later reaches the watcher through the profile list.
+ */
+QStringList
+watchPaths()
+{
+    QStringList paths;
+    paths << QString::fromLocal8Bit(getConfDir()) + QStringLiteral("stylerc");
+    paths << QString::fromLocal8Bit(getXDGConfigHome()) +
+        QStringLiteral("kdeglobals");
+    for (const QString &root : roots()) {
+        paths << root + QStringLiteral("/profiles.ini");
+    }
+    for (const QString &dir : profiles(false)) {
+        paths << chromeOf(dir) + QLatin1Char('/') +
+            QString::fromLatin1(sharedName);
+    }
+    return paths;
+}
+
+/** Parses the command line into args, and returns false on a bad switch. */
+bool
+parse(const QStringList &argv, Args &args)
+{
+    for (int i = 1;i < argv.size();++i) {
+        const QString &arg = argv.at(i);
+        if (arg == QLatin1String("--write") ||
+            arg == QLatin1String("--remove") ||
+            arg == QLatin1String("--watch") ||
+            arg == QLatin1String("--stdout")) {
+            args.mode = arg;
+        } else if (arg == QLatin1String("--default")) {
+            args.useDefaults = true;
+        } else if (arg == QLatin1String("--force")) {
+            args.force = true;
+        } else if (arg == QLatin1String("--settings") && i + 1 < argv.size()) {
+            args.settings = argv.at(++i);
+        } else if (arg == QLatin1String("--scheme") && i + 1 < argv.size()) {
+            args.scheme = argv.at(++i);
+        } else if (arg == QLatin1String("--out") && i + 1 < argv.size()) {
+            args.out = argv.at(++i);
+        } else {
+            return false;
+        }
+    }
+    return true;
+}
+
+/**
+ * Runs the watch mode, and returns the exit code. A false gate removes the
+ * owned files and leaves. The settings file of the gate is inside the watched
+ * set, and the save of the dialog starts this mode again.
+ */
+int
+runWatch(const Args &args, const QString &exePath,
+         const std::vector<std::string> &savedArgs)
+{
+    Options opts;
+    const int read = readOptions(args, opts);
+    if (read != 0) {
+        return read;
+    }
+    if (!args.force && !opts.firefoxTheme) {
+        return lockedRun(removeAll);
+    }
+    int dfd = Gtk::adoptLockFd(Gtk::lockPath(Gtk::daemonLockName));
+    if (dfd < 0) {
+        pid_t holder = 0;
+        dfd = Gtk::acquireDaemonLock(&holder);
+        if (dfd < 0) {
+            printf("%s: a watch instance runs with the pid %d, and this"
+                   " instance stops\n", writerName, (int)holder);
+            return 0;
+        }
+    }
+    const int first = lockedRun([&args] { return runWrite(args); });
+    if (first > 1 && first != lockBusyCode) {
+        return first;
+    }
+    Gtk::Watcher watcher([&args] {
+            return lockedRun([&args] { return runWrite(args); });
+        }, watchPaths());
+    Gtk::Reexec reexec(exePath, savedArgs, dfd);
+    if (first == lockBusyCode) {
+        watcher.kick();
+    }
+    return QCoreApplication::exec();
+}
+
+}
+
+int
+main(int argc, char **argv)
+{
+    // The raw arguments of this run, for the exec of a new image. The copy
+    // comes first, because the constructor of QCoreApplication takes the
+    // arguments of Qt out of argv.
+    static std::vector<std::string> savedArgs(argv, argv + argc);
+
+    QCoreApplication app(argc, argv);
+    QCoreApplication::setApplicationName(
+        QStringLiteral("qtcurve-firefox-writer"));
+    // The path of the running image, before a package can replace it.
+    const QString exePath = QCoreApplication::applicationFilePath();
+
+    Args args;
+    if (!parse(QCoreApplication::arguments(), args)) {
+        usage();
+        return 1;
+    }
+
+    if (args.mode == QLatin1String("--stdout")) {
+        return runStdout(args);
+    }
+    if (args.mode == QLatin1String("--remove")) {
+        return lockedRun(removeAll);
+    }
+    if (args.mode == QLatin1String("--watch")) {
+        return runWatch(args, exePath, savedArgs);
+    }
+    return lockedRun([&args] { return runWrite(args); });
+}
