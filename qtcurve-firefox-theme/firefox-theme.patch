+
+#ifndef QTC_FIREFOX_FFMAP_H
+#define QTC_FIREFOX_FFMAP_H
+
+#include <palette.h>
+
+namespace QtCurve {
+namespace Firefox {
+
+/**
+ * The palette source of one row of the map. A ladder role takes one step of a
+ * shade ladder, and Clear is the one row that no colour of the palette feeds.
+ */
+enum class FfRole {
+    Titlebar,
+    TitlebarText,
+    TitlebarInactive,
+    TitlebarInactiveText,
+    Window,
+    WindowText,
+    Base,
+    Text,
+    WindowBorder,
+    ButtonFocus,
+    Highlight,
+    HighlightText,
+    Menu,
+    MenuText,
+    MenuBorder,
+    ButtonHover,
+    ButtonActive,
+    Clear
+};
+
+/**
+ * One row of the map. The row binds one palette source to the custom
+ * properties of the generated sheet and to the colour keys of the static
+ * manifest. Either list can be empty, because a colour can reach one arm
+ * alone.
+ */
+struct FfRow {
+    FfRole role;
+    /** The custom properties of the generated sheet. */
+    const char *const *vars;
+    /** The count of the custom properties. */
+    int varCount;
+    /** The colour keys of the theme object of the manifest. */
+    const char *const *keys;
+    /** The count of the colour keys. */
+    int keyCount;
+};
+
+/**
+ * Returns the rows of the map, which the two emitters walk in this order.
+ *
+ * \param count  takes the count of the rows.
+ * \return the first row of the table.
+ */
+const FfRow *ffRows(int &count);
+
+/** Returns the name of role, which the exported map carries. */
+const char *ffRoleName(FfRole role);
+
+/**
+ * Returns the colour of role, under the settings opts and the palette pal.
+ * FfRole::Clear gives a colour of the alpha 0, and no other row gives a
+ * translucent colour.
+ */
+QColor ffColour(const Options &opts, const Gtk::Palette &pal, FfRole role);
+
+}
+}
+
+#endif
