diff --git a/firefox/check/assert-ff-dialog-spawn.sh b/firefox/check/assert-ff-dialog-spawn.sh
new file mode 100644
index 00000000..3a0d3607
--- /dev/null
+++ b/firefox/check/assert-ff-dialog-spawn.sh
@@ -0,0 +1,84 @@
+#!/bin/sh
+# assert-ff-dialog-spawn.sh SOURCE: the save of the dialog must start the watch
+# mode of the Firefox writer beside the GTK one. SOURCE is the source file of
+# the dialog. The run then puts the write mode back in a copy of that file, and
+# it fails if the check passes the copy.
+set -eu
+usage='usage: assert-ff-dialog-spawn.sh SOURCE'
+src=${1:?$usage}
+
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+
+# vector FILE: prints the rows of the argument vector of the Firefox spawn.
+vector() {
+    awk '/firefoxWriter\[\] = \{/,/\};/' "$1"
+}
+
+# check FILE: gives 0 when the three contracts hold. It names the first
+# contract that fails on the standard error.
+check() {
+    c_file=$1
+
+    # 1. The file holds the argument vector of the spawn.
+    block=$(vector "$c_file")
+    if [ -z "$block" ]; then
+        echo "assert-ff-dialog-spawn: $c_file holds no argument vector" >&2
+        return 1
+    fi
+
+    # 2. The vector names the binary and the watch mode.
+    case $block in
+        *'"qtcurve-firefox-writer"'*) ;;
+        *) echo "assert-ff-dialog-spawn: the vector of $c_file names no" \
+                "binary" >&2
+           return 1;;
+    esac
+    case $block in
+        *'"--watch"'*) ;;
+        *) echo "assert-ff-dialog-spawn: the vector of $c_file names no" \
+                "'--watch'" >&2
+           return 1;;
+    esac
+
+    # 3. The file spawns the vector, so no edit can leave it unread.
+    if ! grep -qF 'qtcSpawn(firefoxWriter[0], firefoxWriter' "$c_file"; then
+        echo "assert-ff-dialog-spawn: $c_file spawns no Firefox writer" >&2
+        return 1
+    fi
+    return 0
+}
+
+if ! check "$src"; then
+    echo "assert-ff-dialog-spawn: the source fails the check" >&2
+    exit 1
+fi
+
+# The controls below break one contract in a copy of the source, and the check
+# must fail over each copy.
+broken=0
+
+# control NAME FILE: the check must fail over the file that the caller gives.
+control() {
+    c_name=$1
+    shift
+    if check "$@" 2> "$tmp/control.log"; then
+        echo "assert-ff-dialog-spawn: the check passed the control copy of" \
+             "$c_name" >&2
+        exit 1
+    fi
+    broken=$((broken + 1))
+}
+
+# The write mode in the vector, which writes one pass and starts no watch.
+awk '/firefoxWriter\[\] = \{/,/\};/ { gsub(/"--watch"/, "\"--write\"") } 1' \
+    "$src" > "$tmp/write.cpp"
+control write "$tmp/write.cpp"
+
+# The vector with no spawn, which leaves the Firefox files behind the dialog.
+grep -v 'qtcSpawn(firefoxWriter\[0\], firefoxWriter' "$src" > "$tmp/quiet.cpp"
+control quiet "$tmp/quiet.cpp"
+
+echo "assert-ff-dialog-spawn: the save of the dialog starts the watch mode" \
+     "of the Firefox writer, and the check rejects each of the $broken" \
+     "control copies"
diff --git a/firefox/check/assert-ff-gate.sh b/firefox/check/assert-ff-gate.sh
new file mode 100644
index 00000000..60b76001
--- /dev/null
+++ b/firefox/check/assert-ff-gate.sh
@@ -0,0 +1,176 @@
+#!/bin/sh
+# assert-ff-gate.sh WRITER WORKDIR: the writer must write a profile only while
+# the settings hold the key of the gate. The run holds two settings files that
+# differ in that key alone. A false gate must take the owned sheet away and
+# keep every foreign line. The watch mode of a false gate must leave with no
+# resident process. That run is a counted poll of steps of one second. A watch
+# that stays resident therefore fails the check and never stops the build.
+# HOME, XDG_CONFIG_HOME and QTCURVE_CONFIG_DIR point into WORKDIR, because the
+# writer rewrites the files of the caller.
+set -eu
+ulimit -c 0
+usage='usage: assert-ff-gate.sh WRITER WORKDIR'
+writer=${1:?$usage}
+work=${2:?$usage}
+
+# A relative path leaves XDG_CONFIG_HOME outside the root of the file system.
+# The library of the writer then reads the configuration home of the caller.
+# The run therefore takes an absolute path of its own.
+case $work in
+    /*) ;;
+    *) work=$PWD/$work;;
+esac
+
+owned=chrome/qtcurve-userChrome.css
+shared=chrome/userChrome.css
+home=$work/home
+root=$home/.config/mozilla/firefox
+dir=$root/gate.default
+qtc=$home/qtcurve
+status=0
+pids=
+
+# The deadline of the watch arm, in seconds. The other arms of this run end in
+# under one second, so 20 steps hold a loaded build host with room to spare.
+watch_limit=20
+
+clean() {
+    for p in $pids; do
+        kill "$p" 2>/dev/null || true
+    done
+}
+
+# A signal that stops the run leaves a writer of the run alive. The trap takes
+# it away, and SIGKILL runs no trap.
+trap clean EXIT
+trap 'clean; exit 1' HUP INT QUIT TERM
+
+rm -rf "$work"
+mkdir -p "$dir/chrome" "$qtc"
+printf '#nav-bar { min-height: 40px; }\n' > "$dir/$shared"
+printf '[Profile0]\nName=gate\nIsRelative=1\nPath=gate.default\n' \
+    > "$root/profiles.ini"
+
+fail() {
+    echo "assert-ff-gate: $1" >&2
+    status=1
+}
+
+# gate VALUE: writes the settings file of the user with the key of the gate at
+# VALUE. The two files differ in that one row.
+gate() {
+    printf '[Settings]\nappearance=gradient\nfirefoxTheme=%s\n' "$1" \
+        > "$qtc/stylerc"
+}
+
+# run NAME ARGS...: runs the writer over the private home, and holds the exit
+# code in the variable code.
+run() {
+    r_name=$1
+    shift
+    code=0
+    HOME=$home XDG_CONFIG_HOME=$home/.config QTCURVE_CONFIG_DIR=$qtc \
+        "$writer" "$@" > "$work/$r_name.log" 2>&1 || code=$?
+}
+
+# running PID: gives 0 while the process PID runs. A process that ended and
+# waits for its parent holds the state Z, and it does not run.
+running() {
+    state=$(sed -n 's/^State:[[:space:]]*//p' "/proc/$1/status" 2>/dev/null) ||
+        return 1
+    case $state in
+        Z*|'') return 1;;
+        *) return 0;;
+    esac
+}
+
+# run_capped NAME LIMIT ARGS...: starts the writer over the private home and
+# waits at most LIMIT steps of one second for it to end. The exit code lands
+# in the variable code. A run that stays at the limit takes a signal, and the
+# variable code takes the value 124 of a deadline.
+run_capped() {
+    r_name=$1
+    limit=$2
+    shift 2
+    code=0
+    HOME=$home XDG_CONFIG_HOME=$home/.config QTCURVE_CONFIG_DIR=$qtc \
+        "$writer" "$@" > "$work/$r_name.log" 2>&1 &
+    capped=$!
+    pids="$pids $capped"
+    i=0
+    while [ "$i" -lt "$limit" ]; do
+        if ! running "$capped"; then
+            wait "$capped" || code=$?
+            return 0
+        fi
+        sleep 1
+        i=$((i + 1))
+    done
+    kill "$capped" 2>/dev/null || true
+    i=0
+    while [ "$i" -lt 3 ] && running "$capped"; do
+        sleep 1
+        i=$((i + 1))
+    done
+    kill -9 "$capped" 2>/dev/null || true
+    wait "$capped" 2>/dev/null || true
+    code=124
+}
+
+# 1. A true gate writes the owned sheet and the import line.
+gate true
+run true --write
+[ "$code" -eq 0 ] || fail "the true gate gave the code $code"
+[ -s "$dir/$owned" ] || fail "the true gate wrote no owned sheet"
+grep -qF 'qtcurve-userChrome.css' "$dir/$shared" ||
+    fail "the true gate merged no import line"
+
+# 2. A false gate takes both away, and it keeps the foreign line.
+gate false
+run false --write
+[ "$code" -eq 0 ] || fail "the false gate gave the code $code"
+if [ -e "$dir/$owned" ]; then
+    fail "the false gate kept the owned sheet"
+fi
+if grep -qF 'qtcurve-userChrome.css' "$dir/$shared"; then
+    fail "the false gate kept the import line"
+fi
+grep -qF '#nav-bar' "$dir/$shared" ||
+    fail "the false gate dropped the foreign line"
+
+# 3. The watch mode of a false gate leaves with the code 0 and holds no
+# process. The settings file is inside the watched set, so the save of the
+# dialog starts this mode again. A watch that stays resident meets the
+# deadline of this run, and the run reaps it and names the fault.
+run_capped watch "$watch_limit" --watch
+if [ "$code" -eq 124 ]; then
+    fail "the watch mode of the false gate ran past $watch_limit seconds"
+elif [ "$code" -ne 0 ]; then
+    fail "the watch mode of the false gate gave $code"
+fi
+if [ -e "$home/.config/qtcurve-firefox-writer.lock" ]; then
+    if [ -s "$home/.config/qtcurve-firefox-writer.lock" ]; then
+        fail "the watch mode of the false gate took the daemon lock"
+    fi
+fi
+
+# 4. The true gate writes again, so the two arms differ in the key alone.
+gate true
+run again --write
+[ -s "$dir/$owned" ] || fail "the true gate wrote no owned sheet again"
+
+# The control below runs the false arm with --force, which takes the gate out
+# of the pass. The owned sheet must stay, so the check reads the gate and not
+# the settings file.
+gate false
+run forced --write --force
+if [ ! -s "$dir/$owned" ]; then
+    fail "the forced run of the false gate took the owned sheet away"
+fi
+
+if [ $status -eq 0 ]; then
+    echo "assert-ff-gate: the false gate removed the owned sheet and kept" \
+         "the foreign line, the watch mode left with 0, and --force wrote" \
+         "over the false gate"
+fi
+exit $status
diff --git a/firefox/check/assert-ff-import.sh b/firefox/check/assert-ff-import.sh
new file mode 100644
index 00000000..7d008264
--- /dev/null
+++ b/firefox/check/assert-ff-import.sh
@@ -0,0 +1,185 @@
+#!/bin/sh
+# assert-ff-import.sh WRITER WORKDIR: the import line of the writer must stand
+# before every rule of the shared sheet of a profile. A parser of the chrome
+# drops an import that stands after a rule. The run builds four fixture
+# sheets, merges the line into each one and reads the bytes around it. One
+# sheet holds a charset rule and a style rule on one line, where the import
+# must stand between the two. It then doctors a copy of one sheet with the
+# line at the end, and it fails if the check passes that copy.
+set -eu
+usage='usage: assert-ff-import.sh WRITER WORKDIR'
+writer=${1:?$usage}
+work=${2:?$usage}
+
+# A relative path leaves XDG_CONFIG_HOME outside the root of the file system.
+# The library of the writer then reads the configuration home of the caller.
+# The run therefore takes an absolute path of its own.
+case $work in
+    /*) ;;
+    *) work=$PWD/$work;;
+esac
+
+line='@import "qtcurve-userChrome.css";'
+shared=chrome/userChrome.css
+home=$work/home
+root=$home/.config/mozilla/firefox
+status=0
+
+rm -rf "$work"
+mkdir -p "$work"
+
+fail() {
+    echo "assert-ff-import: $1" >&2
+    status=1
+}
+
+mkdir -p "$root"
+{
+    printf '[Profile0]\nName=plain\nIsRelative=1\nPath=plain\n\n'
+    printf '[Profile1]\nName=charset\nIsRelative=1\nPath=charset\n\n'
+    printf '[Profile2]\nName=crlf\nIsRelative=1\nPath=crlf\n\n'
+    printf '[Profile3]\nName=oneline\nIsRelative=1\nPath=oneline\n'
+} > "$root/profiles.ini"
+
+for name in plain charset crlf oneline; do
+    mkdir -p "$root/$name/chrome"
+done
+
+# The first fixture holds two rules and no other statement.
+printf '#nav-bar { min-height: 40px; }\n.tab { color: #101010; }\n' \
+    > "$root/plain/$shared"
+# The second fixture opens with a charset rule, which must keep the first line.
+printf '@charset "utf-8";\n#nav-bar { min-height: 40px; }\n' \
+    > "$root/charset/$shared"
+# The third fixture holds the line ending of another operating system.
+printf '#nav-bar { min-height: 40px; }\r\n.tab { color: #101010; }\r\n' \
+    > "$root/crlf/$shared"
+# The fourth fixture holds the charset rule and a style rule on one line, and
+# it ends with no line break. The import must stand between the two rules.
+printf '@charset "utf-8";#x{color:red}' > "$root/oneline/$shared"
+
+for name in plain charset crlf oneline; do
+    cp "$root/$name/$shared" "$work/$name.want"
+done
+
+# run: runs one write pass over the three fixtures.
+run() {
+    code=0
+    (
+        ulimit -c 0
+        HOME=$home XDG_CONFIG_HOME=$home/.config \
+            QTCURVE_CONFIG_DIR=$home/qtcurve \
+            "$writer" --write --force --default
+    ) >> "$work/write.log" 2>&1 || code=$?
+    if [ "$code" -ne 0 ]; then
+        fail "the write pass gave the code $code"
+    fi
+}
+
+# at_front FILE: gives 0 when the import line stands before every rule of
+# FILE. A charset rule keeps the first line, and the import line follows it.
+# The line follows it on the first line when the rule shares that line.
+at_front() {
+    a_first=$(head -n 1 "$1")
+    case $a_first in
+        '@charset'*)
+            a_rest=${a_first#*;}
+            if [ "$a_rest" = "$line" ]; then
+                return 0
+            fi
+            if [ -n "$a_rest" ]; then
+                echo "assert-ff-import: $1 holds '$a_rest' after the" \
+                     "charset rule" >&2
+                return 1
+            fi
+            a_second=$(sed -n 2p "$1")
+            if [ "$a_second" != "$line" ]; then
+                echo "assert-ff-import: $1 holds '$a_second' after the" \
+                     "charset rule" >&2
+                return 1
+            fi;;
+        *)
+            if [ "$a_first" != "$line" ]; then
+                echo "assert-ff-import: $1 holds '$a_first' on the first" \
+                     "line" >&2
+                return 1
+            fi;;
+    esac
+    return 0
+}
+
+# foreign FILE WANT: gives 0 when FILE without the import line holds the bytes
+# of WANT, in order.
+foreign() {
+    sed "\\|^$line\$|d" "$1" > "$work/strip"
+    if ! cmp -s "$work/strip" "$2"; then
+        echo "assert-ff-import: $1 without the import line is not $2" >&2
+        return 1
+    fi
+    return 0
+}
+
+run
+for name in plain charset crlf oneline; do
+    at_front "$root/$name/$shared" || status=1
+    cp "$root/$name/$shared" "$work/$name.first"
+done
+for name in plain charset crlf; do
+    foreign "$root/$name/$shared" "$work/$name.want" || status=1
+done
+
+# The fourth sheet takes the import between the two rules of its first line,
+# and the merge adds one line break and no other byte.
+printf '@charset "utf-8";%s\n#x{color:red}' "$line" > "$work/oneline.merged"
+cmp -s "$root/oneline/$shared" "$work/oneline.merged" ||
+    fail "the one line sheet did not take the import after the charset rule"
+
+# The carriage returns of the third fixture must survive the merge.
+want_cr=$(tr -dc '\r' < "$work/crlf.want" | wc -c)
+got_cr=$(tr -dc '\r' < "$root/crlf/$shared" | wc -c)
+if [ "$want_cr" -ne "$got_cr" ]; then
+    fail "the merge left $got_cr carriage returns of $want_cr"
+fi
+
+# A second pass must write no byte of a sheet that holds the line.
+run
+for name in plain charset crlf oneline; do
+    cmp -s "$root/$name/$shared" "$work/$name.first" ||
+        fail "the second pass moved a byte of the $name sheet"
+done
+
+# The remove mode must keep every foreign line, in order.
+code=0
+(
+    ulimit -c 0
+    HOME=$home XDG_CONFIG_HOME=$home/.config \
+        QTCURVE_CONFIG_DIR=$home/qtcurve "$writer" --remove
+) > "$work/remove.log" 2>&1 || code=$?
+[ "$code" -eq 0 ] || fail "the remove mode gave the code $code"
+for name in plain charset crlf oneline; do
+    sed 's/\r$//' "$work/$name.want" > "$work/$name.lines"
+    sed 's/\r$//' "$root/$name/$shared" > "$work/$name.left"
+    cmp -s "$work/$name.left" "$work/$name.lines" ||
+        fail "the remove mode moved a line of the $name sheet"
+done
+
+# The remove mode takes back the bytes of the front merge alone, so the fourth
+# sheet holds its first bytes again.
+cmp -s "$root/oneline/$shared" "$work/oneline.want" ||
+    fail "the remove mode did not give the one line sheet its bytes back"
+
+# The control below puts the import line at the end of a copy, which is the
+# append that a parser of the chrome drops. The check must fail over it.
+sed "\\|^$line\$|d" "$work/plain.first" > "$work/append.css"
+printf '%s\n' "$line" >> "$work/append.css"
+if at_front "$work/append.css" 2> "$work/control.log"; then
+    fail "the check passed the control copy of the append"
+fi
+
+if [ $status -eq 0 ]; then
+    echo "assert-ff-import: the line stands first in 4 fixture sheets, the" \
+         "foreign bytes and the $got_cr carriage returns survive, the one" \
+         "line sheet gives its exact bytes back, a second pass writes" \
+         "nothing, and the check rejects the append copy"
+fi
+exit $status
diff --git a/firefox/check/assert-ff-keep.sh b/firefox/check/assert-ff-keep.sh
new file mode 100644
index 00000000..75058aae
--- /dev/null
+++ b/firefox/check/assert-ff-keep.sh
@@ -0,0 +1,87 @@
+#!/bin/sh
+# assert-ff-keep.sh WRITER WORKDIR: a remove pass that stops must keep the
+# shared sheet of the profile whole. The run builds a large userChrome.css
+# that holds the import line. It then runs the remove mode under a file size
+# limit that the rewrite passes, so the writer takes SIGXFSZ. HOME and
+# XDG_CONFIG_HOME point into WORKDIR, because the remove mode rewrites the
+# files of the caller.
+set -eu
+usage='usage: assert-ff-keep.sh WRITER WORKDIR'
+writer=${1:?$usage}
+work=${2:?$usage}
+
+# A relative path leaves XDG_CONFIG_HOME outside the root of the file system.
+# The library of the writer then reads the configuration home of the caller.
+# The run therefore takes an absolute path of its own.
+case $work in
+    /*) ;;
+    *) work=$PWD/$work;;
+esac
+
+shared=chrome/userChrome.css
+owned=chrome/qtcurve-userChrome.css
+home=$work/home
+root=$home/.config/mozilla/firefox
+dir=$root/keep.default
+status=0
+
+rm -rf "$work"
+mkdir -p "$dir/chrome"
+printf '[Profile0]\nName=keep\nIsRelative=1\nPath=keep.default\n' \
+    > "$root/profiles.ini"
+
+# The fixture holds one import line of 34 bytes and 4000 rule lines of 32
+# bytes, so it is 128034 bytes. One unit of ulimit -f is 1024 bytes at most,
+# and the rewrite of 128000 bytes passes that limit in every shell.
+fixture=$work/fixture.css
+printf '@import "qtcurve-userChrome.css";\n' > "$fixture"
+awk 'BEGIN { for (i = 0; i < 4000; i++)
+                 printf "label.r%04d { color: #101010; }\n", i }' >> "$fixture"
+tail -n +2 "$fixture" > "$work/want.css"
+cp "$fixture" "$dir/$shared"
+printf 'x\n' > "$dir/$owned"
+
+same() {
+    if cmp -s "$1" "$2"; then
+        return 0
+    fi
+    echo "assert-ff-keep: $1 is not the file $2" >&2
+    status=1
+}
+
+# The writer dies on the signal and gives 153, so the run keeps the exit code
+# and reads the two files. ulimit -c 0 stops the core file of that signal, and
+# the shell of the run prints the signal into the log of the run.
+(
+    ulimit -c 0
+    ulimit -f 1
+    code=0
+    HOME=$home XDG_CONFIG_HOME=$home/.config "$writer" --remove || code=$?
+    echo "$code" > "$work/limit.status"
+) > "$work/limit.log" 2>&1
+limited=$(cat "$work/limit.status")
+same "$dir/$shared" "$fixture"
+if [ ! -f "$dir/$owned" ]; then
+    echo "assert-ff-keep: the stopped pass deleted the owned sheet" >&2
+    status=1
+fi
+if [ $status -eq 0 ]; then
+    echo "assert-ff-keep: the shared sheet keeps 128034 bytes under the" \
+         "limit, the owned sheet stays, and the writer gave $limited"
+fi
+
+# The same run with no limit must remove the import line, keep every other
+# line and delete the owned sheet. The limited run above therefore fails on
+# the write of the shared sheet alone.
+HOME=$home XDG_CONFIG_HOME=$home/.config "$writer" --remove \
+    > "$work/free.log" 2>&1
+same "$dir/$shared" "$work/want.css"
+if [ -e "$dir/$owned" ]; then
+    echo "assert-ff-keep: the free pass kept the owned sheet" >&2
+    status=1
+fi
+if [ $status -eq 0 ]; then
+    echo "assert-ff-keep: a free pass removes the import line, keeps 4000" \
+         "lines and deletes the owned sheet"
+fi
+exit $status
diff --git a/firefox/check/assert-ff-notice.sh b/firefox/check/assert-ff-notice.sh
new file mode 100644
index 00000000..bb786c62
--- /dev/null
+++ b/firefox/check/assert-ff-notice.sh
@@ -0,0 +1,93 @@
+#!/bin/sh
+# assert-ff-notice.sh WRITER WORKDIR: the writer must name the one preference
+# that Firefox reads before it takes the shared sheet. The run holds two
+# profiles that differ in the prefs.js file alone. The profile without the row
+# must take one notice, and the profile with the row must take none. The file
+# keeps its bytes, because the writer never writes it.
+set -eu
+usage='usage: assert-ff-notice.sh WRITER WORKDIR'
+writer=${1:?$usage}
+work=${2:?$usage}
+
+# A relative path leaves XDG_CONFIG_HOME outside the root of the file system.
+# The library of the writer then reads the configuration home of the caller.
+# The run therefore takes an absolute path of its own.
+case $work in
+    /*) ;;
+    *) work=$PWD/$work;;
+esac
+
+pref=toolkit.legacyUserProfileCustomizations.stylesheets
+home=$work/home
+root=$home/.config/mozilla/firefox
+status=0
+
+rm -rf "$work"
+mkdir -p "$root/with/chrome" "$root/without/chrome"
+{
+    printf '[Profile0]\nName=with\nIsRelative=1\nPath=with\n\n'
+    printf '[Profile1]\nName=without\nIsRelative=1\nPath=without\n'
+} > "$root/profiles.ini"
+
+# The first profile holds the row, and the second one holds another row alone.
+printf '// Mozilla User Preferences\nuser_pref("%s", true);\n' "$pref" \
+    > "$root/with/prefs.js"
+printf '// Mozilla User Preferences\nuser_pref("browser.startup.page", 3);\n' \
+    > "$root/without/prefs.js"
+cp "$root/with/prefs.js" "$work/with.want"
+cp "$root/without/prefs.js" "$work/without.want"
+
+fail() {
+    echo "assert-ff-notice: $1" >&2
+    status=1
+}
+
+code=0
+(
+    ulimit -c 0
+    HOME=$home XDG_CONFIG_HOME=$home/.config QTCURVE_CONFIG_DIR=$home/qtcurve \
+        "$writer" --write --force --default
+) > "$work/write.log" 2>&1 || code=$?
+[ "$code" -eq 0 ] || fail "the write pass gave the code $code"
+
+# count DIR: prints the count of the notice lines of the profile DIR.
+count() {
+    n=$(grep -c "the profile $root/$1 needs $pref" "$work/write.log") || n=0
+    printf '%s\n' "$n"
+}
+
+if [ "$(count without)" -ne 1 ]; then
+    fail "the profile without the row took $(count without) notices, not 1"
+fi
+if [ "$(count with)" -ne 0 ]; then
+    fail "the profile with the row took $(count with) notices, not 0"
+fi
+
+# The writer reads prefs.js and never writes it.
+cmp -s "$root/with/prefs.js" "$work/with.want" ||
+    fail "the writer moved a byte of the prefs.js of the first profile"
+cmp -s "$root/without/prefs.js" "$work/without.want" ||
+    fail "the writer moved a byte of the prefs.js of the second profile"
+
+# The control below takes the row into the second profile, and the notice of
+# that profile must stop. A check that prints the notice for every profile
+# fails here.
+printf '// Mozilla User Preferences\nuser_pref("%s", true);\n' "$pref" \
+    > "$root/without/prefs.js"
+code=0
+(
+    ulimit -c 0
+    HOME=$home XDG_CONFIG_HOME=$home/.config QTCURVE_CONFIG_DIR=$home/qtcurve \
+        "$writer" --write --force --default
+) > "$work/write.log" 2>&1 || code=$?
+[ "$code" -eq 0 ] || fail "the control pass gave the code $code"
+if [ "$(count without)" -ne 0 ]; then
+    fail "the control profile took $(count without) notices, and not 0"
+fi
+
+if [ $status -eq 0 ]; then
+    echo "assert-ff-notice: the profile without the preference took one" \
+         "notice, the profile with it took none, and the row of the control" \
+         "stopped the notice"
+fi
+exit $status
diff --git a/firefox/check/assert-ff-profiles.sh b/firefox/check/assert-ff-profiles.sh
new file mode 100644
index 00000000..8b9f29dc
--- /dev/null
+++ b/firefox/check/assert-ff-profiles.sh
@@ -0,0 +1,190 @@
+#!/bin/sh
+# assert-ff-profiles.sh WRITER WORKDIR: the writer must find every profile of
+# the two roots and write its owned sheet into each one. The run builds seven
+# fixture layouts under WORKDIR, and each layout holds a private HOME and
+# XDG_CONFIG_HOME. A directory outside every root must keep its bytes. A
+# profile of two roots must take one pass. The remove mode must take every
+# path of the write mode away.
+set -eu
+usage='usage: assert-ff-profiles.sh WRITER WORKDIR'
+writer=${1:?$usage}
+work=${2:?$usage}
+
+# A relative path leaves XDG_CONFIG_HOME outside the root of the file system.
+# The library of the writer then reads the configuration home of the caller.
+# The run therefore takes an absolute path of its own.
+case $work in
+    /*) ;;
+    *) work=$PWD/$work;;
+esac
+
+owned=chrome/qtcurve-userChrome.css
+shared=chrome/userChrome.css
+status=0
+
+rm -rf "$work"
+mkdir -p "$work"
+
+fail() {
+    echo "assert-ff-profiles: $1" >&2
+    status=1
+}
+
+# run NAME ARGS...: runs the writer over the tree WORKDIR/NAME, and holds the
+# exit code of that run in the variable code.
+run() {
+    r_name=$1
+    shift
+    r_home=$work/$r_name
+    code=0
+    (
+        ulimit -c 0
+        HOME=$r_home XDG_CONFIG_HOME=$r_home/.config \
+            QTCURVE_CONFIG_DIR=$r_home/qtcurve "$writer" "$@"
+    ) >> "$work/$r_name.log" 2>&1 || code=$?
+}
+
+# profile DIR: makes the profile directory DIR and one foreign sheet in it.
+profile() {
+    mkdir -p "$1/chrome"
+    printf '#nav-bar { min-height: 40px; }\n' > "$1/$shared"
+}
+
+# ini FILE PATH RELATIVE: writes one profiles.ini of one profile section.
+ini() {
+    mkdir -p "$(dirname "$1")"
+    {
+        printf '[Install0]\nDefault=%s\n\n' "$2"
+        printf '[Profile0]\nName=default\nIsRelative=%s\nPath=%s\n' "$3" "$2"
+    } > "$1"
+}
+
+# written DIR: gives 0 when DIR holds the owned sheet and the import line on
+# the first line of the shared sheet.
+written() {
+    if [ ! -s "$1/$owned" ]; then
+        echo "assert-ff-profiles: $1 holds no owned sheet" >&2
+        return 1
+    fi
+    w_first=$(head -n 1 "$1/$shared")
+    if [ "$w_first" != '@import "qtcurve-userChrome.css";' ]; then
+        echo "assert-ff-profiles: $1 holds '$w_first' on the first line" >&2
+        return 1
+    fi
+    return 0
+}
+
+# untouched DIR: gives 0 when DIR holds no owned sheet and no import line.
+untouched() {
+    if [ -e "$1/$owned" ]; then
+        echo "assert-ff-profiles: $1 holds an owned sheet" >&2
+        return 1
+    fi
+    if [ -e "$1/$shared" ] && grep -qF 'qtcurve-userChrome.css' "$1/$shared"
+    then
+        echo "assert-ff-profiles: $1 holds the import line" >&2
+        return 1
+    fi
+    return 0
+}
+
+# 1. One profile under the configuration home of the user.
+xdg=$work/xdg/.config/mozilla/firefox
+profile "$xdg/abc.default"
+ini "$xdg/profiles.ini" abc.default 1
+run xdg --write --force --default
+[ "$code" -eq 0 ] || fail "the run over the first root gave the code $code"
+written "$xdg/abc.default" || status=1
+
+# 2. One profile under the home directory of the user.
+legacy=$work/legacy/.mozilla/firefox
+profile "$legacy/xyz.default"
+ini "$legacy/profiles.ini" xyz.default 1
+run legacy --write --force --default
+[ "$code" -eq 0 ] || fail "the run over the second root gave the code $code"
+written "$legacy/xyz.default" || status=1
+
+# 3. One directory that the ini file of each root names, with an absolute
+# path. The writer must take it one time, so the log holds one notice of it.
+both=$work/both
+profile "$both/shared.default"
+ini "$both/.config/mozilla/firefox/profiles.ini" "$both/shared.default" 0
+ini "$both/.mozilla/firefox/profiles.ini" "$both/shared.default" 0
+run both --write --force --default
+[ "$code" -eq 0 ] || fail "the run over the two roots gave the code $code"
+written "$both/shared.default" || status=1
+notices=$(grep -c 'holds the new sheet' "$work/both.log" || true)
+if [ "$notices" -ne 1 ]; then
+    fail "the shared profile took $notices passes, and not 1"
+fi
+
+# 4. An absolute path outside every root.
+away=$work/away
+profile "$away/outside"
+ini "$away/.config/mozilla/firefox/profiles.ini" "$away/outside" 0
+run away --write --force --default
+[ "$code" -eq 0 ] || fail "the run of the absolute path gave the code $code"
+written "$away/outside" || status=1
+
+# 5. A root with no profile section, a root with no ini file, and no root at
+# all. Each one is zero profiles and the code 0.
+none=$work/none
+mkdir -p "$none/.config/mozilla/firefox" "$none/.mozilla/firefox"
+printf '[General]\nStartWithLastProfile=1\n' \
+    > "$none/.config/mozilla/firefox/profiles.ini"
+run none --write --force --default
+[ "$code" -eq 0 ] || fail "the run of the empty ini file gave the code $code"
+bare=$work/bare
+mkdir -p "$bare/qtcurve"
+run bare --write --force --default
+[ "$code" -eq 0 ] || fail "the run of the absent root gave the code $code"
+
+# 6. An ini file that names a directory which is gone. The writer must skip it
+# with one notice, and it must make no profile.
+lost=$work/lost/.config/mozilla/firefox
+ini "$lost/profiles.ini" gone.default 1
+run lost --write --force --default
+[ "$code" -eq 0 ] || fail "the run of the gone profile gave the code $code"
+grep -qF 'is gone, and this pass skips it' "$work/lost.log" ||
+    fail "the run of the gone profile printed no skip notice"
+if [ -e "$lost/gone.default" ]; then
+    fail "the writer made the profile directory $lost/gone.default"
+fi
+
+# 7. A profile shaped directory that no ini file names must keep its bytes.
+decoy=$work/xdg/decoy
+profile "$decoy"
+cp "$decoy/$shared" "$work/decoy.want"
+run xdg --write --force --default
+untouched "$decoy" || status=1
+cmp -s "$decoy/$shared" "$work/decoy.want" ||
+    fail "the writer moved a byte of the decoy sheet"
+
+# 8. The remove mode must take every path of the write mode away, and it must
+# keep every foreign line of the shared sheet.
+run xdg --remove
+[ "$code" -eq 0 ] || fail "the remove mode gave the code $code"
+untouched "$xdg/abc.default" || status=1
+grep -qF '#nav-bar' "$xdg/abc.default/$shared" ||
+    fail "the remove mode dropped the foreign line of the shared sheet"
+
+# The controls below run the two readers over a tree of the other state, and
+# each one must fail.
+broken=0
+if written "$decoy" 2> "$work/control.log"; then
+    fail "the check read an owned sheet in the untouched decoy"
+else
+    broken=$((broken + 1))
+fi
+if untouched "$both/shared.default" 2>> "$work/control.log"; then
+    fail "the check read no owned sheet in the profile that holds one"
+else
+    broken=$((broken + 1))
+fi
+
+if [ $status -eq 0 ]; then
+    echo "assert-ff-profiles: the writer wrote 4 profiles of 7 layouts," \
+         "skipped the gone one, kept the decoy, and the remove mode took" \
+         "every path away. The check rejects each of the $broken controls"
+fi
+exit $status
diff --git a/firefox/check/assert-ff-toolbox.sh b/firefox/check/assert-ff-toolbox.sh
new file mode 100644
index 00000000..e68671ea
--- /dev/null
+++ b/firefox/check/assert-ff-toolbox.sh
@@ -0,0 +1,166 @@
+#!/bin/sh
+# assert-ff-toolbox.sh WRITER WORKDIR: the tool box of the sheet must follow
+# the title bar appearance of each state of the window. Decoration::paint() of
+# the QtCurve decoration fills the title bar from the appearance and the
+# colour of the state. A gradient of the active state must never reach a
+# window that holds no focus. The run flips the two appearance keys over four
+# write passes. HOME, XDG_CONFIG_HOME and QTCURVE_CONFIG_DIR point into
+# WORKDIR, because the writer rewrites the files of the caller.
+set -eu
+ulimit -c 0
+usage='usage: assert-ff-toolbox.sh WRITER WORKDIR'
+writer=${1:?$usage}
+work=${2:?$usage}
+
+# A relative path leaves XDG_CONFIG_HOME outside the root of the file system.
+# The library of the writer then reads the configuration home of the caller.
+case $work in
+    /*) ;;
+    *) work=$PWD/$work;;
+esac
+
+owned=chrome/qtcurve-userChrome.css
+home=$work/home
+root=$home/.config/mozilla/firefox
+dir=$root/toolbox.default
+qtc=$home/qtcurve
+sheet=$dir/$owned
+status=0
+
+# The selector of each state. browser.css of omni.ja gives the tool box the
+# first identifier, and the pseudo class of the second one reads a window that
+# holds no focus.
+live='#navigator-toolbox'
+idle='#navigator-toolbox:-moz-window-inactive'
+
+fail() {
+    echo "assert-ff-toolbox: $1" >&2
+    status=1
+}
+
+rm -rf "$work"
+mkdir -p "$dir/chrome" "$qtc" "$home/.config"
+printf '[Profile0]\nName=toolbox\nIsRelative=1\nPath=toolbox.default\n' \
+    > "$root/profiles.ini"
+
+# The colour file of the private home. The two title bar colours must differ,
+# because the two rules of the tool box carry one gradient of each colour. A
+# home with no colour file gives both title bars the window colour, and the
+# run then reads two rules of one colour.
+printf '[WM]\nactiveBackground=40,60,80\ninactiveBackground=200,210,220\n' \
+    > "$home/.config/kdeglobals"
+
+# settings ACTIVE INACTIVE: writes the settings file of the user with the gate
+# on, the active title bar appearance at ACTIVE and the inactive one at
+# INACTIVE.
+settings() {
+    printf '[Settings]\nfirefoxTheme=true\ntitlebarAppearance=%s\n'\
+'inactiveTitlebarAppearance=%s\n' "$1" "$2" > "$qtc/stylerc"
+}
+
+# run NAME: runs one write pass over the private home, and holds the exit code
+# in the variable code.
+run() {
+    r_name=$1
+    code=0
+    HOME=$home XDG_CONFIG_HOME=$home/.config QTCURVE_CONFIG_DIR=$qtc \
+        "$writer" --write > "$work/$r_name.log" 2>&1 || code=$?
+}
+
+# image FILE SELECTOR: prints the background image of the block of SELECTOR,
+# and prints nothing when the sheet holds no such block.
+image() {
+    i_esc=$(printf '%s' "$2" | sed 's/[.[\*^$]/\\&/g')
+    sed -n "/^$i_esc {\$/,/^}\$/p" "$1" |
+        sed -n 's/^  background-image: \(.*\) !important;$/\1/p'
+}
+
+# gradient VALUE: gives 0 while VALUE is one linear gradient of the writer.
+gradient() {
+    case $1 in
+        'linear-gradient(to bottom, '*')') return 0;;
+        *) return 1;;
+    esac
+}
+
+# 1. Two gradient appearances give two rules, and the two rules must differ.
+# The stops of the inactive rule come from the inactive title bar colour.
+settings custom1 custom1
+run both
+[ "$code" -eq 0 ] || fail "the gradient pair gave the code $code"
+[ -s "$sheet" ] || fail "the gradient pair wrote no sheet"
+live_img=$(image "$sheet" "$live")
+idle_img=$(image "$sheet" "$idle")
+gradient "$live_img" || fail "the active state carries no gradient"
+gradient "$idle_img" || fail "the inactive state carries no gradient"
+if [ "$live_img" = "$idle_img" ]; then
+    fail "the two states carry one image of one colour"
+fi
+cp "$sheet" "$work/both.css"
+
+# 2. A flat inactive appearance holds the image at none. The active gradient
+# reaches every state without that rule, because no rule takes it back.
+settings custom1 flat
+run flat-idle
+[ "$code" -eq 0 ] || fail "the flat inactive key gave the code $code"
+gradient "$(image "$sheet" "$live")" ||
+    fail "the flat inactive key moved the active state"
+[ "$(image "$sheet" "$idle")" = none ] ||
+    fail "the flat inactive key left no suppression rule"
+
+# 3. A flat active appearance and a gradient inactive one give the inactive
+# rule alone, because the map holds the flat colour of the active state.
+settings flat custom1
+run flat-live
+[ "$code" -eq 0 ] || fail "the flat active key gave the code $code"
+[ -z "$(image "$sheet" "$live")" ] ||
+    fail "the flat active key left an image of the active state"
+gradient "$(image "$sheet" "$idle")" ||
+    fail "the flat active key moved the inactive state"
+
+# 4. Two flat appearances give no rule at all, so the map paints the tool box.
+settings flat flat
+run flat-both
+[ "$code" -eq 0 ] || fail "the flat pair gave the code $code"
+if grep -q '^#navigator-toolbox' "$sheet"; then
+    fail "the flat pair left a rule of the tool box"
+fi
+
+# The controls below. Each one doctors a copy of the sheet of the gradient
+# pair, and the arm of that copy must fail.
+broken=0
+
+# control NAME COPY: the state of the copy must leave its own image.
+control() {
+    c_name=$1
+    c_live=$(image "$2" "$live")
+    c_idle=$(image "$2" "$idle")
+    if [ -n "$c_live" ] && [ -n "$c_idle" ] && [ "$c_live" != "$c_idle" ]; then
+        echo "assert-ff-toolbox: the check passed the control copy of" \
+             "$c_name" >&2
+        exit 1
+    fi
+    broken=$((broken + 1))
+}
+
+# A sheet that lost the rule of the inactive state. The writer wrote such a
+# sheet before the state of the window reached the tool box.
+sed "/^$idle {\$/,/^}\$/d" "$work/both.css" > "$work/gone.css"
+control gone "$work/gone.css"
+
+# A sheet that gives the inactive state the image of the active state. Such a
+# sheet paints a window with no focus in the colour of a window with focus.
+grep -A1 "^$live {\$" "$work/both.css" | grep '^  background-image:' \
+    > "$work/live.line"
+sed "/^$idle {\$/,/^}\$/{
+/^  background-image:/d
+}" "$work/both.css" > "$work/cut.css"
+sed "/^$idle {\$/r $work/live.line" "$work/cut.css" > "$work/same.css"
+control same "$work/same.css"
+
+if [ $status -eq 0 ]; then
+    echo "assert-ff-toolbox: the two states of the tool box follow the two" \
+         "title bar appearances over four settings pairs, and the check" \
+         "rejects each of the $broken control copies"
+fi
+exit $status
diff --git a/firefox/check/assert-ff-varnames.sh b/firefox/check/assert-ff-varnames.sh
new file mode 100644
index 00000000..92c02d41
--- /dev/null
+++ b/firefox/check/assert-ff-varnames.sh
@@ -0,0 +1,79 @@
+#!/bin/sh
+# assert-ff-varnames.sh [-n MIN] SHEET PIN: every custom property of SHEET must
+# stand in PIN, and SHEET must set MIN properties at least. The chrome paints
+# nothing for a property outside the pin, and an empty sheet paints nothing at
+# all. The run then doctors two copies of SHEET, and it fails if the check
+# passes a copy.
+set -eu
+usage='usage: assert-ff-varnames.sh [-n MIN] SHEET PIN'
+min=1
+if [ "${1:-}" = "-n" ]; then
+    min=${2:?$usage}
+    shift 2
+fi
+sheet=${1:?$usage}
+pin=${2:?$usage}
+
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+
+grep -o -- '^--[A-Za-z0-9-]*' "$pin" | sort -u > "$tmp/pin"
+if [ ! -s "$tmp/pin" ]; then
+    echo "assert-ff-varnames: $pin holds no name" >&2
+    exit 1
+fi
+
+# check SHEET: gives 0 when the two contracts hold. It names the first
+# contract that fails on the standard error.
+check() {
+    c_sheet=$1
+    grep -o -- '--[A-Za-z0-9-]*:' "$c_sheet" | sed 's/:$//' | sort -u \
+        > "$tmp/used" || true
+    comm -23 "$tmp/used" "$tmp/pin" > "$tmp/loose"
+    if [ -s "$tmp/loose" ]; then
+        echo "assert-ff-varnames: $c_sheet sets names outside the pin:" >&2
+        cat "$tmp/loose" >&2
+        return 1
+    fi
+    c_count=$(wc -l < "$tmp/used")
+    if [ "$c_count" -lt "$min" ]; then
+        echo "assert-ff-varnames: $c_sheet sets $c_count properties," \
+             "under $min" >&2
+        return 1
+    fi
+    return 0
+}
+
+if ! check "$sheet"; then
+    echo "assert-ff-varnames: the sheet fails the check" >&2
+    exit 1
+fi
+count=$(wc -l < "$tmp/used")
+
+# The controls below. Each one doctors a copy of the sheet, and the check must
+# fail over that copy.
+broken=0
+
+# control NAME SHEET: the check must fail over the sheet that the caller gives.
+control() {
+    c_name=$1
+    shift
+    if check "$@" 2> "$tmp/control.log"; then
+        echo "assert-ff-varnames: the check passed the control copy of" \
+             "$c_name" >&2
+        exit 1
+    fi
+    broken=$((broken + 1))
+}
+
+# A property that the pin does not hold, which the chrome never reads.
+sed '/^:root {$/a\
+  --qtc-outside-the-pin-color: #000000 !important;' "$sheet" > "$tmp/loose.css"
+control loose "$tmp/loose.css"
+
+# An empty sheet, which sets no property at all.
+: > "$tmp/empty.css"
+control empty "$tmp/empty.css"
+
+echo "assert-ff-varnames: $sheet ok, $count properties of the pin, and the" \
+     "check rejects each of the $broken control copies"
diff --git a/firefox/check/assert-locks-distinct.sh b/firefox/check/assert-locks-distinct.sh
new file mode 100644
index 00000000..f3162ea0
--- /dev/null
+++ b/firefox/check/assert-locks-distinct.sh
@@ -0,0 +1,64 @@
+#!/bin/sh
+# assert-locks-distinct.sh MAIN MAIN...: the writers must hold no lock name in
+# common. Each MAIN is the main file of one binary, and each one defines a
+# daemon lock name and a write lock name. Two binaries of one name would stop
+# each other, and one write lock over two file sets buys nothing. The run then
+# doctors a copy of the second file, and it fails if the check passes the copy.
+set -eu
+usage='usage: assert-locks-distinct.sh MAIN MAIN...'
+first=${1:?$usage}
+second=${2:?$usage}
+
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+
+# names FILE: prints the two lock names of FILE, one per line.
+names() {
+    sed -n 's/^const char \*const [a-z]*LockName = "\(.*\)";$/\1/p' "$1"
+}
+
+# check MAIN...: gives 0 when each file holds two names and no name repeats.
+check() {
+    : > "$tmp/all"
+    for c_file in "$@"; do
+        names "$c_file" > "$tmp/one"
+        c_count=$(wc -l < "$tmp/one")
+        if [ "$c_count" -ne 2 ]; then
+            echo "assert-locks-distinct: $c_file defines $c_count lock" \
+                 "names, and not 2" >&2
+            return 1
+        fi
+        cat "$tmp/one" >> "$tmp/all"
+    done
+    c_total=$(wc -l < "$tmp/all")
+    c_unique=$(sort -u "$tmp/all" | wc -l)
+    if [ "$c_total" -ne "$c_unique" ]; then
+        echo "assert-locks-distinct: the $c_total names hold $c_unique" \
+             "values, so two binaries share a lock" >&2
+        return 1
+    fi
+    return 0
+}
+
+if ! check "$@"; then
+    echo "assert-locks-distinct: the main files fail the check" >&2
+    exit 1
+fi
+total=$(wc -l < "$tmp/all")
+
+# The control below takes the names of the first binary into a copy of the
+# second one, and the check must fail over that copy.
+names "$first" > "$tmp/first"
+daemon=$(sed -n 1p "$tmp/first")
+write=$(sed -n 2p "$tmp/first")
+sed -e "s|^\(const char \*const daemonLockName = \).*|\1\"$daemon\";|" \
+    -e "s|^\(const char \*const writeLockName = \).*|\1\"$write\";|" \
+    "$second" > "$tmp/same.cpp"
+if check "$first" "$tmp/same.cpp" 2> "$tmp/control.log"; then
+    echo "assert-locks-distinct: the check passed the control copy of the" \
+         "shared names" >&2
+    exit 1
+fi
+
+echo "assert-locks-distinct: the $# main files hold $total lock names of" \
+     "their own, and the check rejects the control copy"
