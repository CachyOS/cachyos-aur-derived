+++ b/qt6/style/qtcurve_primitive.cpp
@@ -405,8 +405,8 @@ Style::drawPrimitiveIndicatorToolBarSeparator(PrimitiveElement,
                           true, true, false);
 
             if (opts.toolbarSeparators == LINE_SUNKEN) {
-                drawFadedLine(painter, QRect(x + 1, r.y() + 6, 1,
