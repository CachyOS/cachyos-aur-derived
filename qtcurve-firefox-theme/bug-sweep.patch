+// Qt adopts a window that exists before QWidget::create only on a window
+// or on a native child. On any other child the window stays unused.
+void
+removeAlphaWindow(QWidget *widget)
+{
+    if (widget->isWindow() || widget->testAttribute(Qt::WA_NativeWindow) ||
+        !widget->windowHandle()) {
+        return;
+    }
+    QWidgetPrivate *widgetPrivate =
+        static_cast<QWidgetPrivate*>(QObjectPrivate::get(widget));
+    widgetPrivate->deleteTLSysExtra();
+}
+
 }
