+/**
+ * Read the three columns of one stop row as fractions. The columns hold
+ * percentages, and the stop set holds fractions.
+ */
+static void
+readGradStop(const QTreeWidgetItem *i, double (&stop)[3])
+{
+    for(int c=0; c<3; ++c)
+        stop[c]=i->text(c).toDouble()/100.0;
+}
+
 void QtCurveConfig::itemChanged(QTreeWidgetItem *i, int col)
 {
     bool   ok;
-    double val=i->text(col).toDouble(&ok)/100.0;
+    double cell=prev,
+           val=i->text(col).toDouble(&ok)/100.0,
+           was=cell/100.0;
 
-    if(prev<0 || (ok && qtcEqual(val, prev)))
+    if(cell<0 || (ok && qtcEqual(val, was)))
         return;
 
+    // The write below emits itemChanged() again, and the edited cell no
+    // longer holds the value that prev names.
+    prev=-1.0;
+    gradStops->blockSignals(true);
     if(!ok || ((0==col || 2==col) && (val<0.0 || val>1.0)) || (1==col && (val<0.0 || val>2.0)))
-        i->setText(col, QString().setNum(prev));
+        i->setText(col, QString().setNum(cell));
     else
     {
-        double other=i->text(col ? 0 : 1).toDouble(&ok)/100.0;
-
         GradientCont::iterator it=customGradient.find((EAppearance)gradCombo->currentIndex());
 
         if(it!=customGradient.end())
         {
-            (*it).second.stops.erase(GradientStop(0==col ? prev : other, 1==col ? prev : other, 2==col ? prev : other));
-            (*it).second.stops.insert(GradientStop(0==col ? val : other, 1==col ? val : other, 2==col ? val : other));
+            double after[3];
+
+            readGradStop(i, after);
+
+            double before[3]={after[0], after[1], after[2]};
+
+            before[col]=was;
+            (*it).second.stops.erase(GradientStop(before[0], before[1], before[2]));
+            (*it).second.stops.insert(GradientStop(after[0], after[1], after[2]));
             gradPreview->setGrad((*it).second);
             i->setText(col, QString().setNum(val*100.0));
             emit changed(true);
         }
+        else
+            i->setText(col, QString().setNum(cell));
     }
+    gradStops->blockSignals(false);
 }
 
