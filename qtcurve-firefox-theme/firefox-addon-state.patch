@@ -0,0 +1,164 @@
+#!/bin/sh
+# assert-ff-matrix.sh WRITER WORKDIR ID: the key of the gate, the switch
+# --force and the add-on state must hold one matrix of twelve cells. The run
+# holds three profiles under one root. One holds the identifier ID as the
+# active theme, one holds the same identifier in a not active state, and one
+# holds no state file. Five passes read the cells, and the last pass proves
+# that a sheet of an earlier pass leaves a not active profile. HOME,
+# XDG_CONFIG_HOME and QTCURVE_CONFIG_DIR point into WORKDIR, because the
+# writer rewrites the files of the caller.
+set -eu
+ulimit -c 0
+usage='usage: assert-ff-matrix.sh WRITER WORKDIR ID'
+writer=${1:?$usage}
+work=${2:?$usage}
+id=${3:?$usage}
+
+# A relative path leaves XDG_CONFIG_HOME outside the root of the file system.
+# The library of the writer then reads the configuration home of the caller.
+# The run therefore takes an absolute path of its own.
+case $work in
+    /*) ;;
+    *) work=$PWD/$work;;
+esac
+
+owned=chrome/qtcurve-userChrome.css
+state=extensions.json
+home=$work/home
+root=$home/.config/mozilla/firefox
+qtc=$home/qtcurve
+status=0
+
+# The three profiles of the matrix, in the order of the profiles.ini file. The
+# profile absent holds no state file.
+cells='active inactive absent'
+
+fail() {
+    echo "assert-ff-matrix: $1" >&2
+    status=1
+}
+
+# gate VALUE: writes the settings file of the user with the key of the gate at
+# VALUE. The two files differ in that one row.
+gate() {
+    printf '[Settings]\nappearance=gradient\nfirefoxTheme=%s\n' "$1" \
+        > "$qtc/stylerc"
+}
+
+# write_state NAME ACTIVE: writes the state file of the profile NAME, with the
+# theme record of the identifier ID at the active value ACTIVE.
+write_state() {
+    printf '{"schemaVersion":37,"addons":[{"id":"%s","type":"theme",' "$id" \
+        > "$root/$1/$state"
+    printf '"active":%s,"visible":true}]}\n' "$2" >> "$root/$1/$state"
+}
+
+# run NAME ARGS...: runs the writer over the private home, and holds the exit
+# code in the variable code.
+run() {
+    r_name=$1
+    shift
+    code=0
+    HOME=$home XDG_CONFIG_HOME=$home/.config QTCURVE_CONFIG_DIR=$qtc \
+        "$writer" "$@" > "$work/$r_name.log" 2>&1 || code=$?
+    [ "$code" -eq 0 ] || fail "the pass $r_name gave the code $code"
+}
+
+# has PASS NAME WANT: reads the owned sheet of the profile NAME after the pass
+# PASS against WANT, which is yes or no.
+has() {
+    if [ "$3" = yes ]; then
+        [ -s "$root/$2/$owned" ] ||
+            fail "the pass $1 wrote no owned sheet of the profile $2"
+    elif [ -e "$root/$2/$owned" ]; then
+        fail "the pass $1 kept the owned sheet of the profile $2"
+    fi
+}
+
+# same_states PASS: the writer reads the state files and never writes them, so
+# each one must hold the bytes of its copy after the pass PASS.
+same_states() {
+    for cell in active inactive; do
+        cmp -s "$root/$cell/$state" "$work/$cell.want" ||
+            fail "the pass $1 moved a byte of the state file of $cell"
+    done
+    if [ -e "$root/absent/$state" ]; then
+        fail "the pass $1 made a state file in the profile absent"
+    fi
+}
+
+rm -rf "$work"
+mkdir -p "$qtc"
+for cell in $cells; do
+    mkdir -p "$root/$cell/chrome"
+done
+{
+    printf '[Profile0]\nName=active\nIsRelative=1\nPath=active\n\n'
+    printf '[Profile1]\nName=inactive\nIsRelative=1\nPath=inactive\n\n'
+    printf '[Profile2]\nName=absent\nIsRelative=1\nPath=absent\n'
+} > "$root/profiles.ini"
+write_state active true
+write_state inactive false
+cp "$root/active/$state" "$work/active.want"
+cp "$root/inactive/$state" "$work/inactive.want"
+
+# Pass A, the key true and no --force: each profile follows its add-on state.
+gate true
+run a --write
+has a active yes
+has a inactive no
+has a absent yes
+same_states a
+
+# Pass B, the key false and no --force: the remove pass runs over every
+# profile, because the one key stops the sheet everywhere.
+gate false
+run b --write
+has b active no
+has b inactive no
+has b absent no
+same_states b
+
+# Pass C, the key true and --force: the pass writes every profile, because
+# --force takes the state read out of the pass.
+gate true
+run c --write --force
+has c active yes
+has c inactive yes
+has c absent yes
+same_states c
+
+# Pass D, the key false and --force: the switch takes the gate out as well, so
+# every profile keeps the sheet.
+gate false
+run d --write --force
+has d active yes
+has d inactive yes
+has d absent yes
+same_states d
+
+# Pass E, the key true and no --force, over the sheets of pass D. The not
+# active profile must lose its sheet here. A pass that skips such a profile and
+# removes nothing leaves the sheet of pass D, which is the defect itself.
+gate true
+run e --write
+has e active yes
+has e inactive no
+has e absent yes
+same_states e
+
+# The control below makes the record of the not active profile active, and one
+# plain pass must bring the sheet back. A remove that latches fails here.
+write_state inactive true
+cp "$root/inactive/$state" "$work/inactive.want"
+run flipped --write
+has flipped inactive yes
+same_states flipped
+
+if [ $status -eq 0 ]; then
+    echo "assert-ff-matrix: the 12 cells of the key, --force and the add-on" \
+         "state held over 5 passes, the pass E took the sheet of the pass D" \
+         "from the not active profile, the 2 state files kept their bytes," \
+         "and the flip brought that sheet back"
+fi
+exit $status
