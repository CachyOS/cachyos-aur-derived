+#include "state.h"
+
+#include "manifest.h"
+
+#include <QFile>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QJsonParseError>
+#include <QJsonValue>
+
+namespace QtCurve {
+namespace Firefox {
+
+const char *const stateName = "extensions.json";
+
+namespace {
+
+/** The key of the array of the state file that holds one record per add-on. */
+const char *const addonsKey = "addons";
+
+/** The key of a record that holds the identifier of the add-on. */
+const char *const idKey = "id";
+
+/** The key of a record that holds the kind of the add-on. */
+const char *const typeKey = "type";
+
+/** The value of the type key of a theme. */
+const char *const themeType = "theme";
+
+/**
+ * The key of a record that Firefox sets while the add-on takes effect. A
+ * record without the key counts as not active, because the writer of Firefox
+ * drops a field that holds no value.
+ */
+const char *const activeKey = "active";
+
+/** The key of a record that about:addons shows to the user. */
+const char *const visibleKey = "visible";
+
+/**
+ * Returns true while the record names the static theme. A record without a
+ * type field matches, because the identifier is the strong key.
+ */
+bool
+matches(const QJsonObject &record)
+{
+    if (record.value(QLatin1String(idKey)).toString() !=
+        QLatin1String(geckoId)) {
+        return false;
+    }
+    const QJsonValue type = record.value(QLatin1String(typeKey));
+    return type.isUndefined() || type.toString() == QLatin1String(themeType);
+}
+
+}
+
+AddonState
+addonState(const QString &dir)
+{
+    const QString path = dir + QLatin1Char('/') +
+        QString::fromLatin1(stateName);
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly)) {
+        // A file that is not there is the add-on free flow, and a file that
+        // the reader cannot open takes the keep arm.
+        return QFile::exists(path) ? AddonState::Unknown : AddonState::NoAddon;
+    }
+    QJsonParseError error;
+    const QJsonDocument doc = QJsonDocument::fromJson(file.readAll(), &error);
+    if (error.error != QJsonParseError::NoError) {
+        return AddonState::Unknown;
+    }
+    if (!doc.isObject()) {
+        // A file that parses and holds no object is a format change, and a
+        // format change takes the add-on free flow.
+        return AddonState::NoAddon;
+    }
+    const QJsonValue addons = doc.object().value(QLatin1String(addonsKey));
+    if (!addons.isArray()) {
+        return AddonState::NoAddon;
+    }
+    const QJsonArray records = addons.toArray();
+    bool found = false;
+    bool active = false;
+    for (qsizetype i = 0;i < records.size();++i) {
+        const QJsonValue entry = records.at(i);
+        if (!entry.isObject()) {
+            continue;
+        }
+        const QJsonObject record = entry.toObject();
+        if (!matches(record)) {
+            continue;
+        }
+        const bool visible = record.value(QLatin1String(visibleKey)).toBool();
+        if (found && !visible) {
+            continue;
+        }
+        found = true;
+        active = record.value(QLatin1String(activeKey)).toBool();
+        if (visible) {
+            break;
+        }
+    }
+    if (!found) {
+        return AddonState::NoAddon;
+    }
+    return active ? AddonState::Active : AddonState::Inactive;
+}
+
+}
+}
