index 00000000..42efc498
--- /dev/null
+++ b/firefox/check/assert-ff-state.sh
@@ -0,0 +1,246 @@
+#!/bin/sh
+# assert-ff-state.sh WRITER WORKDIR ID: the writer must follow the add-on state
+# of each profile. The run holds nine profiles under one root, and eight of
+# them carry a state file of their own shape. A profile that holds the
+# identifier ID in a not active state loses the sheet, and every other shape
+# keeps the add-on free flow. The state files keep their bytes, because the
+# writer reads them and never writes them. HOME, XDG_CONFIG_HOME and
+# QTCURVE_CONFIG_DIR point into WORKDIR, because the writer rewrites the files
+# of the caller.
+set -eu
+ulimit -c 0
+usage='usage: assert-ff-state.sh WRITER WORKDIR ID'
+writer=${1:?$usage}
+work=${2:?$usage}
+id=${3:?$usage}
+
+# A relative path leaves XDG_CONFIG_HOME outside the root of the file system.
+# The library of the writer then reads the configuration home of the caller.
+# The run therefore takes an absolute path of its own.
+case $work in
+    /*) ;;
+    *) work=$PWD/$work;;
+esac
+
+owned=chrome/qtcurve-userChrome.css
+shared=chrome/userChrome.css
+state=extensions.json
+pref=toolkit.legacyUserProfileCustomizations.stylesheets
+home=$work/home
+root=$home/.config/mozilla/firefox
+qtc=$home/qtcurve
+status=0
+
+# The nine arms of the predicate, in the order of the profiles.ini file. The
+# arm absent holds no state file, and the other eight hold one each.
+arms='active inactive absent unparseable-held unparseable-bare unknown-schema
+      missing-array other-id array-shape'
+
+# The seed of a held sheet. The writer emits no such line, so a byte compare
+# tells a keep from a rewrite.
+seed='/* the seed of assert-ff-state.sh, which the writer never writes */'
+
+fail() {
+    echo "assert-ff-state: $1" >&2
+    status=1
+}
+
+# gate VALUE: writes the settings file of the user with the key of the gate at
+# VALUE. The two files differ in that one row.
+gate() {
+    printf '[Settings]\nappearance=gradient\nfirefoxTheme=%s\n' "$1" \
+        > "$qtc/stylerc"
+}
+
+# record ID ACTIVE DISABLED: prints one theme record of a state file. Firefox
+# writes the same fields, and the reader takes the field active alone.
+record() {
+    printf '{"id":"%s","type":"theme","active":%s,"userDisabled":%s,' \
+        "$1" "$2" "$3"
+    printf '"visible":true,"location":"app-system-share"}'
+}
+
+# write_state NAME SCHEMA BODY: writes the state file of the profile NAME, with
+# the schema version SCHEMA and the array body BODY.
+write_state() {
+    printf '{"schemaVersion":%s,"addons":[%s]}\n' "$2" "$3" \
+        > "$root/$1/$state"
+}
+
+# seed_sheet NAME: writes the seed into the owned sheet of the profile NAME.
+seed_sheet() {
+    printf '%s\n' "$seed" > "$root/$1/$owned"
+}
+
+# run NAME ARGS...: runs the writer over the private home, and holds the exit
+# code in the variable code.
+run() {
+    r_name=$1
+    shift
+    code=0
+    HOME=$home XDG_CONFIG_HOME=$home/.config QTCURVE_CONFIG_DIR=$qtc \
+        "$writer" "$@" > "$work/$r_name.log" 2>&1 || code=$?
+    [ "$code" -eq 0 ] || fail "the pass $r_name gave the code $code"
+}
+
+# count PATTERN LOG: prints the count of the lines of LOG that hold PATTERN.
+count() {
+    n=$(grep -cF "$1" "$2") || n=0
+    printf '%s\n' "$n"
+}
+
+# has NAME WANT: reads the owned sheet of the profile NAME against WANT, which
+# is yes or no.
+has() {
+    if [ "$2" = yes ]; then
+        [ -s "$root/$1/$owned" ] || fail "the profile $1 holds no owned sheet"
+    elif [ -e "$root/$1/$owned" ]; then
+        fail "the profile $1 keeps an owned sheet"
+    fi
+}
+
+# save_states: copies every state file, for the byte compare after a pass.
+save_states() {
+    for arm in $arms; do
+        if [ -f "$root/$arm/$state" ]; then
+            cp "$root/$arm/$state" "$work/$arm.want"
+        fi
+    done
+}
+
+# same_states PASS: the writer reads the state files and never writes them, so
+# each one must hold the bytes of its copy after the pass PASS.
+same_states() {
+    for arm in $arms; do
+        if [ -f "$work/$arm.want" ]; then
+            cmp -s "$root/$arm/$state" "$work/$arm.want" ||
+                fail "the pass $1 moved a byte of the state file of $arm"
+        fi
+    done
+    if [ -e "$root/absent/$state" ]; then
+        fail "the pass $1 made a state file in the profile absent"
+    fi
+}
+
+rm -rf "$work"
+mkdir -p "$qtc"
+for arm in $arms; do
+    mkdir -p "$root/$arm/chrome"
+done
+{
+    i=0
+    for arm in $arms; do
+        printf '[Profile%s]\nName=%s\nIsRelative=1\nPath=%s\n\n' \
+            "$i" "$arm" "$arm"
+        i=$((i + 1))
+    done
+} > "$root/profiles.ini"
+
+# The nine fixtures. The arm active holds the theme as the active theme, and
+# the arms inactive and unknown-schema hold it in a not active state.
+write_state active 37 "$(record "$id" true false)"
+write_state inactive 37 "$(record "$id" false true)"
+write_state unknown-schema 99 "$(record "$id" false true)"
+write_state other-id 37 "$(record other-theme@example.invalid false true)"
+printf '{"schemaVersion":37}\n' > "$root/missing-array/$state"
+printf '{"schemaVersion":37,"addons":[{"id":' \
+    > "$root/unparseable-held/$state"
+cp "$root/unparseable-held/$state" "$root/unparseable-bare/$state"
+
+# The arm array-shape holds a top level JSON array, which parses and is no
+# object. The array carries the not active record, so a reader that takes a
+# record out of any shape removes the sheet and fails this arm.
+printf '[%s]\n' "$(record "$id" false true)" > "$root/array-shape/$state"
+
+# The arm inactive starts with the whole state of a written profile. The pass
+# below must take the sheet and the import line, and it must keep the foreign
+# line.
+seed_sheet inactive
+seed_sheet unparseable-held
+seed_sheet unknown-schema
+printf '@import "qtcurve-userChrome.css";\n#nav-bar { min-height: 40px; }\n' \
+    > "$root/inactive/$shared"
+cp "$root/unparseable-held/$owned" "$work/held.want"
+save_states
+
+# 1. One pass over the nine arms, with the key of the gate true.
+gate true
+run first --write
+has active yes
+grep -qF 'qtcurve-userChrome.css' "$root/active/$shared" ||
+    fail "the arm active merged no import line"
+has inactive no
+if grep -qF 'qtcurve-userChrome.css' "$root/inactive/$shared"; then
+    fail "the arm inactive kept the import line"
+fi
+grep -qF '#nav-bar' "$root/inactive/$shared" ||
+    fail "the arm inactive dropped the foreign line"
+has absent yes
+cmp -s "$root/unparseable-held/$owned" "$work/held.want" ||
+    fail "the arm unparseable-held lost the bytes of its sheet"
+has unparseable-bare no
+has unknown-schema no
+has missing-array yes
+has other-id yes
+has array-shape yes
+grep -qF 'qtcurve-userChrome.css' "$root/array-shape/$shared" ||
+    fail "the arm array-shape merged no import line"
+
+# The arm inactive takes one transition line and no notice of about:config,
+# because the pass removes that profile and never writes it.
+n=$(count "the profile $root/inactive holds the QtCurve add-on not active" \
+    "$work/first.log")
+[ "$n" -eq 1 ] || fail "the arm inactive took $n transition lines, and not 1"
+n=$(count "the profile $root/inactive needs $pref" "$work/first.log")
+[ "$n" -eq 0 ] || fail "the arm inactive took $n notices of about:config"
+
+# The sheet of a profile that holds the add-on and the sheet of a profile with
+# no add-on hold the same bytes. One pass writes one sheet body.
+cmp -s "$root/active/$owned" "$root/absent/$owned" ||
+    fail "the sheets of the arms active and absent differ"
+same_states first
+
+# 2. The same pass again. The transition line fires on the transition alone,
+# and a second pass removes nothing more.
+run second --write
+n=$(count 'holds the QtCurve add-on not active' "$work/second.log")
+[ "$n" -eq 0 ] || fail "the second pass printed $n transition lines, and not 0"
+n=$(count ': removed ' "$work/second.log")
+[ "$n" -eq 0 ] || fail "the second pass removed $n files, and not 0"
+has active yes
+has inactive no
+has absent yes
+has unknown-schema no
+# The arm array-shape holds the sheet of the first pass. That is the other
+# direction of the arm: a pass writes a bare profile, and a pass keeps a held
+# profile.
+has array-shape yes
+cmp -s "$root/unparseable-held/$owned" "$work/held.want" ||
+    fail "the second pass moved a byte of the sheet of unparseable-held"
+same_states second
+
+# The control below runs the same fixtures with --force, which takes the state
+# read out of the pass. The two held profiles must take the sheet, so a writer
+# that reads the state under --force fails here.
+run forced --write --force
+has inactive yes
+has unknown-schema yes
+same_states forced
+
+# The control below makes the record of the arm inactive active, and one plain
+# pass must bring the sheet back. A reader that latches the remove fails here,
+# and so does a reader that holds the state of an earlier pass.
+rm -f "$root/inactive/$owned"
+write_state inactive 37 "$(record "$id" true false)"
+cp "$root/inactive/$state" "$work/inactive.want"
+run flipped --write
+has inactive yes
+same_states flipped
+
+if [ $status -eq 0 ]; then
+    echo "assert-ff-state: the 9 arms of the predicate held, the 8 state" \
+         "files kept their bytes over 4 passes, the not active arm took 1" \
+         "transition line and 0 notices, --force wrote the 2 held profiles," \
+         "and the flip brought the sheet back"
+fi
+exit $status
