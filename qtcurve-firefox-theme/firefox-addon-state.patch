+#ifndef QTC_FIREFOX_STATE_H
+#define QTC_FIREFOX_STATE_H
+
+#include <QString>
+
+namespace QtCurve {
+namespace Firefox {
+
+/**
+ * The name of the file of a profile that holds the add-on records. The watch
+ * mode holds the same name in its path set, and state.cpp is the one reader.
+ */
+extern const char *const stateName;
+
+/** The add-on state of one profile, which one write pass reads. */
+enum class AddonState {
+    /** The profile holds no record of the static theme. */
+    NoAddon,
+    /** The profile holds the static theme as the active theme. */
+    Active,
+    /** The profile holds the static theme in a not active state. */
+    Inactive,
+    /**
+     * The state file does not open, or the bytes do not parse as JSON, and
+     * the pass keeps the files of the profile.
+     */
+    Unknown,
+};
+
+/**
+ * Reads the extensions.json file of the profile dir and returns the add-on
+ * state of the static theme. The reader never writes the file.
+ *
+ * \param dir the profile directory.
+ * \return the state of the record with the identifier of the static theme. A
+ *     present file that does not open or parse gives Unknown, and every other
+ *     file with no record gives NoAddon.
+ */
+AddonState addonState(const QString &dir);
+
+}
+}
+
+#endif
