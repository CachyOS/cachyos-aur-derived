+          "${qtc_cover_dir}/scrollbar" "${qtc_light}" "${qtc_distinct}"
+  VERBATIM)
+
 # Every check above reads a sheet as text. The check below reads one in GTK 3
 # itself. It builds a menu bar with an open menu. It then reads the node path,
 # the caption colour and the box of each state that the toolkit gives. A text
diff --git a/gtk4/check/assert-scrollbar.sh b/gtk4/check/assert-scrollbar.sh
new file mode 100644
index 00000000..7448af82
--- /dev/null
+++ b/gtk4/check/assert-scrollbar.sh
@@ -0,0 +1,461 @@
+#!/bin/sh
+# assert-scrollbar.sh WRITER WORKDIR SCHEME DISTINCT: the scroll bar rules of
+# the widget must hold the colours that the Qt style paints. The thumb must
+# take the ladder of Style::sliderColors() under each slider key and one
+# highlight step of that ladder under the pointer. The groove must take step
+# two of the base ladder under every groove key. Each border must take the
+# border step of the ladder of its own fill. The run writes one settings file
+# and one sheet for each arm under WORKDIR, over the colour file SCHEME and
+# over the colour file DISTINCT. It then breaks one contract in a copy of an
+# arm, and it fails if the check passes the broken copy.
+set -eu
+usage='usage: assert-scrollbar.sh WRITER WORKDIR SCHEME DISTINCT'
+writer=${1:?$usage}
+work=${2:?$usage}
+scheme=${3:?$usage}
+distinct=${4:?$usage}
+
+# A relative path leaves the sheets outside the directory that the caller
+# names, because the writer runs in a directory of its own.
+case $work in
+    /*) ;;
+    *) work=$PWD/$work;;
+esac
+
+# The four rules of the scroll bar, as Writer::scrollBar() names them. A rule
+# of the widget carries no rank guard, so each selector below is the whole
+# selector line of the sheet.
+bar='scrollbar, scrollbar > range'
+trough='scrollbar > range > trough, scrollbar trough'
+thumb='scrollbar > range > trough > slider, scrollbar slider'
+grab='scrollbar > range > trough > slider:hover, scrollbar slider:hover'
+# The trough of a level bar, which holds step two of the window ladder. The
+# fix moves the scroll bar trough off that ladder, so the two rules must hold
+# two values in every sheet.
+anchor='levelbar > trough, levelbar trough'
+# The scroll bar block of the browser, which the GTK 3 sheet carries only
+# where the writer emits that block.
+moz='#MozillaGtkWidget scrollbar'
+
+# The colour names of the three roles that the rules read.
+base='@theme_base_color_breeze'
+button='@theme_button_background_normal_breeze'
+selected='@theme_selected_bg_color_breeze'
+# The border of the trough, which takes the border step of the base ladder.
+edge="1px solid shade($base, 0.750)"
+# The colour of the custom arm, which the rest row must carry byte for byte.
+custom='#ff8800'
+
+# Every arm of the light scheme, in the order that the run writes them. The
+# last two arms take no colour name. The noborder arm drops the border of the
+# trough, and the hsv arm writes a literal for every shaded tone.
+arms='none darken selected blend custom mo slapp app thin wide page corner
+      square noborder hsv'
+# The arms that hold a colour name in the trough rule.
+namearms='none darken selected blend custom mo slapp app thin wide page corner
+          square noborder'
+# The arms that hold the border of the trough on a colour name.
+edgearms='none darken selected blend custom mo slapp app thin wide page corner
+          square'
+# The arms of the distinct scheme, where no two roles share a value.
+darms='none blend hsv'
+
+rm -rf "$work"
+mkdir -p "$work/arm" "$work/broken"
+
+# settings NAME BODY: writes the settings file of the arm NAME, which holds
+# the keys of BODY over the shipped preset. BODY carries one escape of a new
+# line for each key.
+settings() {
+    printf '[Settings]\n%b' "$2" > "$work/$1.qtcurve"
+}
+
+# sheet NAME SETTINGS DIALECT COLOURS: writes the sheet of the arm NAME from
+# the settings file SETTINGS, in the dialect DIALECT, over the colour file
+# COLOURS.
+sheet() {
+    "$writer" --stdout --force --settings "$work/$2.qtcurve" \
+        --scheme "$4" --dialect "$3" --asset-base "../assets/" \
+        --out "$work/arm/$1.css"
+}
+
+# The five slider keys, one arm each. The reader takes a colour value of the
+# key as the custom colour of the slider.
+settings none 'shadeSliders=none\n'
+settings darken 'shadeSliders=darken\n'
+settings selected 'shadeSliders=origselected\n'
+settings blend 'shadeSliders=selected\n'
+settings custom "shadeSliders=$custom\\n"
+# The pointer key, which the reader keeps under the three ladder keys alone.
+settings mo 'shadeSliders=origselected\ncolorSliderMouseOver=true\n'
+# The two gradient arms. The slapp arm moves the thumb key alone and the app
+# arm moves the general key alone. A writer that reads the wrong field
+# therefore fails one of the two.
+settings slapp 'sliderAppearance=shinyglass\n'
+settings app 'appearance=shinyglass\n'
+# The five groove arms, which hold the four corners of the groove keys and the
+# square corner of no button. No one of them may move the trough of the bar.
+settings thin 'flatSbarButtons=true\nthinSbarGroove=true\n'
+settings wide 'flatSbarButtons=true\nthinSbarGroove=false\n'
+settings page 'flatSbarButtons=false\nthinSbarGroove=true\n'
+settings corner 'flatSbarButtons=false\nthinSbarGroove=true\nscrollbarType=none\n'
+settings square \
+    'flatSbarButtons=false\nthinSbarGroove=true\nscrollbarType=none\nround=none\n'
+# The border key of the groove, which drops the border of the trough.
+settings noborder 'borderSbarGroove=false\n'
+# The shading model of the sheet. The GTK function shade() computes the HSL
+# model alone, so another model gives a literal for every shaded tone. Each
+# seed then stands as a byte that a reader can measure.
+settings hsv 'shading=hsv\n'
+
+for arm in $arms; do
+    sheet "$arm" "$arm" gtk3 "$scheme"
+done
+# The GTK 4 sheets of two arms. The hsv sheet pins the form of the two rows
+# that the custom property names carry.
+sheet gtk4 none gtk4 "$scheme"
+sheet gtk4-hsv hsv gtk4 "$scheme"
+# The three arms of the distinct scheme, where the window colour, the base
+# colour and the button colour stand far apart.
+for arm in $darms; do
+    sheet "d-$arm" "$arm" gtk3 "$distinct"
+done
+
+# row DIR ARM SELECTOR PROP: prints the value of the property PROP of the rule
+# SELECTOR in the sheet of ARM under DIR. It prints nothing for a rule or a
+# property that the sheet does not hold.
+row() {
+    r_sel=$(printf '%s' "$3" | sed 's/[]\/$*.^[]/\\&/g')
+    sed -n "/^$r_sel {\$/,/^}\$/p" "$1/$2.css" |
+        sed -n "s/^  $4: \(.*\);\$/\1/p"
+}
+
+# check DIR: gives 0 while the ten contracts hold over the arm sheets of DIR.
+# It names the first contract that fails on the standard error.
+check() {
+    d=$1
+
+    # 1. Each sheet of the run holds the four rules of the scroll bar, and
+    # each rule holds a ground. This is the guard against an empty read.
+    for c_arm in $arms gtk4 gtk4-hsv d-none d-blend d-hsv; do
+        for c_sel in "$bar" "$trough" "$thumb" "$grab"; do
+            if [ -z "$(row "$d" "$c_arm" "$c_sel" background-color)" ]; then
+                echo "assert-scrollbar: $c_arm holds no rule '$c_sel'" >&2
+                return 1
+            fi
+        done
+    done
+
+    # 2. The five slider keys give five colours of their own, and each one
+    # takes the ladder that Style::sliderColors() holds.
+    c_none=$(row "$d" none "$thumb" background-color)
+    c_darken=$(row "$d" darken "$thumb" background-color)
+    c_sel=$(row "$d" selected "$thumb" background-color)
+    c_blend=$(row "$d" blend "$thumb" background-color)
+    c_custom=$(row "$d" custom "$thumb" background-color)
+    if [ "$c_none" != "$button" ]; then
+        echo "assert-scrollbar: the none arm rests on '$c_none'" >&2
+        return 1
+    fi
+    case $c_darken in
+        "shade($button, "*')') ;;
+        *) echo "assert-scrollbar: the darken arm rests on '$c_darken'" >&2
+           return 1;;
+    esac
+    if [ "$c_sel" != "$selected" ]; then
+        echo "assert-scrollbar: the selected arm rests on '$c_sel'" >&2
+        return 1
+    fi
+    case $c_blend in
+        '#'[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
+        *) echo "assert-scrollbar: the blend arm rests on '$c_blend'" >&2
+           return 1;;
+    esac
+    if [ "$c_custom" != "$custom" ]; then
+        echo "assert-scrollbar: the custom arm rests on '$c_custom'" >&2
+        return 1
+    fi
+    if [ "$(printf '%s\n' "$c_none" "$c_darken" "$c_sel" "$c_blend" \
+            "$c_custom" | sort -u | wc -l)" -ne 5 ]; then
+        echo "assert-scrollbar: two slider keys give one colour" >&2
+        return 1
+    fi
+
+    # 3. Each arm takes a colour of its own for the pointer. A rest row that
+    # follows a colour name takes one highlight step of that name. The
+    # pointer arm of contract 4 moves that name to another ladder.
+    for c_arm in $arms; do
+        c_rest=$(row "$d" "$c_arm" "$thumb" background-color)
+        c_hover=$(row "$d" "$c_arm" "$grab" background-color)
+        if [ "$c_rest" = "$c_hover" ]; then
+            echo "assert-scrollbar: $c_arm holds one colour for two states" \
+                 >&2
+            return 1
+        fi
+        if [ "$c_arm" = mo ]; then
+            continue
+        fi
+        case $c_rest in
+            '@'*|'shade('*)
+                case $c_hover in
+                    "shade($c_rest, "*')') ;;
+                    *) echo "assert-scrollbar: $c_arm moves the pointer to" \
+                            "'$c_hover' over '$c_rest'" >&2
+                       return 1;;
+                esac;;
+        esac
+    done
+
+    # 4. The pointer key moves the rest row to the button ladder and it keeps
+    # the hover row on the slider ladder.
+    if [ "$(row "$d" mo "$thumb" background-color)" != "$c_none" ]; then
+        echo "assert-scrollbar: the pointer key holds the rest row" >&2
+        return 1
+    fi
+    if [ "$(row "$d" mo "$grab" background-color)" != \
+         "$(row "$d" selected "$grab" background-color)" ]; then
+        echo "assert-scrollbar: the pointer key moves the hover row" >&2
+        return 1
+    fi
+
+    # 5. The gradient of the thumb follows the thumb key of the settings. The
+    # general key of the appearance leaves that gradient alone.
+    c_img=$(row "$d" none "$thumb" background-image)
+    if [ "$(row "$d" slapp "$thumb" background-image)" = "$c_img" ]; then
+        echo "assert-scrollbar: the thumb key holds the gradient" >&2
+        return 1
+    fi
+    if [ "$(row "$d" app "$thumb" background-image)" != "$c_img" ]; then
+        echo "assert-scrollbar: the general key moves the gradient" >&2
+        return 1
+    fi
+
+    # 6. The trough takes one step of the base ladder under every key of the
+    # settings. It never takes the window ladder that the level bar holds.
+    for c_arm in $namearms; do
+        c_gnd=$(row "$d" "$c_arm" "$trough" background-color)
+        case $c_gnd in
+            "shade($base, "*')') ;;
+            *) echo "assert-scrollbar: $c_arm grounds the trough on" \
+                    "'$c_gnd'" >&2
+               return 1;;
+        esac
+    done
+    if [ "$(for c_arm in $namearms; do
+                row "$d" "$c_arm" "$trough" background-color
+            done | sort -u | wc -l)" -ne 1 ]; then
+        echo "assert-scrollbar: a key of the settings moves the trough" >&2
+        return 1
+    fi
+    for c_arm in $arms gtk4 gtk4-hsv d-none d-blend d-hsv; do
+        if [ "$(row "$d" "$c_arm" "$trough" background-color)" = \
+             "$(row "$d" "$c_arm" "$anchor" background-color)" ]; then
+            echo "assert-scrollbar: the trough of $c_arm holds the window" \
+                 "ladder of the level bar" >&2
+            return 1
+        fi
+    done
+    # The distinct scheme gives the window colour, the base colour and the
+    # button colour three values that stand far apart. The hsv arm writes each
+    # one as a literal, so the three seeds read as three bytes.
+    if [ "$(printf '%s\n' "$(row "$d" d-hsv "$trough" background-color)" \
+            "$(row "$d" d-hsv "$anchor" background-color)" \
+            "$(row "$d" d-hsv "$thumb" background-color)" |
+            sort -u | wc -l)" -ne 3 ]; then
+        echo "assert-scrollbar: two seeds of the distinct scheme give one" \
+             "colour" >&2
+        return 1
+    fi
+
+    # 7. The border of the trough takes the border step of the base ladder,
+    # and the border key of the groove drops it.
+    for c_arm in $edgearms; do
+        if [ "$(row "$d" "$c_arm" "$trough" border)" != "$edge" ]; then
+            echo "assert-scrollbar: the trough of $c_arm borders on" \
+                 "'$(row "$d" "$c_arm" "$trough" border)'" >&2
+            return 1
+        fi
+    done
+    if [ "$(row "$d" noborder "$trough" border)" != none ]; then
+        echo "assert-scrollbar: the noborder arm keeps the border of the" \
+             "trough" >&2
+        return 1
+    fi
+
+    # 8. The border of the thumb takes the border step of the ladder of its
+    # own fill. The style passes one colour array to the fill and to the
+    # border of a box.
+    for c_pair in "none:$button" "darken:$button" "mo:$button" \
+                  "selected:$selected"; do
+        c_arm=${c_pair%%:*}
+        c_name=${c_pair#*:}
+        if [ "$(row "$d" "$c_arm" "$thumb" border)" != \
+             "1px solid shade($c_name, 0.750)" ]; then
+            echo "assert-scrollbar: the thumb of $c_arm borders on" \
+                 "'$(row "$d" "$c_arm" "$thumb" border)'" >&2
+            return 1
+        fi
+    done
+    for c_arm in blend custom; do
+        case $(row "$d" "$c_arm" "$thumb" border) in
+            '1px solid #'[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
+            *) echo "assert-scrollbar: the thumb of $c_arm borders on" \
+                    "'$(row "$d" "$c_arm" "$thumb" border)'" >&2
+               return 1;;
+        esac
+    done
+
+    # 9. The hsv arm follows no colour name. The sheet of GTK 4 must carry
+    # the thumb under the name of a literal and the trough under the plain
+    # name. A rewrite that drops the cover test moves the thumb row to the
+    # plain name.
+    case $(row "$d" gtk4-hsv "$thumb" background-color) in
+        'var(--qtc-sbar-slider-bg-fixed, #'[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]')') ;;
+        *) echo "assert-scrollbar: the hsv arm rests on" \
+                "'$(row "$d" gtk4-hsv "$thumb" background-color)'" >&2
+           return 1;;
+    esac
+    case $(row "$d" gtk4-hsv "$trough" background-color) in
+        'var(--qtc-sbar-trough-bg, #'[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]')') ;;
+        *) echo "assert-scrollbar: the hsv arm grounds the trough on" \
+                "'$(row "$d" gtk4-hsv "$trough" background-color)'" >&2
+           return 1;;
+    esac
+
+    # 10. The block of the browser reads the same helper. Its ground must hold
+    # the trough of the widget, and its rest row must hold the thumb of the
+    # widget. The clause holds only where the sheet carries that block, which
+    # assert-browser.sh reads. The rest clause reads the arms 1 to 14. Under
+    # the hsv arm the widget rest row writes the literal of its cover branch
+    # and the block writes the colour name. The two spellings give one colour.
+    if [ -n "$(row "$d" none "$moz" background-color)" ]; then
+        for c_arm in $arms; do
+            if [ "$(row "$d" "$c_arm" "$moz" background-color)" != \
+                 "$(row "$d" "$c_arm" "$trough" background-color)" ]; then
+                echo "assert-scrollbar: the block of $c_arm grounds apart" \
+                     "from the trough of the widget" >&2
+                return 1
+            fi
+        done
+        for c_arm in $namearms; do
+            if [ "$(row "$d" "$c_arm" "$moz slider" background-color)" != \
+                 "$(row "$d" "$c_arm" "$thumb" background-color)" ]; then
+                echo "assert-scrollbar: the block of $c_arm rests apart" \
+                     "from the thumb of the widget" >&2
+                return 1
+            fi
+        done
+    fi
+    return 0
+}
+
+if ! check "$work/arm"; then
+    echo "assert-scrollbar: the arms fail the check" >&2
+    exit 1
+fi
+
+# The controls below. Each one breaks one contract in a copy of the arms, and
+# the check must fail over that copy.
+broken=0
+
+# control NAME: the check must fail over the copy under the broken directory.
+control() {
+    if check "$work/broken" 2> "$work/control.log"; then
+        echo "assert-scrollbar: the check passed the broken copy of $1" >&2
+        exit 1
+    fi
+    broken=$((broken + 1))
+}
+
+# paste ARM SELECTOR PROP VALUE: writes the copy of the arms with the property
+# PROP of the rule SELECTOR of ARM at VALUE.
+paste() {
+    rm -rf "$work/broken"
+    cp -r "$work/arm" "$work/broken"
+    awk -v want="$2 {" -v prop="  $3: " -v val="$4" '
+        $0 == want { in_rule = 1 }
+        in_rule && index($0, prop) == 1 { print prop val ";"; next }
+        in_rule && $0 == "}" { in_rule = 0 }
+        { print }' "$work/arm/$1.css" > "$work/broken/$1.css"
+}
+
+# The thumb rule cut out of one arm, which is the sheet of a writer that
+# writes no rule of the thumb.
+rm -rf "$work/broken"
+cp -r "$work/arm" "$work/broken"
+t_sel=$(printf '%s' "$thumb" | sed 's/[]\/$*.^[]/\\&/g')
+sed "/^$t_sel {\$/,/^}\$/d" "$work/arm/none.css" > "$work/broken/none.css"
+control 'the thumb rule of an arm'
+
+# The rest row of the darken arm at the colour of the none arm, which drops
+# the darker pair of ladder steps.
+paste darken "$thumb" background-color "$button"
+control 'the ladder of the darken arm'
+
+# The rest row of the blend arm at a colour name, which is the row that the
+# tree of the defect writes.
+paste blend "$thumb" background-color "$button"
+control 'the literal of the blend arm'
+
+# The colour of the custom arm at another value, which is a doctored sheet.
+paste custom "$thumb" background-color '#ff0000'
+control 'the colour of the custom arm'
+
+# The hover row at the rest row, which drops the step of the pointer.
+paste selected "$grab" background-color "$selected"
+control 'the step of the pointer'
+
+# The rest row of the pointer arm at the slider ladder, which is the row of
+# the arm that holds the key at false.
+paste mo "$thumb" background-color "$selected"
+control 'the rest row of the pointer key'
+
+# The gradient of the thumb key arm at the gradient of the none arm. That
+# sheet comes from a writer that reads the general key of the appearance.
+paste slapp "$thumb" background-image \
+    "$(row "$work/arm" none "$thumb" background-image)"
+control 'the gradient of the thumb key'
+
+# The trough of one arm on the window ladder, which is the ladder of the tree
+# of the defect.
+paste thin "$trough" background-color 'shade(@theme_bg_color_breeze, 0.900)'
+control 'the ladder of the trough'
+
+# The trough of the hsv arm at the level bar of the same sheet, which holds
+# the window ladder as a literal.
+paste hsv "$trough" background-color \
+    "$(row "$work/arm" hsv "$anchor" background-color)"
+control 'the seed of the trough'
+
+# The border of the noborder arm at a line, which the border key drops.
+paste noborder "$trough" border "$edge"
+control 'the border key of the groove'
+
+# The border of the thumb of the selected arm on the button ladder, which is
+# the border of another fill.
+paste selected "$thumb" border "1px solid shade($button, 0.750)"
+control 'the border of the thumb'
+
+# The thumb of the hsv arm under the plain name, which is the row of a writer
+# that drops the cover test.
+paste gtk4-hsv "$thumb" background-color 'var(--qtc-sbar-slider-bg, #d6d86d)'
+control 'the name of the literal'
+
+# The ground of the block of the browser at another value. The block stands in
+# the sheet only where the writer emits it.
+if [ -n "$(row "$work/arm" none "$moz" background-color)" ]; then
+    paste none "$moz" background-color '@theme_base_color_breeze'
+    control 'the ground of the block of the browser'
+    blocked='it holds the block of the browser on the same derivation,'
+else
+    blocked='the sheets hold no block of the browser,'
+fi
+
+rm -rf "$work/broken"
+echo "assert-scrollbar: the four rules stand in $(echo $arms | wc -w) arms of" \
+     "the light scheme, in $(echo $darms | wc -w) arms of the distinct" \
+     "scheme and in 2 sheets of GTK 4, the thumb holds the five slider keys," \
+     "the pointer key and the thumb key of the gradient, the trough holds one" \
+     "step of the base ladder under every key and never the window ladder of" \
+     "the level bar, each border holds the ladder of its own fill," \
+     "$blocked and the check rejects each of the $broken control copies"
diff --git a/gtk4/check/paths.txt b/gtk4/check/paths.txt
index 19b58088..fbac66e4 100644
--- a/gtk4/check/paths.txt
+++ b/gtk4/check/paths.txt
@@ -290,7 +290,7 @@ follow | theme_bg_color_breeze | window.background levelbar trough | - |
 follow | theme_bg_color_breeze | window.background levelbar block.empty | - |
 follow | theme_bg_color_breeze | window.background progressbar trough | - |
 follow | theme_bg_color_breeze | window.background scrollbar | - |
