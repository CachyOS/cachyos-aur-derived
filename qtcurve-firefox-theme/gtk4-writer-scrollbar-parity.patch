+ScrollSpec
+scrollSpec(const Options &opts, const Palette &pal)
+{
+    // Style::sliderColors() holds the button ladder while the settings build
+    // no thumb ladder, and Style::getFill() takes the darker pair of steps
+    // under SHADE_DARKEN alone. Every other value of the key, such as
+    // SHADE_WINDOW_BORDER, reaches the same default arm as SHADE_NONE.
+    Role role = Role::Button;
+    QColor seed;
+    int rest = ORIGINAL_SHADE;
+    int hover = SHADE_ORIG_HIGHLIGHT;
+    switch (opts.shadeSliders) {
+    case SHADE_DARKEN:
+        rest = 2;
+        hover = SHADE_2_HIGHLIGHT;
+        break;
+    case SHADE_SELECTED:
+        role = Role::Highlight;
+        break;
+    case SHADE_BLEND_SELECTED:
+        role = Role::None;
+        seed = midColor(pal.highlight, pal.button);
+        break;
+    case SHADE_CUSTOM:
+        role = Role::None;
+        seed = opts.customSlidersColor;
+        break;
+    default:
+        break;
+    }
+
+    ScrollSpec spec;
+    spec.rest = ScrollTone { role, seed, rest };
+    spec.hover = ScrollTone { role, seed, hover };
+    // Style::sliderColors() gives the thumb ladder to the pointer alone under
+    // colorSliderMouseOver. The reader clears that key under SHADE_NONE and
+    // SHADE_DARKEN, whose ladder is the button ladder already.
+    if (opts.colorSliderMouseOver) {
+        spec.rest = ScrollTone { Role::Button, QColor(), ORIGINAL_SHADE };
+    }
+
+    // Every groove path of Style::drawComplexControl() paints the visible
+    // groove at the step 2 of a shade ladder, so the track holds that step
+    // under every setting. The ladder of the base colour carries it.
+    spec.track = ScrollTone { Role::Base, QColor(), 2 };
+    return spec;
+}
+
+QColor
+scrollColour(const Options &opts, const Palette &pal, const ScrollTone &t)
+{
+    if (t.step < 0 || t.step > TOTAL_SHADES) {
+        failUnknown("Shade", t.step);
+        return QColor();
+    }
+    switch (t.role) {
+    case Role::None: {
+        Shades own;
+        shadeLadder(opts, t.seed, own);
+        return own[t.step];
+    }
+    case Role::Base:
+        return pal.bgnd[t.step];
+    case Role::Button:
+        return pal.btn[t.step];
+    case Role::Highlight:
+        return pal.hl[t.step];
+    default:
+        break;
+    }
+    failUnknown("Role", int(t.role));
+    return QColor();
+}
+
