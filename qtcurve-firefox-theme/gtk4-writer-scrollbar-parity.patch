+/** One colour of a scroll bar: a shade ladder and one step of that ladder. */
+struct ScrollTone {
+    /** Role of the ladder, or Role::None for a ladder of the seed colour. */
+    Role role;
+    /** Seed colour of the ladder while role is Role::None. */
+    QColor seed;
+    /** Step of the ladder, from 0 to TOTAL_SHADES. */
+    int step;
+};
+
+/** The three colours that a browser reads off the scroll bar of a theme. */
+struct ScrollSpec {
+    /** Colour of the thumb while the pointer stands off it. */
+    ScrollTone rest;
+    /** Colour of the thumb under the pointer and under the button. */
+    ScrollTone hover;
+    /** Colour of the ground of the bar, which a browser takes as the track. */
+    ScrollTone track;
+};
+
+/**
+ * Returns the scroll bar colours of the settings opts and the palette pal.
+ * Style::drawSbSliderHandle() paints the thumb of Qt from the two thumb
+ * tones, and the groove arm of Style::drawComplexControl() paints the bar of
+ * Qt from the track tone.
+ */
+ScrollSpec scrollSpec(const Options &opts, const Palette &pal);
+
+/**
+ * Returns the colour of the scroll bar tone t. A tone of the role None takes
+ * the ladder that shadeLadder() builds over the seed of the tone, and a step
+ * or a role outside the contract of ScrollTone gives exit code 5 and an
+ * invalid colour.
+ */
+QColor scrollColour(const Options &opts, const Palette &pal,
+                    const ScrollTone &t);
