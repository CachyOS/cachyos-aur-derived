diff --git a/firefox/check/assert-ff-content.sh b/firefox/check/assert-ff-content.sh
new file mode 100644
index 00000000..e4d28540
--- /dev/null
+++ b/firefox/check/assert-ff-content.sh
@@ -0,0 +1,278 @@
+#!/bin/sh
+# assert-ff-content.sh WRITER WORKDIR LIGHT DARK: the owned content sheet must
+# hold the header line of the writer and one universal rule of one
+# declaration. The rule states two literal colours under !important. The
+# sheet must carry no width row, no custom property and no other property.
+# The pair must follow the slider keys. It must hold one track under every
+# key. It must equal the pair of the sidebar rule of the chrome sheet of the
+# same settings. The run writes one settings file, one content sheet and one
+# chrome sheet for each arm under WORKDIR, over the colour file LIGHT. It
+# then breaks one contract in a copy of an arm, and it fails if the check
+# passes the broken copy. One control carries the pair of the colour file
+# DARK, which the writer emits.
+set -eu
+usage='usage: assert-ff-content.sh WRITER WORKDIR LIGHT DARK'
+writer=${1:?$usage}
+work=${2:?$usage}
+light=${3:?$usage}
+dark=${4:?$usage}
+
+# A relative path leaves the sheets outside the directory that the caller
+# names, because the writer runs in a directory of its own.
+case $work in
+    /*) ;;
+    *) work=$PWD/$work;;
+esac
+
+# The colour of the custom arm, which the thumb must carry byte for byte.
+custom='#ff8800'
+# The arms of the slider keys and the arms of the groove keys.
+sliders='none darken selected blend custom mo'
+grooves='thin wide page corner square'
+# The count of the lines of a content sheet: the header line, the head of the
+# rule, one declaration and the close of the rule.
+lines=4
+
+rm -rf "$work"
+mkdir -p "$work/arm" "$work/broken"
+
+# settings NAME BODY: writes the settings file of the arm NAME, which holds
+# the keys of BODY over the shipped preset. BODY carries one escape of a new
+# line for each key.
+settings() {
+    printf '[Settings]\n%b' "$2" > "$work/$1.qtcurve"
+}
+
+# sheet NAME: writes the content sheet and the chrome sheet of the arm NAME.
+# The two runs read one settings file, so the two pairs must agree.
+sheet() {
+    "$writer" --stdout-content --force --settings "$work/$1.qtcurve" \
+        --scheme "$light" --out "$work/arm/$1.css"
+    "$writer" --stdout --force --settings "$work/$1.qtcurve" \
+        --scheme "$light" --out "$work/arm/$1.chrome.css"
+}
+
+# The five slider keys, one arm each, and the pointer key.
+settings none 'shadeSliders=none\n'
+settings darken 'shadeSliders=darken\n'
+settings selected 'shadeSliders=origselected\n'
+settings blend 'shadeSliders=selected\n'
+settings custom "shadeSliders=$custom\\n"
+settings mo 'shadeSliders=origselected\ncolorSliderMouseOver=true\n'
+# The five groove arms, which hold the four corners of the groove keys and the
+# square corner of no button. No one of them may move a colour of the pair.
+settings thin 'flatSbarButtons=true\nthinSbarGroove=true\n'
+settings wide 'flatSbarButtons=true\nthinSbarGroove=false\n'
+settings page 'flatSbarButtons=false\nthinSbarGroove=true\n'
+settings corner 'flatSbarButtons=false\nthinSbarGroove=true\nscrollbarType=none\n'
+settings square \
+    'flatSbarButtons=false\nthinSbarGroove=true\nscrollbarType=none\nround=none\n'
+
+for arm in $sliders $grooves; do
+    sheet "$arm"
+done
+
+# The content sheet of the other colour file, which one control below reads.
+# The writer gives that pair, so the control carries no hand written colour.
+"$writer" --stdout-content --force --settings "$work/none.qtcurve" \
+    --scheme "$dark" --out "$work/dark.css"
+
+# rules FILE: prints the count of the heads of the universal rule of FILE.
+rules() {
+    grep -c '^\* {$' "$1" || true
+}
+
+# body FILE: prints the declarations of the universal rule of FILE, and prints
+# nothing for a sheet that holds no such rule.
+body() {
+    sed -n '/^\* {$/,/^}$/p' "$1" | sed '1d;$d'
+}
+
+# pair FILE: prints the thumb colour and the track colour of the universal rule
+# of FILE, with one space between them. It prints nothing while the rule does
+# not hold the exact shape of the contract.
+pair() {
+    body "$1" | sed -n \
+'s/^  scrollbar-color: \(#[0-9a-f]\{6\}\) \(#[0-9a-f]\{6\}\) !important;$/\1 \2/p'
+}
+
+# sidebar FILE: prints the pair of the sidebar rule of the chrome sheet FILE.
+sidebar() {
+    sed -n '/^:root\[lwt-sidebar\] {$/,/^}$/p' "$1" | sed -n \
+'s/^  scrollbar-color: \(#[0-9a-f]\{6\}\) \(#[0-9a-f]\{6\}\) !important;$/\1 \2/p'
+}
+
+# thumb FILE, track FILE: print one half of the pair of the content sheet FILE.
+thumb() {
+    pair "$1" | cut -d' ' -f1
+}
+track() {
+    pair "$1" | cut -d' ' -f2
+}
+
+# check DIR: gives 0 while the six contracts hold over the arm files of DIR. It
+# names the first contract that fails on the standard error.
+check() {
+    d=$1
+
+    # 1. Each arm opens with the header line of its chrome sheet, and it holds
+    # one universal rule of two literal colours under !important.
+    for c_arm in $sliders $grooves; do
+        c_head=$(head -n 1 "$d/$c_arm.css")
+        if [ "$c_head" != "$(head -n 1 "$d/$c_arm.chrome.css")" ]; then
+            echo "assert-ff-content: $c_arm opens with '$c_head'" >&2
+            return 1
+        fi
+        if [ "$(rules "$d/$c_arm.css")" -ne 1 ]; then
+            echo "assert-ff-content: $c_arm holds" \
+                 "$(rules "$d/$c_arm.css") universal rules" >&2
+            return 1
+        fi
+        if [ -z "$(pair "$d/$c_arm.css")" ]; then
+            echo "assert-ff-content: the rule of $c_arm reads" \
+                 "'$(body "$d/$c_arm.css")'" >&2
+            return 1
+        fi
+    done
+
+    # 2. The sheet states the colour pair alone: no custom property, no width
+    # row and no other property of the browser.
+    for c_arm in $sliders $grooves; do
+        if grep -qF -e '--' "$d/$c_arm.css"; then
+            echo "assert-ff-content: $c_arm declares a custom property" >&2
+            return 1
+        fi
+        if grep -qF 'scrollbar-width' "$d/$c_arm.css"; then
+            echo "assert-ff-content: $c_arm declares a width row" >&2
+            return 1
+        fi
+        c_props=$(grep -c '^  [a-z-]*:' "$d/$c_arm.css" || true)
+        if [ "$c_props" -ne 1 ]; then
+            echo "assert-ff-content: $c_arm declares $c_props properties," \
+                 "and not 1" >&2
+            return 1
+        fi
+    done
+
+    # 3. The whole sheet is the header line and that one rule, and the rule
+    # holds one declaration.
+    for c_arm in $sliders $grooves; do
+        c_lines=$(wc -l < "$d/$c_arm.css")
+        if [ "$c_lines" -ne "$lines" ]; then
+            echo "assert-ff-content: $c_arm holds $c_lines lines, and not" \
+                 "$lines" >&2
+            return 1
+        fi
+        if [ "$(body "$d/$c_arm.css" | wc -l)" -ne 1 ]; then
+            echo "assert-ff-content: the rule of $c_arm holds" \
+                 "$(body "$d/$c_arm.css" | wc -l) declarations" >&2
+            return 1
+        fi
+    done
+
+    # 4. The five slider keys give five thumbs of their own. The reader
+    # takes the colour value of the key as the custom colour of the
+    # slider. The pointer key moves the thumb to the button colour.
+    c_none=$(thumb "$d/none.css")
+    c_custom=$(thumb "$d/custom.css")
+    if [ "$c_custom" != "$custom" ]; then
+        echo "assert-ff-content: the custom arm holds the thumb" \
+             "'$c_custom'" >&2
+        return 1
+    fi
+    if [ "$(for c_arm in none darken selected blend custom; do
+                thumb "$d/$c_arm.css"
+            done | sort -u | wc -l)" -ne 5 ]; then
+        echo "assert-ff-content: two slider keys give one thumb" >&2
+        return 1
+    fi
+    if [ "$(thumb "$d/mo.css")" != "$c_none" ]; then
+        echo "assert-ff-content: the pointer key holds the thumb" \
+             "'$(thumb "$d/mo.css")'" >&2
+        return 1
+    fi
+
+    # 5. No key of the settings moves the track, and the five groove keys
+    # leave it alone as well.
+    if [ "$(for c_arm in $sliders $grooves; do track "$d/$c_arm.css"; done |
+            sort -u | wc -l)" -ne 1 ]; then
+        echo "assert-ff-content: a key of the settings moves the track" >&2
+        return 1
+    fi
+
+    # 6. The pair of an arm is the pair of the sidebar rule of the chrome
+    # sheet of that arm. One map gives both rules.
+    for c_arm in $sliders $grooves; do
+        c_want=$(sidebar "$d/$c_arm.chrome.css")
+        if [ -z "$c_want" ]; then
+            echo "assert-ff-content: the chrome sheet of $c_arm holds no" \
+                 "sidebar pair" >&2
+            return 1
+        fi
+        if [ "$(pair "$d/$c_arm.css")" != "$c_want" ]; then
+            echo "assert-ff-content: $c_arm holds the pair" \
+                 "'$(pair "$d/$c_arm.css")' over the sidebar pair" \
+                 "'$c_want'" >&2
+            return 1
+        fi
+    done
+    return 0
+}
+
+if ! check "$work/arm"; then
+    echo "assert-ff-content: the arms fail the check" >&2
+    exit 1
+fi
+
+# The controls below. Each one breaks one contract in a copy of the arms, and
+# the check must fail over that copy.
+broken=0
+
+# control NAME: the check must fail over the copy under the broken directory.
+control() {
+    if check "$work/broken" 2> "$work/control.log"; then
+        echo "assert-ff-content: the check passed the broken copy of $1" >&2
+        exit 1
+    fi
+    broken=$((broken + 1))
+}
+
+# copy: writes a fresh copy of every arm file under the broken directory.
+copy() {
+    rm -rf "$work/broken"
+    cp -r "$work/arm" "$work/broken"
+}
+
+# The rule cut out of one arm, which is the profile before this sheet shipped.
+copy
+sed '/^\* {$/,/^}$/d' "$work/arm/none.css" > "$work/broken/none.css"
+control 'the rule of an arm'
+
+# The pair of the other colour file, which a writer that reads one colour file
+# for the two sheets would give.
+copy
+row="  scrollbar-color: $(pair "$work/dark.css") !important;"
+sed "s/^  scrollbar-color: .*\$/$row/" "$work/arm/none.css" \
+    > "$work/broken/none.css"
+control 'the pair of another colour file'
+
+# A width row beside the pair, which no key of QtCurve maps to and which would
+# beat the thin choice of a page.
+copy
+sed 's/^\(  scrollbar-color: .*\)$/\1\n  scrollbar-width: thin !important;/' \
+    "$work/arm/none.css" > "$work/broken/none.css"
+control 'a width row of the rule'
+
+# The root selector in place of the universal one, which a page rule on a
+# scroller blocks.
+copy
+sed 's/^\* {$/:root {/' "$work/arm/none.css" > "$work/broken/none.css"
+control 'the root selector'
+
+rm -rf "$work/broken"
+echo "assert-ff-content: the universal rule holds one declaration of two" \
+     "literal colours under !important over $(echo $sliders $grooves | wc -w)" \
+     "arms, the sheet holds $lines lines with no width row and no custom" \
+     "property, the thumb follows the slider keys, one track holds under" \
+     "every key, each pair is the sidebar pair of the chrome sheet of that" \
+     "arm, and the check rejects each of the $broken control copies"
