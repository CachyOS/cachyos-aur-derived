+ *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU       *
+ *   Lesser General Public License for more details.                         *
+ *                                                                           *
+ *   You should have received a copy of the GNU Lesser General Public        *
+ *   License along with this library. If not,                                *
+ *   see <http://www.gnu.org/licenses/>.                                     *
+ *****************************************************************************/
+
+/* mutebus NAME [SECONDS]: a socket that accepts a client and answers nothing.
+ *
+ * A D-Bus client that waits for this bus blocks for ever. A bounded read of
+ * the bus therefore stops at its deadline, and the check reads that outcome.
+ * The socket takes a name of the abstract namespace of Linux. The path of a
+ * socket of the file system holds 107 bytes at most, and a build tree can be
+ * deeper than that. The helper is a test fixture, and no rule installs it.
+ */
+
+#include <errno.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+/* The cap of the run time of the helper, in seconds. */
+#define QTC_MUTEBUS_CAP 180
+
+int
+main(int argc, char **argv)
+{
+    struct sockaddr_un addr;
+    socklen_t len;
+    size_t size;
+    unsigned cap;
+    int s;
+
+    if (argc < 2) {
+        fprintf(stderr, "usage: qtcurve-mutebus NAME [SECONDS]\n");
+        return 2;
+    }
+    size = strlen(argv[1]);
+    if (size + 1 >= sizeof addr.sun_path) {
+        fprintf(stderr, "qtcurve-mutebus: the name is too long\n");
+        return 1;
+    }
+    cap = argc > 2 && atoi(argv[2]) > 0 ? (unsigned)atoi(argv[2]) :
+        QTC_MUTEBUS_CAP;
+    s = socket(AF_UNIX, SOCK_STREAM, 0);
+    if (s < 0) {
+        perror("qtcurve-mutebus: socket");
+        return 1;
+    }
+    memset(&addr, 0, sizeof addr);
+    addr.sun_family = AF_UNIX;
+    /* A first byte of 0 in sun_path names the abstract namespace, and the
+       length of the address gives the length of the name. */
+    memcpy(addr.sun_path + 1, argv[1], size);
+    len = (socklen_t)(offsetof(struct sockaddr_un, sun_path) + 1 + size);
+    if (bind(s, (struct sockaddr *)&addr, len) != 0) {
+        perror("qtcurve-mutebus: bind");
+        return 1;
+    }
+    if (listen(s, 16) != 0) {
+        perror("qtcurve-mutebus: listen");
+        return 1;
+    }
+    printf("ready\n");
+    fflush(stdout);
+    /* A cap of the run time, so a helper that outlives its script stops. */
+    alarm(cap);
+    for (;;) {
+        int c = accept(s, NULL, NULL);
+        if (c < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            break;
+        }
+        /* The helper holds the connection open and it answers nothing. */
+    }
+    return 0;
+}
diff --git a/gtk4/writer/busprobe.cpp b/gtk4/writer/busprobe.cpp
