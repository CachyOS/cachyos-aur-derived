index 00000000..06db0036
--- /dev/null
+++ b/gtk4/writer/busprobe.cpp
@@ -0,0 +1,171 @@
+/*****************************************************************************
+ *   Copyright 2026 QtCurve authors                                          *
+ *                                                                           *
+ *   This program is free software; you can redistribute it and/or modify    *
+ *   it under the terms of the GNU Lesser General Public License as          *
+ *   published by the Free Software Foundation; either version 2.1 of the    *
+ *   License, or (at your option) version 3, or any later version accepted   *
+ *   by the membership of KDE e.V. (or its successor approved by the         *
+ *   membership of KDE e.V.), which shall act as a proxy defined in          *
+ *   Section 6 of version 3 of the license.                                  *
+ *                                                                           *
+ *   This program is distributed in the hope that it will be useful,         *
+ *   but WITHOUT ANY WARRANTY; without even the implied warranty of          *
+ *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU       *
+ *   Lesser General Public License for more details.                         *
+ *                                                                           *
+ *   You should have received a copy of the GNU Lesser General Public        *
+ *   License along with this library. If not,                                *
+ *   see <http://www.gnu.org/licenses/>.                                     *
+ *****************************************************************************/
+
+#include "busprobe.h"
+
+#include <QByteArray>
+#include <QDBusConnection>
+#include <QDBusInterface>
+#include <QDBusReply>
+
+#include <atomic>
+#include <chrono>
+#include <future>
+#include <memory>
+#include <thread>
+
+namespace QtCurve {
+namespace Gtk {
+
+namespace {
+
+/** The name of the variable that holds the theme name of the session. */
+const char *const themeEnv = "GTK_THEME";
+
+/**
+ * True while a stalled bus holds a sacrificial thread. A later call then
+ * stops at once, and it starts no second thread.
+ */
+std::atomic<bool> g_busy{false};
+
+/** The serial of a private connection, so no two probes share a name. */
+std::atomic<unsigned> g_serial{0};
+
+/** The outcome of one run of the sacrificial thread. */
+enum class Slot { Done, Deadline, Stalled };
+
+/**
+ * Runs the function body in the sacrificial thread, waits at most deadlineMs
+ * for it, and gives the value of body to out. The thread of a run that met
+ * the deadline stays blocked, and it owns the shared state of that run.
+ *
+ * \param deadlineMs the longest wait for body, in milliseconds.
+ * \param body the work over the session bus, which gives one value.
+ * \param out the value of body, which the function writes for Done alone.
+ * \return Done after body returned inside deadlineMs. Deadline after a wait
+ *     of deadlineMs. Stalled while the thread of an earlier run stays
+ *     blocked, which starts no thread and waits no time.
+ */
+template <typename Value, typename Body>
+Slot
+runBounded(int deadlineMs, Body body, Value &out)
+{
+    if (g_busy.exchange(true)) {
+        return Slot::Stalled;
+    }
+    // The worker owns the promise through the shared pointer, so the promise
+    // outlives the future of a run that meets its deadline.
+    auto slot = std::make_shared<std::promise<Value>>();
+    std::future<Value> ready = slot->get_future();
+    std::thread worker([slot, body] {
+            slot->set_value(body());
+            g_busy.store(false);
+        });
+    if (ready.wait_for(std::chrono::milliseconds(deadlineMs)) ==
+        std::future_status::ready) {
+        worker.join();
+        out = ready.get();
+        return Slot::Done;
+    }
+    worker.detach();
+    return Slot::Deadline;
+}
+
+/**
+ * Reads the theme name over a private connection of the session bus, and
+ * gives the outcome. The function runs in the sacrificial thread alone. The
+ * connection carries a name of its own, and the function closes it before it
+ * returns.
+ *
+ * \param name the name of the private connection, which no other probe holds.
+ * \return the outcome and the name, which is empty for every outcome other
+ *     than Answered.
+ */
+ThemeResult
+readOverBus(const QString &name)
+{
+    ThemeResult result{ ThemeProbe::NoBus, QString() };
+    QDBusConnection bus =
+        QDBusConnection::connectToBus(QDBusConnection::SessionBus, name);
+    if (bus.isConnected()) {
+        QDBusInterface portal(
+            QStringLiteral("org.freedesktop.portal.Desktop"),
+            QStringLiteral("/org/freedesktop/portal/desktop"),
+            QStringLiteral("org.freedesktop.portal.Settings"), bus);
+        const QDBusReply<QDBusVariant> reply =
+            portal.call(QStringLiteral("ReadOne"),
+                        QStringLiteral("org.gnome.desktop.interface"),
+                        QStringLiteral("gtk-theme"));
+        if (reply.isValid()) {
+            result.probe = ThemeProbe::Answered;
+            result.name = reply.value().variant().toString();
+            // A deep copy, because the name crosses to the calling thread.
+            result.name.detach();
+        } else {
+            result.probe = ThemeProbe::Connected;
+        }
+    }
+    QDBusConnection::disconnectFromBus(name);
+    return result;
+}
+
+}
+
+ThemeResult
+sessionThemeProbe(int deadlineMs)
+{
+    const QByteArray env = qgetenv(themeEnv);
+    if (!env.isEmpty()) {
+        return { ThemeProbe::Answered,
+                 QString::fromLocal8Bit(env).section(QLatin1Char(':'), 0, 0) };
+    }
+    const QString name = QStringLiteral("qtcurve-gtk-writer-probe-%1")
+        .arg(g_serial.fetch_add(1));
+    ThemeResult result{ ThemeProbe::NoBus, QString() };
+    const Slot slot = runBounded(deadlineMs,
+                                 [name] { return readOverBus(name); }, result);
+    if (slot == Slot::Done) {
+        return result;
+    }
+    if (slot == Slot::Stalled) {
+        return { ThemeProbe::Stalled, QString() };
+    }
+    return { ThemeProbe::Deadline, QString() };
+}
+
+bool
+openSessionBus(int deadlineMs)
+{
+    bool open = false;
+    const Slot slot = runBounded(deadlineMs, [] {
+            return QDBusConnection::sessionBus().isConnected();
+        }, open);
+    return slot == Slot::Done && open;
+}
+
+bool
+busProbeStalled()
+{
+    return g_busy.load();
+}
+
+}
+}
