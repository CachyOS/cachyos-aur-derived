diff --git a/gtk4/check/assert-bus.sh b/gtk4/check/assert-bus.sh
new file mode 100644
index 00000000..679c2fdd
--- /dev/null
+++ b/gtk4/check/assert-bus.sh
@@ -0,0 +1,213 @@
+#!/bin/sh
+# assert-bus.sh WRITER WORKDIR MUTEBUS: a stalled session bus must not park a
+# pass or the start of the daemon. The run points the session bus of the
+# writer at MUTEBUS, which accepts a client and answers nothing. It reads the
+# deadline through the exit codes, the log lines and the liveness of each run.
+# This is the one check that runs the writer without --force, because it must
+# drive the read of the bus. HOME, XDG_CONFIG_HOME, QTCURVE_CONFIG_DIR and
+# XDG_RUNTIME_DIR point into WORKDIR, and GTK_THEME and DISPLAY go away. No
+# run therefore reaches the bus or the files of the caller. Every wait is a
+# counted poll of steps of one second, so no arm can stop the build.
+set -eu
+usage='usage: assert-bus.sh WRITER WORKDIR MUTEBUS'
+writer=${1:?$usage}
+work=${2:?$usage}
+mutebus=${3:?$usage}
+
+conf=$work/config
+qtc=$work/qtcurve
+run=$work/runtime
+fault=$work/fault
+# The names of two sockets of the abstract namespace, which hold no path. The
+# number of the process keeps the names of one run apart from another run.
+mutename=qtcurve-mutebus-$$
+realname=qtcurve-realbus-$$
+# The cap of the run time of the mute bus, in seconds.
+mutecap=120
+seeds="$conf/gtk-4.0/qtcurve.css $conf/gtk-3.0/qtcurve.css
+$conf/gtk-4.0/qtcurve-assets/marker"
+pids=
+last=
+code=0
+daemon=
+kept=0
+
+clean() {
+    for p in $pids; do
+        kill "$p" 2>/dev/null || true
+    done
+    rm -f "$fault" 2>/dev/null || true
+}
+
+# A signal that stops the run leaves a writer, a mute bus or a private bus of
+# the run alive. The trap takes each one away, and SIGKILL runs no trap.
+trap clean EXIT
+trap 'clean; exit 1' HUP INT QUIT TERM
+
+rm -rf "$work"
+mkdir -p "$conf/gtk-3.0" "$conf/gtk-4.0" "$conf/gtk-4.0/qtcurve-assets" \
+    "$qtc" "$run"
+chmod 0700 "$run"
+printf '[Settings]\nappearance=gradient\n' > "$qtc/stylerc"
+unset GTK_THEME DISPLAY WAYLAND_DISPLAY DBUS_SESSION_BUS_ADDRESS
+ulimit -c 0
+
+fail() {
+    echo "assert-bus: $1" >&2
+    exit 1
+}
+
+# running PID: gives 0 while the process PID runs. A process that ended and
+# waits for its parent holds the state Z, and it does not run.
+running() {
+    state=$(sed -n 's/^State:[[:space:]]*//p' "/proc/$1/status" 2>/dev/null) ||
+        return 1
+    case $state in
+        Z*|'') return 1;;
+        *) return 0;;
+    esac
+}
+
+# start LOG BUS ARGS...: starts one run of the writer over the private home
+# and the bus BUS, and holds the pid of that run in the variable last.
+start() {
+    log=$1
+    bus=$2
+    shift 2
+    HOME=$work XDG_CONFIG_HOME=$conf QTCURVE_CONFIG_DIR=$qtc \
+        XDG_RUNTIME_DIR=$run DBUS_SESSION_BUS_ADDRESS=$bus \
+        QTC_GTK_TEST_FAULT=$fault "$writer" "$@" > "$log" 2>&1 &
+    last=$!
+    pids="$pids $last"
+}
+
+# wait_exit PID LIMIT NAME: waits at most LIMIT seconds for the run PID to
+# end, and holds the exit code of that run in the variable code. A run that
+# stays at the limit takes a signal, and the check fails.
+wait_exit() {
+    i=0
+    while [ "$i" -lt "$2" ]; do
+        if ! running "$1"; then
+            code=0
+            wait "$1" || code=$?
+            return 0
+        fi
+        sleep 1
+        i=$((i + 1))
+    done
+    kill "$1" 2>/dev/null || true
+    fail "$3 runs after $2 seconds"
+}
+
+# wait_line LIMIT FILE TEXT NAME: waits at most LIMIT seconds for the file
+# FILE to hold the text TEXT.
+wait_line() {
+    i=0
+    while [ "$i" -lt "$1" ]; do
+        if grep -qF "$3" "$2" 2>/dev/null; then
+            return 0
+        fi
+        sleep 1
+        i=$((i + 1))
+    done
+    fail "$4"
+}
+
+# 1. A one shot write meets the deadline of the bus, gives the code 8 and
+# removes no file. The mute bus accepts the client and answers nothing, so a
+# read of the bus with no deadline parks the run for ever.
+"$mutebus" "$mutename" "$mutecap" > "$work/mute.log" 2>&1 &
+pids="$pids $!"
+wait_line 15 "$work/mute.log" ready "the mute bus started no socket"
+
+for path in $seeds; do
+    printf 'seed\n' > "$path"
+    kept=$((kept + 1))
+done
+start "$work/write.log" "unix:abstract=$mutename" --write
+wait_exit "$last" 20 "the bounded write"
+if [ "$code" -ne 8 ]; then
+    fail "the bounded write gave the code $code and not 8"
+fi
+grep -qF "gave no theme name" "$work/write.log" ||
+    fail "the bounded write named no deadline of the session bus"
+for path in $seeds; do
+    [ -e "$path" ] || fail "the bounded write removed $path"
+done
+echo "assert-bus: the bounded write met the deadline, gave the code 8 and" \
+     "kept its $kept files"
+
+# 2. The watch mode starts on the same stalled bus, and a poke of a watched
+# path drives one pass. The flag --force holds the bus out of every pass, so
+# the arm reads the start of the daemon alone. The control fault gives that
+# pass the code 5 on every host.
+rm -f "$fault"
+start "$work/watch.log" "unix:abstract=$mutename" --watch --force
+daemon=$last
+sleep 2
+running "$daemon" || fail "the watch mode stopped at the first pass"
+: > "$fault"
+printf 'appearance=soft\n' >> "$qtc/stylerc"
+wait_line 20 "$work/watch.log" "the write failed with the code 5" \
+    "the watch mode ran no pass on a stalled bus"
+running "$daemon" || fail "the watch mode stopped after the pass"
+kill "$daemon" 2>/dev/null || true
+wait_exit "$daemon" 10 "the watch mode on a stalled bus"
+rm -f "$fault"
+echo "assert-bus: the watch mode started on a stalled bus, and a poke of a" \
+     "watched path drove one pass"
+
+# 3. The watch mode with no --force meets the deadline in its first pass, and
+# the daemon lives on. The unit of the daemon carries Restart=on-failure. A
+# first pass that left with the code 8 would give one restart every few
+# seconds while the bus stalls. A later pass waits no time, because the read
+# of the first pass still holds the one thread of the bus.
+rm -f "$fault"
+start "$work/tolerate.log" "unix:abstract=$mutename" --watch
+daemon=$last
+wait_line 20 "$work/tolerate.log" "gave no theme name" \
+    "the first pass of the watch mode met no deadline"
+if ! running "$daemon"; then
+    code=0
+    wait "$daemon" || code=$?
+    if [ "$code" -eq 8 ]; then
+        fail "the watch mode left with the code 8, which the unit restarts"
+    fi
+    fail "the watch mode left with the code $code after the first pass"
+fi
+printf 'appearance=flat\n' >> "$qtc/stylerc"
+wait_line 20 "$work/tolerate.log" "an earlier read of the session bus" \
+    "a later pass named no earlier read of the session bus"
+running "$daemon" || fail "the watch mode stopped after a later pass"
+kill "$daemon" 2>/dev/null || true
+wait_exit "$daemon" 10 "the watch mode with no --force"
+echo "assert-bus: the watch mode with no --force lived past a first pass of" \
+     "the code 8, and a later pass named the earlier read"
+
+# 4. The daemon leaves with the code 0 when the session bus dies, so a logout
+# stops a daemon that no unit holds. The arm needs dbus-daemon, and it names
+# the binary where the host holds none. The private bus holds no portal, so
+# the probe of the daemon connects and reads no name. That outcome is enough
+# for the handler of the lost bus.
+if command -v dbus-daemon > /dev/null 2>&1; then
+    dbus-daemon --session --nofork --address="unix:abstract=$realname" \
+        --print-address > "$work/bus.log" 2>&1 &
+    buspid=$!
+    pids="$pids $buspid"
+    wait_line 15 "$work/bus.log" "$realname" \
+        "the private bus started no socket"
+    start "$work/death.log" "unix:abstract=$realname" --watch --force
+    daemon=$last
+    sleep 3
+    running "$daemon" || fail "the watch mode stopped on a live bus"
+    kill "$buspid" 2>/dev/null || true
+    wait_exit "$daemon" 20 "the daemon after the death of the bus"
+    if [ "$code" -ne 0 ]; then
+        fail "the daemon gave the code $code and not 0 after the bus died"
+    fi
+    echo "assert-bus: the daemon left with the code 0 when the session bus" \
+         "died"
+else
+    echo "assert-bus: dbus-daemon is absent, so the arm of the death of the" \
+         "bus did not run" >&2
+fi
