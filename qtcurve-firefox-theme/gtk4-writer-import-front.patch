+/**
+ * Returns the offset of contents after a leading @charset rule, and 0 when
+ * the file starts with another byte. The offset holds the semicolon of the
+ * rule and one line break after it. A CSS parser reads that rule at the head
+ * of a file alone, so no byte of the writer can stand before it.
+ */
+static int
+charsetEnd(const QByteArray &contents)
+{
+    if (!contents.startsWith("@charset")) {
+        return 0;
+    }
+    const int line = contents.indexOf('\n');
+    const int semi = contents.indexOf(';');
+    if (semi < 0 || (line >= 0 && semi > line)) {
+        // The first line closes no rule, so the whole line stands first.
+        return line < 0 ? (int)contents.size() : line + 1;
+    }
+    int end = semi + 1;
+    if (end < contents.size() && contents[end] == '\r') {
+        end++;
+    }
+    if (end < contents.size() && contents[end] == '\n') {
+        end++;
+    }
+    return end;
+}
+
+/**
+ * Puts statement and one newline after a leading @charset rule of contents,
+ * and at the front of contents when the file holds no such rule. Every other
+ * byte of the file keeps its place and its order.
+ */
+static QByteArray
+frontMerge(const QByteArray &contents, const QByteArray &statement)
+{
+    const int at = charsetEnd(contents);
+    QByteArray out = contents.left(at);
+    out.append(statement);
+    out.append('\n');
+    out.append(contents.mid(at));
+    return out;
+}
