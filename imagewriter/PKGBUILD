pkgname=imagewriter
pkgver=1.10.1748706892.d72444b
pkgrel=1
epoch=1
pkgdesc="A graphical utility for writing raw disk images & hybrid isos to USB keys"
arch=('x86_64')
url="https://github.com/openSUSE/imagewriter"
license=('GPL-2.0-only')
depends=(
  'hicolor-icon-theme'
  'qt5-base'
  'udisks2'
)
_commit=d72444b40cf68cfe18799525226c5bee10ac1bd5
source=(
  # should use git instead or be tag at all instead of hardcoded commit
  "$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz"
)
sha256sums=('59deec2c9858ce744aea7e412971e08e00d5d9122e27421e6e36413e571693ce')

build() {
  cd "$pkgname-$_commit"
  qmake-qt5 \
    QMAKE_CFLAGS="${CFLAGS} -DKIOSKHACK" \
    QMAKE_CXXFLAGS="${CXXFLAGS} -DKIOSKHACK" \
    QMAKE_LFLAGS="${LDFLAGS}" \
    PREFIX="$pkgdir/usr" \
    DEFINES=USEUDISKS2 \
    "$pkgname.pro"
  make
}

package() {
  cd "$pkgname-$_commit"
  make DESTDIR="$pkgdir" install
}
