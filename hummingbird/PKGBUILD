# Maintainer: OpenSourcerer <alex at opensourcery dot eu>
pkgname=hummingbird
_pkgname=AirVPN-Suite
pkgver=2.2.0
pkgrel=1
# no proper tags for us
_commit=35fe8af098db7e907207aa5ab6ad38219286c9cf
# AirVPN's OpenVPN3 fork
_openvpn3_commit=095286b6a2ceee0cb040edc5ba135942db5fedbb
# asio required by the fork
_asio_ver=1-38-2
pkgdesc="FLOSS OpenVPN3 and WireGuard client using AirVPN's OpenVPN3 library fork"
arch=('x86_64' 'armv7l' 'aarch64')
url="https://gitlab.com/AirVPN/$_pkgname"
license=('GPL-3.0-or-later')
provides=('hummingbird-bin')
conflicts=('hummingbird-bin' 'airvpn-suite' 'airvpn-suite-bin' 'airvpn-suite-beta-bin')
depends=('glibc' 'libgcc' 'libstdc++' 'lz4' 'openssl' 'xz' 'zlib' 'zstd' 'fmt')
makedepends=('git')
source=("git+$url.git#commit=$_commit"
        "git+https://github.com/AirVPN/openvpn3-airvpn.git#commit=$_openvpn3_commit"
        "asio-$_asio_ver.tar.gz::https://github.com/chriskohlhoff/asio/archive/asio-$_asio_ver.tar.gz")
sha256sums=('SKIP'
            'SKIP'
            '9f2648fa483e58a6bf848d970ee0ea650ca19ed7769dfa520ed4f7b8d27af1db')
changelog=Changelog.txt

prepare() {
    cd "$srcdir/asio-asio-$_asio_ver"
    local _patch
    for _patch in "$srcdir"/openvpn3-airvpn/deps/vcpkg-ports/asio/*.patch; do
        patch -Np1 -i "$_patch"
    done
    ln -sfn "asio-asio-$_asio_ver" "$srcdir/asio"

    cd "$srcdir/$_pkgname"
    mkdir -p obj

    # inject our build flags
    sed -i \
        -e 's/^\(\s*CCOMP="gcc\) /\1 ${CPPFLAGS} ${CFLAGS} /' \
        -e 's/^COMPILE="g++ /COMPILE="g++ ${CPPFLAGS} ${CXXFLAGS} ${LDFLAGS} /' \
        -e 's/^\(\s*\)strip \${BIN_FILE}$/\1:/' \
        build-hummingbird.sh
}

build() {
    cd "$srcdir/$_pkgname"
    # fail-fast
    bash -e ./build-hummingbird.sh
}

package() {
    cd "$srcdir/$_pkgname"
    install -Dm755 hummingbird -t "$pkgdir/usr/bin/"
    install -Dm644 README-hummingbird.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE.md -t "$pkgdir/usr/share/licenses/$pkgname/"
}
