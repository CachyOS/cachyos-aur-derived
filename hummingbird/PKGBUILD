# Maintainer: OpenSourcerer <alex at opensourcery dot eu>
pkgname=hummingbird
_pkgname=AirVPN-Suite
pkgver=1.3.0
pkgrel=3
_commit="ef5ce5ad8fff24f3476f3a072f44d31a5cd1d3fc"
# hardcoded tracked commit from airvpn..
_openvpn3_commit="3614b1a565fa2fee0667f86bd21a49e7a6a24421"
# asio version required for openvpn3
_asio_ver=1-24-0
pkgdesc="FLOSS OpenVPN3 client using AirVPN's OpenVPN3 library fork"
arch=('x86_64' 'armv7l' 'aarch64')
url="https://gitlab.com/AirVPN/$_pkgname"
license=('GPL-3.0-or-later')
provides=('hummingbird-bin')
conflicts=('hummingbird-bin' 'airvpn-suite' 'airvpn-suite-bin' 'airvpn-suite-beta-bin')
depends=('crypto++' 'curl' 'zlib' 'lz4' 'openssl' 'zstd' 'xz' 'glibc' 'gcc-libs')
makedepends=('git' 'wireguard-tools')
source=("git+$url.git#commit=$_commit"
        "git+https://github.com/AirVPN/openvpn3-airvpn.git#commit=$_openvpn3_commit"
        "asio-$_asio_ver.tar.gz::https://github.com/chriskohlhoff/asio/archive/asio-$_asio_ver.tar.gz")
sha256sums=('SKIP'
            'SKIP'
            'cbcaaba0f66722787b1a7c33afe1befb3a012b5af3ad7da7ff0f6b8c9b7a8a5b')
changelog="Changelog.txt"

prepare() {
    cd "$srcdir/asio-asio-$_asio_ver"
    local _patch
    for _patch in "$srcdir"/openvpn3-airvpn/deps/asio/patches/*.patch; do
        patch -Np1 -i "$_patch"
    done
    ln -sfn "asio-asio-$_asio_ver" "$srcdir/asio"

    cd "$srcdir/$_pkgname"
    mkdir -p obj
    cp /usr/share/wireguard-tools/examples/embeddable-wg-library/wireguard.? src/
    cp /usr/share/wireguard-tools/examples/embeddable-wg-library/wireguard.h src/include/
}

build() {
    cd "$srcdir/$_pkgname"
    ./build-hummingbird.sh
}

package() {
    cd "$srcdir/$_pkgname"

    # place binaries
    install -Dm755 hummingbird "$pkgdir/usr/bin/hummingbird"

    # place documentation
    install -Dm644 README.md "$pkgdir/usr/share/doc/hummingbird/README.md"

    # place license
    install -Dm644 LICENSE.md "$pkgdir/usr/share/licenses/hummingbird/LICENSE.md"
}
