pkgname=rustdesk
pkgver=1.5.0
pkgrel=6
pkgdesc='Remote desktop application with Flutter UI and hardware codecs'
arch=('x86_64')
url='https://rustdesk.com'
license=('AGPL-3.0-only')
depends=(
  'alsa-lib'
  'aom'
  'at-spi2-core'
  'cairo'
