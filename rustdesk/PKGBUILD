  'libva-intel-driver: VA-API hardware video support on older Intel GPUs'
  'libva-mesa-driver: VA-API hardware video support on supported Mesa GPUs'
  'libva-utils: inspect VA-API codec support'
  'nvidia-utils: NVIDIA hardware video support'
)
# Mixed Rust/C++ objects; Rust's release profile still enables its own LTO.
options=('!lto')
_commit=fada664df7a294d1d1a9ca3e7cd3637069122f17
# Source archives omit submodule contents; this pin matches _commit's gitlink.
_hbb_commit=229b904508364c8997aad0fb5af57effac859f60
# Match upstream .github/workflows/{bridge,flutter-build}.yml respectively.
_flutter_bridge=3.22.3
_flutter_app=3.24.5
source=(
  "rustdesk-$_commit.tar.gz::https://codeload.github.com/rustdesk/rustdesk/tar.gz/$_commit"
  "hbb_common-$_hbb_commit.tar.gz::https://codeload.github.com/rustdesk/hbb_common/tar.gz/$_hbb_commit"
  'libyuv.pc'
  'libwebm-cstdint.patch'
  'flutter-rpath.patch'
)
sha256sums=(
  '251c82c41378d55823cfc37203b75280f6c442deadb6428cb02e3a28486efcb4'
  '4902cb2429d3ab7f055a7833c966d63b8531d3912a0423bd27cfe81fee000356'
  'c339defc017d160e591cf6572028684eef5fb221a02307cd7a2fe4f853d80d8f'
  'de9a5893fcbc875c0bc840766cb8655ff60ecad619dcc0e58298c6d0f34c8f56'
