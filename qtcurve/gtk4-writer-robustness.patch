diff --git a/gtk4/check/assert-keep.sh b/gtk4/check/assert-keep.sh
new file mode 100644
index 00000000..b91d6496
--- /dev/null
+++ b/gtk4/check/assert-keep.sh
@@ -0,0 +1,91 @@
+#!/bin/sh
+# assert-keep.sh WRITER WORKDIR: a write that stops must keep the gtk.css of
+# the user whole. The run builds a large gtk.css that holds the import line.
+# Then it runs --remove-gtk under a file size limit that the rewrite passes,
+# so the writer takes SIGXFSZ. HOME and XDG_CONFIG_HOME point into WORKDIR,
+# because --remove-gtk rewrites the files of the caller.
+set -eu
+usage='usage: assert-keep.sh WRITER WORKDIR'
+writer=${1:?$usage}
+work=${2:?$usage}
+
+rm -rf "$work"
+mkdir -p "$work/config/gtk-3.0" "$work/config/gtk-4.0"
+
+# The fixture holds one import line of 23 bytes and 4000 rule lines of 32
+# bytes, so it is 128023 bytes. One unit of ulimit -f is 1024 bytes at most,
+# and the rewrite of 128000 bytes passes that limit in every shell.
+fixture=$work/fixture.css
+printf "@import 'qtcurve.css';\n" > "$fixture"
+awk 'BEGIN { for (i = 0; i < 4000; i++)
+                 printf "label.r%04d { color: #101010; }\n", i }' >> "$fixture"
+tail -n +2 "$fixture" > "$work/want.css"
+cp "$fixture" "$work/config/gtk-4.0/gtk.css"
+cp "$fixture" "$work/config/gtk-3.0/gtk.css"
+printf 'x\n' > "$work/config/gtk-4.0/qtcurve.css"
+printf 'x\n' > "$work/config/gtk-3.0/qtcurve.css"
+
+status=0
+same() {
+    if cmp -s "$1" "$2"; then
+        return 0
+    fi
+    echo "assert-keep: $1 is not the file $2" >&2
+    status=1
+}
+
+# The writer dies on the signal and gives 153, so the run keeps the exit code
+# and reads the two files. ulimit -c 0 stops the core file of that signal, and
+# the shell of the run prints the signal into the log of the run.
+(
+    ulimit -c 0
+    ulimit -f 1
+    code=0
+    HOME=$work XDG_CONFIG_HOME=$work/config "$writer" --remove-gtk || code=$?
+    echo "$code" > "$work/limit.status"
+) > "$work/limit.log" 2>&1
+limited=$(cat "$work/limit.status")
+same "$work/config/gtk-4.0/gtk.css" "$fixture"
+same "$work/config/gtk-3.0/gtk.css" "$fixture"
+if [ $status -eq 0 ]; then
+    echo "assert-keep: the two user sheets keep 128023 bytes under the limit," \
+         "and the writer gave $limited"
+fi
+
+# The write mode takes the same path over a theme that is not QtCurve. The run
+# sets SIGXFSZ to no action, so the writer lives and gives the code of the
+# removal.
+(
+    ulimit -c 0
+    ulimit -f 1
+    trap '' XFSZ
+    code=0
+    GTK_THEME=Breeze HOME=$work XDG_CONFIG_HOME=$work/config "$writer" --write \
+        || code=$?
+    echo "$code" > "$work/write.status"
+) > "$work/write.log" 2>&1
+wrote=$(cat "$work/write.status")
+same "$work/config/gtk-4.0/gtk.css" "$fixture"
+same "$work/config/gtk-3.0/gtk.css" "$fixture"
+if [ "$wrote" -eq 0 ]; then
+    echo "assert-keep: the write mode gave 0 for a removal that failed" >&2
+    status=1
+fi
+if [ ! -f "$work/config/gtk-4.0/qtcurve.css" ]; then
+    echo "assert-keep: the write mode deleted a sheet that gtk.css names" >&2
+    status=1
+fi
+if [ $status -eq 0 ]; then
+    echo "assert-keep: the write mode gave $wrote and kept qtcurve.css"
+fi
+
+# The same run with no limit must remove the import line and keep every other
+# line. The limited run above therefore fails on the write alone.
+HOME=$work XDG_CONFIG_HOME=$work/config "$writer" --remove-gtk \
+    > "$work/free.log" 2>&1
+same "$work/config/gtk-4.0/gtk.css" "$work/want.css"
+same "$work/config/gtk-3.0/gtk.css" "$work/want.css"
+if [ $status -eq 0 ]; then
+    echo "assert-keep: a free run removes the import line and keeps 4000 lines"
+fi
+exit $status
diff --git a/gtk4/check/assert-latch.sh b/gtk4/check/assert-latch.sh
new file mode 100644
index 00000000..ce0f353b
--- /dev/null
+++ b/gtk4/check/assert-latch.sh
@@ -0,0 +1,102 @@
+#!/bin/sh
+# assert-latch.sh WRITER WORKDIR: one write pass that fails must not stop the
+# pass after it. The run starts the watch mode over a private home, gives one
+# pass a fault through QTC_GTK_TEST_FAULT, and then takes the fault away. No
+# settings value and no colour file reaches a fault of the emitter, so the
+# environment variable is the one trigger. HOME, XDG_CONFIG_HOME and
+# QTCURVE_CONFIG_DIR point into WORKDIR, because the writer rewrites the files
+# of the caller.
+set -eu
+usage='usage: assert-latch.sh WRITER WORKDIR'
+writer=${1:?$usage}
+work=${2:?$usage}
+
+log=$work/watch.log
+gtk4dir=$work/config/gtk-4.0
+pid=
+
+clean() {
+    if [ -n "$pid" ]; then
+        kill "$pid" 2>/dev/null || true
+    fi
+    chmod 0700 "$gtk4dir" 2>/dev/null || true
+}
+
+# A signal that stops the run leaves the watch mode alive and the directory of
+# the third pass read only. SIGKILL runs no trap, so the run makes WORKDIR
+# writable again before it removes the tree.
+trap clean EXIT
+trap 'clean; exit 1' HUP INT QUIT TERM
+
+if [ -d "$work" ]; then
+    chmod -R u+rwX "$work"
+fi
+rm -rf "$work"
+mkdir -p "$work/config/gtk-3.0" "$work/config/gtk-4.0" "$work/qtcurve"
+
+appearance() {
+    printf '[Settings]\nappearance=%s\n' "$1" > "$work/qtcurve/stylerc"
+}
+
+# The count of the failure lines of one exit code, which Watcher::fire()
+# prints.
+count() {
+    n=$(grep -c "the write failed with the code $1" "$log" 2>/dev/null) || n=0
+    printf '%s\n' "$n"
+}
+
+# wait_for CODE COUNT: waits at most 15 seconds for COUNT failure lines of the
+# exit code CODE. The debounce of the watch mode is 500 ms.
+wait_for() {
+    i=0
+    while [ "$i" -lt 15 ]; do
+        if [ "$(count "$1")" -ge "$2" ]; then
+            return 0
+        fi
+        sleep 1
+        i=$((i + 1))
+    done
+    return 1
+}
+
+appearance gradient
+ulimit -c 0
+HOME=$work XDG_CONFIG_HOME=$work/config QTCURVE_CONFIG_DIR=$work/qtcurve \
+    QTC_GTK_TEST_FAULT=$work/fault "$writer" --watch --force > "$log" 2>&1 &
+pid=$!
+sleep 2
+if ! kill -0 "$pid" 2>/dev/null; then
+    echo "assert-latch: the watch mode stopped at the first pass" >&2
+    exit 1
+fi
+
+# The second pass carries the fault, so it must give the exit code 5.
+: > "$work/fault"
+appearance agua
+if ! wait_for 5 1; then
+    echo "assert-latch: no pass gave the exit code 5 under the fault" >&2
+    exit 1
+fi
+sleep 1
+five=$(count 5)
+
+# The third pass carries no fault, and copyAssets() gives it the exit code 1
+# because the build tree holds no installed asset. The read only directory
+# gives the same code on a machine that holds the assets.
+rm -f "$work/fault"
+chmod 0500 "$gtk4dir"
+appearance soft
+if ! wait_for 1 1; then
+    echo "assert-latch: the pass after the fault kept the exit code 5" >&2
+    exit 1
+fi
+if [ "$(count 5)" -ne "$five" ]; then
+    echo "assert-latch: a pass after the fault gave the exit code 5" >&2
+    exit 1
+fi
+if ! kill -0 "$pid" 2>/dev/null; then
+    echo "assert-latch: the watch mode stopped after the fault" >&2
+    exit 1
+fi
+echo "assert-latch: the fault gave $five failure lines of the code 5, and the" \
+     "pass after it gave a line of its own"
