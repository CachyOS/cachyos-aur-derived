pkgver() {
	git -C "$pkgname" log -1 --format=%cd --date=format:%Y%m%d
}

prepare() {
	# The patch keeps the free space bar at full height in Dolphin.
	patch -Np1 -d "$pkgname" -i "$srcdir/qt6-child-layout-margin.patch"
	# The patch keeps the whole status text in Dolphin.
	patch -Np1 -d "$pkgname" -i "$srcdir/qt6-dolphin-small-status-bar.patch"
	# The patch takes the translation files from KF6, and not from KF5.
	patch -Np1 -d "$pkgname" -i "$srcdir/prefer-kf6-translations.patch"
	# The patch draws menu and tooltip shadows on Wayland as well as on X11.
	patch -Np1 -d "$pkgname" -i "$srcdir/qt6-wayland-shadows.patch"
	# The patch draws the window frame of Plasma 6 in the QtCurve look.
	patch -Np1 -d "$pkgname" -i "$srcdir/qt6-kdecoration3.patch"
	# The patch adds the settings module of the Plasma 6 window frame.
	patch -Np1 -d "$pkgname" -i "$srcdir/qt6-kdecoration3-kcm.patch"
}

build() {
	export CFLAGS+=" -fmacro-prefix-map=$srcdir/$pkgname=$pkgname"
	export CXXFLAGS+=" -fmacro-prefix-map=$srcdir/$pkgname=$pkgname"

	cmake -S "$pkgname" -B "$pkgname/build" \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DENABLE_QT4=OFF \
		-DENABLE_QT5=ON \
		-DQTC_QT5_ENABLE_KDE=OFF \
		-DENABLE_QT6=ON \
		-DQTC_QT6_ENABLE_KDE=ON \
		-DQTC_QT6_ENABLE_KDECORATION=ON \
		-DENABLE_GTK2=ON \
		-DBUILD_TESTING=ON
	cmake --build "$pkgname/build"

	grep -qF "\"$(git -C "$pkgname" describe)\"" "$pkgname/build/version.cpp"
}

check() {
	ctest --test-dir "$pkgname/build" --output-on-failure --no-tests=error -E '^test-printf$'
}

package() {
	DESTDIR="$pkgdir" cmake --install "$pkgname/build"
	# The style helpers that QtCurve took from Oxygen carry an MIT notice. The
	# notice names the copyright holder, so the package must ship the text.
	# Upstream keeps no MIT licence file. Take the text from the comment block
	# in qt6/style/shadowhelper.cpp.
	sed -n '/^\/\/ Copyright (c) 2010 Hugo/,/IN THE SOFTWARE\./p' "$pkgname/qt6/style/shadowhelper.cpp" |
		sed 's|^// \?||' |
		install -Dm644 /dev/stdin "$pkgdir/usr/share/licenses/$pkgname/MIT"

	test -s "$pkgdir/usr/share/licenses/$pkgname/MIT"
	test -f "$pkgdir/usr/lib/qt/plugins/styles/qtcurve.so"
	test -f "$pkgdir/usr/lib/qt6/plugins/styles/qtcurve.so"
	test -f "$pkgdir/usr/lib/qt6/plugins/org.kde.kdecoration3/org.kde.qtcurve.so"
	test -f "$pkgdir/usr/lib/qt6/plugins/org.kde.kdecoration3.kcm/kcm_qtcurvedecoration.so"
	readelf -d "$pkgdir/usr/lib/qt/plugins/styles/qtcurve.so" | grep -q libQt5X11Extras
}
