# Maintainer: Maxim Devaev <mdevaev@gmail.com>

# hardcoded as usual..
_commit=6c3176e0f7ad8d669287b91e5e4c509cf3218f5f
pkgname=qtcurve
pkgver=20261006
pkgrel=2
pkgdesc="A configurable widget style for Qt6 with KDE Frameworks integration"
arch=(x86_64)
url="https://invent.kde.org/system/qtcurve"
license=('LGPL-2.1-only OR LGPL-3.0-only')
groups=(qtcurve)
depends=(
    frameworkintegration
    gcc-libs
    glibc
    karchive
    kconfig
    kconfigwidgets
    kguiaddons
    ki18n
    kiconthemes
    kio
    kwidgetsaddons
    kwindowsystem
    kxmlgui
    libx11
    libxcb
    qt6-base
    qt6-svg
)
makedepends=(
    cmake
    extra-cmake-modules
    git
)
conflicts=(
    qtcurve-gtk2
    qtcurve-kde
    qtcurve-qt5
    qtcurve-utils
)
source=("git+https://invent.kde.org/system/qtcurve.git#commit=$_commit")
sha256sums=('c04f39e8cfd207a1f55b7b1cba8d39d58678fea4ed3ba3fc6a9044bd4847b7c2')

prepare() {
    # kf6 support needs to be enabled via kwin
    sed -i 's/set(QTC_QT6_ENABLE_KWIN ON)/set(QTC_QT6_ENABLE_KWIN OFF)/' \
        "$pkgname/qt6/CMakeLists.txt"
}

build() {
    cmake -B build -S "$pkgname" \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DENABLE_QT4=OFF \
        -DENABLE_QT5=OFF \
        -DENABLE_QT6=ON \
        -DENABLE_GTK2=OFF \
        -DQTC_QT6_ENABLE_KDE=ON \
        -DBUILD_TESTING=OFF \
        -Wno-dev
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
