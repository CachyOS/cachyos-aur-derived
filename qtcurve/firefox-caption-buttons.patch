+#include "caption.h"
+
+#include "ffmap.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+
+namespace QtCurve {
+namespace Firefox {
+
+using Gtk::Palette;
+
+namespace {
+
+/**
+ * The side of one caption button of the browser, in CSS pixels. browser.css
+ * of browser/omni.ja holds the button size property at this number. The
+ * decoration takes its own side from the caption font, and no sheet reads
+ * that font. The sheet therefore keeps the side of the browser, which holds
+ * the hit target of the browser.
+ */
+const double buttonSide = 24.0;
+
+/**
+ * The gap between two caption buttons, in CSS pixels. buttonSpacing in
+ * qt6/kdecoration/qtcurvedecoration.cpp holds this gap. The browser puts the
+ * spacing property of one button on each side of that button. The sheet
+ * therefore gives the property one half of this number.
+ */
+const double buttonGap = 2.0;
+
+/**
+ * The gap between the window edge and the outermost caption button, in CSS
+ * pixels. buttonEdgePad in qt6/kdecoration/qtcurvedecoration.cpp holds it.
+ */
+const double edgeGap = 4.0;
+
+/**
+ * The divisor of the room around the line art. Button::paint() of
+ * qt6/kdecoration/qtcurvedecorationbutton.cpp takes two parts of the button
+ * side away on each axis, and each part is the side over this number.
+ */
+const double glyphDivisor = 3.5;
+
+/**
+ * The smallest side of the line art that carries the wide lines, in pixels.
+ * Button::drawGlyph() gives a stroke of 3 pixels, a bar of 4 pixels and a
+ * frame of 2 pixels above this side.
+ */
+const double wideGlyphSide = 16.0;
+
+/**
+ * The smallest side of the line art that carries the middle lines, in pixels.
+ * Button::drawGlyph() gives a stroke of 2 pixels and a bar of 2 pixels above
+ * this side, and 1 pixel of each at or under it.
+ */
+const double thinGlyphSide = 4.0;
+
+/**
+ * The narrowest frame of a window symbol, in pixels. Button::drawGlyph()
+ * gives this width at or under the wide side above, and 2 pixels over it.
+ */
+const double thinFrame = 1.0;
+
+/**
+ * The shortest step of the restore symbol, in pixels. Button::drawGlyph()
+ * takes the larger of this floor and one quarter of the side of the line art.
+ */
+const double restoreFloor = 2.0;
+
+/**
+ * The lightest channel value of a dark title bar foreground, from 0 to 255.
+ * DARK_WINDOW_TEXT in qt6/common/common.h reads a colour as dark while one
+ * channel stands under this value.
+ */
+const int darkTextCeiling = 230;
+
+/**
+ * The opacity of the line art of a dark foreground at rest, from 0.0 to 1.0.
+ * HOVER_BUTTON_ALPHA in qt6/common/common.h gives this figure, and the hover
+ * symbol setting alone brings it into the sheet.
+ */
+const double darkRestOpacity = 0.25;
+
+/** The opacity of the line art of a light foreground at rest, from 0.0 to 1.0. */
+const double lightRestOpacity = 0.65;
+
+/**
+ * The colour of the close line art under the pointer. CLOSE_COLOR in
+ * qt6/common/common.h holds this colour, and no colour of the scheme feeds
+ * it. A settings value that colours the buttons takes this colour away.
+ */
+const QColor closeHoverColour(191, 82, 82);
+
+/** The characters that stay as they are inside one data URI. */
+const char *const uriSafe =
+    "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._~:/=";
+
+/**
+ * Returns text with every character outside the safe set above in the percent
+ * form, such as %3C. The caller puts the result inside a url() of the sheet,
+ * where a raw quotation mark or a raw number sign ends the value early.
+ */
+QString
+percent(const QString &text)
+{
+    QString out;
+    out.reserve(text.size() * 3);
+    for (const QChar ch : text) {
+        const ushort code = ch.unicode();
+        if (code > 0 && code < 128 &&
+            strchr(uriSafe, (char)code) != nullptr) {
+            out += ch;
+        } else {
+            out += QString::asprintf("%%%02X", (unsigned)code);
+        }
+    }
+    return out;
+}
+
+/**
+ * Returns the CSS text of the number value, with two decimals at most and no
+ * tail of zeros. The sheet must hold one text for one number on every host,
+ * so the form takes no locale.
+ */
+QString
+num(double value)
+{
+    QString out = QString::asprintf("%.2f", value);
+    while (out.endsWith(QLatin1Char('0'))) {
+        out.chop(1);
+    }
+    if (out.endsWith(QLatin1Char('.'))) {
+        out.chop(1);
+    }
+    return out;
+}
+
+/**
+ * Returns the CSS colour of col at the opacity alpha, such as #232629a6. The
+ * image carries the fade of the decoration in the alpha byte. The image of a
+ * button at rest and the image of the same button under the pointer then hold
+ * one geometry and two colours.
+ *
+ * \param col    the colour of the line art.
+ * \param alpha  the opacity of the line art, from 0.0 to 1.0.
+ * \return the colour in the four byte hexadecimal form.
+ */
+QString
+inkText(const QColor &col, double alpha)
+{
+    return Gtk::hex(col) +
+        QString::asprintf("%02x", (unsigned)std::lround(alpha * 255.0));
+}
+
+/** The measures of the line art of one caption button, in CSS pixels. */
+struct Glyph {
+    /** The left and the top edge of the square of the line art. */
+    double origin;
+    /** The side of that square. */
+    double side;
+    /** The width of a line of the close symbol. */
+    double stroke;
+    /** The height of the bar at the top of a window symbol. */
+    double bar;
+    /** The width of the frame of a window symbol. */
+    double frame;
+    /**
+     * The offset of the window behind the restore symbol. That window sits
+     * one step to the right of the window in front, and one step above it.
+     */
+    double step;
+    /**
+     * The side of the image of one button. The box holds the square of the
+     * line art and one half of the stroke width on each side. That room holds
+     * the cap of the close symbol inside the box, because the browser clips
+     * an image at the edge of its box.
+     */
+    double image;
+};
+
+/**
+ * Returns the measures of the line art at the button side above.
+ * Button::paint() of the decoration holds the rule of the square, and
+ * Button::drawGlyph() holds the rule of every width.
+ */
+Glyph
+glyphOf()
+{
+    Glyph g;
+    double side = std::ceil(buttonSide - 2.0 * (buttonSide / glyphDivisor));
+    if (std::fmod(side, 2.0) == 0.0) {
+        // An even result gains 1 pixel, so the line art keeps a centre pixel.
+        side += 1.0;
+    }
+    g.side = side;
+    g.stroke = side > wideGlyphSide ? 3.0 : side > thinGlyphSide ? 2.0 : 1.0;
+    g.bar = side > wideGlyphSide ? 4.0 : side > thinGlyphSide ? 2.0 : 1.0;
+    g.frame = side > wideGlyphSide ? 2.0 : thinFrame;
+    g.step = std::max(restoreFloor, side / 4.0);
+    g.image = side + g.stroke;
+    g.origin = g.stroke / 2.0;
+    return g;
+}
+
+/** Returns one filled rectangle of the line art, in the colour col. */
+QString
+fillRect(double x, double y, double width, double height, const QString &col)
+{
+    return QStringLiteral("<rect x=\"%1\" y=\"%2\" width=\"%3\" height=\"%4\""
+                          " fill=\"%5\"/>")
+        .arg(num(x), num(y), num(width), num(height), col);
+}
+
+/**
+ * Returns the frame of one window symbol, in the colour col. The line sits
+ * inside the square by one half of the frame width. The outer edge of the
+ * line then lands on the edge that the caller gives. drawWindowSymbol() of
+ * the decoration insets the frame in the same way.
+ */
+QString
+frameRect(const Glyph &g, double x, double y, double side, const QString &col)
+{
+    const double inset = g.frame / 2.0;
+    return QStringLiteral("<rect x=\"%1\" y=\"%2\" width=\"%3\" height=\"%3\""
+                          " fill=\"none\" stroke=\"%4\" stroke-width=\"%5\"/>")
+        .arg(num(x + inset), num(y + inset), num(side - g.frame), col,
+             num(g.frame));
+}
+
+/**
+ * Returns one window symbol of the line art, in the colour col. The symbol is
+ * a thin frame with a thick bar along the top edge, as drawWindowSymbol() of
+ * the decoration draws it.
+ */
+QString
+windowSymbol(const Glyph &g, double x, double y, double side,
+             const QString &col)
+{
+    return frameRect(g, x, y, side, col) + fillRect(x, y, side, g.bar, col);
+}
+
+/** The four caption buttons that the browser shows. */
+enum class Shape {
+    Minimize,
+    Maximize,
+    Restore,
+    Close
+};
+
+/** Returns the line art of shape in the colour col, with no view box. */
+QString
+shapeArt(Shape shape, const Glyph &g, const QString &col)
+{
+    const double x = g.origin;
+    const double y = g.origin;
+    const double side = g.side;
+    const double inner = side - g.step;
+    switch (shape) {
+    case Shape::Minimize:
+        return fillRect(x, y + side - g.bar, side, g.bar, col);
+    case Shape::Maximize:
+        return windowSymbol(g, x, y, side, col);
+    case Shape::Restore:
+        // The window behind shows a bar, a right edge and one corner of the
+        // bottom edge. The window in front then covers the rest of it.
+        return fillRect(x + g.step, y, inner, g.bar, col) +
+            fillRect(x + side - g.frame, y, g.frame, inner, col) +
+            fillRect(x + side - g.step, y + side - g.step - g.frame, g.step,
+                     g.frame, col) +
+            windowSymbol(g, x, y + g.step, inner, col);
+    case Shape::Close:
+        return QStringLiteral("<path d=\"M%1 %2L%3 %4M%3 %2L%1 %4\""
+                              " fill=\"none\" stroke=\"%5\""
+                              " stroke-width=\"%6\"/>")
+            .arg(num(x), num(y), num(x + side), num(y + side), col,
+                 num(g.stroke));
+    }
+    return QString();
+}
+
+/**
+ * Returns the url() of the line art of shape in the colour col. The value
+ * carries the whole image, so the sheet reads no file of the disk.
+ */
+QString
+shapeUrl(Shape shape, const Glyph &g, const QString &col)
+{
+    const QString svg =
+        QStringLiteral("<svg xmlns=\"http://www.w3.org/2000/svg\""
+                       " viewBox=\"0 0 %1 %1\">%2</svg>")
+        .arg(num(g.image), shapeArt(shape, g, col));
+    return QStringLiteral("url(\"data:image/svg+xml,%1\")")
+        .arg(percent(svg));
+}
+
+/** Returns one rule that gives the icon of selector the image image. */
+QString
+imageRule(const QString &selector, const QString &image)
+{
+    return QStringLiteral("%1 > .toolbarbutton-icon {\n"
+                          "  background-image: %2 !important;\n"
+                          "}\n").arg(selector, image);
+}
+
+/**
+ * Returns the opacity of the line art at rest, from 0.0 to 1.0. The hover
+ * symbol setting fades the line art while the pointer sits away from the
+ * button, and every other setting holds it at 1.0.
+ */
+double
+restOpacity(const Options &opts, const QColor &col)
+{
+    if (!(opts.titlebarButtons & TITLEBAR_BUTTON_HOVER_SYMBOL)) {
+        return 1.0;
+    }
+    const bool dark = col.red() < darkTextCeiling ||
+        col.green() < darkTextCeiling || col.blue() < darkTextCeiling;
+    return dark ? darkRestOpacity : lightRestOpacity;
+}
+
+/** One caption button of the browser and the shape that it shows. */
+struct Entry {
+    /** The class selector of the button in the chrome of the browser. */
+    const char *selector;
+    /** The shape of the line art of that button. */
+    Shape shape;
+};
+
+/** The four buttons of the caption, in the order of the rules. */
+const Entry entries[] = {
+    {".titlebar-min", Shape::Minimize},
+    {".titlebar-max", Shape::Maximize},
+    {".titlebar-restore", Shape::Restore},
+    {".titlebar-close", Shape::Close}
+};
+
+/**
+ * The pseudo class of a window that holds no focus. Each rule of that window
+ * carries one class more than its pair, so it stands over that pair.
+ */
+const char *const idleClass = ":-moz-window-inactive";
+
+/**
+ * Returns the image rules of the four buttons in the ink colour col. Button::
+ * glyphColor() of qt6/kdecoration/qtcurvedecorationbutton.cpp reads the
+ * foreground of the state of the window, so the caller gives one colour and
+ * one class for each state.
+ *
+ * \param opts    the QtCurve settings, which give the fade and the colours.
+ * \param g       the measures of the line art.
+ * \param col     the foreground of the title bar of one window state.
+ * \param extra   the pseudo class of that state, which may be empty.
+ * \return the rules of the four buttons, which end with one newline.
+ */
+QString
+buttonRules(const Options &opts, const Glyph &g, const QColor &col,
+            const QString &extra)
+{
+    const QString rest = inkText(col, restOpacity(opts, col));
+    const QString lit = inkText(col, 1.0);
+    // The decoration gives the close line art the colour above under the
+    // pointer, and a settings value that colours the buttons takes it away.
+    const bool ownColour = (opts.titlebarButtons & TITLEBAR_BUTTON_COLOR) != 0;
+    const QString shut = ownColour ? lit : inkText(closeHoverColour, 1.0);
+
+    QString out;
+    for (const Entry &one : entries) {
+        const QString selector = QLatin1String(one.selector) + extra;
+        const QString hover = one.shape == Shape::Close ? shut : lit;
+        out += imageRule(selector, shapeUrl(one.shape, g, rest));
+        if (hover != rest) {
+            out += imageRule(selector + QStringLiteral(":hover"),
+                             shapeUrl(one.shape, g, hover));
+        }
+    }
+    if (shut != lit) {
+        // The decoration gives the foreground back while the button is down.
+        out += imageRule(QStringLiteral(".titlebar-close") + extra +
+                         QStringLiteral(":hover:active"),
+                         shapeUrl(Shape::Close, g, lit));
+    }
+    return out;
+}
+
+}
+
+QString
+buildCaption(const Options &opts, const Palette &pal)
+{
+    const Glyph g = glyphOf();
+    const QColor ink = ffColour(opts, pal, FfRole::TitlebarText);
+    const QColor idle = ffColour(opts, pal, FfRole::TitlebarInactiveText);
+
+    QString out =
+        QStringLiteral("\n.titlebar-buttonbox {\n"
+                       "  --titlebar-button-size: %1px !important;\n"
+                       "  --titlebar-button-spacing: %2px !important;\n"
+                       "  --titlebar-button-end-spacing: %3px !important;\n"
+                       "}\n"
+                       "\n.titlebar-button {\n"
+                       "  appearance: none !important;\n"
+                       "}\n"
+                       "\n.titlebar-button > .toolbarbutton-icon {\n"
+                       "  appearance: none !important;\n"
+                       "  background-color: transparent !important;\n"
+                       "  background-size: %4px !important;\n"
+                       "  border-radius: 0 !important;\n"
+                       "}\n")
+        .arg(num(buttonSide), num(buttonGap / 2.0), num(edgeGap),
+             num(g.image));
+    out += QLatin1Char('\n');
+    out += buttonRules(opts, g, ink, QString());
+    out += QLatin1Char('\n');
+    out += buttonRules(opts, g, idle, QLatin1String(idleClass));
+    return out;
+}
+
+}
+}
