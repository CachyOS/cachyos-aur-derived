diff --git a/firefox/check/assert-ff-caption.sh b/firefox/check/assert-ff-caption.sh
new file mode 100644
index 00000000..2becfd8b
--- /dev/null
+++ b/firefox/check/assert-ff-caption.sh
@@ -0,0 +1,420 @@
+#!/bin/sh
+# assert-ff-caption.sh SHEET: the caption block of SHEET must hold one inline
+# image for each caption button. It must hold one more image for each state
+# that moves the colour of the line art. A window that holds no focus is one
+# such state. Each image must decode to one well formed SVG. It must carry the
+# shape of the decoration family, the measures of the decoration and the
+# colour of the sheet. The block must carry the button spacing of the
+# decoration, and no hover rule may carry a ground. The run then doctors ten
+# copies of SHEET, and it fails if the check passes a copy.
+set -eu
+usage='usage: assert-ff-caption.sh SHEET'
+sheet=${1:?$usage}
+
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+
+# The colour of the close line art under the pointer. CLOSE_COLOR in
+# qt6/common/common.h holds it, and no colour of the scheme feeds it.
+close_hover='#bf5252'
+
+# The alpha byte of the line art at rest, for a dark foreground and for a
+# light one. HOVER_BUTTON_ALPHA in qt6/common/common.h gives 0.25 and 0.65.
+dark_alpha=40
+light_alpha=a6
+
+# The alpha byte of the line art under the pointer. The decoration lifts the
+# fade there, so every hover image stands at the full opacity.
+lit_alpha=ff
+
+# The measures of the decoration at the 24 pixel button of the browser.
+# Button::paint() of qt6/kdecoration/qtcurvedecorationbutton.cpp gives the
+# square of the line art 11 pixels at an origin of 1 pixel.
+glyph_origin=1
+glyph_far=12
+
+# The widths of the line art, in pixels. Button::drawGlyph() gives these three
+# numbers at a square of 11 pixels.
+stroke_width=2
+bar_height=2
+frame_width=1
+
+# The side of the frame of a window symbol, in pixels. drawWindowSymbol()
+# insets that frame by one half of its width on each side.
+frame_side=10
+
+# The left edge of the window behind the restore symbol, in pixels. The step
+# of Button::drawGlyph() is 2.75 pixels at a square of 11 pixels.
+restore_left=3.75
+
+# The side of the image box of one button, in pixels. The box holds the square
+# of the line art and one half of the stroke width on each side.
+image_side=13
+
+# The head of every image. A sheet without the namespace paints no image at
+# all, because the browser reads the value as XML.
+svg_head='<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 '
+svg_head=$svg_head$image_side' '$image_side'">'
+
+# The three properties of the button box. The browser puts the spacing on each
+# side of a button, so 1 pixel gives the 2 pixel gap of the decoration. The end
+# spacing is the 4 pixel edge pad of the decoration. The size is the button of
+# the browser, which holds the hit target of the browser.
+box_rules='  --titlebar-button-size: 24px !important;
+  --titlebar-button-spacing: 1px !important;
+  --titlebar-button-end-spacing: 4px !important;'
+
+# The three properties of the icon at rest. The transparent ground holds in
+# every state, because the selector of this rule carries no state.
+icon_rules='  background-color: transparent !important;
+  background-size: '$image_side'px !important;
+  border-radius: 0 !important;'
+
+# The selectors of the block, the shape of each one, the state of each one and
+# the colour source of each one. The source ink stands for the foreground of
+# a window that holds the focus. The source dim stands for the foreground of
+# a window that holds no focus. Each rule of a window with no focus carries
+# one class more than its pair, so it stands over that pair.
+rows='.titlebar-min bar rest ink
+.titlebar-min:hover bar lit ink
+.titlebar-max square rest ink
+.titlebar-max:hover square lit ink
+.titlebar-restore double rest ink
+.titlebar-restore:hover double lit ink
+.titlebar-close cross rest ink
+.titlebar-close:hover cross lit close
+.titlebar-close:hover:active cross lit ink
+.titlebar-min:-moz-window-inactive bar rest dim
+.titlebar-min:-moz-window-inactive:hover bar lit dim
+.titlebar-max:-moz-window-inactive square rest dim
+.titlebar-max:-moz-window-inactive:hover square lit dim
+.titlebar-restore:-moz-window-inactive double rest dim
+.titlebar-restore:-moz-window-inactive:hover double lit dim
+.titlebar-close:-moz-window-inactive cross rest dim
+.titlebar-close:-moz-window-inactive:hover cross lit close
+.titlebar-close:-moz-window-inactive:hover:active cross lit dim'
+
+# note LINE: prints one fault of the check that runs now.
+note() {
+    echo "assert-ff-caption: $1" >&2
+}
+
+# rule SHEET SELECTOR: prints the body of the icon rule of SELECTOR, with no
+# brace line. The rule of a selector ends at the first line that holds one
+# closing brace.
+rule() {
+    r_esc=$(printf '%s' "$2" | sed 's/[.[\*^$]/\\&/g')
+    sed -n "/^$r_esc > \.toolbarbutton-icon {\$/,/^}\$/p" "$1" |
+        sed -e '1d' -e '$d'
+}
+
+# uri SHEET SELECTOR: prints the encoded image of SELECTOR.
+uri() {
+    rule "$1" "$2" |
+        sed -n 's|^  background-image: url("data:image/svg+xml,\(.*\)")'\
+' !important;$|\1|p'
+}
+
+# decode: reads the encoded image and prints the SVG. The writer escapes the
+# five characters below and no other one, so a leftover escape is a fault.
+decode() {
+    sed -e 's/%20/ /g' -e 's/%22/"/g' -e 's/%23/#/g' -e 's/%3C/</g' \
+        -e 's/%3E/>/g'
+}
+
+# bare FILE: prints the SVG of FILE with every colour value in place of one
+# mark. The image of a button at rest and the image of the same button under
+# the pointer must give the same text.
+bare() {
+    sed -e 's/fill="#[0-9a-f]*"/fill="C"/g' \
+        -e 's/stroke="#[0-9a-f]*"/stroke="C"/g' "$1"
+}
+
+# colours FILE: prints each colour of the SVG FILE, one to a line, with no
+# repeat. The ground of an outlined shape carries no colour and drops out.
+colours() {
+    grep -o -e 'fill="[^"]*"' -e 'stroke="[^"]*"' "$1" |
+        sed 's/^[a-z]*="//;s/"$//' | grep -v '^none$' | sort -u
+}
+
+# count FILE PATTERN: prints the number of lines of FILE that hold PATTERN.
+# Every image stands on one line, so the run breaks each element out first.
+count() {
+    tr '<' '\n' < "$1" | grep -c "$2" || true
+}
+
+# shape FILE NAME: gives 0 while the SVG FILE holds the shape NAME. The test
+# reads the elements of the image and the measures of the decoration.
+shape() {
+    s_rect=$(count "$1" '^rect ')
+    s_path=$(count "$1" '^path ')
+    s_open=$(count "$1" '^[a-z]* [^>]*fill="none"')
+    case $2 in
+        # One filled bar along the bottom edge of the square.
+        bar) [ "$s_rect" -eq 1 ] && [ "$s_path" -eq 0 ] &&
+             [ "$s_open" -eq 0 ] &&
+             grep -qF "<rect x=\"$glyph_origin\" y=\"10\" width=\"11\"" \
+                 "$1" &&
+             grep -qF "height=\"$bar_height\"" "$1";;
+        # One thin frame with a filled bar along the top edge.
+        square) [ "$s_rect" -eq 2 ] && [ "$s_path" -eq 0 ] &&
+             [ "$s_open" -eq 1 ] &&
+             grep -qF "width=\"$frame_side\" height=\"$frame_side\"" "$1" &&
+             grep -qF "stroke-width=\"$frame_width\"" "$1";;
+        # The window behind in three fills, then the whole window in front.
+        double) [ "$s_rect" -eq 5 ] && [ "$s_path" -eq 0 ] &&
+             [ "$s_open" -eq 1 ] &&
+             grep -qF "<rect x=\"$restore_left\"" "$1" &&
+             grep -qF "stroke-width=\"$frame_width\"" "$1";;
+        # Two lines from corner to corner of the square.
+        cross) [ "$s_rect" -eq 0 ] && [ "$s_path" -eq 1 ] &&
+             [ "$s_open" -eq 1 ] &&
+             grep -qF "d=\"M$glyph_origin $glyph_origin"\
+"L$glyph_far $glyph_far"\
+"M$glyph_far $glyph_origin"\
+"L$glyph_origin $glyph_far\"" "$1" &&
+             grep -qF "stroke-width=\"$stroke_width\"" "$1";;
+        *) return 1;;
+    esac
+}
+
+# block SHEET SELECTOR WANTED: gives 0 while the icon rule of SELECTOR holds
+# every line of WANTED.
+block() {
+    printf '%s\n' "$3" > "$tmp/want"
+    rule "$1" "$2" > "$tmp/got"
+    b_miss=0
+    # A property name opens with two dashes, so every pattern below stands
+    # after the end of the options of grep.
+    while IFS= read -r b_line; do
+        grep -qF -- "$b_line" "$tmp/got" || b_miss=$((b_miss + 1))
+    done < "$tmp/want"
+    [ "$b_miss" -eq 0 ]
+}
+
+# heavy BYTE: gives 0 while the hexadecimal BYTE stands at 230 or over.
+# DARK_WINDOW_TEXT in qt6/common/common.h reads a colour as dark while one
+# channel stands under that value.
+heavy() {
+    printf '%s\n' "$1" | grep -qE '^(f[0-9a-f]|e[6-9a-f])$'
+}
+
+# fade COLOUR: prints the alpha byte of the line art of COLOUR at rest. The
+# fade of the decoration follows the foreground that the state gives it.
+fade() {
+    f_red=$(printf '%s' "$1" | cut -c2-3)
+    f_green=$(printf '%s' "$1" | cut -c4-5)
+    f_blue=$(printf '%s' "$1" | cut -c6-7)
+    if heavy "$f_red" && heavy "$f_green" && heavy "$f_blue"; then
+        printf '%s\n' "$light_alpha"
+    else
+        printf '%s\n' "$dark_alpha"
+    fi
+}
+
+# check SHEET: gives 0 while every contract of the block holds. It names the
+# first contract that fails on the standard error.
+check() {
+    c_sheet=$1
+    c_ink=$(sed -n 's/^  --toolbox-text-color: \(#[0-9a-f]*\) !important;$'\
+'/\1/p' "$c_sheet")
+    c_dim=$(sed -n 's/^  --toolbox-text-color-inactive: \(#[0-9a-f]*\)'\
+' !important;$/\1/p' "$c_sheet")
+    if [ -z "$c_ink" ] || [ -z "$c_dim" ]; then
+        note "$c_sheet declares no title bar foreground of a window state"
+        return 1
+    fi
+    grep -q '^\.titlebar-button {$' "$c_sheet" || {
+        note "$c_sheet holds no caption block"
+        return 1
+    }
+    if ! printf '%s\n' "$box_rules" > "$tmp/box" ||
+       ! sed -n '/^\.titlebar-buttonbox {$/,/^}$/p' "$c_sheet" \
+           > "$tmp/boxgot"; then
+        note "$c_sheet holds no button box block"
+        return 1
+    fi
+    c_miss=0
+    while IFS= read -r c_line; do
+        grep -qF -- "$c_line" "$tmp/boxgot" || c_miss=$((c_miss + 1))
+    done < "$tmp/box"
+    if [ "$c_miss" -ne 0 ]; then
+        note "$c_sheet drops $c_miss button box measures of the decoration"
+        return 1
+    fi
+    if ! block "$c_sheet" '.titlebar-button' "$icon_rules"; then
+        note "$c_sheet drops a measure or the ground strip of the icon"
+        return 1
+    fi
+    c_rest=$(fade "$c_ink")
+    c_drest=$(fade "$c_dim")
+    c_seen=0
+    # A read inside a pipe cannot set a variable of this shell. The loop
+    # therefore reads the rows from a file of the run.
+    printf '%s\n' "$rows" > "$tmp/rows"
+    while read -r c_sel c_shape c_state c_want; do
+        [ -n "$c_sel" ] || continue
+        uri "$c_sheet" "$c_sel" > "$tmp/uri"
+        if [ ! -s "$tmp/uri" ]; then
+            note "$c_sheet gives $c_sel no image"
+            return 1
+        fi
+        decode < "$tmp/uri" > "$tmp/svg"
+        if grep -q '%' "$tmp/svg"; then
+            note "$c_sel keeps an escape that the decoder does not know"
+            return 1
+        fi
+        if ! grep -qF "$svg_head" "$tmp/svg" ||
+           ! grep -q '</svg>$' "$tmp/svg"; then
+            note "$c_sel gives no well formed image"
+            return 1
+        fi
+        if ! shape "$tmp/svg" "$c_shape"; then
+            note "$c_sel gives no $c_shape shape at the decoration measures"
+            return 1
+        fi
+        if [ "$c_state" = rest ]; then
+            if [ "$c_want" = ink ]; then
+                c_col=$c_ink$c_rest
+            else
+                c_col=$c_dim$c_drest
+            fi
+            bare "$tmp/svg" > "$tmp/bare.$c_shape"
+        else
+            case $c_want in
+                ink) c_col=$c_ink$lit_alpha;;
+                dim) c_col=$c_dim$lit_alpha;;
+                *) c_col=$close_hover$lit_alpha;;
+            esac
+            # The hover rule carries the image and no other property, so no
+            # ground, ring or pill reaches the button under the pointer.
+            c_extra=$(rule "$c_sheet" "$c_sel" |
+                grep -cv '^  background-image: url("data:image/svg+xml,'\
+'.*") !important;$' || true)
+            if [ "$c_extra" -ne 0 ]; then
+                note "$c_sel carries $c_extra property lines beside the image"
+                return 1
+            fi
+            bare "$tmp/svg" > "$tmp/lit"
+            if ! cmp -s "$tmp/lit" "$tmp/bare.$c_shape"; then
+                note "$c_sel moves the geometry of the $c_shape shape"
+                return 1
+            fi
+        fi
+        colours "$tmp/svg" > "$tmp/got"
+        printf '%s\n' "$c_col" > "$tmp/exp"
+        if ! cmp -s "$tmp/got" "$tmp/exp"; then
+            note "$c_sel holds $(tr '\n' ' ' < "$tmp/got")and not $c_col"
+            return 1
+        fi
+        c_seen=$((c_seen + 1))
+    done < "$tmp/rows"
+    rows_count=$(grep -c . "$tmp/rows")
+    if [ "$c_seen" -ne "$rows_count" ]; then
+        note "$c_sheet gives $c_seen images of $rows_count"
+        return 1
+    fi
+    return 0
+}
+
+if ! check "$sheet"; then
+    note "the sheet fails the check"
+    exit 1
+fi
+seen=$c_seen
+
+# The controls below. Each one doctors a copy of the sheet, and the check must
+# fail over that copy.
+broken=0
+
+# control NAME COPY: the check must fail over the copy that the caller gives.
+control() {
+    c_name=$1
+    if check "$2" 2> "$tmp/control.log"; then
+        note "the check passed the control copy of $c_name"
+        exit 1
+    fi
+    broken=$((broken + 1))
+}
+
+# A sheet of a stale image: the palette moves and the images stay. A user of
+# a new colour scheme reads the old line art without this control.
+sed 's/^  --toolbox-text-color: .*$/  --toolbox-text-color: #010203'\
+' !important;/' "$sheet" > "$tmp/stale.css"
+control stale "$tmp/stale.css"
+
+# The same fault over the foreground of a window without focus. That window
+# reads the images of a window with focus without this control.
+sed 's/^  --toolbox-text-color-inactive: .*$'\
+'/  --toolbox-text-color-inactive: #040506 !important;/' "$sheet" \
+    > "$tmp/dim.css"
+control dim "$tmp/dim.css"
+
+# A sheet with no caption block, which leaves the glyphs of the browser.
+sed '/^\.titlebar-buttonbox {$/,$d' "$sheet" > "$tmp/dropped.css"
+control dropped "$tmp/dropped.css"
+
+# move TARGET SOURCE SHEET OUT: writes SHEET to OUT with the image of the
+# button SOURCE in place of the image of the button TARGET.
+move() {
+    m_esc=$(printf '%s' "$1" | sed 's/[.[\*^$]/\\&/g')
+    m_from=$(printf '%s' "$2" | sed 's/[.[\*^$]/\\&/g')
+    sed "/^$m_esc > \.toolbarbutton-icon {\$/,/^}\$/{
+/^  background-image:/d
+}" "$3" > "$tmp/cut.css"
+    sed -n "/^$m_from > \.toolbarbutton-icon {\$/,/^}\$/p" "$3" |
+        grep '^  background-image:' > "$tmp/bar.line"
+    sed "/^$m_esc > \.toolbarbutton-icon {\$/r $tmp/bar.line" \
+        "$tmp/cut.css" > "$4"
+}
+
+# A sheet that gives the close button the bar of the minimize button.
+move '.titlebar-close' '.titlebar-min' "$sheet" "$tmp/swapped.css"
+control swapped "$tmp/swapped.css"
+
+# A sheet that gives the maximize button that same bar. One shape of the
+# family stands for another one without this control.
+move '.titlebar-max' '.titlebar-min' "$sheet" "$tmp/family.css"
+control family "$tmp/family.css"
+
+# A sheet whose maximize image lost the ground of the frame, which leaves a
+# solid square outside the family.
+sed '/^\.titlebar-max > \.toolbarbutton-icon {$/,/^}$/{
+s/%20fill=%22none%22//
+}' "$sheet" > "$tmp/filled.css"
+control filled "$tmp/filled.css"
+
+# A sheet whose close button takes a ground under the pointer. The ruling
+# gives the hover the colour of the symbol and nothing else.
+sed '/^\.titlebar-close:hover > \.toolbarbutton-icon {$/{
+a\
+  background-color: rgba(255,255,255,0.15) !important;
+}' "$sheet" > "$tmp/ground.css"
+control ground "$tmp/ground.css"
+
+# A sheet whose hover image of the maximize button moved its frame one pixel
+# down. The shape of that image stands, so the pair of the rest image and the
+# hover image alone catches the move. A hover that moves the line art is a
+# second shape without this control.
+sed '/^\.titlebar-max:hover > \.toolbarbutton-icon {$/,/^}$/{
+s/y=%221.5%22/y=%222.5%22/
+}' "$sheet" > "$tmp/moved.css"
+control moved "$tmp/moved.css"
+
+# A sheet that gives a button of a window without focus the shape of another
+# button. The rules of that window stand outside the shape check of a window
+# with focus without this control.
+move '.titlebar-min:-moz-window-inactive' '.titlebar-max' "$sheet" \
+    "$tmp/focus.css"
+control focus "$tmp/focus.css"
+
+# A sheet that takes the button spacing of the browser back. The buttons then
+# stand 13 pixels apart, and not the 2 pixels of the decoration.
+sed 's/^  --titlebar-button-spacing: 1px !important;$/'\
+'  --titlebar-button-spacing: 6.5px !important;/' "$sheet" > "$tmp/loose.css"
+control loose "$tmp/loose.css"
+
+echo "assert-ff-caption: $sheet holds $seen images of the decoration family," \
+     "each one decodes to one SVG of the shape, the measures and the colour" \
+     "of the sheet, no hover rule carries a ground, and the check rejects" \
+     "each of the $broken control copies"
