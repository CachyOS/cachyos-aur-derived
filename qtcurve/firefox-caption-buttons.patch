+#ifndef QTC_FIREFOX_CAPTION_H
+#define QTC_FIREFOX_CAPTION_H
+
+#include <palette.h>
+
+#include <QString>
+
+namespace QtCurve {
+namespace Firefox {
+
+/**
+ * Returns the caption rules of the sheet, which end with one newline. The
+ * rules take the appearance of the caption buttons away, and they hold no
+ * external file. Each button gets one inline image of the glyph family of
+ * the QtCurve window decoration, at the measures of that decoration. A
+ * window that holds no focus takes a second set of images, because the
+ * decoration reads the inactive foreground of the title bar.
+ *
+ * \param opts  the QtCurve settings, which give the button flags.
+ * \param pal   the colours of the live scheme or of a colour file.
+ * \return the caption rules, with one image for each state of a button.
+ */
+QString buildCaption(const Options &opts, const Gtk::Palette &pal);
+
+}
