+    an absent key, for an empty value and for an unknown name. */
+inline DecorationConfig::ButtonSize
+readButtonSize(const KConfigGroup &group, const char *key)
+{
+    const QString entry = group.readEntry(key, QString());
+    for (int size = DecorationConfig::BUTTON_TINY;
+         size <= DecorationConfig::BUTTON_VERY_LARGE; ++size) {
+        if (entry == QLatin1String(buttonSizeNames[size])) {
+            return DecorationConfig::ButtonSize(size);
+        }
+    }
+    return DecorationConfig::DEFAULT_BUTTON_SIZE;
