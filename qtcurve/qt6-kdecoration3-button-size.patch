+//! the names that the ButtonSize key holds, in the order of the sizes
+/*! The entry number is the DecorationConfig::ButtonSize value.
+    kcm_breezedecoration writes the same names to the breezerc file. */
+inline constexpr const char *
+buttonSizeNames[DecorationConfig::BUTTON_VERY_LARGE + 1] = {
+    "ButtonTiny", "ButtonSmall", "ButtonDefault", "ButtonLarge",
+    "ButtonVeryLarge"
+};
+
+//! the name that the ButtonSize key holds for one button size
+/*! \param size a DecorationConfig::ButtonSize value.
+    \return the name of that size, or the name of the default size for a value
+    outside the enumeration. */
+inline const char*
+buttonSizeName(int size)
+{
+    if (size < DecorationConfig::BUTTON_TINY ||
+        size > DecorationConfig::BUTTON_VERY_LARGE) {
+        return buttonSizeNames[DecorationConfig::DEFAULT_BUTTON_SIZE];
+    }
+    return buttonSizeNames[size];
+}
+
+//! read a button size key
+/*! The key holds the name of a size, as kcm_breezedecoration writes it.
+    \param group the group that holds the key.
+    \param key the name of the key.
+    \return the size of the name, or DecorationConfig::DEFAULT_BUTTON_SIZE for
+    an absent key, for an empty value and for an unknown name. */
+inline DecorationConfig::ButtonSize
+readButtonSize(const KConfigGroup &group, const char *key)
+{
+    const QString entry = group.readEntry(key, QString());
+    for (int size = DecorationConfig::BUTTON_TINY;
+         size <= DecorationConfig::BUTTON_VERY_LARGE; ++size) {
+        if (entry == QLatin1String(buttonSizeNames[size])) {
+            return DecorationConfig::ButtonSize(size);
+        }
+    }
+    return DecorationConfig::DEFAULT_BUTTON_SIZE;
+}
