+//! the title bar height that the decoration draws for a wanted height
+/*! \param height the wanted height, in pixels.
+    \return the height, which is never less than titleBarMinHeight. The value
+    is odd, as in the KDE4 decoration. An odd height gives an odd button side,
+    and an odd glyph side then has a centre pixel. */
+int
+fitTitleBarHeight(int height)
+{
+    height = qMax(height, titleBarMinHeight);
+    if (height % 2 == 0) {
+        height++;
+    }
+    return height;
+}
+
+//! the button side that the decoration draws for a wanted side
+/*! \param side the wanted side, in pixels.
+    \return the nearest odd number of pixels, and never less than 1 pixel. An
+    odd side keeps a centre pixel for the glyph, as an odd title bar height
+    does. A side at the same distance from two odd numbers takes the larger
+    one. */
+int
+fitButtonSide(qreal side)
+{
+    const int odd = int(std::lround((side - 1) / 2)) * 2 + 1;
+    return qMax(1, odd);
+}
