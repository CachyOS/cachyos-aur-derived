+                      i18nc("@item:inlistbox Button size:", "Tiny"));
+    combo->insertItem(DecorationConfig::BUTTON_SMALL,
+                      i18nc("@item:inlistbox Button size:", "Small"));
+    combo->insertItem(DecorationConfig::BUTTON_DEFAULT,
+                      i18nc("@item:inlistbox Button size:", "Normal"));
