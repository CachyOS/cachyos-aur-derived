+//! fill a combination box with the names of the button sizes
+/*! The entry number is the DecorationConfig::ButtonSize value. The order is
+    the order of kcm_breezedecoration. That module names the middle entry
+    Medium, and this module names it Normal.
+    \param combo the combination box. */
+void
+insertButtonSizeEntries(QComboBox *combo)
+{
+    using QtCurve::DecorationConfig;
+    // insertSizeEntries() in qt6/kwinconfig/qtcurvekwinconfig.cpp gives four
+    // border sizes the names Tiny, Normal, Large and Very Large. The context
+    // keeps the translation of a button size apart from the translation of a
+    // border size. kcm_breezedecoration holds the same context string.
+    combo->insertItem(DecorationConfig::BUTTON_TINY,
+                      i18nc("@item:inlistbox Button size:", "Tiny"));
+    combo->insertItem(DecorationConfig::BUTTON_SMALL,
+                      i18nc("@item:inlistbox Button size:", "Small"));
+    combo->insertItem(DecorationConfig::BUTTON_DEFAULT,
+                      i18nc("@item:inlistbox Button size:", "Normal"));
+    combo->insertItem(DecorationConfig::BUTTON_LARGE,
+                      i18nc("@item:inlistbox Button size:", "Large"));
+    combo->insertItem(DecorationConfig::BUTTON_VERY_LARGE,
+                      i18nc("@item:inlistbox Button size:", "Very Large"));
+}
+
 }
 
