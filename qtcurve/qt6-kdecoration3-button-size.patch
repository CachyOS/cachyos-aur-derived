+//! the number of grid units that each button size asks for
+/*! The entry number is the DecorationConfig::ButtonSize value, and the five
+    multiples are the multiples of the Breeze decoration.
+    KDecoration3::DecorationSettings::gridUnit() reports the grid unit in
+    pixels, and that unit follows the caption font. targetButtonSize() takes
+    each product to an odd number of pixels, and minButtonSide then raises a
+    small result. */
+const qreal
+buttonSizeGridUnits[QtCurve::DecorationConfig::BUTTON_VERY_LARGE + 1] = {
+    1.0, 1.5, 2.0, 2.5, 3.5
+};
+
+//! the smallest button side that the ButtonSize option gives, in pixels
+/*! targetButtonSize() applies this floor to each of the five sizes, so two
+    sizes can give the same side at a small grid unit. Button::paint() gives a
+    button of 7 pixels or less a line art of 3 pixels or less. drawGlyph()
+    then draws each stroke 1 pixel wide, and not 2 pixels wide. The floor
+    holds every button above that break. */
+const int minButtonSide = 11;
+
 //! the gap between the caption and a button group, in pixels
 const qreal captionPad = 4.0;
 
@@ -133,6 +153,33 @@ std::shared_ptr<KDecoration3::DecorationShadow> activeShadow;
 /*! The shadow does not depend on the window, so one shadow serves them all. */
 std::shared_ptr<KDecoration3::DecorationShadow> inactiveShadow;
 
+//! the title bar height that the decoration draws for a wanted height
+/*! \param height the wanted height, in pixels.
+    \return the height, which is never less than titleBarMinHeight. The value
+    is odd, as in the KDE4 decoration, so an odd button side leaves the same
+    gap above the button and below it. */
+int
+fitTitleBarHeight(int height)
+{
+    height = qMax(height, titleBarMinHeight);
+    if (height % 2 == 0) {
+        height++;
+    }
+    return height;
+}
+
+//! the button side that the decoration draws for a wanted side
+/*! \param side the wanted side, in pixels.
+    \return the nearest odd number of pixels, and never less than 1 pixel. A
+    side at the same distance from two odd numbers takes the larger one. An
+    odd side lets Button::paint() centre an odd line art on whole pixels. */
+int
+fitButtonSide(qreal side)
+{
+    const int odd = int(std::lround((side - 1) / 2)) * 2 + 1;
+    return qMax(1, odd);
+}
+
