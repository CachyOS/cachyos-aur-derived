+// Reset the options of the shown section to the values of the default
+// preset. The options of the other sections keep the live widget state.
+void QtCurveConfig::resetSection()
+{
+    if (!kwin->ok())
+        return;
+
+    QWidget *sect = stack->currentWidget();
+
+    if (sect == kwin) {
+        kwin->defaults();
+        return;
+    }
+
+    Options opts = presets[currentText].opts;
+
+    setOptions(opts);
+    if (!copySectionDefaults(sect, opts, presets[defaultText].opts))
+        return;
+    readyForPreview = false;
+    setWidgetOptions(opts);
+    readyForPreview = true;
+    if (settingsChanged(previewStyle))
+        updatePreview();
+    if (settingsChanged())
+        emit changed(true);
+    gradChanged(gradCombo->currentIndex());
+}
+
+// Copy the option fields of the shown stack section from src to dest.
+// Returns false for a section with no entry in the map; the caller then
+// does nothing, which matches the disabled button.
+bool QtCurveConfig::copySectionDefaults(QWidget *sect, Options &dest,
+                                        const Options &src)
+{
+    bool found = false;
+
+#define QTC_FIELD(PAGE, FIELD)                          \
+    if (sect == PAGE) {                                 \
+        dest.FIELD = src.FIELD;                         \
+        found = true;                                   \
+    }
+#define QTC_FIELD_MASK(PAGE, FIELD, MASK)               \
+    if (sect == PAGE) {                                 \
+        dest.FIELD = (dest.FIELD & ~(MASK)) | (src.FIELD & (MASK)); \
+        found = true;                                   \
+    }
+#define QTC_FIELD_ARRAY(PAGE, FIELD)                    \
+    if (sect == PAGE) {                                 \
+        memcpy(dest.FIELD, src.FIELD, sizeof(dest.FIELD)); \
+        found = true;                                   \
+    }
+    QTC_SECTION_FIELDS
+#undef QTC_FIELD
+#undef QTC_FIELD_MASK
+#undef QTC_FIELD_ARRAY
+
+    return found;
+}
+
+void QtCurveConfig::updateResetSectionButton()
+{
+    QWidget *sect = stack->currentWidget();
+    bool canReset = sect != page_24 && sect != page_25;
+
+    resetSectionButton->setEnabled(canReset);
+    resetSectionButton->setToolTip(canReset
+        ? i18n("<p>Reset the settings of the shown section to their "
+               "default values. The settings of all other sections do "
+               "not change.</p><p>Nothing is saved until you press "
+               "OK.</p>")
+        : i18n("This section has no settings of its own to reset."));
+}
