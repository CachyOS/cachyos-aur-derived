 void QtCurveConfig::populateShades(const Options &opts)
+{
+    customShading->setChecked(USE_CUSTOM_SHADES(opts));
+
+    if(USE_CUSTOM_SHADES(opts))
+        for(int i=0; i<QTC_NUM_STD_SHADES; ++i)
+            shadeVals[i]->setValue(opts.customShades[i]);
+    else
+        populateInternShades();
+
+    customAlphas->setChecked(USE_CUSTOM_ALPHAS(opts));
+    // The style reads the light alpha where ETCH_BOTTOM_ALPHA stands, and it
+    // reads the dark alpha where ETCH_TOP_ALPHA stands.
+    alphaVals[ALPHA_ETCH_LIGHT]->setValue(USE_CUSTOM_ALPHAS(opts)
+                                          ? opts.customAlphas[ALPHA_ETCH_LIGHT]
+                                          : ETCH_BOTTOM_ALPHA);
+    alphaVals[ALPHA_ETCH_DARK]->setValue(USE_CUSTOM_ALPHAS(opts)
+                                         ? opts.customAlphas[ALPHA_ETCH_DARK]
+                                         : ETCH_TOP_ALPHA);
+}
+
+/**
+ * Shows the shade values of the current shading routine in the boxes of the
+ * custom shades group. The values carry the darker borders adjustment that
+ * the style applies. The boxes emit no signal, so a write here never
+ * re-enters updateChanged(). Each interactive caller reports the change.
+ */
+void QtCurveConfig::populateInternShades()
 {
     int contrast = (QSettings(QLatin1String("Trolltech"))
                     .value("/Qt/KDE/contrast", 7).toInt());
@@ -2444,17 +2482,14 @@ void QtCurveConfig::populateShades(const Options &opts)
     if(contrast<0 || contrast>10)
         contrast=7;
 
-    customShading->setChecked(USE_CUSTOM_SHADES(opts));
-
     for(int i=0; i<QTC_NUM_STD_SHADES; ++i)
-        shadeVals[i]->setValue(USE_CUSTOM_SHADES(opts) ? opts.customShades[i] :
-                               qtc_intern_shades[shading->currentIndex() ==
-                                                 int(Shading::Simple) ? 1 : 0]
-                               [contrast][i]);
+    {
+        const QSignalBlocker blocker(shadeVals[i]);
 
-    customAlphas->setChecked(USE_CUSTOM_ALPHAS(opts));
-    alphaVals[0]->setValue(USE_CUSTOM_ALPHAS(opts) ? opts.customAlphas[0] : ETCH_TOP_ALPHA);
-    alphaVals[1]->setValue(USE_CUSTOM_ALPHAS(opts) ? opts.customAlphas[1] : ETCH_BOTTOM_ALPHA);
+        shadeVals[i]->setValue(qtcShadeGetIntern(contrast, i,
+                                                 darkerBorders->isChecked(),
+                                                 currentShading()));
+    }
 }
 
