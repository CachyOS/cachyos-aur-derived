@@ -790,9 +792,14 @@ static void readDoubleList(QtCConfig &cfg, const char *key, double *list, int co
         opts->ENTRY = readNumEntry(cfg, #ENTRY, def->ENTRY);    \
     } while (0)
 
+// The key held a boolean before the option became a bit mask, so true
+// selects DEF and false selects zero.
 #define CFG_READ_INT_BOOL(ENTRY, DEF) do {                              \
-        if (readBoolEntry(cfg, #ENTRY, false)) {                        \
