 /**
- * Prints one notice line when the prefs.js file of the profile dir holds no
- * user_pref row of the style sheet preference. The writer reads that file and
- * never writes it, so a torn read can print one notice that the user does not
- * need.
+ * Holds each profile after its notice line, until a pass reads the row
+ * of the style sheet preference in its prefs.js. A pass that writes no
+ * sheet prints no second line for a profile of the set.
+ */
+QSet<QString> noticedProfiles;
+
+/**
+ * Prints one notice line when prefs.js of the profile dir holds no row of
+ * the style sheet preference and noticedProfiles does not hold dir. The
+ * writer reads that file and never writes it, so a torn read can print
+ * one notice that the user does not need.
+ *
+ * \param dir the profile directory, which keys noticedProfiles.
+ * \param wrote true when the pass wrote a sheet of the profile. The line
+ *     then prints for a profile of noticedProfiles too.
  */
 void
-noticePref(const QString &dir)
+noticePref(const QString &dir, bool wrote)
 {
     const QString prefs = dir + QLatin1Char('/') +
         QString::fromLatin1(prefsName);
@@ -278,8 +290,13 @@ noticePref(const QString &dir)
     row.append(styleSheetPref);
     row.append("\", true);");
     if (holdsLine(prefs, row)) {
+        noticedProfiles.remove(dir);
+        return;
+    }
+    if (!wrote && noticedProfiles.contains(dir)) {
         return;
     }
+    noticedProfiles.insert(dir);
     printf("%s: the profile %s needs %s true, which about:config sets\n",
            writerName, dir.toLocal8Bit().constData(), styleSheetPref);
 }
@@ -358,13 +375,14 @@ writeProfile(const QByteArray &chrome, const QByteArray &content,
     if (code != 0) {
         return code;
     }
-    if (changedChrome || !hadImportChrome || changedContent ||
-        !hadImportContent) {
+    const bool wrote = changedChrome || !hadImportChrome || changedContent ||
+        !hadImportContent;
+    if (wrote) {
         printf("%s: the profile %s holds the new sheets, and Firefox takes"
                " them after a restart\n", writerName,
                dir.toLocal8Bit().constData());
     }
-    noticePref(dir);
+    noticePref(dir, wrote);
     return 0;
 }
 
