diff --git a/firefox/writer/sheet.cpp b/firefox/writer/sheet.cpp
index c9a947c4..ca51fcec 100644
--- a/firefox/writer/sheet.cpp
+++ b/firefox/writer/sheet.cpp
@@ -83,6 +83,26 @@ toolboxImages(const Options &opts, const Palette &pal)
     return out;
 }
 
+/**
+ * Returns the icon rules of the chrome. Each property holds the text colour
+ * of the element that reads it, and the map gives that colour to every
+ * surface of the sheet. The menu property stands on the popup of the chrome
+ * and never on the root, so a rule of the root cannot reach it. The button
+ * property reaches a shadow tree through the root, because a custom property
+ * crosses a shadow boundary.
+ */
+QString
+iconFills()
+{
+    return QStringLiteral("\n:root {\n"
+                          "  --button-icon-fill: currentColor !important;\n"
+                          "  --button-icon-stroke: currentColor !important;\n"
+                          "}\n"
+                          "\nmenupopup {\n"
+                          "  --menuitem-icon-fill: currentColor !important;\n"
+                          "}\n");
+}
+
 /**
  * The colour of the drop shadow of a popup, as one channel from 0 to 255. c1
  * of qtcX11ShadowInit() in lib/utils/x11helpers.cpp holds 0.4 of the range,
@@ -161,6 +181,7 @@ buildSheet(const Options &opts, const Palette &pal)
     }
     out += QStringLiteral("}\n");
     out += toolboxImages(opts, pal);
+    out += iconFills();
     out += popupShadow(opts);
     out += buildCaption(opts, pal);
     return out;
