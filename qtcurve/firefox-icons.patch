diff --git a/firefox/check/assert-ff-icons.sh b/firefox/check/assert-ff-icons.sh
new file mode 100644
index 00000000..c1c25292
--- /dev/null
+++ b/firefox/check/assert-ff-icons.sh
@@ -0,0 +1,216 @@
+#!/bin/sh
+# assert-ff-icons.sh WRITER WORKDIR: the sheet must recolour the icons of the
+# browser from the colour scheme. It must reach them through the fill
+# properties of the chrome alone. The attention pair must hold the selection
+# colours of the map. The three pinned properties must hold the text colour of
+# the element that reads them. No rule may name a context paint keyword or the
+# preference that gates one. The browser paints a context glyph of an inline
+# image black. A false gate must take the sheet away. HOME,
+# XDG_CONFIG_HOME and QTCURVE_CONFIG_DIR point into WORKDIR, because the
+# writer rewrites the files of the caller.
+set -eu
+ulimit -c 0
+usage='usage: assert-ff-icons.sh WRITER WORKDIR'
+writer=${1:?$usage}
+work=${2:?$usage}
+
+# A relative path leaves XDG_CONFIG_HOME outside the root of the file system.
+# The library of the writer then reads the configuration home of the caller.
+case $work in
+    /*) ;;
+    *) work=$PWD/$work;;
+esac
+
+owned=chrome/qtcurve-userChrome.css
+home=$work/home
+root=$home/.config/mozilla/firefox
+dir=$root/icons.default
+qtc=$home/qtcurve
+sheet=$dir/$owned
+status=0
+
+# The three properties that the sheet pins at the text colour of the element.
+# tokens-shared.css of omni.ja declares the two button properties on the root
+# at line 126 and line 127. menu.css declares the menu property on the popup
+# at line 44. Each shipped value is currentColor.
+pin_root='  --button-icon-fill: currentColor !important;
+  --button-icon-stroke: currentColor !important;'
+pin_menu='  --menuitem-icon-fill: currentColor !important;'
+
+# The two properties of the attention state. tokens-platform.css of omni.ja
+# declares them on the root at line 91 and line 92. The shipped value is the
+# accent colour of the desktop and no colour of the scheme.
+fill_attention='--toolbarbutton-icon-fill-attention'
+text_attention='--toolbarbutton-icon-fill-attention-text'
+
+# The two properties of the same rows of the map. assert-ff-agree.sh reads the
+# rows, and the arm below reads one value of each row against the pair above.
+fill_row='--urlbarview-background-color-selected'
+text_row='--urlbarview-text-color-selected'
+
+# The keywords of the context paint of an image, and the preference that gates
+# them. SVGContextPaint.cpp of the browser blocks the keywords for an inline
+# image, so a sheet that names one paints a black glyph.
+banned='context-fill
+context-stroke
+-moz-context-properties
+svg.context-properties.content.enabled'
+
+fail() {
+    echo "assert-ff-icons: $1" >&2
+    status=1
+}
+
+rm -rf "$work"
+mkdir -p "$dir/chrome" "$qtc"
+printf '[Profile0]\nName=icons\nIsRelative=1\nPath=icons.default\n' \
+    > "$root/profiles.ini"
+
+# settings VALUE: writes the settings file of the user with the gate at VALUE.
+settings() {
+    printf '[Settings]\nfirefoxTheme=%s\n' "$1" > "$qtc/stylerc"
+}
+
+# run NAME: runs one write pass over the private home, and holds the exit code
+# in the variable code.
+run() {
+    r_name=$1
+    code=0
+    HOME=$home XDG_CONFIG_HOME=$home/.config QTCURVE_CONFIG_DIR=$qtc \
+        "$writer" --write > "$work/$r_name.log" 2>&1 || code=$?
+}
+
+# value FILE NAME: prints the value of the custom property NAME of the sheet
+# FILE, and prints nothing when the sheet does not set it.
+value() {
+    sed -n "s/^  $2: \\(.*\\) !important;\$/\\1/p" "$1"
+}
+
+# body FILE SELECTOR: prints the body of the block of SELECTOR, with no brace
+# line. A block ends at the first line that holds one closing brace.
+body() {
+    b_esc=$(printf '%s' "$2" | sed 's/[.[\*^$]/\\&/g')
+    sed -n "/^$b_esc {\$/,/^}\$/p" "$1" | sed -e '1d' -e '$d'
+}
+
+# holds FILE SELECTOR WANTED: gives 0 while the block of SELECTOR holds every
+# line of WANTED.
+holds() {
+    printf '%s\n' "$3" > "$work/want"
+    body "$1" "$2" > "$work/got"
+    h_miss=0
+    # A property name opens with two dashes, so the pattern below stands after
+    # the end of the options of grep.
+    while IFS= read -r h_line; do
+        grep -qF -- "$h_line" "$work/got" || h_miss=$((h_miss + 1))
+    done < "$work/want"
+    [ "$h_miss" -eq 0 ]
+}
+
+# check SHEET: gives 0 while every contract of the icon rules holds. It names
+# the first contract that fails on the standard error.
+check() {
+    c_sheet=$1
+    for c_one in $banned; do
+        if grep -qF -- "$c_one" "$c_sheet"; then
+            echo "assert-ff-icons: $c_sheet names $c_one" >&2
+            return 1
+        fi
+    done
+    if ! holds "$c_sheet" ':root' "$pin_root"; then
+        echo "assert-ff-icons: $c_sheet drops a button icon property" >&2
+        return 1
+    fi
+    if ! holds "$c_sheet" 'menupopup' "$pin_menu"; then
+        echo "assert-ff-icons: $c_sheet drops the menu icon property" >&2
+        return 1
+    fi
+    c_fill=$(value "$c_sheet" "$fill_attention")
+    c_text=$(value "$c_sheet" "$text_attention")
+    c_row=$(value "$c_sheet" "$fill_row")
+    c_trow=$(value "$c_sheet" "$text_row")
+    if [ -z "$c_fill" ] || [ -z "$c_text" ]; then
+        echo "assert-ff-icons: $c_sheet sets no attention colour" >&2
+        return 1
+    fi
+    case $c_fill in
+        '#'*) ;;
+        *) echo "assert-ff-icons: the attention fill $c_fill is no colour" >&2
+           return 1;;
+    esac
+    if [ "$c_fill" != "$c_row" ] || [ "$c_text" != "$c_trow" ]; then
+        echo "assert-ff-icons: the attention pair holds $c_fill and $c_text," \
+             "and the rows hold $c_row and $c_trow" >&2
+        return 1
+    fi
+    return 0
+}
+
+# 1. A true gate writes the sheet, and that sheet carries the icon rules.
+settings true
+run true
+[ "$code" -eq 0 ] || fail "the true gate gave the code $code"
+[ -s "$sheet" ] || fail "the true gate wrote no sheet"
+check "$sheet" || fail "the true gate dropped the icon rules"
+cp "$sheet" "$work/on.css"
+
+# 2. A false gate takes the sheet away, so no icon rule reaches a profile.
+settings false
+run false
+[ "$code" -eq 0 ] || fail "the false gate gave the code $code"
+if [ -e "$sheet" ]; then
+    fail "the false gate left the sheet of the profile behind"
+fi
+
+# The controls below. Each one doctors a copy of the sheet of the true gate,
+# and the check must fail over that copy.
+broken=0
+
+# control NAME COPY: the check must fail over the copy that the caller gives.
+control() {
+    c_name=$1
+    if check "$2" 2> "$work/control.log"; then
+        echo "assert-ff-icons: the check passed the control copy of" \
+             "$c_name" >&2
+        exit 1
+    fi
+    broken=$((broken + 1))
+}
+
+# A sheet that reaches the icons through the context paint of the browser. An
+# inline image of that route paints a black glyph, and the sheet holds inline
+# images alone.
+sed '/^:root {$/a\
+  --qtc-icon: context-fill !important;' "$work/on.css" > "$work/paint.css"
+control paint "$work/paint.css"
+
+# A sheet that names the preference of the context paint. The theme must ask
+# a user for no preference beside the one of the sheets.
+sed '1a\
+/* svg.context-properties.content.enabled */' "$work/on.css" \
+    > "$work/pref.css"
+control pref "$work/pref.css"
+
+# A sheet that lost the pinned properties of the root, which leaves the icons
+# of a shadow tree to a layer of the browser.
+sed '/^  --button-icon-fill: /d' "$work/on.css" > "$work/root.css"
+control root "$work/root.css"
+
+# A sheet that lost the block of the popup. A rule of the root cannot reach
+# the menu property, because the browser declares it on the popup.
+sed '/^menupopup {$/,/^}$/d' "$work/on.css" > "$work/menu.css"
+control menu "$work/menu.css"
+
+# A sheet whose attention colour left its row of the map, which paints the
+# badge of a button in a colour of no scheme.
+sed "s/^  $fill_attention: .*\$/  $fill_attention: #010203 !important;/" \
+    "$work/on.css" > "$work/loose.css"
+control loose "$work/loose.css"
+
+if [ $status -eq 0 ]; then
+    echo "assert-ff-icons: the sheet pins the three icon properties, binds" \
+         "the attention pair to the rows of the map, names no context paint" \
+         "keyword and no preference, the false gate took the sheet away, and" \
+         "the check rejects each of the $broken control copies"
+fi
+exit $status
