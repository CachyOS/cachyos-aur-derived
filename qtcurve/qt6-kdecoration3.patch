+//! the smallest title bar height, in pixels
+/*! readConfig() in qt6/kwin/qtcurvehandler.cpp uses the same figure, but it
+    applies the floor before the TitleBarPad value. A negative pad therefore
+    drives the title bar of the KDE4 decoration below this height. */
+const int titleBarMinHeight = 16;
+
+//! the room above and below the caption, in pixels
+/*! The KDE4 decoration adds this room to the font height so the caption shadow
+    fits inside the title bar. */
+const int titleBarTextPad = 4;
+
+//! the gap between the window edge and a button group, in pixels
+const qreal buttonEdgePad = 4.0;
+
+//! the gap between the title bar edge and a button, in pixels
+/*! The gap keeps a round button clear of the title bar border. */
+const qreal buttonVerticalPad = 3.0;
+
+//! the gap between two buttons, in pixels
+const qreal buttonSpacing = 2.0;
+
+//! the gap between the caption and a button group, in pixels
+const qreal captionPad = 4.0;
+
+//! the gap between the window icon and the caption, in pixels
+/*! constTitlePad in qt6/kwin/qtcurveclient.cpp holds the same value. */
+const qreal iconPad = 4.0;
+
+//! the corner radius of the top of a window with no title bar appearance
+/*! QtCurveClient::paintEvent() in qt6/kwin/qtcurveclient.cpp used the same
