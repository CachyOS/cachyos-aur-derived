+#ifndef qtcurvedecoration_h
+#define qtcurvedecoration_h
+
+#include "qtcurvedecorationconfig.h"
+
+#include <KDecoration3/DecoratedWindow>
+#include <KDecoration3/Decoration>
+
+#include <QColor>
+#include <QMarginsF>
+#include <QPainterPath>
+#include <QRectF>
+#include <QVariantList>
+
+namespace KDecoration3 {
+class DecorationButtonGroup;
+}
+
+namespace QtCurve {
+
+//! darken or lighten a colour the way the QtCurve style does
+/*! \param base the colour to change.
+    \param factor the shade factor. A factor above 1.0 gives a lighter colour
+    and a factor below 1.0 gives a darker colour.
+    \param shading the shading mode of the style settings.
+    \return the shaded colour, with the alpha value of the base. */
+QColor shade(const QColor &base, double factor, Shading shading);
+
+//! paint a QtCurve appearance from the top of a shape to the bottom of the shape
+/*! A flat appearance gives a plain fill. Every other appearance gives the
+    gradient that qtcGetGradient() holds for it.
+    \param painter the painter to draw with.
+    \param path the shape to fill.
+    \param base the colour that the shade factors of the gradient act on.
+    \param app the appearance to draw.
+    \param opts the settings of the style. */
+void fillGradient(QPainter *painter, const QPainterPath &path,
+                  const QColor &base, EAppearance app, const Options &opts);
+
+//! the QtCurve window decoration for Plasma 6
+/*! The decoration draws the title bar, the caption, the buttons and the window
+    border for one window. It takes the colours and the border size from
+    KDecoration3, and it takes the look from the configuration file of the
+    QtCurve style. The compositor thread owns every decoration. */
+class Decoration : public KDecoration3::Decoration {
+    Q_OBJECT
+public:
+    //! make a decoration
+    /*! \param parent the parent object, or a null pointer.
+        \param args the arguments of the decoration framework. The framework
+        passes the bridge and the window in this list. */
+    explicit Decoration(QObject *parent=nullptr,
+                        const QVariantList &args=QVariantList());
+    ~Decoration() override;
+
+    //! draw the decoration
+    /*! \param painter the painter of the decoration framework.
+        \param repaintRegion the area that needs paint, in the coordinates of
+        the decoration. */
+    void paint(QPainter *painter, const QRectF &repaintRegion) override;
+
+    //! the settings of the QtCurve style
+    /*! \return the options of the single Config of the process. */
+    const Options &options() const;
+
+    //! the colour under the title bar gradient
+    /*! \return the title bar colour of the active window group, or of the
+        inactive window group. */
+    QColor titleBarColor() const;
+
+    //! the colour of the caption and of the button glyphs
+    /*! \return the foreground colour of the active window group, or of the
+        inactive window group. */
+    QColor fontColor() const;
+
+    //! the appearance of the title bar of the current window state
+    /*! \return titlebarAppearance for an active window, and
+        inactiveTitlebarAppearance for an inactive window. */
+    EAppearance titleBarAppearance() const;
+
+    //! the length of one side of a square title bar button, in pixels
+    qreal buttonSize() const;
+
+public Q_SLOTS:
+    //! connect the signals and make the buttons
+    /*! The decoration framework calls this method one time, after it builds
+        the decoration.
+        \return true. The decoration needs no resource that can fail. */
+    bool init() override;
+
+private Q_SLOTS:
+    //! give the borders, the grab areas and the corner radius their values
+    /*! The border size of the settings, the maximized state of the window and
+        the screen edges beside the window select the three values. */
+    void recalculateBorders();
+    //! put the buttons in the title bar
+    void updateButtonsGeometry();
+    //! put the buttons in the title bar at the end of the current event cycle
+    /*! The button group of the framework reads the button list of the settings
+        after it emits the change signal. The move therefore waits for the
+        timer. */
+    void updateButtonsGeometryDelayed();
+    //! tell the framework which area takes a click on the title bar
+    void updateTitleBar();
+    //! give the window the drop shadow of the current window state
+    void updateShadow();
+
+private:
+    //! the area that holds the caption
+    /*! \return the rectangle between the two button groups, and the alignment
+        of the caption in that rectangle. The titlebarAlignment key selects the
+        alignment. The full centre alignment centres the caption over the whole
+        title bar while the text fits there. The caption sits beside a button
+        group while the text does not fit. */
+    QPair<QRectF, Qt::Alignment> captionRect() const;
+
+    //! draw the title bar, the caption and the buttons
+    /*! \param painter the painter of the decoration framework.
+        \param repaintRegion the area that needs paint. The call returns at
+        once when the area misses the title bar. */
+    void paintTitleBar(QPainter *painter, const QRectF &repaintRegion);
+
+    //! the height of the title bar, in pixels
+    /*! The value holds the height of the caption font, room for the caption
+        shadow, and two times the TitleBarPad value of the kwinqtcurverc file.
+        A negative pad value drives the sum down, so the floor applies after
+        the pad.
+        \return the height, which is never less than 16 pixels. The value is
+        odd, as in the KDE4 decoration, so a button and a glyph both keep a
+        centre pixel. */
+    qreal titleBarHeight() const;
+
+    //! the width of the side border and of the bottom border, in pixels
+    /*! \param bottom true for the bottom border, false for a side border.
+        \param scale the scale of the screen that shows the window.
+        \return the border width for the border size of the settings, after the
+        OuterBorder key, the InnerBorder key and the EdgePad key change it. The
+        width is zero for the None size, and zero for a side border at the
+        NoSides size. */
+    qreal borderSize(bool bottom, qreal scale) const;
+
+    //! the four borders of the window
+    /*! \param scale the scale of the screen that shows the window.
+        \return the border widths. A border is zero where the window is
+        maximized, where the window touches the screen edge, or where the
+        shaded state hides it. */
+    QMarginsF bordersFor(qreal scale) const;
+
+    //! the corner radius of the top of the window, in pixels
+    /*! \return zero for a maximized window, for a screen with no alpha channel
+        and for a round key below the full value. Every other window gets 6.0
+        pixels for a title bar with no appearance, and 8.0 pixels for every
+        other title bar. The KDE4 decoration used the same two values. */
+    qreal topRadius() const;
+
+    //! the corner radius of the bottom of the window, in pixels
+    /*! \return zero where topRadius() gives zero. The RoundBottom key of the
+        kwinqtcurverc file selects 6.0 pixels or 1.0 pixel. */
+    qreal bottomRadius() const;
+
+    //! the outline of the whole decoration
+    /*! \return a rectangle with the corner radius of the two radius methods. */
+    QPainterPath framePath() const;
+
+    //! the colour of one window border line
+    /*! \param shadeType the shade that the OuterBorder key or the InnerBorder
+        key holds.
+        \return the light shade of the title bar colour, the border shade of
+        the title bar colour, or the colour of the drop shadow. The border
+        shade also answers the no shade value, so a window keeps a visible
+        edge. */
+    QColor borderColor(DecorationConfig::Shade shadeType) const;
+
+    //! the buttons at the left end of the title bar
+    KDecoration3::DecorationButtonGroup *m_leftButtons=nullptr;
+    //! the buttons at the right end of the title bar
+    KDecoration3::DecorationButtonGroup *m_rightButtons=nullptr;
+};
+
+}
+
+#endif
