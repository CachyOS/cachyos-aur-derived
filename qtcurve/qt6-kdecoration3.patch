+ *****************************************************************************/
+
+#include "qtcurvedecorationbutton.h"
+
+#include <KDecoration3/DecoratedWindow>
+
+#include <QPainter>
+#include <QPolygonF>
+#include <QRectF>
+
+#include <qtcurve-utils/color.h>
+
+#include <cmath>
+
+namespace {
+
+//! the smallest side of the line art of a button, in pixels
+const qreal minGlyphSide = 5.0;
+
+//! the entry of the titlebarButtonColors key for one button type
+/*! \param type the button type of the decoration framework.
+    \return the entry, or NUM_TITLEBAR_BUTTONS while the key holds no entry
+    for the type. */
+int
+buttonColorIndex(KDecoration3::DecorationButtonType type)
+{
+    switch (type) {
+    case KDecoration3::DecorationButtonType::Close:
+        return TITLEBAR_CLOSE;
+    case KDecoration3::DecorationButtonType::Minimize:
+        return TITLEBAR_MIN;
+    case KDecoration3::DecorationButtonType::Maximize:
+        return TITLEBAR_MAX;
+    case KDecoration3::DecorationButtonType::ContextHelp:
+        return TITLEBAR_HELP;
+    case KDecoration3::DecorationButtonType::Menu:
+    case KDecoration3::DecorationButtonType::ApplicationMenu:
+        return TITLEBAR_MENU;
+    case KDecoration3::DecorationButtonType::Shade:
+        return TITLEBAR_SHADE;
+    case KDecoration3::DecorationButtonType::OnAllDesktops:
+        return TITLEBAR_ALL_DESKTOPS;
+    case KDecoration3::DecorationButtonType::KeepAbove:
+        return TITLEBAR_KEEP_ABOVE;
+    case KDecoration3::DecorationButtonType::KeepBelow:
+        return TITLEBAR_KEEP_BELOW;
+    default:
+        return NUM_TITLEBAR_BUTTONS;
+    }
+}
+
+//! draw a filled triangle
+/*! \param painter the painter to draw with. The call uses the brush of the
+    painter.
+    \param rect the area of the triangle.
+    \param up true for a triangle that points up, false for a triangle that
+    points down. */
+void
+drawArrow(QPainter *painter, const QRectF &rect, bool up)
+{
+    QPolygonF arrow;
+    if (up) {
+        arrow << QPointF(rect.left(), rect.bottom())
+              << QPointF(rect.right(), rect.bottom())
+              << QPointF(rect.center().x(), rect.top());
+    } else {
+        arrow << QPointF(rect.left(), rect.top())
+              << QPointF(rect.right(), rect.top())
+              << QPointF(rect.center().x(), rect.bottom());
+    }
+    painter->drawPolygon(arrow);
+}
+
+//! draw the symbol of a window
+/*! The symbol is a thin frame with a thick bar along the top edge, as in
+    IconEngine::icon() of the KDE4 decoration.
+    \param painter the painter to draw with. The call draws the frame with the
+    pen and fills the bar with the colour of the pen. The call takes no colour
+    from the brush, and every caller sets Qt::NoBrush, because a brush fills
+    the frame.
+    \param rect the area of the symbol.
+    \param frameWidth the width of the frame, in pixels.
+    \param barHeight the height of the bar, in pixels. */
+void
+drawWindowSymbol(QPainter *painter, const QRectF &rect, qreal frameWidth,
+                 qreal barHeight)
+{
+    const qreal inset = frameWidth / 2.0;
+    painter->drawRect(rect.adjusted(inset, inset, -inset, -inset));
+    painter->fillRect(QRectF(rect.left(), rect.top(), rect.width(), barHeight),
+                      painter->pen().color());
+}
+
+}
+
+namespace QtCurve {
+
+using KDecoration3::DecorationButtonType;
+
+Button::Button(DecorationButtonType type, Decoration *decoration,
+               QObject *parent)
+    : KDecoration3::DecorationButton(type, decoration, parent)
+{
+    connect(this, &KDecoration3::DecorationButton::hoveredChanged,
+            this, [this]() {
+                update();
+            });
+    connect(this, &KDecoration3::DecorationButton::pressedChanged,
+            this, [this]() {
+                update();
+            });
+}
+
+Button::Button(QObject *parent, const QVariantList &args)
+    : Button(args.at(0).value<DecorationButtonType>(),
+             args.at(1).value<Decoration*>(), parent)
+{
+}
+
+Button*
+Button::create(DecorationButtonType type, KDecoration3::Decoration *decoration,
+               QObject *parent)
+{
+    auto *owner = qobject_cast<Decoration*>(decoration);
+    if (!owner) {
+        return nullptr;
+    }
+    auto *button = new Button(type, owner, parent);
+    const auto *decorated = owner->window();
+    switch (type) {
+    case DecorationButtonType::Close:
+        button->setVisible(decorated->isCloseable());
+        connect(decorated, &KDecoration3::DecoratedWindow::closeableChanged,
+                button, &Button::setVisible);
+        break;
+    case DecorationButtonType::Maximize:
+        button->setVisible(decorated->isMaximizeable());
+        connect(decorated, &KDecoration3::DecoratedWindow::maximizeableChanged,
+                button, &Button::setVisible);
+        break;
+    case DecorationButtonType::Minimize:
+        button->setVisible(decorated->isMinimizeable());
+        connect(decorated, &KDecoration3::DecoratedWindow::minimizeableChanged,
+                button, &Button::setVisible);
+        break;
+    case DecorationButtonType::ContextHelp:
+        button->setVisible(decorated->providesContextHelp());
+        connect(decorated,
+                &KDecoration3::DecoratedWindow::providesContextHelpChanged,
+                button, &Button::setVisible);
+        break;
+    case DecorationButtonType::Shade:
+        button->setVisible(decorated->isShadeable());
+        connect(decorated, &KDecoration3::DecoratedWindow::shadeableChanged,
+                button, &Button::setVisible);
+        break;
+    default:
+        break;
+    }
+    return button;
+}
+
+bool
+Button::colored() const
+{
+    const auto *owner = qobject_cast<Decoration*>(decoration());
+    if (!owner) {
+        return false;
+    }
+    const int flags = owner->options().titlebarButtons;
+    if (!(flags & TITLEBAR_BUTTON_COLOR)) {
+        return false;
+    }
+    const bool hover = isHovered() || isPressed();
+    if (owner->window()->isActive()) {
+        return hover || !(flags & TITLEBAR_BUTTON_COLOR_MOUSE_OVER);
+    }
+    return ((flags & TITLEBAR_BUTTON_COLOR_MOUSE_OVER) && hover) ||
+        (!(flags & TITLEBAR_BUTTON_COLOR_MOUSE_OVER) &&
+         (flags & TITLEBAR_BUTTON_COLOR_INACTIVE));
+}
+
+QColor
+Button::buttonColor() const
+{
+    const auto *owner = qobject_cast<Decoration*>(decoration());
+    if (!owner) {
+        return QColor();
+    }
+    const Options &opts = owner->options();
+    const auto entry = opts.titlebarButtonColors.find(buttonColorIndex(type()));
+    if (entry == opts.titlebarButtonColors.end()) {
+        return owner->titleBarColor();
+    }
+    return entry->second;
+}
+
+QColor
+Button::glyphColor() const
+{
+    const auto *owner = qobject_cast<Decoration*>(decoration());
+    if (!owner) {
+        return QColor();
+    }
+    const Options &opts = owner->options();
+    const int flags = opts.titlebarButtons;
+    QColor color = owner->fontColor();
+    if (colored() && (flags & TITLEBAR_BUTTON_COLOR_SYMBOL)) {
+        color = buttonColor();
+    } else if (isHovered() && !isPressed() &&
+               !(flags & TITLEBAR_BUTTON_COLOR) &&
+               type() == DecorationButtonType::Close) {
+        color = CLOSE_COLOR;
+    }
+    if (isPressed() || isHovered() ||
+        !(flags & TITLEBAR_BUTTON_HOVER_SYMBOL)) {
+        return color;
+    }
+    // The hover symbol flag fades the glyph while the pointer sits away from
+    // the button.
+    color.setAlphaF(HOVER_BUTTON_ALPHA(color));
+    return color;
+}
+
+void
+Button::drawFrame(QPainter *painter, const QRectF &rect) const
+{
+    const auto *owner = qobject_cast<Decoration*>(decoration());
+    if (!owner) {
+        return;
+    }
+    const Options &opts = owner->options();
+    const int flags = opts.titlebarButtons;
+    const bool hover = isHovered() || isPressed();
+    if ((flags & TITLEBAR_BUTTON_NO_FRAME) ||
+        (!hover && (flags & TITLEBAR_BUTTON_HOVER_FRAME))) {
+        return;
+    }
+
+    // The round flag gives a circle. Every other setting gives the corner
+    // radius that the round key of the style asks for. qtcGetRadius() reads
+    // both keys.
+    const QColor base = colored() ? buttonColor() : owner->titleBarColor();
+    const QRectF area = rect.adjusted(0.5, 0.5, -0.5, -0.5);
+    const double radius = qtcGetRadius(&opts, int(area.width()),
+                                       int(area.height()),
+                                       WIDGET_MDI_WINDOW_BUTTON,
+                                       RADIUS_EXTERNAL);
+    QPainterPath path;
+    path.addRoundedRect(area, radius, radius);
+    fillGradient(painter, path, base,
+                 isPressed() ? opts.sunkenAppearance :
+                 opts.titlebarButtonAppearance, opts);
+    painter->setBrush(Qt::NoBrush);
+    painter->setPen(QPen(shade(base, shadeFactor(opts, QTC_STD_BORDER),
+                               opts.shading), 1.0));
+    painter->drawPath(path);
+}
+
+void
+Button::drawGlyph(QPainter *painter, const QRectF &rect,
+                  const QColor &color) const
+{
+    const qreal side = qMin(rect.width(), rect.height());
+    // The three widths follow IconEngine::icon() of the KDE4 decoration. A
+    // stroke draws a line. A bar draws the head of a window symbol. A frame
+    // draws the body of a window symbol.
+    const qreal stroke = side > 16 ? 3.0 : side > 4 ? 2.0 : 1.0;
+    const qreal bar = side > 16 ? 4.0 : side > 4 ? 2.0 : 1.0;
+    const qreal frame = side > 16 ? 2.0 : 1.0;
+
+    QPen pen(color);
+    pen.setWidthF(stroke);
+    pen.setCapStyle(Qt::FlatCap);
+    pen.setJoinStyle(Qt::MiterJoin);
+    painter->setPen(pen);
+    painter->setBrush(color);
+
+    switch (type()) {
+    case DecorationButtonType::Close:
+        painter->drawLine(rect.topLeft(), rect.bottomRight());
+        painter->drawLine(rect.topRight(), rect.bottomLeft());
+        break;
+
+    case DecorationButtonType::Maximize:
+        pen.setWidthF(frame);
+        painter->setPen(pen);
+        painter->setBrush(Qt::NoBrush);
+        if (isChecked()) {
+            // A maximized window gets the restore symbol. The style draws the
+            // edges of a window behind, then a whole window in front.
+            const qreal step = qMax(2.0, side / 4.0);
+            painter->fillRect(QRectF(rect.left() + step, rect.top(),
+                                     rect.width() - step, bar), color);
+            painter->fillRect(QRectF(rect.right() - frame, rect.top(), frame,
+                                     rect.height() - step), color);
+            painter->fillRect(QRectF(rect.right() - step,
+                                     rect.bottom() - step - frame, step,
+                                     frame), color);
+            drawWindowSymbol(painter,
+                             QRectF(rect.left(), rect.top() + step,
+                                    rect.width() - step, rect.height() - step),
+                             frame, bar);
+        } else {
+            drawWindowSymbol(painter, rect, frame, bar);
+        }
+        break;
+
+    case DecorationButtonType::Minimize:
+        painter->fillRect(QRectF(rect.left(), rect.bottom() - bar,
+                                 rect.width(), bar), color);
+        break;
+
+    case DecorationButtonType::Menu:
+    case DecorationButtonType::ApplicationMenu: {
+        // The menu glyph of the style is three lines.
+        const qreal gap = side / 3.0;
+        for (int i = 0;i < 3;i++) {
+            painter->fillRect(QRectF(rect.left(), rect.top() + i * gap,
+                                     rect.width(), qMax(1.0, frame)), color);
+        }
+        break;
+    }
+
+    case DecorationButtonType::ContextHelp: {
+        // The style draws the question mark from four strokes. A bar runs
+        // along the top. A bar runs down the right side. A bar runs back to
+        // the centre. A dot closes the mark.
+        const qreal quarter = side / 4.0;
+        pen.setWidthF(frame > 1.0 ? frame : stroke);
+        painter->setPen(pen);
+        painter->setBrush(Qt::NoBrush);
+        QPainterPath mark;
+        mark.moveTo(rect.left() + quarter, rect.top() + quarter);
+        mark.lineTo(rect.center().x(), rect.top());
+        mark.lineTo(rect.right(), rect.top() + quarter);
+        mark.lineTo(rect.center().x(), rect.top() + 2 * quarter);
+        mark.lineTo(rect.center().x(), rect.top() + 3 * quarter);
+        painter->drawPath(mark);
+        painter->fillRect(QRectF(rect.center().x() - frame / 2.0,
+                                 rect.bottom() - frame, frame, frame), color);
+        break;
+    }
+
+    case DecorationButtonType::OnAllDesktops: {
+        painter->setPen(Qt::NoPen);
+        const qreal mark = qMax(2.0, side / 3.0);
+        if (isChecked()) {
+            // A window on every desktop gets one dot in the centre.
+            QRectF dot(0, 0, mark, mark);
+            dot.moveCenter(rect.center());
+            painter->fillRect(dot, color);
+        } else {
+            // A window on one desktop gets a dot in each corner.
+            painter->fillRect(QRectF(rect.left(), rect.top(), mark, mark),
+                              color);
+            painter->fillRect(QRectF(rect.right() - mark, rect.top(), mark,
+                                     mark), color);
+            painter->fillRect(QRectF(rect.left(), rect.bottom() - mark, mark,
+                                     mark), color);
+            painter->fillRect(QRectF(rect.right() - mark, rect.bottom() - mark,
+                                     mark, mark), color);
+        }
+        break;
+    }
+
+    case DecorationButtonType::KeepAbove: {
+        painter->setPen(Qt::NoPen);
+        const qreal half = side / 2.0;
+        if (isChecked()) {
+            drawArrow(painter, QRectF(rect.left(), rect.top(), rect.width(),
+                                      half), true);
+        } else {
+            painter->fillRect(QRectF(rect.left(), rect.top(), rect.width(),
+                                     frame), color);
+        }
+        drawArrow(painter, QRectF(rect.left(), rect.top() + half, rect.width(),
+                                  half), true);
+        break;
+    }
+
+    case DecorationButtonType::KeepBelow: {
+        painter->setPen(Qt::NoPen);
+        const qreal half = side / 2.0;
+        drawArrow(painter, QRectF(rect.left(), rect.top(), rect.width(), half),
+                  false);
+        if (isChecked()) {
+            drawArrow(painter, QRectF(rect.left(), rect.top() + half,
+                                      rect.width(), half), false);
+        } else {
+            painter->fillRect(QRectF(rect.left(), rect.bottom() - frame,
+                                     rect.width(), frame), color);
+        }
+        break;
+    }
+
+    case DecorationButtonType::Shade: {
+        painter->setPen(Qt::NoPen);
+        // The style points the arrow down while the window is open, and up
+        // while the window is shaded. A bar sits under the arrow.
+        drawArrow(painter, QRectF(rect.left(), rect.top(), rect.width(),
+                                  rect.height() - 2 * bar), !isChecked());
+        painter->fillRect(QRectF(rect.left(), rect.bottom() - bar,
+                                 rect.width(), bar), color);
+        break;
+    }
+
+    case DecorationButtonType::ExcludeFromCapture: {
+        pen.setWidthF(frame);
+        painter->setPen(pen);
+        painter->setBrush(Qt::NoBrush);
+        drawWindowSymbol(painter, rect, frame, bar);
+        pen.setWidthF(stroke);
+        painter->setPen(pen);
+        painter->drawLine(rect.bottomLeft(), rect.topRight());
+        break;
+    }
+
+    default:
+        break;
+    }
+}
+
+void
+Button::paint(QPainter *painter, const QRectF &repaintRegion)
+{
+    Q_UNUSED(repaintRegion)
+    if (!qobject_cast<Decoration*>(decoration())) {
+        return;
+    }
+    if (type() == DecorationButtonType::Spacer ||
+        type() == DecorationButtonType::Custom) {
+        return;
+    }
+
+    // The room outside the square takes clicks and no paint. geometry() holds
+    // the square and that room, so the paint starts from the square alone.
+    const QRectF area = geometry().marginsRemoved(m_padding);
+    if (area.width() < 2.0 || area.height() < 2.0) {
+        return;
+    }
+    const auto *owner = qobject_cast<Decoration*>(decoration());
+    const Options &opts = owner->options();
+    const int flags = opts.titlebarButtons;
+    const bool hover = isHovered() || isPressed();
+
+    painter->save();
+    painter->setRenderHint(QPainter::Antialiasing);
+    drawFrame(painter, area);
+
+    if ((flags & TITLEBAR_BUTTON_HOVER_SYMBOL_FULL) && !hover) {
+        // The full hover symbol flag hides the glyph until the pointer reaches
+        // the button.
+        painter->restore();
+        return;
+    }
+
+    // buttonBitmap() of the KDE4 decoration takes four sevenths of the button
+    // away on each axis, then centres the line art in the rest.
+    const qreal side = qMin(area.width(), area.height());
+    int glyphSide = int(qMax(minGlyphSide,
+                             std::round(side - 2.0 * (side / 3.5))));
+    // IconEngine::icon() takes one pixel away from an even side, so the line
+    // art keeps a centre pixel.
+    if (glyphSide % 2 == 0) {
+        glyphSide--;
+    }
+    QRectF glyph(0, 0, glyphSide, glyphSide);
+    glyph.moveCenter(area.center());
+    if (isPressed()) {
+        // The style moves the line art of a sunken button one pixel down and
+        // one pixel right.
+        glyph.translate(1, 1);
+    }
+
+    // drawMdiIcon() in qt6/style/qtcurve.cpp draws the line art a second time
+    // under the line art, in the colour of the title bar effect. A sunken
+    // button and a faded glyph get no second copy.
+    const bool faded = !isPressed() && !isHovered() &&
+        (flags & TITLEBAR_BUTTON_HOVER_SYMBOL);
+    if (!isPressed() && !faded && opts.titlebarEffect != EFFECT_NONE) {
+        const QColor edge(WINDOW_SHADOW_COLOR(opts.titlebarEffect));
+        const QColor base = owner->titleBarColor();
+        drawGlyph(painter,
+                  glyph.translated(opts.titlebarEffect == EFFECT_SHADOW ? 1 : 0,
+                                   1),
+                  qtcColorMix(&base, &edge,
+                              WINDOW_TEXT_SHADOW_ALPHA(opts.titlebarEffect)));
+    }
+    drawGlyph(painter, glyph, glyphColor());
+    painter->restore();
+}
+
+}
