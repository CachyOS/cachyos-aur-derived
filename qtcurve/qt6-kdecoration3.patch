+namespace QtCurve {
+
+using KDecoration3::ColorGroup;
+using KDecoration3::ColorRole;
+
+QColor
+shade(const QColor &base, double factor, Shading shading)
+{
+    QColor result;
+    qtcShade(&base, &result, factor, shading);
+    return result;
+}
+
+void
+fillGradient(QPainter *painter, const QPainterPath &path, const QColor &base,
+             EAppearance app, const Options &opts)
+{
+    if (qtcIsFlat(app)) {
+        painter->fillPath(path, base);
+        return;
+    }
+    const Gradient *grad = qtcGetGradient(app, &opts);
+    const QRectF area = path.boundingRect();
+    QLinearGradient gradient(area.topLeft(), area.bottomLeft());
+    for (const auto &stop : grad->stops) {
+        QColor colour = shade(base, stop.val, opts.shading);
+        colour.setAlphaF(stop.alpha * base.alphaF());
+        gradient.setColorAt(stop.pos, colour);
+    }
+    painter->fillPath(path, QBrush(gradient));
+}
