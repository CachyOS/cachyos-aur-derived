+ *   see <http://www.gnu.org/licenses/>.                                     *
+ *****************************************************************************/
+
+#include "qtcurvedecorationconfig.h"
+
+#include <common/config_file.h>
+
+#include <KColorScheme>
+#include <KConfig>
+#include <KConfigGroup>
+
+#include <QGuiApplication>
+#include <QLatin1String>
+#include <QString>
+
+#include <qtcurve-utils/shade.h>
+
+namespace {
+
+//! the name of the file that holds the frame settings and the shadow settings
+/*! The settings module of the KDE4 decoration wrote the file. The Plasma 6
+    decoration has no settings module yet, so the file only changes by hand. */
+const char *const kwinConfigFile = "kwinqtcurverc";
+
+//! the group that holds the frame settings
+const char *const frameGroup = "General";
+
+//! the group that holds the shadow of an active window
+const char *const activeShadowGroup = "ActiveShadows";
+
+//! the group that holds the shadow of an inactive window
+const char *const inactiveShadowGroup = "InactiveShadows";
+
+//! the fixed grey of the CT_GRAY colour type
+/*! ShadowConfig::setColorType() in qt6/kwin/qtcurveshadowconfiguration.cpp
+    uses the same colour. */
+const char *const fixedShadowGray = "#393835";
+
+//! read a border shade key
+/*! The KDE4 settings module wrote a boolean value in an older release and a
+    Shade number now, so the reader takes both forms. readShade() in
+    qt6/kwin/qtcurveconfig.cpp does the same.
+    \param group the group that holds the key.
+    \param key the name of the key.
+    \return the shade, or QtCurve::DecorationConfig::SHADE_NONE for an absent key, for an
+    empty value and for a value outside the Shade range. */
+QtCurve::DecorationConfig::Shade
+readShade(const KConfigGroup &group, const char *key)
+{
+    const QString entry = group.readEntry(key, QString());
+    if (entry.isEmpty() || QLatin1String("false") == entry) {
+        return QtCurve::DecorationConfig::SHADE_NONE;
+    }
+    if (QLatin1String("true") == entry) {
+        return QtCurve::DecorationConfig::SHADE_DARK;
+    }
+    const int value = entry.toInt();
+    if (value > QtCurve::DecorationConfig::SHADE_NONE &&
+        value <= QtCurve::DecorationConfig::SHADE_SHADOW) {
+        return QtCurve::DecorationConfig::Shade(value);
+    }
+    return QtCurve::DecorationConfig::SHADE_NONE;
+}
+
+}
+
+namespace QtCurve {
+
+ShadowConfig::ShadowConfig(QPalette::ColorGroup colorGroup)
+    : m_colorGroup(colorGroup)
+{
+    defaults();
+}
+
+void
+ShadowConfig::defaults()
+{
+    m_hOffset = 0;
+    m_vOffset = 5;
+    if (QPalette::Active == m_colorGroup) {
+        m_size = 35;
+        m_shadowType = SH_ACTIVE;
+        setColorType(CT_FOCUS);
+    } else {
+        m_size = 30;
+        m_shadowType = SH_INACTIVE;
+        setColorType(CT_GRAY);
+    }
+}
+
+void
+ShadowConfig::setColorType(ColorType ct)
+{
+    m_colorType = ct;
+    switch (m_colorType) {
+    default:
+    case CT_FOCUS:
+        m_color = KColorScheme(m_colorGroup)
+            .decoration(KColorScheme::FocusColor).color();
+        break;
+    case CT_HOVER:
+        m_color = KColorScheme(m_colorGroup)
+            .decoration(KColorScheme::HoverColor).color();
+        break;
+    case CT_SELECTION:
+        // The KDE4 decoration read the palette of the application. A
+        // decoration plugin runs inside the compositor, so the palette is the
+        // palette of the compositor.
+        m_color = QGuiApplication::palette().color(m_colorGroup,
+                                                   QPalette::Highlight);
+        break;
+    case CT_TITLEBAR:
+        m_color = KColorScheme(m_colorGroup, KColorScheme::Window)
+            .background(m_colorGroup == QPalette::Active ?
+                        KColorScheme::ActiveBackground :
+                        KColorScheme::NormalBackground)
+            .color();
+        break;
+    case CT_GRAY:
+        m_color = QColor(QString::fromLatin1(fixedShadowGray));
+        break;
+    case CT_CUSTOM:
+        break;
+    }
+}
+
+void
+ShadowConfig::load(const KConfig *cfg)
+{
+    const KConfigGroup group(cfg, QString::fromLatin1(
+                                 QPalette::Active == m_colorGroup ?
+                                 activeShadowGroup : inactiveShadowGroup));
+    const ShadowConfig def(m_colorGroup);
+
+    m_size = group.readEntry("Size", def.m_size);
+    m_hOffset = group.readEntry("HOffset", def.m_hOffset);
+    m_vOffset = group.readEntry("VOffset", def.m_vOffset);
+    m_colorType = group.readEntry("ColorType", def.m_colorType);
+    m_shadowType = group.readEntry("ShadowType", def.m_shadowType);
+    if (CT_CUSTOM == m_colorType) {
+        m_color = group.readEntry("Color", def.m_color);
+    }
+    if (m_size < MIN_SIZE || m_size > MAX_SIZE) {
+        m_size = def.m_size;
+    }
+    if (m_hOffset < MIN_OFFSET || m_hOffset > MAX_OFFSET) {
+        m_hOffset = def.m_hOffset;
+    }
+    if (m_vOffset < MIN_OFFSET || m_vOffset > MAX_OFFSET) {
+        m_vOffset = def.m_vOffset;
+    }
+    setColorType(ColorType(m_colorType));
+}
+
+DecorationConfig::DecorationConfig()
+    : m_activeShadow(QPalette::Active),
+      m_inactiveShadow(QPalette::Inactive)
+{
+    // qtcReadConfig() takes the file from the QTCURVE_CONFIG_FILE environment
+    // variable when it is set. It takes the file from the QtCurve directory of
+    // the configuration folder of the user when the variable is not set. The
+    // style reads the same file, so its settings dialogue drives the frame.
+    qtcDefaultSettings(&m_opts);
+    qtcReadConfig(QString(), &m_opts);
+
+    const KConfig cfg{QString::fromLatin1(kwinConfigFile)};
+    const KConfigGroup group(&cfg, QString::fromLatin1(frameGroup));
+    m_outerBorder = readShade(group, "OuterBorder");
+    m_innerBorder = (SHADE_NONE == m_outerBorder ? SHADE_NONE :
+                     readShade(group, "InnerBorder"));
+    m_roundBottom = group.readEntry("RoundBottom", true);
+    m_customShadows = group.readEntry("CustomShadows", false);
+    m_titleBarPad = group.readEntry("TitleBarPad", 0);
+    m_edgePad = group.readEntry("EdgePad", 0);
+    // load() in qt6/kwin/qtcurveconfig.cpp holds the two pad values inside the
+    // same limits.
+    if (m_titleBarPad < -5 || m_titleBarPad > 10) {
+        m_titleBarPad = 0;
+    }
+    if (m_edgePad < 0 || m_edgePad > 10) {
+        m_edgePad = 0;
+    }
+
+    m_activeShadow.load(&cfg);
+    m_inactiveShadow.load(&cfg);
+}
+
+const DecorationConfig&
+DecorationConfig::instance()
+{
+    static const DecorationConfig config;
+    return config;
+}
+
+double
+shadeFactor(const Options &opts, int index)
+{
+    if (USE_CUSTOM_SHADES(opts)) {
+        return opts.customShades[index];
+    }
+    return qtcShadeGetIntern(opts.contrast, index, opts.darkerBorders,
+                             opts.shading);
+}
+
+}
