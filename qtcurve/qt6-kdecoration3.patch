+    the sharp point of a plain rectangle. */
+const qreal flatBottomRadius = 1.0;
+
+//! the width of the side border of a normal window, in pixels
+/*! setBorderSize() in qt6/kwin/qtcurvehandler.cpp reports this width for
+    BORDER_NORMAL. */
+const qreal normalBorder = 4.0;
+
+//! the alpha value of the border line in the drop shadow colour
+/*! QtCurveClient::paintEvent() in qt6/kwin/qtcurveclient.cpp mixes the shadow
+    colour with the window colour by this weight for an active window. */
+const double activeShadowBorderAlpha = 0.75;
+
+//! the alpha value of the border line of an inactive window
+/*! QtCurveClient::paintEvent() in qt6/kwin/qtcurveclient.cpp mixes the shadow
+    colour with the window colour by this weight for an inactive window. */
+const double inactiveShadowBorderAlpha = 0.4;
+
+//! the length of the drop shadow gradient of a window with no custom shadow
+/*! The value is the default shadow size of the style, which
+    lib/utils/x11helpers.cpp holds. */
+const int plainShadowSize = 30;
+
+//! the width of the clear band along the window edge, in pixels
+/*! qtcShadowCreate() holds the alpha at zero over this band, then starts the
+    gradient. The band lets a tile lie over the window edge without a dark
+    line. */
+const size_t shadowRadius = 4;
+
+//! the number of tiles that make one shadow
+const int numTiles = 8;
+
+//! the drop shadow of an active window, or an empty pointer before the first paint
+/*! The shadow does not depend on the window, so one shadow serves them all. */
+std::shared_ptr<KDecoration3::DecorationShadow> activeShadow;
+
+//! the drop shadow of an inactive window, or an empty pointer before the first paint
+/*! The shadow does not depend on the window, so one shadow serves them all. */
+std::shared_ptr<KDecoration3::DecorationShadow> inactiveShadow;
+
+//! find the button at one end of a button group that takes a click
+/*! DecorationButtonGroup::updateLayout() puts the buttons from the left under
+    a left to right layout, and from the right under a right to left layout.
+    The first button of the list is therefore the leftmost button under the
+    first direction and the rightmost button under the second. A hidden button
+    keeps no place in the layout, so the scan drops it. The scan drops a Spacer
+    button and a Custom button as well. DecorationButton disables a Spacer, so
+    a Spacer takes no click. Button::paint() draws neither type.
+    \param group the button group.
+    \param leftEnd true for the leftmost button, or false for the rightmost
+    button.
+    \return the button, or nullptr where the group shows no such button. */
+QtCurve::Button*
+endButton(const KDecoration3::DecorationButtonGroup *group, bool leftEnd)
+{
+    const bool fromFront = (QGuiApplication::layoutDirection() ==
+                            Qt::RightToLeft) ? !leftEnd : leftEnd;
+    QtCurve::Button *found = nullptr;
+    const auto buttons = group->buttons();
+    for (KDecoration3::DecorationButton *button : buttons) {
+        if (!button->isVisible() ||
+            button->type() == KDecoration3::DecorationButtonType::Spacer ||
+            button->type() == KDecoration3::DecorationButtonType::Custom) {
+            continue;
+        }
+        found = static_cast<QtCurve::Button*>(button);
+        if (fromFront) {
+            break;
+        }
+    }
+    return found;
+}
+
+//! move a button group so that the end button of endButton() touches an anchor
+/*! DecorationButtonGroup::updateLayout() adds the group spacing for each
+    visible button that the list holds before another entry. A hidden button
+    at the end of the list therefore makes the group box wider than the
+    buttons in it. A position that comes from the box width then holds the end
+    button away from the anchor. This call reads the end button back and moves
+    the whole group over that surplus. A Spacer button outside the end button
+    moves past the anchor, and it paints nothing there. The call does nothing
+    where the group shows no end button.
+    \param group the button group.
+    \param leftEnd true to put the left side of the end button on the anchor,
+    or false to put the right side of the end button there.
+    \param anchor the x coordinate for that side of the button, in pixels. */
+void
+anchorGroup(KDecoration3::DecorationButtonGroup *group, bool leftEnd,
+            qreal anchor)
+{
+    const QtCurve::Button *end = endButton(group, leftEnd);
+    if (!end) {
+        return;
+    }
+    const QRectF box = end->geometry();
+    const qreal shift = anchor - (leftEnd ? box.left() : box.right());
+    if (shift != 0.0) {
+        group->setPos(group->pos() + QPointF(shift, 0));
+    }
+}
+
+//! build a shape with round top corners and round bottom corners
+/*! \param rect the area to cover.
+    \param radiusTop the radius of the two top corners, in pixels.
+    \param radiusBot the radius of the two bottom corners, in pixels.
+    \return the shape. createPath() in qt6/kwin/qtcurveclient.cpp builds the
+    same shape. */
+QPainterPath
+framedPath(const QRectF &rect, qreal radiusTop, qreal radiusBot)
+{
+    QPainterPath path;
+    const qreal diameterTop = radiusTop * 2.0;
+    const qreal diameterBot = radiusBot * 2.0;
+
+    if (radiusBot > 0.0) {
+        path.moveTo(rect.right(), rect.bottom() - radiusBot);
+        path.arcTo(QRectF(rect.right() - diameterBot,
+                          rect.bottom() - diameterBot, diameterBot,
+                          diameterBot), 0.0, -90.0);
+    } else {
+        path.moveTo(rect.right(), rect.bottom());
+    }
+    if (radiusBot > 0.0) {
+        path.lineTo(rect.left() + radiusBot, rect.bottom());
+        path.arcTo(QRectF(rect.left(), rect.bottom() - diameterBot,
+                          diameterBot, diameterBot), -90.0, -90.0);
+    } else {
+        path.lineTo(rect.left(), rect.bottom());
+    }
+    if (radiusTop > 0.0) {
+        path.lineTo(rect.left(), rect.top() + radiusTop);
+        path.arcTo(QRectF(rect.left(), rect.top(), diameterTop, diameterTop),
+                   180.0, -90.0);
+    } else {
+        path.lineTo(rect.left(), rect.top());
+    }
+    if (radiusTop > 0.0) {
+        path.lineTo(rect.right() - radiusTop, rect.top());
+        path.arcTo(QRectF(rect.right() - diameterTop, rect.top(), diameterTop,
+                          diameterTop), 90.0, -90.0);
+    } else {
+        path.lineTo(rect.right(), rect.top());
+    }
+    path.closeSubpath();
+    return path;
+}
+
+//! make one QtCurve drop shadow for the decoration framework
+/*! qtcShadowCreate() draws eight tiles. The call puts them in one image, in
+    the layout that DecorationShadow asks for: a corner tile in each corner, a
+    side tile between two corner tiles, and one clear pixel in the middle. The
+    padding of the shadow is one pixel less than the gradient, as in
+    qtcX11ShadowInit(), so a tile lies over the window edge. An offset makes
+    the padding of one side larger and the padding of the other side smaller,
+    which moves the whole shadow.
+    \param size the length of the gradient, in pixels.
+    \param start the colour at the window edge.
+    \param end the colour at the outer end of the gradient.
+    \param hOffset the distance that the shadow moves to the right, in pixels.
+    \param vOffset the distance that the shadow moves down, in pixels.
+    \return the shadow. */
+std::shared_ptr<KDecoration3::DecorationShadow>
+createShadow(int size, const QColor &start, const QColor &end, int hOffset,
+             int vOffset)
+{
+    QtcColor c1 = {start.redF(), start.greenF(), start.blueF()};
+    QtcColor c2 = {end.redF(), end.greenF(), end.blueF()};
+    QtCurve::Image *images[numTiles];
+    qtcShadowCreate(size_t(size), &c1, &c2, shadowRadius, false,
+                    QTC_PIXEL_QT, images);
+
+    const int side = size + int(shadowRadius);
+    QImage composite(2 * side + 1, 2 * side + 1,
+                     QImage::Format_ARGB32_Premultiplied);
+    composite.fill(Qt::transparent);
+    // qtcShadowCreate() writes the tiles in this order: top, top right, right,
+    // bottom right, bottom, bottom left, left and top left.
+    const QPoint origin[numTiles] = {
+        QPoint(side, 0),
+        QPoint(side + 1, 0),
+        QPoint(side + 1, side),
+        QPoint(side + 1, side + 1),
+        QPoint(side, side + 1),
+        QPoint(0, side + 1),
+        QPoint(0, side),
+        QPoint(0, 0),
+    };
+    QPainter painter(&composite);
+    for (int i = 0;i < numTiles;i++) {
+        const QtCurve::Image *image = images[i];
+        // QTC_PIXEL_QT puts the four bytes of a pixel in the order that
+        // QImage::Format_ARGB32_Premultiplied reads. qtcFillShadowPixel() also
+        // multiplies each colour channel by the alpha.
+        QImage tile((const uchar*)image->data.data(), int(image->width),
+                    int(image->height), qsizetype(image->width) * 4,
+                    QImage::Format_ARGB32_Premultiplied);
+        painter.drawImage(origin[i], tile);
+        delete images[i];
+    }
+    painter.end();
+
+    auto shadow = std::make_shared<KDecoration3::DecorationShadow>();
+    const qreal base = size - 1;
+    shadow->setPadding(QMarginsF(qMax(qreal(0), base - hOffset),
+                                 qMax(qreal(0), base - vOffset),
+                                 base + hOffset, base + vOffset));
+    shadow->setInnerShadowRect(QRectF(side, side, 1, 1));
+    shadow->setShadow(composite);
+    return shadow;
+}
+
+//! make the drop shadow of one window state
+/*! \param active true for the shadow of an active window, false for the
+    shadow of an inactive window.
+    \return the shadow that the kwinqtcurverc file asks for, or the plain grey
+    shadow of the QtCurve menus while the CustomShadows key is off. */
+std::shared_ptr<KDecoration3::DecorationShadow>
+shadowFor(bool active)
+{
+    const QtCurve::DecorationConfig &config =
+        QtCurve::DecorationConfig::instance();
+    if (!config.customShadows()) {
+        // qtcX11ShadowInit() in lib/utils/x11helpers.cpp fades between the
+        // same two greys, so a window and a menu of the same session get the
+        // same shadow.
+        return createShadow(plainShadowSize, QColor(102, 102, 102),
+                            QColor(51, 51, 51), 0, 0);
+    }
+    // The KDE4 shadow held one colour for the whole gradient, so the start and
+    // the end are the same colour.
+    const QtCurve::ShadowConfig &shadow = config.shadow(active);
+    return createShadow(shadow.shadowSize(), shadow.color(), shadow.color(),
+                        shadow.horizontalOffset(), shadow.verticalOffset());
+}
+
+}
