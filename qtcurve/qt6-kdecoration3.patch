+#ifndef qtcurvedecorationconfig_h
+#define qtcurvedecorationconfig_h
+
+#include <common/common.h>
+
+#include <QColor>
+#include <QPalette>
+
+class KConfig;
+
+namespace QtCurve {
+
+//! the drop shadow settings of one window state
+/*! The settings module of the KDE4 decoration wrote these values to the
+    kwinqtcurverc file, in the ActiveShadows group and in the InactiveShadows
+    group. The class is a port of ShadowConfig in
+    qt6/kwin/qtcurveshadowconfiguration.h. The decoration reads the file one
+    time, at the first paint, so a change needs a restart of the compositor.
+    The compositor thread owns every instance. */
+class ShadowConfig {
+public:
+    //! the source of the shadow colour
+    enum ColorType {
+        //! the focus colour of the decoration colour set
+        CT_FOCUS = 0,
+        //! the hover colour of the decoration colour set
+        CT_HOVER = 1,
+        //! the selection background of the palette of the application
+        CT_SELECTION = 2,
+        //! the window background of the colour scheme
+        CT_TITLEBAR = 3,
+        //! a fixed dark grey
+        CT_GRAY = 4,
+        //! the colour that the Color key of the group holds
+        CT_CUSTOM = 5
+    };
+
+    //! the window state that a shadow belongs to
+    enum ShadowType {
+        //! the shadow of an active window
+        SH_ACTIVE = 0,
+        //! the shadow of an inactive window
+        SH_INACTIVE = 1
+    };
+
+    //! the smallest shadow size that load() accepts, in pixels
+    static const int MIN_SIZE = 10;
+    //! the largest shadow size that load() accepts, in pixels
+    static const int MAX_SIZE = 100;
+    //! the smallest shadow offset that load() accepts, in pixels
+    static const int MIN_OFFSET = 0;
+    //! the largest shadow offset that load() accepts, in pixels
+    static const int MAX_OFFSET = 20;
+
+    //! make a shadow configuration with the values of defaults()
+    /*! \param colorGroup the colour group that names the window state.
+        QPalette::Active selects the active shadow. Every other group selects
+        the inactive shadow. */
+    explicit ShadowConfig(QPalette::ColorGroup colorGroup);
+
+    //! give every value the default of the KDE4 decoration
+    /*! The active shadow gets a size of 35 pixels and the focus colour. The
+        inactive shadow gets a size of 30 pixels and the fixed grey. Both get
+        a horizontal offset of 0 pixels and a vertical offset of 5 pixels. */
+    void defaults();
+
+    //! read the values from the group of this window state
+    /*! A value outside the limits of the class falls back to the default.
+        \param cfg the kwinqtcurverc file. */
+    void load(const KConfig *cfg);
+
+    //! the length of the shadow gradient, in pixels
+    int shadowSize() const { return m_size; }
+
+    //! the distance that the shadow moves to the right, in pixels
+    int horizontalOffset() const { return m_hOffset; }
+
+    //! the distance that the shadow moves down, in pixels
+    int verticalOffset() const { return m_vOffset; }
+
+    //! the colour of the shadow
+    /*! \return the colour that the colour type selects, or the colour of the
+        Color key for the custom type. */
+    const QColor &color() const { return m_color; }
+
+private:
+    //! give the colour the value that a colour type selects
+    /*! \param ct the colour type. The custom type keeps the current colour. */
+    void setColorType(ColorType ct);
+
+    //! the colour group that names the window state
+    QPalette::ColorGroup m_colorGroup;
+    //! the length of the shadow gradient, in pixels
+    int m_size;
+    //! the distance that the shadow moves to the right, in pixels
+    int m_hOffset;
+    //! the distance that the shadow moves down, in pixels
+    int m_vOffset;
+    //! the colour type, as a ColorType value
+    int m_colorType;
+    //! the window state, as a ShadowType value
+    int m_shadowType;
+    //! the colour of the shadow
+    QColor m_color;
+};
+
+//! every configuration value that the QtCurve window decoration reads
+/*! The class reads the configuration file of the QtCurve style, and it reads
+    the kwinqtcurverc file of the KDE4 decoration. The style file drives the
+    look of the frame. The kwinqtcurverc file drives the border shades and the
+    drop shadow.
+
+    The class reads both files one time, at the first use, because KDecoration3
+    gives no reload signal for a file outside its own settings. A change of
+    either file needs a restart of the compositor.
+
+    The compositor thread owns the single instance. */
+class DecorationConfig {
+public:
+    //! the shade of a window border
+    /*! The values are the Shade values of QtCurveConfig in
+        qt6/kwin/qtcurveconfig.h. The OuterBorder key and the InnerBorder key
+        of the kwinqtcurverc file hold one of them. */
+    enum Shade {
+        //! draw no border
+        SHADE_NONE = 0,
+        //! draw a dark border
+        SHADE_DARK = 1,
+        //! draw a light border
+        SHADE_LIGHT = 2,
+        //! draw a border in the shadow colour
+        SHADE_SHADOW = 3
+    };
+
+    //! the single configuration of this process
+    /*! The first call reads both files.
+        \return the configuration. */
+    static const DecorationConfig &instance();
+
+    //! the settings of the QtCurve style
+    /*! \return the options that qtcReadConfig() read. The QTCURVE_CONFIG_FILE
+        environment variable names the file when it is set. */
+    const Options &options() const { return m_opts; }
+
+    //! the shade of the outer window border
+    Shade outerBorder() const { return m_outerBorder; }
+
+    //! the shade of the inner window border
+    Shade innerBorder() const { return m_innerBorder; }
+
+    //! true while the bottom corners of the window are round
+    bool roundBottom() const { return m_roundBottom; }
+
+    //! true while the decoration draws the shadow that ShadowConfig describes
+    /*! \return the value of the CustomShadows key. A false value gives every
+        window the fixed grey shadow of the QtCurve menus. */
+    bool customShadows() const { return m_customShadows; }
+
+    //! the extra room above and below the caption, in pixels
+    /*! \return the value of the TitleBarPad key, from -5 to 10. The title bar
+        grows by two times this value. */
+    int titleBarPad() const { return m_titleBarPad; }
+
+    //! the extra width of the side border and of the bottom border, in pixels
+    /*! \return the value of the EdgePad key, from 0 to 10. */
+    int edgePad() const { return m_edgePad; }
+
+    //! the drop shadow settings of one window state
+    /*! \param active true for the active window, false for an inactive
+        window. */
+    const ShadowConfig &shadow(bool active) const {
+        return active ? m_activeShadow : m_inactiveShadow;
+    }
+
+private:
+    //! read the configuration file of the style and the kwinqtcurverc file
+    DecorationConfig();
+
+    //! the settings of the QtCurve style
+    Options m_opts;
+    //! the drop shadow of an active window
+    ShadowConfig m_activeShadow;
+    //! the drop shadow of an inactive window
+    ShadowConfig m_inactiveShadow;
+    //! the shade of the outer window border
+    Shade m_outerBorder;
+    //! the shade of the inner window border
+    Shade m_innerBorder;
+    //! true while the bottom corners of the window are round
+    bool m_roundBottom;
+    //! true while the decoration draws its own shadow
+    bool m_customShadows;
+    //! the extra room above and below the caption, in pixels
+    int m_titleBarPad;
+    //! the extra width of the side border and of the bottom border, in pixels
+    int m_edgePad;
+};
+
+//! the shade factor of one entry of the shade table of the style
+/*! shadeColors() in qt6/style/qtcurve.cpp reads the same table.
+    \param opts the settings of the style.
+    \param index the entry, from 0 to QTC_NUM_STD_SHADES - 1. QTC_STD_BORDER
+    names the border entry.
+    \return the custom shade of the settings, or the built in shade for the
+    contrast value of the settings. */
+double shadeFactor(const Options &opts, int index);
+
+}
