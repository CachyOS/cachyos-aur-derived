+qreal
+Decoration::titleBarHeight() const
+{
+    const QFontMetricsF metrics(settings()->font());
+    int height = int(std::ceil(metrics.height() + titleBarTextPad));
+    // A negative TitleBarPad value shrinks the title bar, so the floor applies
+    // after the pad and not before it.
+    height += 2 * DecorationConfig::instance().titleBarPad();
+    height = qMax(height, titleBarMinHeight);
+    // The KDE4 decoration keeps an odd height. An odd height gives an odd
+    // button side, and an odd glyph side then has a centre pixel.
+    if (height % 2 == 0) {
+        height++;
+    }
+    return height;
+}
+
+qreal
+Decoration::borderSize(bool bottom, qreal scale) const
+{
+    // The widths of Tiny to Oversized come from setBorderSize() in
+    // qt6/kwin/qtcurvehandler.cpp. The None size and the NoSides size are the
+    // choice of this plugin. KDecoration3 gives None the meaning of no border.
+    // It gives NoSides the meaning of no side border.
+    const KDecoration3::BorderSize wanted = settings()->borderSize();
+    qreal width = normalBorder;
+    switch (wanted) {
+    case KDecoration3::BorderSize::None:
+        return 0;
+    case KDecoration3::BorderSize::NoSides:
+        // The bottom border keeps the width of the Normal size.
+        if (!bottom) {
+            return 0;
+        }
+        break;
+    case KDecoration3::BorderSize::Tiny:
+        width = 2;
+        break;
+    case KDecoration3::BorderSize::Large:
+        width = 8;
+        break;
+    case KDecoration3::BorderSize::VeryLarge:
+        width = 12;
+        break;
+    case KDecoration3::BorderSize::Huge:
+        width = 18;
+        break;
+    case KDecoration3::BorderSize::VeryHuge:
+        width = 27;
+        break;
+    case KDecoration3::BorderSize::Oversized:
+        width = 40;
+        break;
+    case KDecoration3::BorderSize::Normal:
+    default:
+        break;
+    }
+
+    // setBorderSize() in qt6/kwin/qtcurvehandler.cpp changes the width by the
+    // two border keys of the kwinqtcurverc file. A window with no outer border
+    // loses a pixel. A window with both borders and a small size gains the room
+    // for the second line.
+    const DecorationConfig &config = DecorationConfig::instance();
+    if (config.outerBorder() == DecorationConfig::SHADE_NONE) {
+        if (width > normalBorder) {
+            width--;
+        }
+    } else if (config.innerBorder() != DecorationConfig::SHADE_NONE &&
+               wanted <= KDecoration3::BorderSize::Normal) {
+        width += 2;
+    }
+    return KDecoration3::snapToPixelGrid(width + config.edgePad(), scale);
+}
+
+QMarginsF
+Decoration::bordersFor(qreal scale) const
+{
+    const auto *decorated = window();
+    const Qt::Edges edges = decorated->adjacentScreenEdges();
+    // A maximized window fills the screen, so a border on a maximized axis
+    // falls outside the screen.
+    const bool wide = decorated->isMaximizedHorizontally();
+    const bool tall = decorated->isMaximizedVertically();
+    const qreal side = borderSize(false, scale);
+    const qreal left = (wide || edges.testFlag(Qt::LeftEdge)) ? 0 : side;
+    const qreal right = (wide || edges.testFlag(Qt::RightEdge)) ? 0 : side;
+    const qreal bottom = (tall || decorated->isShaded() ||
+                          edges.testFlag(Qt::BottomEdge)) ? 0 :
+        borderSize(true, scale);
+    const qreal top = KDecoration3::snapToPixelGrid(titleBarHeight(), scale);
+    return QMarginsF(left, top, right, bottom);
+}
+
+void
+Decoration::recalculateBorders()
+{
+    const auto *decorated = window();
+    const qreal scale = decorated->nextScale();
+    const QMarginsF borders = bordersFor(scale);
+    setBorders(borders);
+
+    const Qt::Edges edges = decorated->adjacentScreenEdges();
+    const bool wide = decorated->isMaximizedHorizontally();
+    const bool tall = decorated->isMaximizedVertically();
+
+    // The title bar takes every click inside the top border, so the top edge
+    // always needs a grab area outside the frame. A side edge and the bottom
+    // edge need one only where the border size gives no border, because a
+    // border of any width already takes the click. The Breeze decoration makes
+    // the same choice. A maximized axis gets no grab area, because the area
+    // falls outside the screen.
+    const qreal grab = KDecoration3::snapToPixelGrid(settings()->largeSpacing(),
+                                                     scale);
+    const qreal sides = (borderSize(false, scale) <= 0 && !wide) ? grab : 0;
+    const qreal bottom = (borderSize(true, scale) <= 0 && !tall) ? grab : 0;
+    const qreal top = tall ? 0 : grab;
+    setResizeOnlyBorders(QMarginsF(sides, top, sides, bottom));
+
+    // KWin cuts the window to the border radius. The decoration draws the
+    // title bar over the two top corners, so the top radius is the radius of
+    // the title bar. The window content reaches the two bottom corners only
+    // where the bottom border is zero, so every other window keeps square
+    // bottom corners. A maximized axis and a screen edge both give a straight
+    // edge, and a straight edge needs no radius.
+    const bool leftEdge = wide || edges.testFlag(Qt::LeftEdge);
+    const bool rightEdge = wide || edges.testFlag(Qt::RightEdge);
+    const qreal upper = (tall || edges.testFlag(Qt::TopEdge)) ? 0 : topRadius();
+    const qreal lower = (tall || borders.bottom() > 0 ||
+                         edges.testFlag(Qt::BottomEdge)) ? 0 : bottomRadius();
+    setBorderRadius(KDecoration3::BorderRadius(leftEdge ? 0 : upper,
+                                              rightEdge ? 0 : upper,
+                                              rightEdge ? 0 : lower,
+                                              leftEdge ? 0 : lower));
+}
+
+void
+Decoration::updateTitleBar()
+{
+    const bool maximized = window()->isMaximized();
+    const qreal x = maximized ? 0 : borderLeft();
+    const qreal width = maximized ? size().width() :
+        size().width() - borderLeft() - borderRight();
+    setTitleBar(QRectF(x, 0, width, borderTop()));
+}
+
+void
+Decoration::updateButtonsGeometryDelayed()
+{
+    QTimer::singleShot(0, this, &Decoration::updateButtonsGeometry);
+}
+
+void
+Decoration::updateButtonsGeometry()
+{
+    if (!m_leftButtons || !m_rightButtons) {
+        return;
+    }
+    // A window that touches a screen edge keeps no gap between the outermost
+    // button and that edge. The button grows over the gap and takes every
+    // click up to the edge, which the pointer reaches without aim. The frame
+    // and the glyph keep the square, so the button looks the same. The layout
+    // direction selects which button of a group sits at the outer end. The
+    // Breeze decoration makes the same choice.
+    const auto *decorated = window();
+    const Qt::Edges edges = decorated->adjacentScreenEdges();
+    const bool wide = decorated->isMaximizedHorizontally();
+    const bool leftEdge = wide || edges.testFlag(Qt::LeftEdge);
+    const bool rightEdge = wide || edges.testFlag(Qt::RightEdge);
+    const bool topEdge = decorated->isMaximizedVertically() ||
+        edges.testFlag(Qt::TopEdge);
+
+    const qreal side = buttonSize();
+    const qreal top = KDecoration3::snapToPixelGrid((borderTop() - side) / 2,
+                                                    decorated->scale());
+    // The group sits at the top of the decoration at the top edge, and the
+    // room above the square then belongs to the button.
+    const qreal vPad = topEdge ? top : 0;
+    const auto all = m_leftButtons->buttons() + m_rightButtons->buttons();
+    for (KDecoration3::DecorationButton *button : all) {
+        // The plugin hides the Close, Maximize, Minimize, ContextHelp and Shade
+        // buttons in Button::create() when the window drops the ability.
+        // KDecoration3 hides the ApplicationMenu, OnAllDesktops and
+        // ExcludeFromCapture buttons itself. The outermost
+        // visible button carries the edge growth, and the group position
+        // follows that button. A change of the visible set therefore runs
+        // this call again. A group builds new buttons after a change of the
+        // button list, so the connection starts here, and not in init().
+        connect(button, &KDecoration3::DecorationButton::visibilityChanged,
+                this, &Decoration::updateButtonsGeometry,
+                Qt::UniqueConnection);
+        auto *one = static_cast<Button*>(button);
+        one->setPadding(QMarginsF(0, vPad, 0, 0));
+        one->setGeometry(QRectF(QPointF(0, 0), QSizeF(side, side + vPad)));
+    }
+    m_leftButtons->setSpacing(buttonSpacing);
+    m_rightButtons->setSpacing(buttonSpacing);
+
+    const qreal y = topEdge ? 0 : top;
+    if (Button *const atLeft = leftEdge ? endButton(m_leftButtons, true) :
+        nullptr) {
+        atLeft->setPadding(QMarginsF(buttonEdgePad, vPad, 0, 0));
+        atLeft->setGeometry(QRectF(QPointF(0, 0),
+                                   QSizeF(side + buttonEdgePad, side + vPad)));
+    }
+    if (Button *const atRight = rightEdge ? endButton(m_rightButtons, false) :
+        nullptr) {
+        atRight->setPadding(QMarginsF(0, vPad, buttonEdgePad, 0));
+        atRight->setGeometry(QRectF(QPointF(0, 0),
+                                    QSizeF(side + buttonEdgePad, side + vPad)));
+    }
+
+    // The group box can be wider than the buttons in it. The left group starts
+    // on its anchor. The right group starts one box width inside the right
+    // anchor. anchorGroup() then puts the end button of each group on the
+    // anchor.
+    const qreal leftAnchor = leftEdge ? 0 : borderLeft() + buttonEdgePad;
+    const qreal rightAnchor = rightEdge ? size().width() :
+        size().width() - borderRight() - buttonEdgePad;
+    m_leftButtons->setPos(QPointF(leftAnchor, y));
+    m_rightButtons->setPos(
+        QPointF(rightAnchor - m_rightButtons->geometry().width(), y));
+    anchorGroup(m_leftButtons, true, leftAnchor);
+    anchorGroup(m_rightButtons, false, rightAnchor);
+    update();
+}
+
+bool
+Decoration::init()
+{
+    auto config = settings();
+    connect(config.get(), &KDecoration3::DecorationSettings::borderSizeChanged,
+            this, &Decoration::recalculateBorders);
+    connect(config.get(), &KDecoration3::DecorationSettings::fontChanged,
+            this, &Decoration::recalculateBorders);
+    connect(config.get(), &KDecoration3::DecorationSettings::spacingChanged,
+            this, &Decoration::recalculateBorders);
+    connect(config.get(), &KDecoration3::DecorationSettings::reconfigured,
+            this, &Decoration::recalculateBorders);
+    connect(config.get(),
+            &KDecoration3::DecorationSettings::decorationButtonsLeftChanged,
+            this, &Decoration::updateButtonsGeometryDelayed);
+    connect(config.get(),
+            &KDecoration3::DecorationSettings::decorationButtonsRightChanged,
+            this, &Decoration::updateButtonsGeometryDelayed);
+    connect(config.get(), &KDecoration3::DecorationSettings::reconfigured,
+            this, &Decoration::updateButtonsGeometryDelayed);
+
+    auto *decorated = window();
+    connect(decorated, &KDecoration3::DecoratedWindow::activeChanged,
+            this, [this]() {
+                update();
+            });
+    connect(decorated, &KDecoration3::DecoratedWindow::activeChanged,
+            this, &Decoration::updateShadow);
+    connect(decorated, &KDecoration3::DecoratedWindow::captionChanged,
+            this, [this]() {
+                update(titleBar());
+            });
+    connect(decorated, &KDecoration3::DecoratedWindow::iconChanged,
+            this, [this]() {
+                update(titleBar());
+            });
+    connect(decorated,
+            &KDecoration3::DecoratedWindow::adjacentScreenEdgesChanged,
+            this, &Decoration::recalculateBorders);
+    connect(decorated, &KDecoration3::DecoratedWindow::shadedChanged,
+            this, &Decoration::recalculateBorders);
+    connect(decorated, &KDecoration3::DecoratedWindow::nextScaleChanged,
+            this, &Decoration::recalculateBorders);
+    connect(decorated,
+            &KDecoration3::DecoratedWindow::maximizedHorizontallyChanged,
+            this, &Decoration::recalculateBorders);
+    connect(decorated,
+            &KDecoration3::DecoratedWindow::maximizedVerticallyChanged,
+            this, &Decoration::recalculateBorders);
+    connect(decorated, &KDecoration3::DecoratedWindow::maximizedChanged,
+            this, &Decoration::setOpaque);
+    connect(decorated, &KDecoration3::DecoratedWindow::maximizedChanged,
+            this, &Decoration::updateTitleBar);
+    connect(decorated, &KDecoration3::DecoratedWindow::widthChanged,
+            this, &Decoration::updateTitleBar);
+    connect(decorated, &KDecoration3::DecoratedWindow::widthChanged,
+            this, &Decoration::updateButtonsGeometry);
+    // The outermost button of a group grows at a screen edge. The three
+    // signals below also drive the border code, and they drive the button
+    // geometry as well. A border of zero width stays zero over the change, and
+    // bordersChanged then stays silent.
+    connect(decorated,
+            &KDecoration3::DecoratedWindow::adjacentScreenEdgesChanged,
+            this, &Decoration::updateButtonsGeometry);
+    connect(decorated,
+            &KDecoration3::DecoratedWindow::maximizedHorizontallyChanged,
+            this, &Decoration::updateButtonsGeometry);
+    connect(decorated,
+            &KDecoration3::DecoratedWindow::maximizedVerticallyChanged,
+            this, &Decoration::updateButtonsGeometry);
+    connect(this, &KDecoration3::Decoration::bordersChanged,
+            this, &Decoration::updateTitleBar);
+    connect(this, &KDecoration3::Decoration::bordersChanged,
+            this, &Decoration::updateButtonsGeometry);
+
+    recalculateBorders();
+    updateTitleBar();
+    m_leftButtons = new KDecoration3::DecorationButtonGroup(
+        KDecoration3::DecorationButtonGroup::Position::Left, this,
+        &Button::create);
+    m_rightButtons = new KDecoration3::DecorationButtonGroup(
+        KDecoration3::DecorationButtonGroup::Position::Right, this,
+        &Button::create);
+    updateButtonsGeometry();
+    updateShadow();
+    return true;
+}
+
+void
+Decoration::updateShadow()
+{
+    const bool active = window()->isActive();
+    auto &shared = active ? activeShadow : inactiveShadow;
+    if (!shared) {
+        shared = shadowFor(active);
+    }
+    setShadow(shared);
+}
+
+qreal
+Decoration::topRadius() const
+{
+    if (window()->isMaximized() || !settings()->isAlphaChannelSupported() ||
+        options().round <= ROUND_SLIGHT) {
+        return 0;
+    }
+    return (titleBarAppearance() == APPEARANCE_NONE ? noAppearanceRadius :
+            titleBarRadius);
+}
+
+qreal
+Decoration::bottomRadius() const
+{
+    if (topRadius() <= 0) {
+        return 0;
+    }
+    return (DecorationConfig::instance().roundBottom() ? roundBottomRadius :
+            flatBottomRadius);
+}
+
+QPainterPath
+Decoration::framePath() const
+{
+    return framedPath(rect(), topRadius(), bottomRadius());
+}
+
+QColor
+Decoration::borderColor(DecorationConfig::Shade shadeType) const
+{
+    const Options &opts = options();
+    const QColor base = titleBarColor();
+    if (shadeType == DecorationConfig::SHADE_LIGHT) {
+        return shade(base, shadeFactor(opts, 0), opts.shading);
+    }
+    if (shadeType == DecorationConfig::SHADE_SHADOW) {
+        const bool active = window()->isActive();
+        const QColor shadowColour = DecorationConfig::instance().shadow(active).color();
+        return qtcColorMix(&base, &shadowColour,
+                           active ? activeShadowBorderAlpha :
+                           inactiveShadowBorderAlpha);
+    }
+    return shade(base, shadeFactor(opts, QTC_STD_BORDER), opts.shading);
+}
+
+QPair<QRectF, Qt::Alignment>
+Decoration::captionRect() const
+{
+    const qreal width = size().width();
+    const qreal leftOffset = (!m_leftButtons ||
+                              m_leftButtons->buttons().isEmpty()) ?
+        captionPad : m_leftButtons->geometry().right() + captionPad;
+    const qreal rightOffset = (!m_rightButtons ||
+                               m_rightButtons->buttons().isEmpty()) ?
+        captionPad : width - m_rightButtons->geometry().left() + captionPad;
+    const QRectF between(leftOffset, 0, qMax(qreal(0),
+                                             width - leftOffset - rightOffset),
+                         borderTop());
+
+    switch (options().titlebarAlignment) {
+    case ALIGN_LEFT:
+        return qMakePair(between, Qt::AlignVCenter | Qt::AlignLeft);
+    case ALIGN_RIGHT:
+        return qMakePair(between, Qt::AlignVCenter | Qt::AlignRight);
+    case ALIGN_CENTER:
+        return qMakePair(between, Qt::AlignCenter);
+    case ALIGN_FULL_CENTER:
+    default:
+        break;
+    }
+
+    // The full centre alignment centres the caption over the whole title bar
+    // while the text clears both button groups.
+    QRectF bounds = settings()->fontMetrics().boundingRect(window()->caption());
+    bounds.moveLeft((width - bounds.width()) / 2);
+    if (bounds.left() < leftOffset) {
+        return qMakePair(between, Qt::AlignVCenter | Qt::AlignLeft);
+    }
+    if (bounds.right() > width - rightOffset) {
+        return qMakePair(between, Qt::AlignVCenter | Qt::AlignRight);
+    }
+    return qMakePair(QRectF(0, 0, width, borderTop()), Qt::AlignCenter);
+}
+
+void
+Decoration::paintTitleBar(QPainter *painter, const QRectF &repaintRegion)
+{
+    const qreal height = borderTop();
+    if (height <= 0) {
+        return;
+    }
+    const QRectF bar(0, 0, size().width(), height);
+    if (!bar.intersects(repaintRegion)) {
+        return;
+    }
+    const Options &opts = options();
+
+    painter->save();
+    painter->setRenderHint(QPainter::Antialiasing);
+    painter->setPen(Qt::NoPen);
+
+    // The gradient covers the title bar only. A path over the whole window
+    // stretches the same gradient over the border as well, which flattens the
+    // shading.
+    const QPainterPath barPath = framedPath(bar, topRadius(), 0);
+
+    // The fill title bar flag adds the window background under the title bar
+    // appearance. paintEvent() in qt6/kwin/qtcurveclient.cpp lets the flag
+    // extend the background fill over the title bar. The same function draws
+    // the title bar appearance in every case.
+    if (opts.windowBorder & WINDOW_BORDER_FILL_TITLEBAR) {
+        fillGradient(painter, barPath,
+                     window()->color(window()->isActive() ?
+                                     ColorGroup::Active : ColorGroup::Inactive,
+                                     ColorRole::Frame),
+                     opts.bgndAppearance, opts);
+    }
+    fillGradient(painter, barPath, titleBarColor(), titleBarAppearance(), opts);
+    painter->restore();
+
+    painter->save();
+    painter->setFont(settings()->font());
+    const QFontMetricsF metrics(settings()->font());
+    const auto [area, alignment] = captionRect();
+
+    // The titlebarIcon key selects the place of the window icon. This
+    // decoration keeps the icon beside the caption for the menu button value
+    // as well, because KDecoration3 draws the menu button itself.
+    const QIcon icon = (opts.titlebarIcon == TITLEBAR_ICON_NONE ? QIcon() :
+                        window()->icon());
+    const qreal iconSide = icon.isNull() ? 0 :
+        std::floor(qMin(metrics.height(), height - 2 * buttonVerticalPad));
+    const qreal iconRoom = iconSide > 0 ? iconSide + iconPad : 0;
+    const QString caption =
+        metrics.elidedText(window()->caption(), Qt::ElideMiddle,
+                           qMax(qreal(0), area.width() - iconRoom));
+    const qreal textWidth = metrics.horizontalAdvance(caption);
+    const qreal blockWidth = textWidth + iconRoom;
+
+    qreal left = area.left();
+    if (alignment & Qt::AlignRight) {
+        left = area.right() - blockWidth;
+    } else if (alignment & Qt::AlignHCenter) {
+        left = area.left() + (area.width() - blockWidth) / 2;
+    }
+    if (iconSide > 0) {
+        icon.paint(painter,
+                   QRectF(left, (height - iconSide) / 2, iconSide,
+                          iconSide).toRect());
+    }
+    const QRectF textRect(left + iconRoom, 0, textWidth, height);
+
+    // The titlebarEffect key selects the second caption under the caption. The
+    // shadow value draws one pixel down and one pixel right, in a ten percent
+    // black mix of the title bar colour. The etch value draws one pixel down,
+    // in a sixty percent white mix of the title bar colour.
+    if (opts.titlebarEffect != EFFECT_NONE) {
+        const QColor edge(WINDOW_SHADOW_COLOR(opts.titlebarEffect));
+        const QColor base = titleBarColor();
+        painter->setPen(qtcColorMix(&base, &edge,
+                                    WINDOW_TEXT_SHADOW_ALPHA(
+                                        opts.titlebarEffect)));
+        painter->drawText(textRect.translated(
+                              opts.titlebarEffect == EFFECT_SHADOW ? 1 : 0, 1),
+                          Qt::AlignVCenter | Qt::AlignLeft | Qt::TextSingleLine,
+                          caption);
+    }
+    painter->setPen(fontColor());
+    painter->drawText(textRect,
+                      Qt::AlignVCenter | Qt::AlignLeft | Qt::TextSingleLine,
+                      caption);
+    painter->restore();
+
+    if (m_leftButtons) {
+        m_leftButtons->paint(painter, repaintRegion);
+    }
+    if (m_rightButtons) {
+        m_rightButtons->paint(painter, repaintRegion);
+    }
+}
+
+void
+Decoration::paint(QPainter *painter, const QRectF &repaintRegion)
+{
+    const Options &opts = options();
+    const DecorationConfig &config = DecorationConfig::instance();
+    const ColorGroup group = window()->isActive() ? ColorGroup::Active :
+        ColorGroup::Inactive;
+    const QPainterPath frame = framePath();
+
+    // The colorTitlebarOnly key gives the border the window background. The
+    // border keeps the title bar colour while the key is off, which is the
+    // default of the style.
+    const QColor fill =
+        window()->color(group, opts.windowBorder &
+                        WINDOW_BORDER_COLOR_TITLEBAR_ONLY ?
+                        ColorRole::Frame : ColorRole::TitleBar);
+    painter->save();
+    painter->setRenderHint(QPainter::Antialiasing);
+    painter->setPen(Qt::NoPen);
+    painter->fillPath(frame, fill);
+    painter->restore();
+
+    paintTitleBar(painter, repaintRegion);
+
+    const QColor base = titleBarColor();
+    const qreal top = topRadius();
+    const qreal bottom = bottomRadius();
+
+    if (opts.windowBorder & WINDOW_BORDER_ADD_LIGHT_BORDER) {
+        painter->save();
+        painter->setRenderHint(QPainter::Antialiasing);
+        painter->setBrush(Qt::NoBrush);
+        // The light line follows the top edge and the two side edges of the
+        // title bar, one pixel inside the border.
+        painter->setClipRect(QRectF(0, 0, size().width(), borderTop()),
+                             Qt::IntersectClip);
+        painter->setPen(QPen(shade(base, shadeFactor(opts, 0), opts.shading),
+                             1.0));
+        painter->drawPath(framedPath(rect().adjusted(1.5, 1.5, -1.5, 0),
+                                     qMax(qreal(0), top - 1.5), 0));
+        painter->restore();
+    }
+
+    if (window()->isActive() && (opts.windowBorder & WINDOW_BORDER_SEPARATOR)) {
+        painter->save();
+        painter->setPen(QPen(borderColor(DecorationConfig::SHADE_DARK), 1.0));
+        const qreal line = borderTop() - 0.5;
+        painter->drawLine(QPointF(0, line), QPointF(size().width(), line));
+        painter->restore();
+    }
+
+    painter->save();
+    painter->setRenderHint(QPainter::Antialiasing);
+    painter->setBrush(Qt::NoBrush);
+    painter->setPen(QPen(borderColor(config.outerBorder()), 1.0));
+    painter->drawPath(framedPath(rect().adjusted(0.5, 0.5, -0.5, -0.5),
+                                 qMax(qreal(0), top - 0.5),
+                                 qMax(qreal(0), bottom - 0.5)));
+    if (config.outerBorder() != DecorationConfig::SHADE_NONE &&
+        config.innerBorder() != DecorationConfig::SHADE_NONE) {
+        painter->setPen(QPen(borderColor(config.innerBorder()), 1.0));
+        painter->drawPath(framedPath(rect().adjusted(1.5, 1.5, -1.5, -1.5),
+                                     qMax(qreal(0), top - 1.5),
+                                     qMax(qreal(0), bottom - 1.5)));
+    }
+    painter->restore();
+}
+
+}
+
+#include "qtcurvedecoration.moc"
