+
+#ifndef qtcurvedecorationbutton_h
+#define qtcurvedecorationbutton_h
+
+#include "qtcurvedecoration.h"
+
+#include <KDecoration3/DecorationButton>
+
+#include <QColor>
+#include <QMarginsF>
+#include <QRectF>
+#include <QVariantList>
+
+namespace QtCurve {
+
+//! one title bar button of the QtCurve window decoration
+/*! The button draws a frame and a glyph. The glyph follows the line art of the
+    QtCurve style for KDE4. The titlebarButtons key of the style settings
+    selects the shape of the frame, the colour of the frame and the fade of the
+    glyph. The compositor thread owns every button. */
+class Button : public KDecoration3::DecorationButton {
+    Q_OBJECT
+public:
+    //! make a button for the decoration framework
+    /*! \param parent the parent object, or a null pointer.
+        \param args the button type in the first entry and the decoration in
+        the second entry. */
+    explicit Button(QObject *parent, const QVariantList &args);
+    ~Button() override=default;
+
+    //! make a button for a button group
+    /*! \param type the button to make.
+        \param decoration the decoration that holds the button.
+        \param parent the parent object, or a null pointer.
+        \return the new button, or a null pointer if the decoration is not a
+        QtCurve decoration. */
+    static Button *create(KDecoration3::DecorationButtonType type,
+                          KDecoration3::Decoration *decoration,
+                          QObject *parent);
+
+    //! draw the button
+    /*! \param painter the painter of the decoration framework.
+        \param repaintRegion the area that needs paint. The call ignores the
+        area, because a button is small. */
+    void paint(QPainter *painter, const QRectF &repaintRegion) override;
+
+    //! set the room that the button takes outside its square
+    /*! The decoration grows a button that sits at a screen edge, so the button
+        takes every click up to the edge. The frame and the glyph keep the
+        square, and the room stays empty.
+        \param value the room on each side of the square, in pixels. */
+    void setPadding(const QMarginsF &value) { m_padding = value; }
+
+private:
+    //! make a button for a QtCurve decoration
+    /*! \param type the button to make.
+        \param decoration the decoration that holds the button.
+        \param parent the parent object, or a null pointer. */
+    explicit Button(KDecoration3::DecorationButtonType type,
+                    Decoration *decoration, QObject *parent=nullptr);
+
+    //! true while the button takes a colour of the titlebarButtonColors key
+    /*! coloredMdiButtons() in qt6/style/qtcurve.cpp makes the same test.
+        \return true while the colour key is on, and the window state and the
+        pointer position match the two colour flags. */
+    bool colored() const;
+
+    //! the colour of this button in the titlebarButtonColors key
+    /*! \return the colour of the button type, or the title bar colour while
+        the key holds no colour for the type. */
+    QColor buttonColor() const;
+
+    //! draw the frame of the button
+    /*! The call draws nothing while the no frame flag is on. It also draws
+        nothing while the hover frame flag is on and the pointer sits away from
+        the button.
+        \param painter the painter to draw with.
+        \param rect the square of the button, without the room outside it. */
+    void drawFrame(QPainter *painter, const QRectF &rect) const;
+
+    //! draw the line art of the button
+    /*! \param painter the painter to draw with.
+        \param rect the area of the glyph, which is smaller than the button.
+        \param color the colour of the line art. */
+    void drawGlyph(QPainter *painter, const QRectF &rect,
+                   const QColor &color) const;
+
+    //! the colour of the line art
+    /*! \return the button colour for the colour symbol flag, or the caption
+        colour. The close button under the pointer gets the QtCurve close
+        colour. The colour fades while the hover symbol flag is on and the
+        pointer sits away from the button. */
+    QColor glyphColor() const;
+
+    //! the room that the button takes outside its square, in pixels
+    QMarginsF m_padding;
+};
+
+}
+
+#endif
