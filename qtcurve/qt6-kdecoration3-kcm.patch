+/*! An older settings module wrote a boolean value. A later one wrote a Shade
+    number. The reader therefore takes both forms, as readShade() in
+    qt6/kwin/qtcurveconfig.cpp does.
+    \param group the group that holds the key.
+    \param key the name of the key.
+    \return the shade, or DecorationConfig::SHADE_NONE for an absent key, for
+    an empty value and for a value outside the Shade range. */
+inline DecorationConfig::Shade
+readShade(const KConfigGroup &group, const char *key)
+{
+    const QString entry = group.readEntry(key, QString());
+    if (entry.isEmpty() || QLatin1String("false") == entry) {
+        return DecorationConfig::SHADE_NONE;
+    }
+    if (QLatin1String("true") == entry) {
+        return DecorationConfig::SHADE_DARK;
+    }
+    const int value = entry.toInt();
+    if (value > DecorationConfig::SHADE_NONE &&
+        value <= DecorationConfig::SHADE_SHADOW) {
+        return DecorationConfig::Shade(value);
+    }
+    return DecorationConfig::SHADE_NONE;
+}
