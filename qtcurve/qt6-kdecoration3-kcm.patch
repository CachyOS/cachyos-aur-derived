+ *   Lesser General Public License for more details.                         *
+ *                                                                           *
+ *   You should have received a copy of the GNU Lesser General Public        *
+ *   License along with this library. If not,                                *
+ *   see <http://www.gnu.org/licenses/>.                                     *
+ *****************************************************************************/
+
+#ifndef qtcurvedecorationkcm_h
+#define qtcurvedecorationkcm_h
+
+#include "qtcurvedecorationsettings.h"
+#include "ui_qtcurvedecorationconfigui.h"
+
+#include <KCModule>
+#include <KSharedConfig>
+
+class KPluginMetaData;
+
+namespace QtCurve {
+
+//! the settings module of the QtCurve window decoration
+/*! System Settings and the pencil button of the Window Decorations page open
+    the module. The module edits the kwinqtcurverc file, which holds the border
+    shades and the drop shadow of the decoration.
+    qt6/kdecoration/qtcurvedecorationconfig.cpp reads the same file.
+
+    Warning: the KWin page of the settings dialogue of the QtCurve style edits
+    the same file. That page writes a shadow key for a custom shadow alone. It
+    writes the border size and the opacity keys as well, so the two pages use
+    different rules. A user can hold both pages open, and the last save wins.
+
+    The module edits no key of the configuration file of the QtCurve style. The
+    settings dialogue of the style holds the title bar gradient, the button
+    layout and the other keys of the frame.
+
+    The class is a port of KWinConfig in qt6/kwinconfig/qtcurvekwinconfig.h. It
+    drops the border size, the borderless maximised windows, the window
+    grouping and the two opacity values, because the KDecoration3 decoration
+    reads none of them. KWin gives the border size now.
+
+    The graphical thread of the host application owns every instance. */
+class DecorationKCM: public KCModule {
+    Q_OBJECT
+public:
+    //! make the module and fill the combination boxes
+    /*! \param parent the parent object of the host application.
+        \param data the metadata of the plugin. */
+    explicit DecorationKCM(QObject *parent, const KPluginMetaData &data);
+
+    //! read the kwinqtcurverc file into the widgets
+    /*! The module opens the kwinqtcurverc file one time, and the object holds
+        the values of that read. A save from another page therefore leaves it
+        stale, so the call reads the file again first. */
+    void load() override;
+
+    //! write the widgets to the kwinqtcurverc file
+    /*! The call reads the file again first, so a value that the user did not
+        touch still reaches the file. It writes every key that the decoration
+        uses, except the Color key. It writes that key for the CT_CUSTOM colour
+        type alone, and it removes that key for every other type. It keeps every
+        other key of the file. It then asks KWin to reload its configuration
+        over the session bus, so a running compositor takes the change. */
+    void save() override;
+
+    //! give every widget the default of the decoration
+    /*! The call writes nothing. The host application calls save() after it. */
+    void defaults() override;
+
+private:
+    //! give every widget the value of a settings holder
+    /*! \param settings the settings holder. */
+    void setWidgets(const DecorationSettings &settings);
+
+    //! give a settings holder the value of every widget
+    /*! \param settings the settings holder. */
+    void readWidgets(DecorationSettings &settings) const;
+
+    //! enable the widgets that another widget controls
+    /*! The custom shadow box drives the size row and the two offset rows. The
+        two colour rows stay live for a border of the shadow shade as well. The
+        decoration reads the shadow colour for that shade with the custom
+        shadow box off. */
+    void setWidgetStates();
+
+    //! tell the host application whether the widgets differ from the file
+    void updateChanged();
+
+    //! the widgets of the page
+    Ui::QtCurveDecorationConfigUI m_ui;
+
+    //! the kwinqtcurverc file
+    KSharedConfig::Ptr m_config;
+
+    //! the values of the file, as the last load() or save() left them
+    DecorationSettings m_settings;
+};
+
+}
+
+#endif
diff --git a/qt6/kdecoration/config/qtcurvedecorationsettings.cpp b/qt6/kdecoration/config/qtcurvedecorationsettings.cpp
new file mode 100644
index 00000000..efdb7377
--- /dev/null
+++ b/qt6/kdecoration/config/qtcurvedecorationsettings.cpp
@@ -0,0 +1,189 @@
+/*****************************************************************************
+ *   Copyright 2007 - 2010 Craig Drummond <craig.p.drummond@gmail.com>       *
+ *   Copyright 2013 - 2015 Yichao Yu <yyc1992@gmail.com>                     *
+ *                                                                           *
+ *   This program is free software; you can redistribute it and/or modify    *
+ *   it under the terms of the GNU Lesser General Public License as          *
+ *   published by the Free Software Foundation; either version 2.1 of the    *
+ *   License, or (at your option) version 3, or any later version accepted   *
+ *   by the membership of KDE e.V. (or its successor approved by the         *
+ *   membership of KDE e.V.), which shall act as a proxy defined in          *
+ *   Section 6 of version 3 of the license.                                  *
+ *                                                                           *
+ *   This program is distributed in the hope that it will be useful,         *
+ *   but WITHOUT ANY WARRANTY; without even the implied warranty of          *
+ *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU       *
+ *   Lesser General Public License for more details.                         *
+ *                                                                           *
+ *   You should have received a copy of the GNU Lesser General Public        *
+ *   License along with this library. If not,                                *
+ *   see <http://www.gnu.org/licenses/>.                                     *
+ *****************************************************************************/
+
+#include "qtcurvedecorationsettings.h"
+
+#include <KConfig>
+#include <KConfigGroup>
+
+#include <QString>
+
+namespace QtCurve {
+
+ShadowSettings::ShadowSettings(QPalette::ColorGroup colorGroup)
+    : m_colorGroup(colorGroup)
+{
+    defaults();
+}
+
+const char*
+ShadowSettings::group() const
+{
+    return (QPalette::Active == m_colorGroup ? activeShadowGroup :
+            inactiveShadowGroup);
+}
+
+void
+ShadowSettings::defaults()
+{
+    hOffset = ShadowConfig::DEFAULT_HOFFSET;
+    vOffset = ShadowConfig::DEFAULT_VOFFSET;
+    color = QColor(QString::fromLatin1(fixedShadowGray));
+    if (QPalette::Active == m_colorGroup) {
+        size = ShadowConfig::DEFAULT_ACTIVE_SIZE;
+        colorType = ShadowConfig::CT_FOCUS;
+    } else {
+        size = ShadowConfig::DEFAULT_INACTIVE_SIZE;
+        colorType = ShadowConfig::CT_GRAY;
+    }
+}
+
+void
+ShadowSettings::load(const KConfig *cfg)
+{
+    const KConfigGroup entries(cfg, QString::fromLatin1(group()));
+    const ShadowSettings def(m_colorGroup);
+
+    size = entries.readEntry("Size", def.size);
+    hOffset = entries.readEntry("HOffset", def.hOffset);
+    vOffset = entries.readEntry("VOffset", def.vOffset);
+    colorType = entries.readEntry("ColorType", def.colorType);
+    color = entries.readEntry("Color", def.color);
+    if (size < ShadowConfig::MIN_SIZE || size > ShadowConfig::MAX_SIZE) {
+        size = def.size;
+    }
+    if (hOffset < ShadowConfig::MIN_OFFSET ||
+        hOffset > ShadowConfig::MAX_OFFSET) {
+        hOffset = def.hOffset;
+    }
+    if (vOffset < ShadowConfig::MIN_OFFSET ||
+        vOffset > ShadowConfig::MAX_OFFSET) {
+        vOffset = def.vOffset;
+    }
+    if (colorType < ShadowConfig::CT_FOCUS ||
+        colorType > ShadowConfig::CT_CUSTOM) {
+        colorType = def.colorType;
+    }
+}
+
+bool
+ShadowSettings::operator==(const ShadowSettings &other) const
+{
+    return (size == other.size && hOffset == other.hOffset &&
+            vOffset == other.vOffset && colorType == other.colorType &&
+            (ShadowConfig::CT_CUSTOM != colorType || color == other.color));
+}
+
+void
+ShadowSettings::save(KConfig *cfg) const
+{
+    KConfigGroup entries(cfg, QString::fromLatin1(group()));
+
+    entries.writeEntry("Size", size);
+    entries.writeEntry("HOffset", hOffset);
+    entries.writeEntry("VOffset", vOffset);
+    entries.writeEntry("ColorType", colorType);
+    // The call writes no ShadowType key. ShadowConfig reads the key, but the
+    // painter draws every shadow in one colour, so the value changes nothing.
+    // The key of the KDE4 settings module therefore stays as it is.
+    if (ShadowConfig::CT_CUSTOM == colorType) {
+        entries.writeEntry("Color", color);
+    } else {
+        entries.deleteEntry("Color");
+    }
+}
+
+DecorationSettings::DecorationSettings()
+    : activeShadow(QPalette::Active),
+      inactiveShadow(QPalette::Inactive)
+{
+    defaults();
+}
+
+void
+DecorationSettings::defaults()
+{
+    outerBorder = DecorationConfig::SHADE_NONE;
+    innerBorder = DecorationConfig::SHADE_NONE;
+    roundBottom = DecorationConfig::DEFAULT_ROUND_BOTTOM;
+    customShadows = DecorationConfig::DEFAULT_CUSTOM_SHADOWS;
+    titleBarPad = DecorationConfig::DEFAULT_PAD;
+    edgePad = DecorationConfig::DEFAULT_PAD;
+    activeShadow.defaults();
+    inactiveShadow.defaults();
+}
+
+bool
+DecorationSettings::operator==(const DecorationSettings &other) const
+{
+    return (outerBorder == other.outerBorder &&
+            innerBorder == other.innerBorder &&
+            roundBottom == other.roundBottom &&
+            customShadows == other.customShadows &&
+            titleBarPad == other.titleBarPad && edgePad == other.edgePad &&
+            activeShadow == other.activeShadow &&
+            inactiveShadow == other.inactiveShadow);
+}
+
+void
+DecorationSettings::load(const KConfig *cfg)
+{
+    const KConfigGroup entries(cfg, QString::fromLatin1(frameGroup));
+    const DecorationSettings def;
+
+    outerBorder = readShade(entries, "OuterBorder");
+    innerBorder = (DecorationConfig::SHADE_NONE == outerBorder ?
+                   DecorationConfig::SHADE_NONE :
+                   readShade(entries, "InnerBorder"));
+    roundBottom = entries.readEntry("RoundBottom", def.roundBottom);
+    customShadows = entries.readEntry("CustomShadows", def.customShadows);
+    titleBarPad = entries.readEntry("TitleBarPad", def.titleBarPad);
+    edgePad = entries.readEntry("EdgePad", def.edgePad);
+    if (titleBarPad < DecorationConfig::MIN_TITLE_BAR_PAD ||
+        titleBarPad > DecorationConfig::MAX_TITLE_BAR_PAD) {
+        titleBarPad = def.titleBarPad;
+    }
+    if (edgePad < DecorationConfig::MIN_EDGE_PAD ||
+        edgePad > DecorationConfig::MAX_EDGE_PAD) {
+        edgePad = def.edgePad;
+    }
+    activeShadow.load(cfg);
+    inactiveShadow.load(cfg);
+}
+
+void
+DecorationSettings::save(KConfig *cfg) const
+{
+    KConfigGroup entries(cfg, QString::fromLatin1(frameGroup));
+
+    // The reader takes a number and a boolean value, and it writes a number.
+    entries.writeEntry("OuterBorder", outerBorder);
+    entries.writeEntry("InnerBorder", innerBorder);
+    entries.writeEntry("RoundBottom", roundBottom);
+    entries.writeEntry("CustomShadows", customShadows);
+    entries.writeEntry("TitleBarPad", titleBarPad);
+    entries.writeEntry("EdgePad", edgePad);
+    activeShadow.save(cfg);
+    inactiveShadow.save(cfg);
+}
+
+}
diff --git a/qt6/kdecoration/config/qtcurvedecorationsettings.h b/qt6/kdecoration/config/qtcurvedecorationsettings.h
new file mode 100644
index 00000000..89f2e13e
--- /dev/null
+++ b/qt6/kdecoration/config/qtcurvedecorationsettings.h
@@ -0,0 +1,169 @@
+/*****************************************************************************
+ *   Copyright 2007 - 2010 Craig Drummond <craig.p.drummond@gmail.com>       *
+ *   Copyright 2013 - 2015 Yichao Yu <yyc1992@gmail.com>                     *
+ *                                                                           *
