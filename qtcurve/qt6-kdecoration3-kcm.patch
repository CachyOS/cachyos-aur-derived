+ *   by the membership of KDE e.V. (or its successor approved by the         *
+ *   membership of KDE e.V.), which shall act as a proxy defined in          *
+ *   Section 6 of version 3 of the license.                                  *
+ *                                                                           *
+ *   This program is distributed in the hope that it will be useful,         *
+ *   but WITHOUT ANY WARRANTY; without even the implied warranty of          *
+ *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU       *
+ *   Lesser General Public License for more details.                         *
+ *                                                                           *
+ *   You should have received a copy of the GNU Lesser General Public        *
+ *   License along with this library. If not,                                *
+ *   see <http://www.gnu.org/licenses/>.                                     *
+ *****************************************************************************/
+
+#ifndef qtcurvedecorationsettings_h
+#define qtcurvedecorationsettings_h
+
+#include "qtcurvedecorationconfig.h"
+
+#include <QColor>
+#include <QPalette>
+
+class KConfig;
+
+namespace QtCurve {
+
+//! the shadow keys of one window state, in the form that the module edits
+/*! The class reads and writes the ActiveShadows group and the InactiveShadows
+    group of the kwinqtcurverc file. ShadowConfig in
+    qt6/kdecoration/qtcurvedecorationconfig.h reads the same keys, and it gives
+    the group names, the limits and the defaults that this class uses.
+
+    The class writes the Color key for the CT_CUSTOM colour type alone, because
+    the decoration reads the key for that type alone. The colour keeps the
+    value of the colour button while another type is current.
+
+    The class writes no ShadowType key, because the module shows no row for
+    it. A save therefore leaves the key of the KDE4 settings module as it is.
+
+    The thread of the settings module owns every instance. */
+class ShadowSettings {
+public:
+    //! make a shadow settings holder with the values of defaults()
+    /*! \param colorGroup the colour group that names the window state.
+        QPalette::Active selects the ActiveShadows group. Every other group
+        selects the InactiveShadows group. */
+    explicit ShadowSettings(QPalette::ColorGroup colorGroup);
+
+    //! give every value the default of the decoration
+    /*! ShadowConfig::defaults() in qt6/kdecoration/qtcurvedecorationconfig.cpp
+        gives the same values, and the colour follows the colour type. */
+    void defaults();
+
+    //! read the group of this window state
+    /*! A size or an offset outside the limits of ShadowConfig falls back to
+        the default, as ShadowConfig::load() does. The call also holds ColorType
+        inside its enumeration, which ShadowConfig::load() does not do.
+        \param cfg the kwinqtcurverc file. */
+    void load(const KConfig *cfg);
+
+    //! write the group of this window state
+    /*! The call writes Size, HOffset, VOffset and ColorType. It writes the
+        Color key for the CT_CUSTOM colour type. It removes that key for every
+        other type, because the decoration reads the key for that type alone.
+        The call keeps every other key of the group, so the ShadowType key of
+        the KDE4 settings module stays.
+        \param cfg the kwinqtcurverc file. The caller syncs the file. */
+    void save(KConfig *cfg) const;
+
+    //! the group of the file that this instance reads and writes
+    /*! \return activeShadowGroup or inactiveShadowGroup. */
+    const char *group() const;
+
+    //! compare with another holder of the same window state
+    /*! The call ignores the colour while the colour type is not CT_CUSTOM,
+        because the decoration reads the Color key for that type alone. It
+        holds no ShadowType value, because a save writes no such key.
+        \param other the other holder.
+        \return true while both hold the same keys. */
+    bool operator==(const ShadowSettings &other) const;
+
+    //! the length of the shadow gradient, in pixels
+    int size;
+    //! the distance that the shadow moves to the right, in pixels
+    int hOffset;
+    //! the distance that the shadow moves down, in pixels
+    int vOffset;
+    //! the source of the shadow colour, as a ShadowConfig::ColorType value
+    int colorType;
+    //! the colour that the colour button of the group shows
+    /*! defaults() and load() give it the colour of the current colour type,
+        and save() writes it for the CT_CUSTOM type alone. */
+    QColor color;
+
+private:
+    //! the colour group that names the window state
+    QPalette::ColorGroup m_colorGroup;
+};
+
+//! every key of the kwinqtcurverc file that the decoration reads
+/*! DecorationConfig in qt6/kdecoration/qtcurvedecorationconfig.h reads the same
+    keys, and it gives the group name, the limits and the defaults that this
+    class uses. The class edits no key of the configuration file of the QtCurve
+    style. It also edits no key that the KDE4 decoration alone reads, such as
+    BorderSize.
+
+    Warning: the KWin page inside kstyle_qtcurve6_config writes the same file
+    with different rules, and the last save wins.
+
+    The thread of the settings module owns every instance. */
+class DecorationSettings {
+public:
+    //! make a settings holder with the values of defaults()
+    DecorationSettings();
+
+    //! give every value the default of the decoration
+    void defaults();
+
+    //! read the kwinqtcurverc file
+    /*! \param cfg the kwinqtcurverc file. */
+    void load(const KConfig *cfg);
+
+    //! write the kwinqtcurverc file
+    /*! The call writes every key that the decoration uses, except the Color
+        key. It writes that key for the CT_CUSTOM colour type alone, and it
+        removes that key for every other type. It keeps every other key of the
+        file.
+        \param cfg the kwinqtcurverc file. The caller syncs the file. */
+    void save(KConfig *cfg) const;
+
+    //! the shade of the outer window border, as a DecorationConfig::Shade value
+    int outerBorder;
+    //! the shade of the inner window border, as a DecorationConfig::Shade value
+    /*! The decoration reads the value as SHADE_NONE while the outer border is
+        SHADE_NONE. */
+    int innerBorder;
+    //! true while the bottom corners of the window are round
+    bool roundBottom;
+    //! true while the decoration draws the shadow of the two shadow groups
+    bool customShadows;
+    //! the extra room above and below the caption, in pixels
+    int titleBarPad;
+    //! the extra width of the side border and of the bottom border, in pixels
+    int edgePad;
+    //! the shadow of an active window
+    ShadowSettings activeShadow;
+    //! the shadow of an inactive window
+    ShadowSettings inactiveShadow;
+
+    //! compare with another holder
+    /*! \param other the other holder.
+        \return true while both hold the same keys. */
+    bool operator==(const DecorationSettings &other) const;
+};
+
+}
+
+#endif
