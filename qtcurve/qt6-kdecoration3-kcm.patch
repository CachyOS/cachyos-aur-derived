diff --git a/qt6/kdecoration/config/CMakeLists.txt b/qt6/kdecoration/config/CMakeLists.txt
new file mode 100644
index 00000000..cda0b1ce
--- /dev/null
+++ b/qt6/kdecoration/config/CMakeLists.txt
@@ -0,0 +1,65 @@
+set(qtcurve_kdecoration_config_SRCS
+  kcm_qtcurvedecoration.cpp
+  qtcurvedecorationkcm.cpp
+  qtcurvedecorationsettings.cpp)
+set(qtcurve_kdecoration_config_HDRS
+  qtcurvedecorationkcm.h
+  qtcurvedecorationsettings.h)
+set(qtcurve_kdecoration_config_UIS
+  ui/qtcurvedecorationconfigui.ui)
+
+translate_add_sources(${qtcurve_kdecoration_config_SRCS}
+  ${qtcurve_kdecoration_config_HDRS}
+  ${qtcurve_kdecoration_config_UIS}
+  kcm_qtcurvedecoration.json)
+
+# The settings module is a KCMUtils plugin, and shadowColor() of
+# qt6/kdecoration/qtcurvedecorationconfig.h reads the colour scheme of the
+# session. qt6/CMakeLists.txt finds every other KF6 component that the tree
+# needs.
+find_package(KF6 REQUIRED COMPONENTS ColorScheme KCMUtils)
+
+# ki18n_wrap_ui() puts the strings of the page in the qtcurve translation
+# domain. The automatic user interface compiler of Qt takes another route and
+# builds the same header, so this directory turns it off.
+set(CMAKE_AUTOUIC False)
+ki18n_wrap_ui(qtcurve_kdecoration_config_SRCS
+  ${qtcurve_kdecoration_config_UIS})
+
+include_directories(
+  "${CMAKE_CURRENT_SOURCE_DIR}"
+  "${CMAKE_CURRENT_SOURCE_DIR}/.."
+  "${CMAKE_CURRENT_BINARY_DIR}")
+
+# qt6/CMakeLists.txt asks for ECM 1.2.0, so KDECMakeSettings leaves
+# CMAKE_LIBRARY_OUTPUT_DIRECTORY empty. kcoreaddons_add_plugin() needs the
+# variable, and it appends the install namespace to it.
+set(CMAKE_LIBRARY_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}")
+
+# kcoreaddons_add_plugin() installs the plugin in the org.kde.kdecoration3.kcm
+# directory of the Qt plugin path, beside kcm_breezedecoration.so. KWin reads
+# the X-KDE-ConfigModule key of qt6/kdecoration/qtcurve.json and looks for the
+# module there.
+kcoreaddons_add_plugin(kcm_qtcurvedecoration
+  SOURCES ${qtcurve_kdecoration_config_SRCS}
+  INSTALL_NAMESPACE "${KDECORATION_KCM_PLUGIN_DIR}")
+target_link_libraries(kcm_qtcurvedecoration
+  Qt6::Core
+  # save() asks KWin to reload its configuration over the session bus.
+  Qt6::DBus
+  Qt6::Gui
+  Qt6::Widgets
+  # setWidgets() shows the colour of the current shadow colour type, and
+  # shadowColor() takes that colour from the colour scheme.
+  KF6::ColorScheme
+  KF6::ConfigCore
+  KF6::CoreAddons
+  # qt6/kdecoration/qtcurvedecorationconfig.h includes common/common.h, and
+  # that header includes kcolorutils.h of KF6 GuiAddons.
+  KF6::GuiAddons
+  KF6::I18n
+  KF6::KCMUtils
+  KF6::WidgetsAddons)
+
+# The desktop file lets System Settings show the module in its search results.
+kcmutils_generate_desktop_file(kcm_qtcurvedecoration)
