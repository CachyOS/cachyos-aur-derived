+#include "qtcurvedecorationkcm.h"
+
+#include <KColorButton>
+#include <KConfig>
+#include <KLocalizedString>
+
+#include <QCheckBox>
+#include <QComboBox>
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include <QLabel>
+#include <QList>
+#include <QSpinBox>
+#include <QString>
+
+namespace {
+
+//! fill a combination box with the names of the shadow colour sources
+/*! The entry number is the ShadowConfig::ColorType value.
+    \param combo the combination box. */
+void
+insertColorEntries(QComboBox *combo)
+{
+    using QtCurve::ShadowConfig;
+    combo->insertItem(ShadowConfig::CT_FOCUS, i18n("Focus"));
+    combo->insertItem(ShadowConfig::CT_HOVER, i18n("Hover"));
+    combo->insertItem(ShadowConfig::CT_SELECTION, i18n("Selection Background"));
+    combo->insertItem(ShadowConfig::CT_TITLEBAR, i18n("Titlebar"));
+    combo->insertItem(ShadowConfig::CT_GRAY, i18n("Gray"));
+    combo->insertItem(ShadowConfig::CT_CUSTOM, i18n("Custom:"));
+}
+
+//! fill a combination box with the names of the border shades
+/*! The entry number is the DecorationConfig::Shade value.
+    \param combo the combination box. */
+void
+insertShadeEntries(QComboBox *combo)
+{
+    using QtCurve::DecorationConfig;
+    combo->insertItem(DecorationConfig::SHADE_NONE, i18n("None"));
+    combo->insertItem(DecorationConfig::SHADE_DARK, i18n("Dark"));
+    combo->insertItem(DecorationConfig::SHADE_LIGHT, i18n("Light"));
+    combo->insertItem(DecorationConfig::SHADE_SHADOW, i18n("Shadow"));
+}
+
+}
+
+namespace QtCurve {
+
+DecorationKCM::DecorationKCM(QObject *parent, const KPluginMetaData &data)
+    : KCModule(parent, data),
+      m_config(KSharedConfig::openConfig(QString::fromLatin1(kwinConfigFile)))
+{
+    m_ui.setupUi(widget());
+
+    insertShadeEntries(m_ui.outerBorder);
+    insertShadeEntries(m_ui.innerBorder);
+    insertColorEntries(m_ui.activeShadowColorType);
+    insertColorEntries(m_ui.inactiveShadowColorType);
+
+    m_ui.titleBarPad->setRange(DecorationConfig::MIN_TITLE_BAR_PAD,
+                               DecorationConfig::MAX_TITLE_BAR_PAD);
+    m_ui.edgePad->setRange(DecorationConfig::MIN_EDGE_PAD,
+                           DecorationConfig::MAX_EDGE_PAD);
+    for (QSpinBox *box : {m_ui.activeShadowSize, m_ui.inactiveShadowSize}) {
+        box->setRange(ShadowConfig::MIN_SIZE, ShadowConfig::MAX_SIZE);
+    }
+    for (QSpinBox *box : {m_ui.activeShadowHOffset, m_ui.activeShadowVOffset,
+                          m_ui.inactiveShadowHOffset,
+                          m_ui.inactiveShadowVOffset}) {
+        box->setRange(ShadowConfig::MIN_OFFSET, ShadowConfig::MAX_OFFSET);
+    }
+
+    connect(m_ui.roundBottom, &QCheckBox::toggled, this,
+            &DecorationKCM::updateChanged);
+    for (QSpinBox *box : {m_ui.titleBarPad, m_ui.edgePad,
+                          m_ui.activeShadowSize, m_ui.activeShadowHOffset,
+                          m_ui.activeShadowVOffset, m_ui.inactiveShadowSize,
+                          m_ui.inactiveShadowHOffset,
+                          m_ui.inactiveShadowVOffset}) {
+        connect(box, &QSpinBox::valueChanged, this,
+                &DecorationKCM::updateChanged);
+    }
+    for (KColorButton *button : {m_ui.activeShadowColor,
+                                 m_ui.inactiveShadowColor}) {
+        connect(button, &KColorButton::changed, this,
+                &DecorationKCM::updateChanged);
+    }
+    // setWidgetStates() reads the custom shadow box, the outer border box and
+    // the two colour type boxes, and it can change the inner border box. Those
+    // five widgets therefore get a handler that calls it first.
+    connect(m_ui.useShadows, &QCheckBox::toggled, this, [this] {
+        setWidgetStates();
+        updateChanged();
+    });
+    for (QComboBox *combo : {m_ui.outerBorder, m_ui.innerBorder,
+                             m_ui.activeShadowColorType,
+                             m_ui.inactiveShadowColorType}) {
+        connect(combo, &QComboBox::currentIndexChanged, this, [this] {
+            setWidgetStates();
+            updateChanged();
+        });
+    }
+}
+
+void
+DecorationKCM::load()
+{
+    // The module opens the kwinqtcurverc file one time, and the object holds
+    // the values of that read. A save from another page therefore leaves it
+    // stale. The call reads the file again before it fills the widgets.
+    m_config->reparseConfiguration();
+    m_settings.load(m_config.data());
+    setWidgets(m_settings);
+    setNeedsSave(false);
+}
+
+void
+DecorationKCM::save()
+{
+    // The object holds the values of the last read. Read the file again first,
+    // so a value that the user did not touch still differs from the entry of
+    // the file, and KConfig writes it.
+    m_config->reparseConfiguration();
+    readWidgets(m_settings);
+    m_settings.save(m_config.data());
+    m_config->sync();
+    setNeedsSave(false);
+    // KWin reloads its configuration on this signal, and it then emits the
+    // reconfigured signal of KDecoration3. Decoration::reconfigure() reads the
+    // file again on that signal, so the change reaches every open window.
+    // kcm_breezedecoration sends the same signal.
+    QDBusConnection::sessionBus().send(
+        QDBusMessage::createSignal(QStringLiteral("/KWin"),
+                                   QStringLiteral("org.kde.KWin"),
+                                   QStringLiteral("reloadConfig")));
+}
+
+void
+DecorationKCM::defaults()
+{
+    setWidgets(DecorationSettings());
+}
+
+void
+DecorationKCM::setWidgets(const DecorationSettings &settings)
+{
+    m_ui.outerBorder->setCurrentIndex(settings.outerBorder);
+    m_ui.innerBorder->setCurrentIndex(settings.innerBorder);
+    m_ui.roundBottom->setChecked(settings.roundBottom);
+    m_ui.useShadows->setChecked(settings.customShadows);
+    m_ui.titleBarPad->setValue(settings.titleBarPad);
+    m_ui.edgePad->setValue(settings.edgePad);
+
+    m_ui.activeShadowSize->setValue(settings.activeShadow.size);
+    m_ui.activeShadowHOffset->setValue(settings.activeShadow.hOffset);
+    m_ui.activeShadowVOffset->setValue(settings.activeShadow.vOffset);
+    m_ui.activeShadowColorType->setCurrentIndex(settings.activeShadow.colorType);
+    m_ui.activeShadowColor->setColor(settings.activeShadow.color);
+
+    m_ui.inactiveShadowSize->setValue(settings.inactiveShadow.size);
+    m_ui.inactiveShadowHOffset->setValue(settings.inactiveShadow.hOffset);
+    m_ui.inactiveShadowVOffset->setValue(settings.inactiveShadow.vOffset);
+    m_ui.inactiveShadowColorType
+        ->setCurrentIndex(settings.inactiveShadow.colorType);
+    m_ui.inactiveShadowColor->setColor(settings.inactiveShadow.color);
+
+    setWidgetStates();
+}
+
+void
+DecorationKCM::readWidgets(DecorationSettings &settings) const
+{
+    settings.outerBorder = m_ui.outerBorder->currentIndex();
+    settings.innerBorder = m_ui.innerBorder->currentIndex();
+    settings.roundBottom = m_ui.roundBottom->isChecked();
+    settings.customShadows = m_ui.useShadows->isChecked();
+    settings.titleBarPad = m_ui.titleBarPad->value();
+    settings.edgePad = m_ui.edgePad->value();
+
+    settings.activeShadow.size = m_ui.activeShadowSize->value();
+    settings.activeShadow.hOffset = m_ui.activeShadowHOffset->value();
+    settings.activeShadow.vOffset = m_ui.activeShadowVOffset->value();
+    settings.activeShadow.colorType = m_ui.activeShadowColorType->currentIndex();
+    settings.activeShadow.color = m_ui.activeShadowColor->color();
+
+    settings.inactiveShadow.size = m_ui.inactiveShadowSize->value();
+    settings.inactiveShadow.hOffset = m_ui.inactiveShadowHOffset->value();
+    settings.inactiveShadow.vOffset = m_ui.inactiveShadowVOffset->value();
+    settings.inactiveShadow.colorType =
+        m_ui.inactiveShadowColorType->currentIndex();
+    settings.inactiveShadow.color = m_ui.inactiveShadowColor->color();
+}
+
+void
+DecorationKCM::setWidgetStates()
+{
+    // The decoration reads the inner border as SHADE_NONE while the outer
+    // border is SHADE_NONE, so the box follows the outer border.
+    const bool outer =
+        (DecorationConfig::SHADE_NONE != m_ui.outerBorder->currentIndex());
+    m_ui.innerBorder->setEnabled(outer);
+    if (!outer) {
+        m_ui.innerBorder->setCurrentIndex(DecorationConfig::SHADE_NONE);
+    }
+    // The decoration reads the size and the two offsets of a shadow group for
+    // a custom shadow alone. The custom shadow box therefore drives those rows.
+    const bool shadows = m_ui.useShadows->isChecked();
+    for (QWidget *one : QList<QWidget*>{
+            m_ui.activeSizeLabel, m_ui.activeShadowSize,
+            m_ui.activeHOffsetLabel, m_ui.activeShadowHOffset,
+            m_ui.activeVOffsetLabel, m_ui.activeShadowVOffset,
+            m_ui.inactiveSizeLabel, m_ui.inactiveShadowSize,
+            m_ui.inactiveHOffsetLabel, m_ui.inactiveShadowHOffset,
+            m_ui.inactiveVOffsetLabel, m_ui.inactiveShadowVOffset}) {
+        one->setEnabled(shadows);
+    }
+    // Decoration::borderColor() in qt6/kdecoration/qtcurvedecoration.cpp reads
+    // the shadow colour for a border of the shadow shade. It reads that colour
+    // with the custom shadow box on alone, so the two colour rows follow the
+    // same box.
+    for (QWidget *one : QList<QWidget*>{
+            m_ui.activeColorLabel, m_ui.activeShadowColorType,
+            m_ui.inactiveColorLabel, m_ui.inactiveShadowColorType}) {
+        one->setEnabled(shadows);
+    }
+    // The decoration reads the Color key for the custom colour type alone.
+    m_ui.activeShadowColor->setEnabled(
+        shadows &&
+        ShadowConfig::CT_CUSTOM == m_ui.activeShadowColorType->currentIndex());
+    m_ui.inactiveShadowColor->setEnabled(
+        shadows &&
+        ShadowConfig::CT_CUSTOM == m_ui.inactiveShadowColorType->currentIndex());
+}
+
+void
+DecorationKCM::updateChanged()
+{
+    DecorationSettings current;
+    readWidgets(current);
+    setNeedsSave(!(current == m_settings));
+    setRepresentsDefaults(current == DecorationSettings());
+}
+
+}
