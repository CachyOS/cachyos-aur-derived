+# The controls below doctor copies of the distinct dark sheet. A second
+# declaration at the value of the sheet must pass, and the planted value must
+# fail in either declaration.
+popup_var=--panel-background-color
+planted='#141618'
+popup=$(value "$tmp/distinct-dark.css" "$popup_var")
+if [ "$popup" = "$planted" ]; then
+    fail "the planted value equals $popup_var of the distinct dark sheet"
+fi
+
+# plant VALUE COPY: writes to COPY the distinct dark sheet and one more rule.
+# The rule declares $popup_var at VALUE in the line shape that value() reads.
+plant() {
+    cp "$tmp/distinct-dark.css" "$2"
+    {
+        echo
+        echo 'panel[type="autocomplete-richlistbox"] {'
+        printf '  %s: %s !important;\n' "$popup_var" "$1"
+        echo '}'
+    } >> "$2"
+}
+
+# expect NAME CODE COPY: runs the check over COPY in place of the distinct dark
+# sheet. It fails the run when the check gives a code other than CODE.
+expect() {
+    e_code=0
+    agree "$1" "$tmp/distinct-light.css" "$3" "$tmp/distinct-manifest.json" \
+        2> "$tmp/$1.log" || e_code=$?
+    if [ $e_code -ne "$2" ]; then
+        cat "$tmp/$1.log" >&2
+        fail "the check gives $e_code over the copy $1, not $2"
+    fi
+}
+
+plant "$popup" "$tmp/again.css"
+expect again 0 "$tmp/again.css"
+plant "$planted" "$tmp/element.css"
+expect element 1 "$tmp/element.css"
+root_line="  $popup_var: $planted !important;"
+sed "1,/^  $popup_var: /s/^  $popup_var: .* !important;\$/$root_line/" \
+    "$tmp/distinct-dark.css" > "$tmp/root.css"
+expect root 1 "$tmp/root.css"
+
 if [ $status -eq 0 ]; then
     echo "assert-ff-agree: the $rows rows of the map hold one value in the" \
          "sheet and in the manifest of each half, over two colour file" \
          "pairs, and the check rejects the swapped copy"
+    echo "assert-ff-agree: a copy of the distinct dark sheet declares" \
+         "$popup_var again at its value $popup, and the check passes it" \
+         "with the code 0"
+    echo "assert-ff-agree: a copy of the distinct dark sheet declares" \
+         "$popup_var again at $planted, and the check rejects it with the" \
+         "code 1"
+    echo "assert-ff-agree: a copy of the distinct dark sheet sets its first" \
+         "$popup_var line to $planted, and the check rejects it with the" \
+         "code 1"
 fi
 exit $status
