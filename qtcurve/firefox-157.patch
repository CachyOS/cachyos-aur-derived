+/**
+ * Returns the :root block of the radius tokens of the chrome. Each token
+ * holds the radius of the round key for one widget kind, at the size of a
+ * radius call of widgets.cpp for that kind.
+ */
+QString
+radiusTokens(const Options &opts)
+{
+    const QString button = Gtk::radius(opts, 100, 25, WIDGET_STD_BUTTON);
+    const QString tab = Gtk::radius(opts, 80, 26, WIDGET_TAB_TOP);
+    const QString menu = Gtk::radius(opts, 240, 120, WIDGET_OTHER);
+    const QString item = Gtk::radius(opts, 200, 20, WIDGET_MENU_ITEM);
+    const struct {
+        const char *name;
+        const QString &value;
+    } tokens[] = {
+        { "--tab-border-radius", tab },
+        { "--button-border-radius", button },
+        { "--toolbarbutton-border-radius", button },
+        { "--panel-border-radius", menu },
+        { "--popup-border-radius", menu },
+        { "--border-radius-xsmall", item },
+        { "--border-radius-small", item },
+        { "--border-radius-medium", button },
+        { "--border-radius-large", item }
+    };
+    QString out = QStringLiteral("\n:root {\n");
+    for (const auto &token : tokens) {
+        out += QStringLiteral("  %1: %2 !important;\n")
+            .arg(QLatin1String(token.name), token.value);
+    }
+    out += QStringLiteral("}\n");
+    return out;
+}
+
 /**
