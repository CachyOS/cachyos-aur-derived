+ *****************************************************************************/
+
+#ifndef QTC_GTK4_DIALECT_H
+#define QTC_GTK4_DIALECT_H
+
+#include "emit.h"
+
+namespace QtCurve {
+namespace Gtk {
+
+/**
+ * The node names and the properties that the two dialects do not share. The
+ * GTK 3 column comes from the five differences of the breeze-gtk source trees.
+ */
+struct Nodes {
+    /** Selector of the popup menu body. */
+    QString menu;
+    /** Selector of one item of a popup menu. */
+    QString menuItem;
+    /** Selector of the slider of a scale that holds the focus. */
+    QString scaleFocusSlider;
+    /** Selector of one button of the title bar. */
+    QString titleButton;
+    /** Selector of one item of the menu bar. */
+    QString menuBarItem;
+    /** Selector of the frame node, with the border child of GTK 3. */
+    QString frameNode;
+    /** Selector of the tool bar. GTK 4 has the style class alone. */
+    QString toolbarNode;
+    /** True while the dialect accepts the property -gtk-icon-size. */
+    bool iconSize;
+    /**
+     * True while the dialect gives an SVG glyph the colour of the node. A
+     * false value writes no -gtk-icon-source, and the toolkit draws its own.
+     */
+    bool glyphAsset;
+    /** True while the dialect draws the window border on a decoration node. */
+    bool decorationNode;
+};
+
+/** Returns the node names of the dialect dialect. */
+Nodes nodesFor(Dialect dialect);
+
+/**
+ * Writes the whole sheet for one dialect, one settings set and one palette.
+ * The asset base is the directory prefix of every url() of the sheet.
+ */
+QString buildSheet(const Options &opts, const Palette &pal, Dialect dialect,
+                   const QString &assetBase);
+
+/**
+ * Writes the :root block of the GTK 4 sheet alone. The dark sheet of the
+ * shipped theme holds one import and this block.
+ */
+QString buildRoot(const Options &opts, const Palette &pal,
+                  const QString &assetBase);
+
+}
+}
+
+#endif
diff --git a/gtk4/writer/emit.cpp b/gtk4/writer/emit.cpp
new file mode 100644
index 00000000..5baaa7a1
--- /dev/null
+++ b/gtk4/writer/emit.cpp
@@ -0,0 +1,172 @@
+/*****************************************************************************
+ *   Copyright 2026 QtCurve authors                                          *
+ *                                                                           *
+ *   This program is free software; you can redistribute it and/or modify    *
+ *   it under the terms of the GNU Lesser General Public License as          *
+ *   published by the Free Software Foundation; either version 2.1 of the    *
+ *   License, or (at your option) version 3, or any later version accepted   *
+ *   by the membership of KDE e.V. (or its successor approved by the         *
+ *   membership of KDE e.V.), which shall act as a proxy defined in          *
+ *   Section 6 of version 3 of the license.                                  *
+ *                                                                           *
+ *   This program is distributed in the hope that it will be useful,         *
+ *   but WITHOUT ANY WARRANTY; without even the implied warranty of          *
+ *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU       *
+ *   Lesser General Public License for more details.                         *
+ *                                                                           *
+ *   You should have received a copy of the GNU Lesser General Public        *
+ *   License along with this library. If not,                                *
+ *   see <http://www.gnu.org/licenses/>.                                     *
+ *****************************************************************************/
+
+#include "emit.h"
+
+#include <qtcurve-utils/color.h>
+
+#include <QTextStream>
+#include <stdio.h>
+
+namespace QtCurve {
+namespace Gtk {
+
+Sheet::Sheet(Dialect dialect, const QString &assetBase)
+    : m_dialect(dialect), m_assetBase(assetBase)
+{
+}
+
+QString
+Sheet::val(const QString &name, const QString &value)
+{
+    if (!m_values.contains(name)) {
+        m_values.insert(name, value);
+        m_order.append(name);
+    } else if (m_values.value(name) != value) {
+        failDuplicate(name, m_values.value(name), value);
+    }
+    if (m_dialect == Dialect::Gtk3) {
+        return value;
+    }
+    return QStringLiteral("var(--qtc-%1, %2)").arg(name, m_values.value(name));
+}
+
+void
+Sheet::rule(const QString &selector, const QString &body)
+{
+    m_body += selector;
+    m_body += QStringLiteral(" {\n");
+    m_body += body;
+    m_body += QStringLiteral("}\n");
+}
+
+void
+Sheet::raw(const QString &text)
+{
+    m_body += text;
+}
+
+QString
+Sheet::url(const QString &name) const
+{
+    return QStringLiteral("url(\"%1%2\")").arg(m_assetBase, name);
+}
+
+QString
+Sheet::rootBlock() const
+{
+    if (m_dialect == Dialect::Gtk3 || m_order.isEmpty()) {
+        return QString();
+    }
+    QString out = QStringLiteral(":root {\n");
+    for (const QString &name : m_order) {
+        out += QStringLiteral("  --qtc-%1: %2;\n").arg(name,
+                                                       m_values.value(name));
+    }
+    out += QStringLiteral("}\n");
+    return out;
+}
+
+QString
+Sheet::text() const
+{
+    return rootBlock() + m_body;
+}
+
+/** The exit code of the first enumeration value that had no case. */
+static int emit_error = 0;
+
+void
+failUnknown(const char *enumName, int value)
+{
+    fprintf(stderr, "qtcurve-gtk-writer: %s value %d has no case\n",
+            enumName, value);
+    emit_error = 5;
+}
+
+void
+failDuplicate(const QString &name, const QString &held, const QString &value)
+{
+    fprintf(stderr, "qtcurve-gtk-writer: name %s holds '%s' and gets '%s'\n",
+            name.toLocal8Bit().constData(), held.toLocal8Bit().constData(),
+            value.toLocal8Bit().constData());
+    emit_error = 5;
+}
+
+int
+emitError()
+{
+    return emit_error;
+}
+
+/** Returns the colour of one gradient stop, from the base colour and the stop. */
+static QString
+stopColour(const Options &opts, const QColor &base, const GradientStop &stop)
+{
+    QColor col;
+    qtcShade(&base, &col, stop.val, opts.shading);
+    if (stop.alpha < 0.999) {
+        return rgba(col, stop.alpha);
+    }
+    return hex(col);
+}
+
+QString
+gradientImage(const Options &opts, EAppearance app, const QColor &base,
+              bool horiz)
+{
+    if (app == APPEARANCE_FILE) {
+        return QStringLiteral("none");
+    }
+    if (qtcIsFlat(app)) {
+        return QStringLiteral("none");
+    }
+    if (app > APPEARANCE_LV_AGUA || app < APPEARANCE_CUSTOM1) {
+        failUnknown("EAppearance", app);
+        return QStringLiteral("none");
+    }
+
+    const Gradient *grad = qtcGetGradient(app, &opts);
+    const GradientStopCont stops = grad->stops.fix();
+    if (stops.empty()) {
+        return QStringLiteral("none");
+    }
+
+    QString out = QStringLiteral("linear-gradient(to %1")
+        .arg(horiz ? QStringLiteral("bottom") : QStringLiteral("right"));
+    for (const GradientStop &stop : stops) {
+        out += QStringLiteral(", %1 %2%")
+            .arg(stopColour(opts, base, stop))
+            .arg(stop.pos * 100.0, 0, 'f', 1);
+    }
+    out += QLatin1Char(')');
+    return out;
+}
+
+QString
+radius(const Options &opts, int w, int h, EWidget widget)
+{
+    const double r = qtcGetRadius(&opts, w, h, widget, RADIUS_EXTERNAL);
+    return QStringLiteral("%1px").arg(r, 0, 'f', 1);
+}
+
+}
+}
