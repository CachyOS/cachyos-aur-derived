+    box.border = line(QStringLiteral("title-border"),
+                      m_pal.win[QTC_STD_BORDER]);
+    box.fg = col(QStringLiteral("title-fg"), m_pal.titlebarText);
+    box.more << QStringLiteral("padding: 0 6px")
+             << QStringLiteral("min-height: 24px");
+    put(QStringLiteral("headerbar"), box);
+
+    Box title;
+    title.fg = col(QStringLiteral("title-fg"), m_pal.titlebarText);
+    title.more << QStringLiteral("font-weight: bold");
