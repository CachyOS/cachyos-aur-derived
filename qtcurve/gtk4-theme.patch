+void
+Writer::menuBar()
+{
+    const QColor bar = m_opts.shadeMenubars == SHADE_SELECTED ?
+        m_pal.highlight : m_opts.shadeMenubars == SHADE_CUSTOM ?
+        m_opts.customMenubarsColor : m_pal.window;
+    Box box;
+    box.image = grad(QStringLiteral("mbar-img"), m_opts.menubarAppearance, bar);
+    box.bg = col(QStringLiteral("mbar-bg"), bar);
+    box.fg = col(QStringLiteral("mbar-fg"), m_pal.windowText);
+    put(QStringLiteral("menubar, .menubar"), box);
+
+    Box item;
+    item.fg = col(QStringLiteral("mbar-fg"), m_pal.windowText);
+    item.radius = rad(QStringLiteral("mitem-radius"), WIDGET_MENU_ITEM,
+                      60, 20);
+    item.more << QStringLiteral("padding: 3px 8px");
+    put(m_nodes.menuBarItem, item);
+
+    Box hover = item;
+    hover.image = grad(QStringLiteral("mitem-img"), m_opts.menuitemAppearance,
+                       m_pal.highlight);
+    hover.bg = col(QStringLiteral("mitem-bg"), m_pal.highlight);
+    hover.fg = col(QStringLiteral("mitem-fg"), m_pal.highlightText);
+    put(QStringLiteral("%1:hover, %1:selected").arg(m_nodes.menuBarItem),
+        hover);
+}
+
+void
+Writer::frame()
+{
+    Box box;
+    box.border = m_opts.groupBox == FRAME_NONE ?
+        v(QStringLiteral("frame-noborder"), QStringLiteral("none")) :
+        line(QStringLiteral("frame-border"), m_pal.win[QTC_STD_BORDER]);
+    box.radius = rad(QStringLiteral("frame-radius"), WIDGET_FRAME, 600, 40);
+    box.fg = col(QStringLiteral("fg"), m_pal.windowText);
+    put(m_nodes.frameNode, box);
+
+    Box label;
+    label.fg = col(QStringLiteral("fg"), m_pal.windowText);
+    if (m_opts.gbLabel & GB_LBL_BOLD) {
+        label.more << QStringLiteral("font-weight: bold");
+    }
+    put(QStringLiteral("frame > label, frame > label > label"), label);
+
+    Box view;
+    view.bg = col(QStringLiteral("entry-bg"), m_pal.base);
+    view.border = line(QStringLiteral("entry-border"),
+                       m_pal.win[QTC_STD_BORDER]);
+    view.radius = rad(QStringLiteral("view-radius"), WIDGET_SCROLLVIEW,
+                      600, 80);
+    view.fg = col(QStringLiteral("entry-fg"), m_pal.text);
+    put(QStringLiteral("scrolledwindow.frame, .view.frame"), view);
+}
+
+void
+Writer::decoration()
+{
+    if (!m_nodes.decorationNode) {
+        return;
+    }
+    Box box;
+    box.bg = col(QStringLiteral("win-bg"), m_pal.window);
+    box.radius = rad(QStringLiteral("deco-radius"), WIDGET_OTHER, 600, 400);
+    box.shadow = v(QStringLiteral("deco-shadow"),
+                   QStringLiteral("0 2px 6px %1")
+                   .arg(rgba(QColor(0, 0, 0), 0.35)));
+    box.more << QStringLiteral("margin: 10px");
+    put(QStringLiteral("decoration"), box);
+}
+
+void
+Writer::notebook()
+{
+    Box header;
+    header.image = grad(QStringLiteral("nb-header-img"), m_opts.bgndAppearance,
+                        m_pal.window);
+    header.bg = col(QStringLiteral("nb-header-bg"), m_pal.window);
+    put(QStringLiteral("notebook > header, notebook header"), header);
+
+    Box body;
+    body.bg = col(QStringLiteral("nb-body-bg"), m_pal.window);
+    body.border = line(QStringLiteral("nb-border"), m_pal.win[QTC_STD_BORDER]);
+    body.radius = rad(QStringLiteral("nb-radius"), WIDGET_TAB_TOP, 600, 40);
+    put(QStringLiteral("notebook > stack"), body);
+
+    // The frame of a Qt tab widget encloses the body alone.
+    Box outer;
+    outer.bg = col(QStringLiteral("nb-body-bg"), m_pal.window);
+    put(QStringLiteral("notebook.frame"), outer);
+
+    Box tab;
+    tab.image = grad(QStringLiteral("tab-img"), m_opts.tabAppearance,
+                     m_pal.win[m_opts.tabBgnd == 0 ? ORIGINAL_SHADE : 2]);
+    tab.bg = col(QStringLiteral("tab-bg"), m_pal.window);
+    tab.border = m_opts.borderInactiveTab ?
+        line(QStringLiteral("tab-border"), m_pal.win[QTC_STD_BORDER]) :
+        v(QStringLiteral("tab-noborder"), QStringLiteral("none"));
+    tab.radius = rad(QStringLiteral("tab-radius"), WIDGET_TAB_TOP, 80, 26);
+    tab.fg = col(QStringLiteral("fg"), m_pal.windowText);
+    // The pad is the horizontal space of a tab of the Qt style, less the
+    // border. That style sets the label under the top of the tab row.
+    const int tabSpace = 14;
+    tab.more << QStringLiteral("padding: 3px %1px 0").arg(tabSpace / 2 - 1);
+    put(QStringLiteral("notebook > header > tabs > tab, notebook tab"), tab);
+
+    Box active = tab;
+    active.image = grad(QStringLiteral("tab-img-on"),
+                        m_opts.activeTabAppearance, m_pal.window);
+    active.border = m_opts.borderTab ?
+        line(QStringLiteral("tab-border"), m_pal.win[QTC_STD_BORDER]) :
+        v(QStringLiteral("tab-noborder"), QStringLiteral("none"));
+    active.shadow = v(QStringLiteral("tab-shadow"), m_opts.highlightTab ?
+                      QStringLiteral("inset 0 2px 0 0 %1")
+                      .arg(hex(m_pal.highlight)) : QStringLiteral("none"));
+    put(QStringLiteral("notebook > header > tabs > tab:checked, "
+                       "notebook tab:checked"), active);
+}
+
+void
+Writer::lists()
+{
+    Box view;
+    view.bg = col(QStringLiteral("view-bg"), m_pal.base);
+    view.fg = col(QStringLiteral("view-fg"), m_pal.text);
+    view.border = m_opts.gtkScrollViews ?
+        line(QStringLiteral("entry-border"), m_pal.win[QTC_STD_BORDER]) :
+        v(QStringLiteral("view-noborder"), QStringLiteral("none"));
+    view.radius = rad(QStringLiteral("view-radius"), WIDGET_SCROLLVIEW,
+                      600, 80);
+    if (m_opts.gtkScrollViews) {
+        view.more << lowBorderLines();
+    }
+    put(QStringLiteral("columnview, listview, list, treeview.view, "
+                       "gridview, .view"), view);
+
+    Box row;
+    row.fg = col(QStringLiteral("view-fg"), m_pal.text);
+    row.more << QStringLiteral("min-height: 19px");
+    put(QStringLiteral("row, row.activatable, listview > row, list > row"),
+        row);
+
+    if (m_opts.forceAlternateLvCols) {
+        Box alt;
+        alt.bg = col(QStringLiteral("view-bg-alt"), m_pal.baseAlternate);
+        put(QStringLiteral("row:nth-child(even), "
+                           "treeview.view:nth-child(even)"), alt);
+    }
+
+    Box sel;
+    sel.image = grad(QStringLiteral("sel-img"), m_opts.selectionAppearance,
+                     m_pal.highlight);
+    sel.bg = col(QStringLiteral("sel-bg"), m_pal.highlight);
+    sel.fg = col(QStringLiteral("sel-fg"), m_pal.highlightText);
+    sel.radius = rad(QStringLiteral("sel-radius"), WIDGET_SELECTION, 200, 20);
+    sel.border = m_opts.borderSelection ?
+        line(QStringLiteral("sel-border"), m_pal.hl[QTC_STD_BORDER]) :
+        v(QStringLiteral("sel-noborder"), QStringLiteral("none"));
+    put(QStringLiteral("row:selected, listview > row:selected, "
+                       "list > row:selected, treeview.view:selected, "
+                       "columnview > listview > row:selected"), sel);
+
+    // The Qt style halves the alpha of the band of a window that is not
+    // active, at common.h INACTIVE_SEL_ALPHA.
+    Box backdrop = sel;
+    backdrop.image = v(QStringLiteral("sel-img-off"), QStringLiteral("none"));
+    backdrop.bg = v(QStringLiteral("sel-bg-off"),
+                    rgba(m_pal.highlight, INACTIVE_SEL_ALPHA));
+    backdrop.border = v(QStringLiteral("sel-border-off"),
+                        QStringLiteral("none"));
+    put(QStringLiteral("row:selected:backdrop, "
+                       "listview > row:selected:backdrop, "
+                       "list > row:selected:backdrop, "
+                       "treeview.view:selected:backdrop"), backdrop);
+
+    const QColor headerBase = m_opts.lvButton ? m_pal.button : m_pal.window;
+    // The Qt style swaps the bevelled appearance for the list view form.
+    // That style draws the border of a header section at the foot alone.
+    const EAppearance headerApp =
+        (m_opts.lvAppearance == APPEARANCE_BEVELLED ? APPEARANCE_LV_BEVELLED :
+         m_opts.lvAppearance);
+    Box header;
+    header.image = grad(QStringLiteral("lv-header-img"), headerApp,
+                        headerBase);
+    header.bg = col(QStringLiteral("lv-header-bg"), headerBase);
+    header.border = v(QStringLiteral("lv-header-noborder"),
+                      QStringLiteral("none"));
+    header.fg = col(QStringLiteral("fg"), m_pal.windowText);
+    header.more << QStringLiteral("border-bottom: %1")
+                   .arg(line(QStringLiteral("lv-header-border"),
+                             m_pal.win[QTC_STD_BORDER]))
+                << QStringLiteral("padding: 2px 6px 3px")
+                << QStringLiteral("min-height: 15px");
+    put(QStringLiteral("columnview > header > button, "
+                       "treeview.view > header > button, "
+                       "columnview header button, treeview header button"),
+        header);
+}
+
