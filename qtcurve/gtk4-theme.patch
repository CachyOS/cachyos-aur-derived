+void
+Writer::scale()
+{
+    // The rows come from the slider metrics of the Qt style. That style draws
+    // a groove of five pixels and it keeps the tick marks below the groove.
+    const int glow = (m_opts.buttonEffect != EFFECT_NONE &&
+                      m_opts.coloredMouseOver == MO_GLOW ? 2 : 0);
+    const int sliderSize = (m_opts.sliderWidth < DEFAULT_SLIDER_WIDTH ?
+                            DEFAULT_SLIDER_WIDTH - 2 : m_opts.sliderWidth);
+    const int thickness = sliderSize + glow - 2;
+    const int tickOffset = (m_opts.sliderStyle == SLIDER_TRIANGULAR ? 5 : 4);
+    const int grooveBox = 5;
+    const int markBox = 3;
+    const int handleBox = thickness - 1;
+    const int handleWide = m_opts.sliderWidth + 5;
+    // The rows between the top of the groove rectangle and the drawn groove.
+    const int inset = (thickness - grooveBox) / 2;
+    const int scaleHeight = sliderSize + glow + 6 + markBox + 2;
+    const QColor troughBase = m_pal.win[2];
+    Box trough;
+    trough.image = grad(QStringLiteral("scale-trough-img"),
+                        m_opts.grooveAppearance, troughBase, true);
+    trough.bg = col(QStringLiteral("scale-trough-bg"), troughBase);
+    trough.border = line(QStringLiteral("scale-trough-border"),
+                         m_pal.win[QTC_STD_BORDER]);
+    trough.radius = rad(QStringLiteral("scale-trough-radius"),
+                        WIDGET_SLIDER_TROUGH, 600, 7);
+    trough.more << QStringLiteral("min-height: %1px").arg(grooveBox - 2)
+                << QStringLiteral("margin: %1px 0 0").arg(tickOffset + inset);
+    put(QStringLiteral("scale > trough, scale trough"), trough);
+
+    Box fill;
+    fill.image = grad(QStringLiteral("scale-fill-img"), m_opts.sliderFill,
+                      m_pal.highlight, true);
+    fill.bg = col(QStringLiteral("scale-fill-bg"), m_pal.highlight);
+    fill.border = line(QStringLiteral("scale-fill-border"),
+                       m_pal.hl[QTC_STD_BORDER]);
+    fill.radius = rad(QStringLiteral("scale-trough-radius"),
+                      WIDGET_SLIDER_TROUGH, 600, 7);
+    // The fill lies over the border of the groove. The Qt style draws one
+    // groove of five pixels and it fills the same rows.
+    fill.more << QStringLiteral("min-height: %1px").arg(grooveBox - 4)
+              << QStringLiteral("margin: -1px");
+    put(QStringLiteral("scale > trough > highlight, scale highlight, "
+                       "scale > trough > fill"), fill);
+
+    Box slider;
+    slider.image = grad(QStringLiteral("slider-img"), m_opts.sliderAppearance,
+                        m_pal.button);
+    slider.bg = col(QStringLiteral("slider-bg"), m_pal.button);
+    slider.border = line(QStringLiteral("slider-border"),
+                         m_pal.btn[QTC_STD_BORDER]);
+    slider.radius = rad(QStringLiteral("slider-radius"), WIDGET_SLIDER,
+                        handleWide, handleBox);
+    // The handle keeps the centre of the groove, and the Qt style adds the
+    // etch of the button effect under it.
+    slider.more << QStringLiteral("min-width: %1px").arg(handleWide - 2)
+                << QStringLiteral("min-height: %1px").arg(handleBox - 2)
+                << QStringLiteral("margin: -%1px 0 -%2px")
+                   .arg(inset).arg(handleBox + 2 - inset - grooveBox);
+    put(QStringLiteral("scale > trough > slider, scale slider"), slider);
+    put(m_nodes.scaleFocusSlider, slider);
+
+    Box mark;
+    mark.bg = col(QStringLiteral("scale-mark"), m_pal.win[QTC_STD_BORDER]);
+    mark.more << QStringLiteral("min-width: 1px")
+              << QStringLiteral("min-height: %1px").arg(markBox);
+    put(QStringLiteral("scale > marks > mark > indicator, "
+                       "scale marks indicator"), mark);
+
+    Box marks;
+    marks.more << QStringLiteral("margin: %1px 0 2px")
+                  .arg(scaleHeight - tickOffset - inset - grooveBox -
+                       markBox - 2);
+    put(QStringLiteral("scale > marks.bottom, scale marks.bottom"), marks);
+
+    Box row;
+    row.more << QStringLiteral("min-height: %1px").arg(scaleHeight);
+    put(QStringLiteral("scale"), row);
+}
