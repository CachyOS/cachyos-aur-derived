+
+void
+Writer::popoverMenu()
+{
+    Box box;
+    box.image = grad(QStringLiteral("menu-img"), m_opts.menuBgndAppearance,
+                     m_pal.menu[ORIGINAL_SHADE],
+                     m_opts.menuBgndGrad == GT_HORIZ);
+    box.bg = col(QStringLiteral("menu-bg"), m_pal.menu[ORIGINAL_SHADE]);
+    box.border = m_opts.popupBorder ?
+        line(QStringLiteral("menu-border"), m_pal.menu[QTC_STD_BORDER]) :
+        v(QStringLiteral("menu-noborder"), QStringLiteral("none"));
+    box.radius = (m_opts.square & SQUARE_POPUP_MENUS) ? QStringLiteral("0") :
+        rad(QStringLiteral("menu-radius"), WIDGET_OTHER, 240, 120);
+    box.fg = col(QStringLiteral("menu-fg"), m_pal.text);
+    box.more << QStringLiteral("padding: 1px");
+    put(QStringLiteral("%1, %1 > box").arg(m_nodes.menu), box);
+
+    Box item;
+    item.fg = col(QStringLiteral("menu-fg"), m_pal.text);
+    item.radius = rad(QStringLiteral("mitem-radius"), WIDGET_MENU_ITEM,
+                      200, 20);
+    item.more << QStringLiteral("padding: 3px 8px")
+              << QStringLiteral("min-height: 18px");
+    put(m_nodes.menuItem, item);
+
+    Box hover;
+    hover.image = grad(QStringLiteral("mitem-img"), m_opts.menuitemAppearance,
+                       m_pal.highlight);
+    hover.bg = col(QStringLiteral("mitem-bg"), m_pal.highlight);
+    hover.fg = col(QStringLiteral("mitem-fg"), m_pal.highlightText);
+    hover.radius = rad(QStringLiteral("mitem-radius"), WIDGET_MENU_ITEM,
+                       200, 20);
+    hover.border = m_opts.borderMenuitems ?
+        line(QStringLiteral("mitem-border"), m_pal.hl[QTC_STD_BORDER]) :
+        v(QStringLiteral("mitem-noborder"), QStringLiteral("none"));
+    hover.more << QStringLiteral("padding: 3px 8px");
+    put(QStringLiteral("%1:hover, %1:selected")
+        .arg(m_nodes.menuItem), hover);
+
+    Box off;
+    off.fg = col(QStringLiteral("menu-fg-off"),
+                 disabledMix(m_pal.text, m_pal.menu[ORIGINAL_SHADE]));
+    put(QStringLiteral("%1:disabled").arg(m_nodes.menuItem), off);
+
+    if (m_nodes.glyphAsset) {
+        Box right;
+        right.fg = col(QStringLiteral("menu-fg"), m_pal.text);
+        right.more << glyph(QStringLiteral("arrow-right"),
+                            QStringLiteral("qtc-arrow-right.svg"));
+        put(QStringLiteral("%1 > arrow.right").arg(m_nodes.menuItem), right);
+
+        Box left = right;
+        left.more.clear();
+        left.more << glyph(QStringLiteral("arrow-left"),
+                           QStringLiteral("qtc-arrow-left.svg"));
+        put(QStringLiteral("%1 > arrow.left").arg(m_nodes.menuItem), left);
+    }
+}
+
+void
+Writer::focusRing()
+{
+    const bool none = m_opts.focus == FOCUS_NONE;
+    const QColor ring = m_opts.focus == FOCUS_STANDARD ?
+        m_pal.windowText : m_pal.highlight;
+
+    QString body;
+    body += QStringLiteral("  outline: %1;\n")
+        .arg(v(QStringLiteral("focus-outline"), none ?
+               QStringLiteral("none") :
+               QStringLiteral("1px solid %1").arg(hex(ring))));
+    body += QStringLiteral("  outline-offset: %1;\n")
+        .arg(v(QStringLiteral("focus-offset"), QStringLiteral("-3px")));
+    body += QStringLiteral("  box-shadow: %1;\n")
+        .arg(v(QStringLiteral("focus-glow"),
+               (none || m_opts.focus != FOCUS_GLOW) ?
+               QStringLiteral("none") :
+               QStringLiteral("inset 0 0 0 2px %1")
+               .arg(rgba(m_pal.highlight, 0.55))));
+    m_sheet.rule(QStringLiteral(":focus-visible, check:focus-visible, "
+                                "radio:focus-visible, row:focus-visible, "
+                                "tab:focus-visible"), body);
+}
+
+void
+Writer::progressAnimation()
+{
+    m_sheet.raw(QStringLiteral(
+                    "@keyframes qtc-progress-stripe {\n"
+                    "  from { background-position: -10px 0px; }\n"
+                    "  to { background-position: 10px 0px; }\n"
+                    "}\n"));
+}
+
+/** The 23 public colour names that breeze-gtk declares without a suffix. */
+static const char *const publicNames[] = {
+    "accent_bg_color", "accent_color", "accent_fg_color", "borders",
+    "content_view_bg", "error_bg_color", "error_color", "error_fg_color",
+    "insensitive_bg_color", "insensitive_base_color", "insensitive_fg_color",
+    "success_bg_color", "success_color", "success_fg_color", "theme_base_color",
+    "theme_bg_color", "theme_fg_color", "theme_selected_bg_color",
+    "theme_selected_fg_color", "theme_text_color", "warning_bg_color",
+    "warning_color", "warning_fg_color"
+};
+
+void
+Writer::colourNames()
+{
+    const QColor values[] = {
+        m_pal.highlight, m_pal.highlight, m_pal.highlightText,
+        m_pal.win[QTC_STD_BORDER],
+        m_pal.base, m_pal.negative, m_pal.negative, m_pal.highlightText,
+        m_pal.window, m_pal.window, m_pal.windowTextDisabled,
+        m_pal.positive, m_pal.positive, m_pal.highlightText, m_pal.base,
+        m_pal.window, m_pal.windowText, m_pal.highlight,
+        m_pal.highlightText, m_pal.text, m_pal.neutral,
+        m_pal.neutral, m_pal.highlightText
+    };
+    static_assert(sizeof(values) / sizeof(values[0]) ==
+                  sizeof(publicNames) / sizeof(publicNames[0]),
+                  "one colour per public name");
+    QString block;
+    for (size_t i = 0;i < sizeof(values) / sizeof(values[0]);++i) {
+        block += QStringLiteral("@define-color %1 %2;\n")
+            .arg(QLatin1String(publicNames[i]), hex(values[i]));
+    }
+    m_sheet.raw(block);
+}
+
+void
+Writer::run()
+{
+    colourNames();
+    reset();
+    window();
+    button();
+    entry();
+    spinButton();
+    dropDown();
+    checkRadio();
+    scale();
+    progressBar();
+    levelBar();
+    scrollBar();
+    toggleSwitch();
+    separator();
+    toolBar();
+    headerBar();
+    menuBar();
+    frame();
+    decoration();
+    notebook();
+    lists();
+    infoBar();
+    tooltip();
+    popoverMenu();
+    focusRing();
+    progressAnimation();
+}
+
+}
+
+QString
+buildSheet(const Options &opts, const Palette &pal, Dialect dialect,
+           const QString &assetBase)
+{
+    Sheet sheet(dialect, assetBase);
+    Writer writer(opts, pal, sheet, nodesFor(dialect));
+    writer.run();
+    return QStringLiteral("/* QtCurve GTK theme. This file is generated; "
+                          "change the QtCurve settings instead. */\n")
+        + sheet.text();
+}
+
+QString
+buildRoot(const Options &opts, const Palette &pal, const QString &assetBase)
+{
+    Sheet sheet(Dialect::Gtk4, assetBase);
+    Writer writer(opts, pal, sheet, nodesFor(Dialect::Gtk4));
+    writer.run();
+    Sheet names(Dialect::Gtk4, assetBase);
+    Writer only(opts, pal, names, nodesFor(Dialect::Gtk4));
+    only.colourNames();
+    return sheet.rootBlock() + names.text();
+}
+
+}
