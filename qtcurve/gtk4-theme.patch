+
+#include "dialect.h"
+
+namespace QtCurve {
+namespace Gtk {
+
+Nodes
+nodesFor(Dialect dialect)
+{
+    Nodes n;
+    if (dialect == Dialect::Gtk4) {
+        n.menu = QStringLiteral("popover.menu > contents");
+        n.menuItem = QStringLiteral("modelbutton");
+        n.scaleFocusSlider = QStringLiteral("scale:focus-within slider");
+        n.titleButton = QStringLiteral("windowcontrols button");
+        n.menuBarItem = QStringLiteral("menubar > item");
+        n.frameNode = QStringLiteral("frame, .frame");
+        n.toolbarNode = QStringLiteral(".toolbar");
+        n.iconSize = true;
+        n.glyphAsset = true;
+        n.decorationNode = false;
+    } else {
+        n.menu = QStringLiteral("menu");
+        n.menuItem = QStringLiteral("menuitem");
+        n.scaleFocusSlider = QStringLiteral("scale slider:focus");
+        n.titleButton = QStringLiteral("titlebutton");
+        n.menuBarItem = QStringLiteral("menubar > menuitem");
+        n.frameNode = QStringLiteral("frame, .frame, frame > border");
+        n.toolbarNode = QStringLiteral(".toolbar, toolbar");
+        n.iconSize = false;
+        n.glyphAsset = false;
+        n.decorationNode = true;
+    }
+    return n;
+}
+
+}
+}
