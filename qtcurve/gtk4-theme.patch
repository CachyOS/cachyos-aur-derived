+ *   but WITHOUT ANY WARRANTY; without even the implied warranty of          *
+ *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU       *
+ *   Lesser General Public License for more details.                         *
+ *                                                                           *
+ *   You should have received a copy of the GNU Lesser General Public        *
+ *   License along with this library. If not,                                *
+ *   see <http://www.gnu.org/licenses/>.                                     *
+ *****************************************************************************/
+
+#include "userfile.h"
+
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QSaveFile>
+
+namespace QtCurve {
+namespace Gtk {
+
+const char *const importStatement = "@import 'qtcurve.css';";
+
+int
+writeOwned(const QString &path, const QByteArray &content)
+{
+    const QString dir = QFileInfo(path).absolutePath();
+    if (!QDir().mkpath(dir)) {
+        fprintf(stderr, "qtcurve-gtk-writer: cannot make %s\n",
+                dir.toLocal8Bit().constData());
+        return 1;
+    }
+    QSaveFile file(path);
+    if (!file.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+        fprintf(stderr, "qtcurve-gtk-writer: cannot write %s\n",
+                path.toLocal8Bit().constData());
+        return 1;
+    }
+    if (file.write(content) != content.size() || !file.commit()) {
+        fprintf(stderr, "qtcurve-gtk-writer: cannot write %s\n",
+                path.toLocal8Bit().constData());
+        return 1;
+    }
+    return 0;
+}
+
+int
+copyAssets(const QString &srcDir, const QString &dstDir)
+{
+    if (!QDir().mkpath(dstDir)) {
+        fprintf(stderr, "qtcurve-gtk-writer: cannot make %s\n",
+                dstDir.toLocal8Bit().constData());
+        return 1;
+    }
+    const QDir src(srcDir);
+    const QStringList files =
+        src.entryList(QStringList() << QStringLiteral("*.svg"), QDir::Files);
+    if (files.isEmpty()) {
+        fprintf(stderr, "qtcurve-gtk-writer: no SVG file in %s\n",
+                srcDir.toLocal8Bit().constData());
+        return 1;
+    }
+    for (const QString &name : files) {
+        const QString target = dstDir + QLatin1Char('/') + name;
+        QFile::remove(target);
+        if (!QFile::copy(src.filePath(name), target)) {
+            fprintf(stderr, "qtcurve-gtk-writer: cannot copy %s\n",
+                    target.toLocal8Bit().constData());
+            return 1;
+        }
+    }
+    return 0;
+}
+
+int
+mergeImport(const QString &path)
+{
+    if (!QDir().mkpath(QFileInfo(path).absolutePath())) {
+        return 6;
+    }
+    QFile gtkCss(path);
+    if (!gtkCss.open(QIODevice::ReadWrite)) {
+        fprintf(stderr, "qtcurve-gtk-writer: cannot merge %s\n",
+                path.toLocal8Bit().constData());
+        return 6;
+    }
+    QByteArray contents = gtkCss.readAll().trimmed();
+    const QByteArray statement(importStatement);
+    if (contents.contains(statement)) {
+        return 0;
+    }
+    if (!contents.isEmpty()) {
+        contents.append('\n');
+    }
+    contents.append(statement);
+    contents.append('\n');
+    gtkCss.remove();
+    if (!gtkCss.open(QIODevice::WriteOnly | QIODevice::Text)) {
+        return 6;
+    }
+    gtkCss.write(contents);
+    return 0;
+}
+
+int
+removeImport(const QString &path, bool *changed)
+{
+    if (!QFile::exists(path)) {
+        return 0;
+    }
+    QFile gtkCss(path);
+    if (!gtkCss.open(QIODevice::ReadWrite)) {
+        fprintf(stderr, "qtcurve-gtk-writer: cannot merge %s\n",
+                path.toLocal8Bit().constData());
+        return 6;
+    }
+    const QByteArray contents = gtkCss.readAll().trimmed();
+    QList<QByteArray> kept;
+    const QList<QByteArray> lines = contents.split('\n');
+    for (const QByteArray &one : lines) {
+        if (one.trimmed() != QByteArray(importStatement)) {
+            kept.append(one);
+        }
+    }
+    if (kept.size() == lines.size()) {
+        return 0;
+    }
+    QByteArray out = kept.join('\n').trimmed();
+    if (!out.isEmpty()) {
+        out.append('\n');
+    }
+    gtkCss.remove();
+    if (!gtkCss.open(QIODevice::WriteOnly | QIODevice::Text)) {
+        return 6;
+    }
+    gtkCss.write(out);
+    if (changed) {
+        *changed = true;
+    }
+    return 0;
+}
+
+bool
+removeOwned(const QString &path)
+{
+    return QFile::remove(path);
+}
+
+bool
+removeDir(const QString &dir)
+{
+    if (!QDir(dir).exists()) {
+        return false;
+    }
+    return QDir(dir).removeRecursively();
+}
+
+}
+}
