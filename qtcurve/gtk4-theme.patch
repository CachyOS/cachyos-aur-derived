+void
+Writer::progressBar()
+{
+    const QColor troughBase = m_opts.progressGrooveColor == ECOLOR_BACKGROUND ?
+        m_pal.window : m_opts.progressGrooveColor == ECOLOR_BASE ?
+        m_pal.base : m_pal.win[2];
+    Box trough;
+    trough.image = grad(QStringLiteral("pbar-trough-img"),
+                        m_opts.progressGrooveAppearance, troughBase, true);
+    trough.bg = col(QStringLiteral("pbar-trough-bg"), troughBase);
+    trough.border = m_opts.borderProgress ?
+        line(QStringLiteral("pbar-trough-border"), m_pal.win[QTC_STD_BORDER]) :
+        v(QStringLiteral("pbar-trough-noborder"), QStringLiteral("none"));
+    trough.radius = rad(QStringLiteral("pbar-trough-radius"),
+                        WIDGET_PBAR_TROUGH, 300, 14);
+    // The Qt style draws an etch ring outside the trough, so the trough
+    // takes one pixel of margin.
+    trough.more << QStringLiteral("min-height: 19px")
+                << QStringLiteral("margin: 1px");
+    put(QStringLiteral("progressbar > trough, progressbar trough"), trough);
+
+    const QColor fillBase = m_opts.progressColor == SHADE_SELECTED ?
+        m_pal.highlight : m_opts.progressColor == SHADE_CUSTOM ?
+        m_opts.customProgressColor : m_pal.button;
+    Box fill;
+    fill.image = grad(QStringLiteral("pbar-fill-img"),
+                      m_opts.progressAppearance, fillBase, true);
+    fill.bg = col(QStringLiteral("pbar-fill-bg"), fillBase);
+    fill.border = m_opts.borderProgress ?
+        line(QStringLiteral("pbar-fill-border"), m_pal.hl[QTC_STD_BORDER]) :
+        v(QStringLiteral("pbar-fill-noborder"), QStringLiteral("none"));
+    fill.radius = rad(QStringLiteral("pbar-fill-radius"), WIDGET_PROGRESSBAR,
+                      300, 14);
+    // The Qt fill covers the border of the trough, so the fill takes a
+    // negative margin.
+    fill.more << QStringLiteral("min-height: 19px")
+              << QStringLiteral("margin: -1px");
+    const bool striped = m_opts.stripedProgress != STRIPE_NONE;
+    if (striped) {
+        fill.image = v(QStringLiteral("pbar-stripe"),
+                       QStringLiteral("repeating-linear-gradient(to right, "
+                                      "%1 0px, %1 10px, %2 10px, %2 20px)")
+                       .arg(hex(m_pal.hl[1]), hex(m_pal.hl[0])));
+        fill.more << QStringLiteral("background-size: 20px 100%")
+                  << QStringLiteral("background-repeat: repeat");
+    }
+    fill.more << QStringLiteral("animation: %1")
+                 .arg(v(QStringLiteral("pbar-anim"),
+                        (m_opts.animatedProgress && striped) ?
+                        QStringLiteral("qtc-progress-stripe 2s "
+                                       "steps(20, start) infinite") :
+                        QStringLiteral("none")));
+    put(QStringLiteral("progressbar > trough > progress, "
+                       "progressbar progress"), fill);
+
+    Box text;
+    text.fg = col(QStringLiteral("fg"), m_pal.windowText);
+    if (m_opts.boldProgress) {
+        text.more << QStringLiteral("font-weight: bold");
+    }
+    put(QStringLiteral("progressbar > text"), text);
+}
