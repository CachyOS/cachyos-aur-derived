diff --git a/gtk4/check/assert-agree.sh b/gtk4/check/assert-agree.sh
new file mode 100755
index 00000000..513260c8
--- /dev/null
+++ b/gtk4/check/assert-agree.sh
@@ -0,0 +1,25 @@
+#!/bin/sh
+# assert-agree.sh WRITER THEMEDIR SCHEMEDIR: the fallback theme and the
+# emitter must not drift. Every shipped sheet must equal a fresh run of the
+# writer with the shipped preset and the shipped colour scheme.
+set -eu
+writer=${1:?usage: assert-agree.sh WRITER THEMEDIR SCHEMEDIR}
+theme=${2:?}
+schemes=${3:?}
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+status=0
+check() {
+    "$writer" --stdout --default --force --scheme "$3" --dialect "$2" \
+        --asset-base ../assets/ ${4:-} > "$tmp/out.css"
+    if ! cmp -s "$tmp/out.css" "$theme/$1"; then
+        echo "assert-agree: $1 differs from a fresh run" >&2
+        status=1
+    fi
+}
+check gtk-4.0/gtk.css      gtk4 "$schemes/QtCurveLight.colors"
+check gtk-4.0/gtk-dark.css gtk4 "$schemes/QtCurveDark.colors"  --root
+check gtk-3.0/gtk.css      gtk3 "$schemes/QtCurveLight.colors"
+check gtk-3.0/gtk-dark.css gtk3 "$schemes/QtCurveDark.colors"
+[ $status -eq 0 ] && echo "assert-agree: the four sheets agree"
+exit $status
diff --git a/gtk4/check/assert-nodes.sh b/gtk4/check/assert-nodes.sh
new file mode 100755
index 00000000..d3c26298
--- /dev/null
+++ b/gtk4/check/assert-nodes.sh
@@ -0,0 +1,29 @@
+#!/bin/sh
+# assert-nodes.sh SHEET DIALECT: the sheet holds no selector that matches
+# nothing. DIALECT is gtk3 or gtk4. Six selectors of breeze-gtk are dead
+# under GTK 4.22.4, and a GTK 4 sheet must hold no GTK 3 node name.
+set -eu
+sheet=${1:?usage: assert-nodes.sh SHEET DIALECT}
+dialect=${2:?usage: assert-nodes.sh SHEET DIALECT}
+status=0
+if [ "$dialect" = gtk4 ]; then
+    for dead in "frame > border" "radiobutton" "tooltip decoration" \
+                "tooltip.window-frame.csd" "menu menuitem check"; do
+        if grep -qF "$dead" "$sheet"; then
+            echo "assert-nodes: $sheet holds the dead selector '$dead'" >&2
+            status=1
+        fi
+    done
+    for old in "menuitem" "titlebutton" "decoration"; do
+        if grep -qE "(^|[ ,>])$old([ ,.:{]|$)" "$sheet"; then
+            echo "assert-nodes: $sheet holds the GTK 3 node '$old'" >&2
+            status=1
+        fi
+    done
+fi
+if grep -qE "(^|[ ,>])toolbar([ ,.:{]|$)" "$sheet" && [ "$dialect" = gtk4 ]; then
+    echo "assert-nodes: $sheet holds the dead element 'toolbar'" >&2
+    status=1
+fi
+[ $status -eq 0 ] && echo "assert-nodes: $sheet ok for $dialect"
+exit $status
diff --git a/gtk4/check/assert-varnames.sh b/gtk4/check/assert-varnames.sh
new file mode 100755
index 00000000..1e2a9d60
--- /dev/null
+++ b/gtk4/check/assert-varnames.sh
@@ -0,0 +1,21 @@
+#!/bin/sh
+# assert-varnames.sh SHEET [ROOTSHEET]: every var() name that SHEET uses must
+# have a declaration. The optional second file holds the :root block, for the
+# dark sheet of the shipped theme. GTK drops a declaration with an undeclared
+# name in silence, so a miss must fail the build.
+set -eu
+sheet=${1:?usage: assert-varnames.sh SHEET [ROOTSHEET]}
+root=${2:-$1}
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+grep -o -- "var(--qtc-[A-Za-z0-9-]*" "$sheet" | sed 's/^var(//' | sort -u > "$tmp/used"
+grep -o -- "--qtc-[A-Za-z0-9-]*:" "$root" | sed 's/:$//' | sort -u > "$tmp/declared"
+if ! comm -23 "$tmp/used" "$tmp/declared" > "$tmp/missing"; then
+    exit 1
+fi
+if [ -s "$tmp/missing" ]; then
+    echo "assert-varnames: $sheet uses names with no declaration:" >&2
+    cat "$tmp/missing" >&2
+    exit 1
+fi
