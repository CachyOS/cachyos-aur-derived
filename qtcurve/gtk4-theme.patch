diff --git a/gtk4/CMakeLists.txt b/gtk4/CMakeLists.txt
new file mode 100644
index 00000000..9aecee7a
--- /dev/null
+++ b/gtk4/CMakeLists.txt
@@ -0,0 +1,117 @@
+# The GTK theme generator, the four sheets of the fallback theme and the
+# glyphs that both dialects name.
+
+set(CMAKE_AUTOMOC True)
+
+set(QTC_GTK_THEME_DIR "${CMAKE_INSTALL_FULL_DATADIR}/themes/QtCurve")
+set(QTC_GTK_WRITER_PATH "${CMAKE_INSTALL_FULL_BINDIR}/qtcurve-gtk-writer")
+
+find_package(ECM 1.2.0 REQUIRED NO_MODULE)
+set(CMAKE_MODULE_PATH ${CMAKE_MODULE_PATH} ${ECM_MODULE_PATH})
+find_package(Qt6 REQUIRED COMPONENTS Core Gui Widgets Svg DBus)
+find_package(KF6 REQUIRED COMPONENTS ColorScheme Config CoreAddons)
+
+set(qtcurve_gtk_writer_SRCS
+  writer/main.cpp
+  writer/palette.cpp
+  writer/emit.cpp
+  writer/widgets.cpp
+  writer/dialect.cpp
+  writer/userfile.cpp
+  writer/watch.cpp
+  "${CMAKE_CURRENT_SOURCE_DIR}/../qt6/common/common.cpp"
+  "${CMAKE_CURRENT_SOURCE_DIR}/../qt6/common/config_file.cpp")
+
+add_executable(qtcurve-gtk-writer ${qtcurve_gtk_writer_SRCS})
+target_compile_definitions(qtcurve-gtk-writer PRIVATE
+  QTC_UTILS_QT6 QTC_UTILS_QT
+  "QTC_GTK_THEME_DIR=\"${QTC_GTK_THEME_DIR}\"")
+# qt6/common/common.h includes QApplication, so the writer needs the QtWidgets
+# headers. It calls no function of the library and it links none.
+target_include_directories(qtcurve-gtk-writer PRIVATE
+  "${CMAKE_CURRENT_SOURCE_DIR}/writer"
+  "${CMAKE_CURRENT_SOURCE_DIR}/../qt6/common"
+  "${CMAKE_BINARY_DIR}"
+  ${Qt6Widgets_INCLUDE_DIRS})
+target_link_libraries(qtcurve-gtk-writer
+  Qt6::Core Qt6::Gui Qt6::Svg Qt6::DBus
+  KF6::ColorScheme KF6::ConfigCore KF6::CoreAddons
+  qtcurve-utils)
+
+# A cross build cannot run a host tool. A silent skip would install a theme
+# directory with no sheet, so the configure step fails instead.
+if(CMAKE_CROSSCOMPILING AND NOT QTC_GTK4_WRITER)
+  message(FATAL_ERROR
+    "A cross build needs -DQTC_GTK4_WRITER=<path of a host qtcurve-gtk-writer>")
+endif()
+if(QTC_GTK4_WRITER)
+  set(qtc_writer_command "${QTC_GTK4_WRITER}")
+  set(qtc_writer_depends "${QTC_GTK4_WRITER}")
+else()
+  set(qtc_writer_command "$<TARGET_FILE:qtcurve-gtk-writer>")
+  set(qtc_writer_depends qtcurve-gtk-writer)
+endif()
+
+set(qtc_theme_dir "${CMAKE_CURRENT_BINARY_DIR}/themes/QtCurve")
+set(qtc_light "${CMAKE_CURRENT_SOURCE_DIR}/schemes/QtCurveLight.colors")
+set(qtc_dark "${CMAKE_CURRENT_SOURCE_DIR}/schemes/QtCurveDark.colors")
+
+# Four build time runs of the same emitter, one per shipped sheet.
+function(qtc_gtk_sheet out scheme dialect)
+  add_custom_command(OUTPUT "${out}"
+    COMMAND "${qtc_writer_command}" --stdout --default --force
+            --scheme "${scheme}" --dialect "${dialect}"
+            --asset-base "../assets/" --out "${out}" ${ARGN}
+    DEPENDS ${qtc_writer_depends} "${scheme}"
+    COMMENT "Writing ${out}"
+    VERBATIM)
+endfunction()
+
+qtc_gtk_sheet("${qtc_theme_dir}/gtk-4.0/gtk.css" "${qtc_light}" gtk4)
+qtc_gtk_sheet("${qtc_theme_dir}/gtk-4.0/gtk-dark.css" "${qtc_dark}" gtk4 --root)
+qtc_gtk_sheet("${qtc_theme_dir}/gtk-3.0/gtk.css" "${qtc_light}" gtk3)
+qtc_gtk_sheet("${qtc_theme_dir}/gtk-3.0/gtk-dark.css" "${qtc_dark}" gtk3)
+
+add_custom_target(qtcurve-gtk-theme ALL DEPENDS
+  "${qtc_theme_dir}/gtk-4.0/gtk.css"
+  "${qtc_theme_dir}/gtk-4.0/gtk-dark.css"
+  "${qtc_theme_dir}/gtk-3.0/gtk.css"
+  "${qtc_theme_dir}/gtk-3.0/gtk-dark.css")
+
+# GTK drops a rule with an unknown name or an unknown node in silence. The
+# checks therefore run at build time and not at review time.
+set(qtc_check "${CMAKE_CURRENT_SOURCE_DIR}/check")
+add_custom_command(TARGET qtcurve-gtk-theme POST_BUILD
+  COMMAND sh "${qtc_check}/assert-varnames.sh"
+          "${qtc_theme_dir}/gtk-4.0/gtk.css"
+  COMMAND sh "${qtc_check}/assert-varnames.sh"
+          "${qtc_theme_dir}/gtk-4.0/gtk.css"
+          "${qtc_theme_dir}/gtk-4.0/gtk-dark.css"
+  COMMAND sh "${qtc_check}/assert-nodes.sh"
+          "${qtc_theme_dir}/gtk-4.0/gtk.css" gtk4
+  COMMAND sh "${qtc_check}/assert-nodes.sh"
+          "${qtc_theme_dir}/gtk-4.0/gtk-dark.css" gtk4
+  COMMAND sh "${qtc_check}/assert-nodes.sh"
+          "${qtc_theme_dir}/gtk-3.0/gtk.css" gtk3
+  COMMAND sh "${qtc_check}/assert-nodes.sh"
+          "${qtc_theme_dir}/gtk-3.0/gtk-dark.css" gtk3
+  COMMAND sh "${qtc_check}/assert-agree.sh" "${qtc_writer_command}"
+          "${qtc_theme_dir}" "${CMAKE_CURRENT_SOURCE_DIR}/schemes"
+  VERBATIM)
+
+configure_file(autostart/qtcurve-gtk-writer.desktop.in
+  "${CMAKE_CURRENT_BINARY_DIR}/qtcurve-gtk-writer.desktop" @ONLY)
+
+install(TARGETS qtcurve-gtk-writer DESTINATION "${CMAKE_INSTALL_FULL_BINDIR}")
+install(FILES
+  "${qtc_theme_dir}/gtk-4.0/gtk.css"
+  "${qtc_theme_dir}/gtk-4.0/gtk-dark.css"
+  DESTINATION "${QTC_GTK_THEME_DIR}/gtk-4.0")
+install(FILES
+  "${qtc_theme_dir}/gtk-3.0/gtk.css"
+  "${qtc_theme_dir}/gtk-3.0/gtk-dark.css"
+  DESTINATION "${QTC_GTK_THEME_DIR}/gtk-3.0")
+install(DIRECTORY assets/ DESTINATION "${QTC_GTK_THEME_DIR}/assets"
+  FILES_MATCHING PATTERN "*.svg")
+install(FILES "${CMAKE_CURRENT_BINARY_DIR}/qtcurve-gtk-writer.desktop"
+  DESTINATION "${CMAKE_INSTALL_FULL_SYSCONFDIR}/xdg/autostart")
