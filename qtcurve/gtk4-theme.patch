+ *   but WITHOUT ANY WARRANTY; without even the implied warranty of          *
+ *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU       *
+ *   Lesser General Public License for more details.                         *
+ *                                                                           *
+ *   You should have received a copy of the GNU Lesser General Public        *
+ *   License along with this library. If not,                                *
+ *   see <http://www.gnu.org/licenses/>.                                     *
+ *****************************************************************************/
+
+#include "palette.h"
+
+#include <qtcurve-utils/color.h>
+
+#include <KColorScheme>
+#include <KConfigGroup>
+#include <KSharedConfig>
+
+#include <QFile>
+#include <QRegularExpression>
+
+namespace QtCurve {
+namespace Gtk {
+
+QString
+hex(const QColor &col)
+{
+    return QString::asprintf("#%02x%02x%02x", col.red(), col.green(),
+                             col.blue());
+}
+
+QString
+rgba(const QColor &col, double alpha)
+{
+    return QString::asprintf("rgba(%d,%d,%d,%.3f)", col.red(), col.green(),
+                             col.blue(), alpha);
+}
+
+void
+shadeLadder(const Options &opts, const QColor &base, Shades &out)
+{
+    const bool custom = USE_CUSTOM_SHADES(opts);
+    const double hl = TO_FACTOR(opts.highlightFactor);
+
+    for (int i = 0;i < QTC_NUM_STD_SHADES;++i) {
+        const double k = (custom ? opts.customShades[i] :
+                          qtcShadeGetIntern(opts.contrast, i,
+                                            opts.darkerBorders, opts.shading));
+        qtcShade(&base, &out.col[i], k, opts.shading);
+    }
+    qtcShade(&base, &out.col[SHADE_ORIG_HIGHLIGHT], hl, opts.shading);
+    qtcShade(&out.col[4], &out.col[SHADE_4_HIGHLIGHT], hl, opts.shading);
+    qtcShade(&out.col[2], &out.col[SHADE_2_HIGHLIGHT], hl, opts.shading);
+    out.col[ORIGINAL_SHADE] = base;
+}
+
+/** The groups and the keys that a shipped .colors file must hold. */
+static const struct {
+    const char *group;
+    const char *key;
+} requiredEntries[] = {
+    { "Colors:Window", "BackgroundNormal" },
+    { "Colors:Window", "ForegroundNormal" },
+    { "Colors:Button", "BackgroundNormal" },
+    { "Colors:Button", "ForegroundNormal" },
+    { "Colors:View", "BackgroundNormal" },
+    { "Colors:View", "ForegroundNormal" },
+    { "Colors:Selection", "BackgroundNormal" },
+    { "Colors:Selection", "ForegroundNormal" },
+    { "Colors:Tooltip", "BackgroundNormal" },
+    { "Colors:Tooltip", "ForegroundNormal" },
+    { "WM", "activeBackground" },
+    { "WM", "activeForeground" },
+};
+
+static int
+checkFile(const QString &file, KSharedConfigPtr cfg, QString &err)
+{
+    static const QRegularExpression triple(
+        QStringLiteral("^\\s*\\d+\\s*,\\s*\\d+\\s*,\\s*\\d+\\s*$"));
+
+    for (const auto &entry : requiredEntries) {
+        KConfigGroup group(cfg, QLatin1String(entry.group));
+        if (!group.exists() || !group.hasKey(entry.key)) {
+            err = QStringLiteral("%1: group [%2] key %3")
+                .arg(file, QLatin1String(entry.group),
+                     QLatin1String(entry.key));
+            return 3;
+        }
+        const QString value = group.readEntry(entry.key, QString());
+        if (!triple.match(value).hasMatch()) {
+            err = QStringLiteral("%1: group [%2] key %3 value '%4'")
+                .arg(file, QLatin1String(entry.group),
+                     QLatin1String(entry.key), value);
+            return 4;
+        }
+    }
+    return 0;
+}
+
+int
+readPalette(const QString &file, const Options &opts, Palette &pal,
+            QString &err)
+{
+    KSharedConfigPtr cfg;
+    if (file.isEmpty()) {
+        cfg = KSharedConfig::openConfig(QStringLiteral("kdeglobals"));
+    } else {
+        if (!QFile::exists(file)) {
+            err = file;
+            return 3;
+        }
+        cfg = KSharedConfig::openConfig(file, KConfig::SimpleConfig);
+        const int bad = checkFile(file, cfg, err);
+        if (bad != 0) {
+            return bad;
+        }
+    }
+
+    const KColorScheme win(QPalette::Active, KColorScheme::Window, cfg);
+    const KColorScheme btn(QPalette::Active, KColorScheme::Button, cfg);
+    const KColorScheme view(QPalette::Active, KColorScheme::View, cfg);
+    const KColorScheme sel(QPalette::Active, KColorScheme::Selection, cfg);
+    const KColorScheme tip(QPalette::Active, KColorScheme::Tooltip, cfg);
+    const KColorScheme winOff(QPalette::Disabled, KColorScheme::Window, cfg);
+    const KColorScheme btnOff(QPalette::Disabled, KColorScheme::Button, cfg);
+    const KColorScheme viewOff(QPalette::Disabled, KColorScheme::View, cfg);
+
+    pal.window = win.background().color();
+    pal.windowText = win.foreground().color();
+    pal.windowTextDisabled = winOff.foreground().color();
+    pal.button = btn.background().color();
+    pal.buttonText = btn.foreground().color();
+    pal.buttonTextDisabled = btnOff.foreground().color();
+    pal.buttonDisabled = btnOff.background().color();
+    pal.base = view.background().color();
+    pal.baseAlternate =
+        view.background(KColorScheme::AlternateBackground).color();
+    pal.text = view.foreground().color();
+    pal.textDisabled = viewOff.foreground().color();
+    pal.highlight = sel.background().color();
+    pal.highlightText = sel.foreground().color();
+    pal.tooltip = tip.background().color();
+    pal.tooltipText = tip.foreground().color();
+    pal.link = view.foreground(KColorScheme::LinkText).color();
+    pal.negative = view.foreground(KColorScheme::NegativeText).color();
+    pal.neutral = view.foreground(KColorScheme::NeutralText).color();
+    pal.positive = view.foreground(KColorScheme::PositiveText).color();
+
+    const KConfigGroup wm(cfg, QStringLiteral("WM"));
+    pal.titlebar = wm.readEntry("activeBackground", pal.window);
+    pal.titlebarText = wm.readEntry("activeForeground", pal.windowText);
+
+    shadeLadder(opts, pal.button, pal.btn);
+    shadeLadder(opts, pal.base, pal.bgnd);
+    shadeLadder(opts, pal.window, pal.win);
+    shadeLadder(opts, pal.highlight, pal.hl);
+    shadeLadder(opts, opts.lighterPopupMenuBgnd != 0 ?
+                pal.base : pal.window, pal.menu);
+
+    pal.dark = qtcColorLuma(&pal.window) < 0.5;
+    return 0;
+}
+
+}
+}
