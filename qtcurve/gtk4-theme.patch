+#ifndef QTC_GTK4_USERFILE_H
+#define QTC_GTK4_USERFILE_H
+
+#include <QString>
+#include <QStringList>
+
+namespace QtCurve {
+namespace Gtk {
+
+/** The one line of the shared gtk.css file that QtCurve owns. */
+extern const char *const importStatement;
+
+/**
+ * Writes content to path through a temporary name in the same directory.
+ * One rename() replaces the target, so a reader sees the old file or the
+ * new file.
+ *
+ * \return 0 on success, and 1 when the file does not open for writing.
+ */
+int writeOwned(const QString &path, const QByteArray &content);
+
+/**
+ * Copies every SVG file of srcDir into dstDir and makes dstDir. The copy
+ * replaces a file that exists in dstDir.
+ *
+ * \return 0 on success, and 1 when srcDir holds no SVG file or a copy fails.
+ */
+int copyAssets(const QString &srcDir, const QString &dstDir);
+
+/**
+ * Appends the QtCurve import line to path when the trimmed content of the
+ * file does not hold it. The function writes no byte when the line is there.
+ *
+ * \return 0 on success, and 6 when the file does not open.
+ */
+int mergeImport(const QString &path);
+
+/**
+ * Removes the QtCurve import line from path and keeps every other line. The
+ * function writes no byte when no line matches.
+ *
+ * \param changed  the call sets it to true when the file loses the line.
+ * \return 0 on success or on a missing file, and 6 when the file does not open.
+ */
+int removeImport(const QString &path, bool *changed = nullptr);
+
+/**
+ * Deletes path and gives no error when the file is already gone.
+ *
+ * \return true when the call deleted the file.
+ */
+bool removeOwned(const QString &path);
+
+/**
+ * Deletes dir and every file in it, and gives no error when it is gone.
+ *
+ * \return true when the call deleted the directory.
+ */
+bool removeDir(const QString &dir);
+
+}
+}
+
+#endif
diff --git a/gtk4/writer/watch.cpp b/gtk4/writer/watch.cpp
new file mode 100644
index 00000000..c0f52b5e
--- /dev/null
+++ b/gtk4/writer/watch.cpp
@@ -0,0 +1,100 @@
+/*****************************************************************************
+ *   Copyright 2026 QtCurve authors                                          *
+ *                                                                           *
+ *   This program is free software; you can redistribute it and/or modify    *
+ *   it under the terms of the GNU Lesser General Public License as          *
+ *   published by the Free Software Foundation; either version 2.1 of the    *
+ *   License, or (at your option) version 3, or any later version accepted   *
+ *   by the membership of KDE e.V. (or its successor approved by the         *
+ *   membership of KDE e.V.), which shall act as a proxy defined in          *
+ *   Section 6 of version 3 of the license.                                  *
+ *                                                                           *
+ *   This program is distributed in the hope that it will be useful,         *
+ *   but WITHOUT ANY WARRANTY; without even the implied warranty of          *
+ *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU       *
+ *   Lesser General Public License for more details.                         *
+ *                                                                           *
+ *   You should have received a copy of the GNU Lesser General Public        *
+ *   License along with this library. If not,                                *
+ *   see <http://www.gnu.org/licenses/>.                                     *
+ *****************************************************************************/
+
+#include "watch.h"
+
+#include <KConfigGroup>
+#include <KConfigWatcher>
+#include <KSharedConfig>
+
+#include <QFileInfo>
+#include <QFileSystemWatcher>
+
+namespace QtCurve {
+namespace Gtk {
+
+/**
+ * The debounce of the watch mode, in milliseconds. The value lands after the
+ * 200 ms defer of kde-gtk-config, so the QtCurve line goes on the file that
+ * the daemon already rewrote.
+ */
+static const int debounceMs = 500;
+
+Watcher::Watcher(const std::function<int()> &write, const QStringList &paths,
+                 QObject *parent)
+    : QObject(parent), m_write(write), m_paths(paths),
+      m_files(new QFileSystemWatcher(this))
+{
+    m_timer.setSingleShot(true);
+    m_timer.setInterval(debounceMs);
+    connect(&m_timer, &QTimer::timeout, this, &Watcher::fire);
+
+    addPaths();
+    connect(m_files, &QFileSystemWatcher::fileChanged,
+            this, &Watcher::schedule);
+    connect(m_files, &QFileSystemWatcher::directoryChanged,
+            this, &Watcher::schedule);
+
+    m_config = KConfigWatcher::create(
+        KSharedConfig::openConfig(QStringLiteral("kdeglobals")));
+    connect(m_config.get(), &KConfigWatcher::configChanged, this,
+            [this] (const KConfigGroup &group, const QByteArrayList &names) {
+                if (group.name() != QLatin1String("General")) {
+                    return;
+                }
+                if (names.contains(QByteArrayLiteral("ColorScheme")) ||
+                    names.contains(QByteArrayLiteral("AccentColor"))) {
+                    schedule();
+                }
+            });
+}
+
+void
+Watcher::addPaths()
+{
+    const QStringList files = m_files->files();
+    const QStringList dirs = m_files->directories();
+    for (const QString &path : m_paths) {
+        const QString dir = QFileInfo(path).absolutePath();
+        if (!dirs.contains(dir) && QFileInfo::exists(dir)) {
+            m_files->addPath(dir);
+        }
+        if (!files.contains(path) && QFileInfo::exists(path)) {
+            m_files->addPath(path);
+        }
+    }
+}
+
+void
+Watcher::schedule()
+{
+    addPaths();
+    m_timer.start();
+}
+
+void
+Watcher::fire()
+{
+    m_write();
+}
+
+}
+}
