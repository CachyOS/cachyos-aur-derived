+ *   see <http://www.gnu.org/licenses/>.                                     *
+ *****************************************************************************/
+
+#ifndef QTC_GTK4_PALETTE_H
+#define QTC_GTK4_PALETTE_H
+
+#include <common.h>
+
+#include <QColor>
+#include <QString>
+
+namespace QtCurve {
+namespace Gtk {
+
+/**
+ * One QtCurve shade ladder. Index 0 to 5 are the standard shades, 6 to 8 are
+ * the highlight shades, and index 9 is the base colour.
+ */
+struct Shades {
+    QColor col[TOTAL_SHADES + 1];
+    const QColor &operator[](int i) const { return col[i]; }
+};
+
+/**
+ * The colour roles and the shade ladders that the emitter reads. The polarity
+ * flag is true when the luminance of the window background is below 0.5.
+ */
+struct Palette {
+    QColor window, windowText, windowTextDisabled;
+    QColor button, buttonText, buttonTextDisabled, buttonDisabled;
+    QColor base, baseAlternate, text, textDisabled;
+    QColor highlight, highlightText;
+    QColor tooltip, tooltipText;
+    QColor link, negative, neutral, positive;
+    QColor titlebar, titlebarText;
+    Shades btn, bgnd, win, hl, menu;
+    bool dark = false;
+};
+
+/**
+ * Fills out with the ladder that Style::shadeColors() builds for the base
+ * colour, under the custom shades, the contrast and the shading model of opts.
+ */
+void shadeLadder(const Options &opts, const QColor &base, Shades &out);
+
+/**
+ * Reads the colour scheme and builds every role and ladder of pal. An empty
+ * file name takes the live scheme from kdeglobals, which the function must
+ * name because KConfig reads a configuration name off the command line.
+ *
+ * \param file  path of a KDE .colors file, or an empty string for the live scheme.
+ * \param opts  the QtCurve settings that give the contrast and the shading model.
+ * \param pal   receives the roles and the ladders.
+ * \param err   receives the file, the group and the key of a failure.
+ * \return 0 on success, 3 for a missing group or key, and 4 for a bad colour value.
+ */
+int readPalette(const QString &file, const Options &opts, Palette &pal,
+                QString &err);
+
+/** Returns the CSS hexadecimal form of col, such as #eff0f1. */
+QString hex(const QColor &col);
+
+/** Returns the CSS rgba() form of col with the alpha alpha, from 0.0 to 1.0. */
+QString rgba(const QColor &col, double alpha);
+
+}
+}
+
+#endif
