+void
+Writer::checkRadio()
+{
+    // The drawn frame of the Qt indicator is 15 pixels for a check box and
+    // 14 for a radio button. The etch effect takes one pixel of margin.
+    const int checkSide = 13;
+    const int radioSide = 13;
+    const QColor face = m_opts.crButton ? m_pal.button : m_pal.base;
+    const QColor mark = m_opts.crButton ? m_pal.buttonText : m_pal.text;
+    const Shades &ladder = m_opts.crButton ? m_pal.btn : m_pal.bgnd;
+
+    Box box;
+    box.image = grad(QStringLiteral("cr-img"), m_opts.appearance, face);
+    box.bg = col(QStringLiteral("cr-bg"), face);
+    box.border = line(QStringLiteral("cr-border"), ladder[QTC_STD_BORDER]);
+    box.radius = rad(QStringLiteral("cr-radius"), WIDGET_CHECKBOX, 18, 18);
+    box.shadow = v(QStringLiteral("cr-etch"), etchShadow());
+    box.fg = col(QStringLiteral("cr-fg"), mark);
+    box.more << QStringLiteral("min-width: %1px").arg(checkSide)
+             << QStringLiteral("min-height: %1px").arg(checkSide)
+             << QStringLiteral("margin: 2px")
+             << QStringLiteral("padding: 0");
+    if (m_nodes.iconSize) {
+        box.more << QStringLiteral("-gtk-icon-size: %1px").arg(checkSide);
+    }
+    put(QStringLiteral("check, checkbutton > check"), box);
+
+    Box radio = box;
+    radio.radius = QStringLiteral("50%");
+    radio.more.clear();
+    radio.more << QStringLiteral("min-width: %1px").arg(radioSide)
+               << QStringLiteral("min-height: %1px").arg(radioSide)
+               << QStringLiteral("margin: 2px")
+               << QStringLiteral("padding: 0");
+    if (m_nodes.iconSize) {
+        radio.more << QStringLiteral("-gtk-icon-size: %1px").arg(radioSide);
+    }
+    put(QStringLiteral("radio, checkbutton > radio"), radio);
+
+    if (m_nodes.glyphAsset) {
+        Box on = box;
+        on.more.clear();
+        on.more << glyph(QStringLiteral("check-mark"),
+                         QStringLiteral("qtc-check.svg"));
+        put(QStringLiteral("check:checked, checkbutton > check:checked"), on);
+
+        Box mixed = on;
+        mixed.more.clear();
+        mixed.more << glyph(QStringLiteral("check-dash"),
+                            QStringLiteral("qtc-dash.svg"));
+        put(QStringLiteral("check:indeterminate, "
+                           "checkbutton > check:indeterminate"), mixed);
+
+        Box bullet = radio;
+        bullet.more.clear();
+        bullet.more << glyph(QStringLiteral("radio-bullet"),
+                             QStringLiteral("qtc-bullet.svg"));
+        put(QStringLiteral("radio:checked, checkbutton > radio:checked"),
+            bullet);
+    }
+
+    Box off = box;
+    off.image = QStringLiteral("none");
+    off.bg = col(QStringLiteral("cr-bg-off"), m_pal.window);
+    off.fg = col(QStringLiteral("cr-fg-off"), m_pal.windowTextDisabled);
+    off.more.clear();
+    put(QStringLiteral("check:disabled, radio:disabled"), off);
+}
