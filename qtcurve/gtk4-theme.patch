+
+#ifndef QTC_GTK4_EMIT_H
+#define QTC_GTK4_EMIT_H
+
+#include "palette.h"
+
+#include <QList>
+#include <QMap>
+#include <QString>
+
+namespace QtCurve {
+namespace Gtk {
+
+/** The two CSS dialects that the one emitter writes. */
+enum class Dialect {
+    Gtk4,
+    Gtk3
+};
+
+/**
+ * One CSS sheet under construction. The GTK 4 dialect collects every value
+ * into the :root block, and the GTK 3 dialect writes the literal alone.
+ */
+class Sheet {
+public:
+    Sheet(Dialect dialect, const QString &assetBase);
+
+    /**
+     * Declares the custom property name with the value value and returns the
+     * text of one use of it. A second value for one name gives exit code 5,
+     * and the first value stays in the sheet.
+     */
+    QString val(const QString &name, const QString &value);
+
+    /** Appends one rule of the selector selector and the body body. */
+    void rule(const QString &selector, const QString &body);
+
+    /** Appends text to the body of the sheet without a change. */
+    void raw(const QString &text);
+
+    /** Returns the url() of the asset name against the asset base of the run. */
+    QString url(const QString &name) const;
+
+    /** Returns the whole sheet, with the :root block and the body. */
+    QString text() const;
+
+    /** Returns the :root block alone, with no rule of the body. */
+    QString rootBlock() const;
+
+    Dialect dialect() const { return m_dialect; }
+
+private:
+    Dialect m_dialect;
+    QString m_assetBase;
+    QMap<QString, QString> m_values;
+    QList<QString> m_order;
+    QString m_body;
+};
+
+/**
+ * Returns the background-image of the appearance app over the base colour
+ * base, from the stop table of qtcGetGradient(). A flat appearance gives none.
+ *
+ * \param horiz  true marks a horizontal widget, and the gradient then runs to
+ *               the bottom. A vertical widget takes the gradient to the right.
+ */
+QString gradientImage(const Options &opts, EAppearance app, const QColor &base,
+                      bool horiz = true);
+
+/**
+ * Returns the border-radius of the widget widget at the size w by h pixels,
+ * in the CSS pixel form.
+ */
+QString radius(const Options &opts, int w, int h, EWidget widget);
+
+/**
+ * Records exit code 5 and prints the enumeration name and the value. The
+ * emitter has no default branch, so a new upstream value stops the build.
+ */
+void failUnknown(const char *enumName, int value);
+
+/**
+ * Records exit code 5 and prints the name of a custom property, the value
+ * that it holds and the second value.
+ */
+void failDuplicate(const QString &name, const QString &held,
+                   const QString &value);
+
+/** Returns 5 after a failure call, and 0 while the emitter is sound. */
+int emitError();
+
+}
+}
+
+#endif
