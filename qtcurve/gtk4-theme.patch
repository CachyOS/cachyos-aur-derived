+ *****************************************************************************/
+
+#ifndef QTC_GTK4_WATCH_H
+#define QTC_GTK4_WATCH_H
+
+#include <KConfigWatcher>
+
+#include <QObject>
+#include <QStringList>
+#include <QTimer>
+
+#include <functional>
+
+class QFileSystemWatcher;
+
+namespace QtCurve {
+namespace Gtk {
+
+/**
+ * The resident half of the writer. It holds one KConfigWatcher over kdeglobals
+ * and one QFileSystemWatcher over the five watched paths and their holding
+ * directories.
+ */
+class Watcher : public QObject {
+    Q_OBJECT
+public:
+    /**
+     * Builds the watcher over the paths paths and the colour scheme keys.
+     * The function write runs one pass, and the caller owns its state.
+     */
+    Watcher(const std::function<int()> &write, const QStringList &paths,
+            QObject *parent = nullptr);
+
+private Q_SLOTS:
+    /** Starts the debounce timer and adds every lost watch path again. */
+    void schedule();
+    /** Runs the write function once, after the debounce. */
+    void fire();
+
+private:
+    /**
+     * Adds every path and every holding directory that the watcher does not
+     * hold. A watch on the directory covers a file that is absent at start.
+     */
+    void addPaths();
+
+    std::function<int()> m_write;
+    QStringList m_paths;
+    QFileSystemWatcher *m_files;
+    KConfigWatcher::Ptr m_config;
+    QTimer m_timer;
+};
+
+}
+}
+
+#endif
diff --git a/gtk4/writer/widgets.cpp b/gtk4/writer/widgets.cpp
new file mode 100644
index 00000000..1887426c
--- /dev/null
+++ b/gtk4/writer/widgets.cpp
@@ -0,0 +1,1236 @@
+/*****************************************************************************
+ *   Copyright 2026 QtCurve authors                                          *
+ *                                                                           *
+ *   This program is free software; you can redistribute it and/or modify    *
+ *   it under the terms of the GNU Lesser General Public License as          *
+ *   published by the Free Software Foundation; either version 2.1 of the    *
+ *   License, or (at your option) version 3, or any later version accepted   *
+ *   by the membership of KDE e.V. (or its successor approved by the         *
+ *   membership of KDE e.V.), which shall act as a proxy defined in          *
+ *   Section 6 of version 3 of the license.                                  *
+ *                                                                           *
+ *   This program is distributed in the hope that it will be useful,         *
+ *   but WITHOUT ANY WARRANTY; without even the implied warranty of          *
+ *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU       *
+ *   Lesser General Public License for more details.                         *
+ *                                                                           *
+ *   You should have received a copy of the GNU Lesser General Public        *
+ *   License along with this library. If not,                                *
+ *   see <http://www.gnu.org/licenses/>.                                     *
+ *****************************************************************************/
+
+#include "dialect.h"
+
+#include <qtcurve-utils/color.h>
+
+namespace QtCurve {
+namespace Gtk {
+
+namespace {
+
+/** The seven properties of the full box reset of every generated rule. */
+struct Box {
+    QString image = QStringLiteral("none");
+    QString bg = QStringLiteral("transparent");
+    QString border = QStringLiteral("none");
+    QString radius = QStringLiteral("0");
+    QString shadow = QStringLiteral("none");
+    QString fg;
+    QString outline = QStringLiteral("none");
+    QStringList more;
+};
+
+/** Holds one emitter run: the settings, the palette, the sheet and the nodes. */
+class Writer {
+public:
+    Writer(const Options &opts, const Palette &pal, Sheet &sheet,
+           const Nodes &nodes)
+        : m_opts(opts), m_pal(pal), m_sheet(sheet), m_nodes(nodes)
+    {
+    }
+
+    void run();
+    void colourNames();
+
+private:
+    QString v(const QString &name, const QString &value)
+    {
+        return m_sheet.val(name, value);
+    }
+    QString col(const QString &name, const QColor &c)
+    {
+        return m_sheet.val(name, hex(c));
+    }
+    QString grad(const QString &name, EAppearance app, const QColor &base,
+                 bool horiz = true)
+    {
+        return m_sheet.val(name, gradientImage(m_opts, app, base, horiz));
+    }
+    QString rad(const QString &name, EWidget w, int width, int height)
+    {
+        return m_sheet.val(name, radius(m_opts, width, height, w));
+    }
+    QString line(const QString &name, const QColor &c, int width = 1)
+    {
+        return m_sheet.val(name, QStringLiteral("%1px solid %2")
+                           .arg(width).arg(hex(c)));
+    }
+    QString glowLine(const QString &name, const QColor &c, double alpha)
+    {
+        return m_sheet.val(name, QStringLiteral("1px solid %1")
+                           .arg(rgba(c, alpha)));
+    }
+    /**
+     * Returns the box-shadow of the button effect of the settings. The etch
+     * draws a ring and the shadow draws the line under the button.
+     */
+    QString etchShadow() const
+    {
+        if (m_opts.buttonEffect == EFFECT_NONE) {
+            return QStringLiteral("none");
+        }
+        const double alpha = USE_CUSTOM_ALPHAS(m_opts) ?
+            m_opts.customAlphas[ALPHA_ETCH_DARK] : ETCH_TOP_ALPHA;
+        return QStringLiteral("%1 %2")
+            .arg(m_opts.buttonEffect == EFFECT_ETCH ?
+                 QStringLiteral("0 0 0 1px") : QStringLiteral("1px 1px 0"),
+                 rgba(QColor(0, 0, 0), alpha));
+    }
+    /**
+     * Returns the two lines that fade the lower half of a sunken border. The
+     * list is empty while etchEntry is on, because the Qt style then draws
+     * one colour on the whole border.
+     */
+    QStringList lowBorderLines()
+    {
+        if (m_opts.etchEntry) {
+            return QStringList();
+        }
+        const QString low =
+            col(QStringLiteral("entry-border-low"),
+                qtcColorMix(&m_pal.window, &m_pal.win[QTC_STD_BORDER],
+                            LOWER_BORDER_ALPHA));
+        return QStringList()
+            << QStringLiteral("border-bottom-color: %1").arg(low)
+            << QStringLiteral("border-right-color: %1").arg(low);
+    }
+    QString glyph(const QString &name, const QString &file)
+    {
+        return QStringLiteral("-gtk-icon-source: %1")
+            .arg(m_sheet.val(name, QStringLiteral("-gtk-recolor(%1)")
+                             .arg(m_sheet.url(file))));
+    }
+    void put(const QString &selector, const Box &box);
+
+    void reset();
+    void window();
+    void button();
+    void entry();
+    void spinButton();
+    void dropDown();
+    void checkRadio();
+    void scale();
+    void progressBar();
+    void levelBar();
+    void scrollBar();
+    void toggleSwitch();
+    void separator();
+    void toolBar();
+    void headerBar();
+    void menuBar();
+    void frame();
+    void decoration();
+    void notebook();
+    void lists();
+    void infoBar();
+    void tooltip();
+    void popoverMenu();
+    void focusRing();
+    void progressAnimation();
+
+    const Options &m_opts;
+    const Palette &m_pal;
+    Sheet &m_sheet;
+    const Nodes &m_nodes;
+};
+
+void
+Writer::put(const QString &selector, const Box &box)
+{
+    QString body;
+    body += QStringLiteral("  background-image: %1;\n").arg(box.image);
+    body += QStringLiteral("  background-color: %1;\n").arg(box.bg);
+    body += QStringLiteral("  border: %1;\n").arg(box.border);
+    body += QStringLiteral("  border-radius: %1;\n").arg(box.radius);
+    body += QStringLiteral("  box-shadow: %1;\n").arg(box.shadow);
+    if (!box.fg.isEmpty()) {
+        body += QStringLiteral("  color: %1;\n").arg(box.fg);
+    }
+    body += QStringLiteral("  outline: %1;\n").arg(box.outline);
+    for (const QString &extra : box.more) {
+        body += QStringLiteral("  %1;\n").arg(extra);
+    }
+    m_sheet.rule(selector, body);
+}
+
+/** Returns the colour of a widget that the user cannot use, from the style. */
+static QColor
+disabledMix(const QColor &fg, const QColor &bg)
+{
+    return qtcColorMix(&fg, &bg, 0.5);
+}
+
+void
+Writer::reset()
+{
+    m_sheet.rule(QStringLiteral("*"),
+                 QStringLiteral("  outline: none;\n"
+                                "  -gtk-secondary-caret-color: initial;\n"));
+    m_sheet.rule(QStringLiteral("label"),
+                 QStringLiteral("  color: %1;\n")
+                 .arg(col(QStringLiteral("fg"), m_pal.windowText)));
+    m_sheet.rule(QStringLiteral("label:disabled"),
+                 QStringLiteral("  color: %1;\n")
+                 .arg(col(QStringLiteral("fg-off"), m_pal.windowTextDisabled)));
+}
+
+void
+Writer::window()
+{
+    Box box;
+    box.image = grad(QStringLiteral("win-img"), m_opts.bgndAppearance,
+                     m_pal.window, m_opts.bgndGrad == GT_HORIZ);
+    box.bg = col(QStringLiteral("win-bg"), m_pal.window);
+    box.fg = col(QStringLiteral("fg"), m_pal.windowText);
+    put(QStringLiteral("window, window.background, .background, "
+                       "headerbar > windowhandle, popover > contents"), box);
+
+    // A container that paints the window colour hides the sheet of a popover
+    // or of a list under it, so every container node stays clear.
+    Box clear;
+    put(QStringLiteral("box, grid, paned, stack, viewport, scrolledwindow, "
+                       "widget, revealer, overlay, dropdown, "
+                       "columnview > listview.view, notebook > header > tabs"),
+        clear);
+}
+
+void
+Writer::button()
+{
+    const QColor border = m_pal.btn[QTC_STD_BORDER];
+    const QString border0 = line(QStringLiteral("btn-border"), border);
+    const QString r = rad(QStringLiteral("btn-radius"), WIDGET_STD_BUTTON,
+                          100, 25);
+    const bool effect = m_opts.buttonEffect != EFFECT_NONE;
+    const QString pad = effect ?
+        QStringLiteral("padding: 3px 10px 2px 10px") :
+        QStringLiteral("padding: 4px 10px 3px 10px");
+    const QString space = effect ? QStringLiteral("margin: 1px") :
+        QStringLiteral("margin: 0");
+    const QString minSize = QStringLiteral("min-height: 15px");
+    const QString minWidth = QStringLiteral("min-width: 58px");
+
+    Box box;
+    box.image = grad(QStringLiteral("btn-img"), m_opts.appearance,
+                     m_pal.button);
+    box.bg = col(QStringLiteral("btn-bg"), m_pal.button);
+    box.border = line(QStringLiteral("btn-border"), border);
+    box.radius = r;
+    box.fg = col(QStringLiteral("btn-fg"), m_pal.buttonText);
+    box.shadow = v(QStringLiteral("btn-etch"), etchShadow());
+    box.more << pad << space << minSize << minWidth
+             << QStringLiteral("transition: none");
+    put(QStringLiteral("button, button.text-button, button.image-button, "
+                       "dropdown > button, combobox button.combo, "
+                       "spinbutton button, %1").arg(m_nodes.titleButton), box);
+
+    Box hover = box;
+    hover.image = grad(QStringLiteral("btn-img-hover"), m_opts.appearance,
+                       m_pal.btn[SHADE_ORIG_HIGHLIGHT]);
+    hover.bg = col(QStringLiteral("btn-bg-hover"),
