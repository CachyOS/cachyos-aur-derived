+using namespace QtCurve::Gtk;
+
+namespace {
+
+/** The name that the GTK theme setting must hold before the writer writes. */
+const char *const themeName = "QtCurve";
+
+/** One parsed command line. */
+struct Args {
+    QString mode = QStringLiteral("--write");
+    QString settings;
+    QString scheme;
+    QString assetBase;
+    QString out;
+    Dialect dialect = Dialect::Gtk4;
+    bool useDefaults = false;
+    bool rootOnly = false;
+    bool force = false;
+};
+
+void
+usage()
+{
+    fprintf(stderr,
+            "usage: qtcurve-gtk-writer [--write|--remove-gtk|--remove-qt|\n"
+            "                           --purge-settings|--watch|--stdout]\n"
+            "  --remove-gtk      delete the GTK files of the writer\n"
+            "  --remove-qt       delete the QtCurve settings, then write the\n"
+            "                    GTK files again\n"
+            "  --purge-settings  delete the settings and the GTK files\n"
+            "  --settings FILE   read the QtCurve settings from FILE\n"
+            "  --default         use the shipped preset\n"
+            "  --scheme FILE     read the colours from a KDE .colors file\n"
+            "  --dialect gtk3|gtk4\n"
+            "  --asset-base DIR  prefix of every url() of the sheet\n"
+            "  --out FILE        write the sheet to FILE and not to stdout\n"
+            "  --root            write the :root block alone\n"
+            "  --force           skip the theme name gate\n");
+}
+
+/** Returns the GTK theme name of the session, or an empty string. */
+QString
+sessionThemeName()
+{
+    const QByteArray env = qgetenv("GTK_THEME");
+    if (!env.isEmpty()) {
+        return QString::fromLocal8Bit(env).section(QLatin1Char(':'), 0, 0);
+    }
+    QDBusInterface portal(QStringLiteral("org.freedesktop.portal.Desktop"),
+                          QStringLiteral("/org/freedesktop/portal/desktop"),
+                          QStringLiteral("org.freedesktop.portal.Settings"),
+                          QDBusConnection::sessionBus());
+    const QDBusReply<QDBusVariant> reply =
+        portal.call(QStringLiteral("ReadOne"),
+                    QStringLiteral("org.gnome.desktop.interface"),
+                    QStringLiteral("gtk-theme"));
+    if (reply.isValid()) {
+        return reply.value().variant().toString();
+    }
+    return QString();
+}
+
+/** Returns the directory that holds the shipped SVG assets. */
+QString
+installedAssets()
+{
+    return QStringLiteral(QTC_GTK_THEME_DIR "/assets");
+}
+
+/** Returns the user configuration directory of the dialect dialect. */
+QString
+userDir(Dialect dialect)
+{
+    return QString::fromLocal8Bit(getXDGConfigHome()) +
+        (dialect == Dialect::Gtk4 ? QStringLiteral("gtk-4.0") :
+         QStringLiteral("gtk-3.0"));
+}
+
+/**
+ * Returns the settings directory of QtCurve, with a trailing separator. The
+ * function makes no directory, and getConfDir() of the library makes one.
+ */
+QString
+settingsDir()
+{
+    const QByteArray env = qgetenv("QTCURVE_CONFIG_DIR");
+    if (env.startsWith('/')) {
+        return QString::fromLocal8Bit(env) + QLatin1Char('/');
+    }
+    return QString::fromLocal8Bit(getXDGConfigHome()) +
+        QStringLiteral("qtcurve/");
+}
+
+/** Prints the path of one file or one directory that the writer deleted. */
+void
+printGone(const QString &path)
+{
+    printf("qtcurve-gtk-writer: removed %s\n", path.toLocal8Bit().constData());
+}
+
+/** Reads the settings of args into opts, and returns the exit code. */
+int
+readOptions(const Args &args, Options &opts)
+{
+    qtcDefaultSettings(&opts);
+    if (args.useDefaults) {
+        return 0;
+    }
+    if (!args.settings.isEmpty()) {
+        QFile file(args.settings);
+        if (!file.open(QIODevice::ReadOnly)) {
+            fprintf(stderr, "qtcurve-gtk-writer: cannot read %s\n",
+                    args.settings.toLocal8Bit().constData());
+            return 2;
+        }
+    }
+    Options def;
+    qtcDefaultSettings(&def);
+    if (!qtcReadConfig(args.settings, &opts, &def, false)) {
+        if (!args.settings.isEmpty()) {
+            fprintf(stderr, "qtcurve-gtk-writer: cannot read %s\n",
+                    args.settings.toLocal8Bit().constData());
+            return 2;
+        }
+    }
+    return 0;
+}
+
+/** Writes the owned files of one dialect, and returns the exit code. */
+int
+writeDialect(const Options &opts, const Palette &pal, Dialect dialect)
+{
+    const QString dir = userDir(dialect);
+    const QString sheet = buildSheet(opts, pal, dialect,
+                                     QStringLiteral("qtcurve-assets/"));
+    if (emitError() != 0) {
+        return emitError();
+    }
+    const int copied = copyAssets(installedAssets(),
+                                  dir + QStringLiteral("/qtcurve-assets"));
+    if (copied != 0) {
+        return copied;
+    }
+    const QString path = dir + QStringLiteral("/qtcurve.css");
+    const QByteArray content = sheet.toUtf8();
+    QFile old(path);
+    if (old.open(QIODevice::ReadOnly) && old.readAll() == content) {
+        old.close();
+        return mergeImport(dir + QStringLiteral("/gtk.css"));
+    }
+    const int written = writeOwned(path, content);
+    if (written != 0) {
+        return written;
+    }
+    return mergeImport(dir + QStringLiteral("/gtk.css"));
+}
+
+/**
+ * Deletes the owned files of one dialect and prints each path that it
+ * deletes. A file that is absent is no error.
+ *
+ * \return 0 on success, and 6 when gtk.css does not open.
+ */
+int
+removeDialect(Dialect dialect)
+{
+    const QString dir = userDir(dialect);
+    const QString sheet = dir + QStringLiteral("/qtcurve.css");
+    const QString assets = dir + QStringLiteral("/qtcurve-assets");
+    const QString shared = dir + QStringLiteral("/gtk.css");
+    if (removeOwned(sheet)) {
+        printGone(sheet);
+    }
+    if (removeDir(assets)) {
+        printGone(assets);
+    }
+    bool changed = false;
+    const int code = removeImport(shared, &changed);
+    if (changed) {
+        printf("qtcurve-gtk-writer: removed the import line of %s\n",
+               shared.toLocal8Bit().constData());
+    }
+    return code;
+}
+
+/** Deletes the owned files of both dialects, and returns the exit code. */
+int
+removeBoth()
+{
+    const int four = removeDialect(Dialect::Gtk4);
+    const int three = removeDialect(Dialect::Gtk3);
+    return four != 0 ? four : three;
+}
+
+/**
+ * Deletes the settings of the user and prints each path that it deletes. The
+ * settings are the configuration directory of QtCurve and kwinqtcurverc.
+ */
+void
+removeSettings()
+{
+    const QString dir = settingsDir();
+    if (removeDir(dir)) {
+        printGone(dir);
+    }
+    const QString kwin = QString::fromLocal8Bit(getXDGConfigHome()) +
+        QStringLiteral("kwinqtcurverc");
+    if (removeOwned(kwin)) {
+        printGone(kwin);
+    }
+}
+
+/** Runs one write pass over both dialects, and returns the exit code. */
+int
+runWrite(const Args &args)
+{
+    if (!args.force && sessionThemeName() != QLatin1String(themeName)) {
+        removeDialect(Dialect::Gtk4);
+        removeDialect(Dialect::Gtk3);
+        return 0;
+    }
+    Options opts;
+    const int read = readOptions(args, opts);
+    if (read != 0) {
+        return read;
+    }
+    Palette pal;
+    QString err;
+    const int bad = readPalette(args.scheme, opts, pal, err);
+    if (bad != 0) {
+        fprintf(stderr, "qtcurve-gtk-writer: %s\n", err.toLocal8Bit().constData());
+        return bad;
+    }
+    const int four = writeDialect(opts, pal, Dialect::Gtk4);
+    if (four != 0) {
+        return four;
+    }
+    return writeDialect(opts, pal, Dialect::Gtk3);
+}
+
+/** Prints one sheet to standard output, and returns the exit code. */
+int
+runStdout(const Args &args)
+{
+    Options opts;
+    const int read = readOptions(args, opts);
+    if (read != 0) {
+        return read;
+    }
+    Palette pal;
+    QString err;
+    const int bad = readPalette(args.scheme, opts, pal, err);
+    if (bad != 0) {
+        fprintf(stderr, "qtcurve-gtk-writer: %s\n", err.toLocal8Bit().constData());
+        return bad;
+    }
+    const QString base = args.assetBase.isEmpty() ?
+        QStringLiteral("../assets/") : args.assetBase;
+    const QString text = args.rootOnly ?
+        QStringLiteral("@import \"gtk.css\";\n") + buildRoot(opts, pal, base) :
+        buildSheet(opts, pal, args.dialect, base);
+    if (emitError() != 0) {
+        return emitError();
+    }
+    if (!args.out.isEmpty()) {
+        return writeOwned(args.out, text.toUtf8());
+    }
+    QTextStream stream(stdout);
+    stream << text;
+    return 0;
+}
+
+/** Parses the command line into args, and returns false on a bad switch. */
+bool
+parse(const QStringList &argv, Args &args)
+{
+    for (int i = 1;i < argv.size();++i) {
+        const QString &arg = argv.at(i);
+        if (arg == QLatin1String("--write") ||
+            arg == QLatin1String("--remove-gtk") ||
+            arg == QLatin1String("--remove-qt") ||
+            arg == QLatin1String("--purge-settings") ||
+            arg == QLatin1String("--watch") ||
+            arg == QLatin1String("--stdout")) {
+            args.mode = arg;
+        } else if (arg == QLatin1String("--default")) {
+            args.useDefaults = true;
+        } else if (arg == QLatin1String("--force")) {
+            args.force = true;
+        } else if (arg == QLatin1String("--root")) {
+            args.rootOnly = true;
+        } else if (arg == QLatin1String("--settings") && i + 1 < argv.size()) {
+            args.settings = argv.at(++i);
+        } else if (arg == QLatin1String("--scheme") && i + 1 < argv.size()) {
+            args.scheme = argv.at(++i);
+        } else if (arg == QLatin1String("--asset-base") && i + 1 < argv.size()) {
+            args.assetBase = argv.at(++i);
+        } else if (arg == QLatin1String("--out") && i + 1 < argv.size()) {
+            args.out = argv.at(++i);
+        } else if (arg == QLatin1String("--dialect") && i + 1 < argv.size()) {
+            const QString value = argv.at(++i);
+            if (value == QLatin1String("gtk3")) {
+                args.dialect = Dialect::Gtk3;
+            } else if (value == QLatin1String("gtk4")) {
+                args.dialect = Dialect::Gtk4;
+            } else {
+                return false;
+            }
+        } else {
+            return false;
+        }
+    }
+    return true;
+}
+
+}
+
+int
+main(int argc, char **argv)
+{
+    QCoreApplication app(argc, argv);
+    QCoreApplication::setApplicationName(QStringLiteral("qtcurve-gtk-writer"));
+
+    Args args;
+    if (!parse(QCoreApplication::arguments(), args)) {
+        usage();
+        return 1;
+    }
+
+    if (args.mode == QLatin1String("--stdout")) {
+        return runStdout(args);
+    }
+    if (args.mode == QLatin1String("--remove-gtk")) {
+        return removeBoth();
+    }
+    if (args.mode == QLatin1String("--remove-qt")) {
+        removeSettings();
+        args.useDefaults = true;
+        return runWrite(args);
+    }
+    if (args.mode == QLatin1String("--purge-settings")) {
+        removeSettings();
+        return removeBoth();
+    }
+    if (args.mode == QLatin1String("--watch")) {
+        const int first = runWrite(args);
+        if (first > 1) {
+            return first;
+        }
+        QStringList paths;
+        paths << QString::fromLocal8Bit(getConfDir()) + QStringLiteral("stylerc");
+        for (Dialect dialect : { Dialect::Gtk4, Dialect::Gtk3 }) {
+            paths << userDir(dialect) + QStringLiteral("/settings.ini");
+            paths << userDir(dialect) + QStringLiteral("/gtk.css");
+        }
+        Watcher watcher([&args] { return runWrite(args); }, paths);
+        return QCoreApplication::exec();
+    }
+    return runWrite(args);
+}
