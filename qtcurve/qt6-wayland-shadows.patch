+//! the width of the clear band along the window edge, in pixels
+/*! qtcShadowCreate() holds the alpha at zero over this band, then starts the
+    gradient. The band hides the shadow behind the window. */
+const size_t shadowRadius = 4;
+
+//! the number of tiles that make one shadow
+const int numTiles = 8;
+
+//! the tiles that every shadow of this process shares
+/*! The pointer is null until the first shadow needs the tiles. */
+QVector<KWindowShadowTile::Ptr> *shadowTiles = nullptr;
+
+//! the gradient length of the tiles in shadowTiles, in pixels
+/*! The value is zero while the process holds no tiles. */
+int shadowTilesSize = 0;
+
+//! free the shared tiles
+/*! A tile holds resources of the platform plugin. Qt runs a post routine at
+    the start of the QApplication destructor, while the plugin is still
+    alive. A post routine therefore frees the tiles, and a static
+    destructor at process exit does not. */
+void
+freeShadowTiles()
+{
+    delete shadowTiles;
+    shadowTiles = nullptr;
+    shadowTilesSize = 0;
+}
+
+//! how far the shadow reaches outside the window, in pixels
+/*! \param size the length of the shadow gradient, in pixels.
+    \return one pixel less than the gradient. The first pixel of the
+    gradient then sits on the window edge. */
+int
+shadowPadding(int size)
+{
+    return size - 1;
+}
+
+//! make the eight tiles of the QtCurve shadow
+/*! \param size the length of the shadow gradient, in pixels. The call makes
+    new tiles when the size differs from the size of the tiles in hand.
+    \return the eight tiles in the order that KWin wants. The order is top,
+    top right, right, bottom right, bottom, bottom left, left and top left.
+    qtcShadowCreate() writes the tiles in that order. */
+const QVector<KWindowShadowTile::Ptr>&
+getShadowTiles(int size)
+{
+    if (shadowTiles && shadowTilesSize == size)
+        return *shadowTiles;
+    if (shadowTiles) {
+        shadowTiles->clear();
+    } else {
+        shadowTiles = new QVector<KWindowShadowTile::Ptr>;
+        qAddPostRoutine(freeShadowTiles);
+    }
+    shadowTilesSize = size;
+    // The colours match qtcX11ShadowInit(), so a Wayland client and an X11
+    // client get the same shadow.
+    QtcColor c1 = {0.4, 0.4, 0.4};
+    QtcColor c2 = {0.2, 0.2, 0.2};
+    Image *images[numTiles];
+    qtcShadowCreate(size_t(size), &c1, &c2, shadowRadius, false,
+                    QTC_PIXEL_QT, images);
+    shadowTiles->reserve(numTiles);
+    for (int i = 0;i < numTiles;i++) {
+        const Image *image = images[i];
+        // QTC_PIXEL_QT puts the four bytes of a pixel in the order that
+        // QImage::Format_ARGB32_Premultiplied reads. qtcFillShadowPixel()
+        // multiplies the colour by the alpha. QImage shares the buffer of
+        // the Image, so the tile takes a copy before the Image goes away.
+        QImage buffer((const uchar*)image->data.data(), int(image->width),
+                      int(image->height), qsizetype(image->width) * 4,
+                      QImage::Format_ARGB32_Premultiplied);
+        auto tile = KWindowShadowTile::Ptr::create();
+        tile->setImage(buffer.copy());
+        shadowTiles->append(tile);
+        delete images[i];
+    }
+    return *shadowTiles;
+}
+
+}
+
+ShadowHelper::~ShadowHelper()
+{
+    qDeleteAll(m_shadows);
+}
