+#ifdef QTC_QT6_ENABLE_KDE
+QMargins
+ShadowHelper::shadowMargins(QWidget *widget) const
+{
+    const int padding = shadowPadding(qtcX11ShadowSize());
+    int top = padding;
+    int bottom = padding;
+    if (widget->windowType() == Qt::ToolTip &&
+        widget->inherits("QBalloonTip")) {
+        // A balloon tip keeps an arrow in the top margin or in the bottom
+        // margin. Pull the shadow in on that side, so the shadow follows the
+        // body of the balloon and not the arrow.
+        bool atTop = true;
+        int margin = qtcGetBalloonMargin(widget, &atTop);
+        if (atTop) {
+            top -= margin;
+        } else {
+            bottom -= margin;
+        }
+    }
+    return QMargins(padding, top, padding, bottom);
+}
+
+void
+ShadowHelper::windowDeleted(QObject *object)
+{
+    // The window deletes the shadow, because the shadow is a child of the
+    // window. Drop the stale entry only.
+    m_shadows.remove(static_cast<QWindow*>(object));
+}
+
+bool
+ShadowHelper::installShadows(QWidget *widget)
+{
+    QTC_RET_IF_FAIL(widget, false);
+    // Only a window can carry a shadow.
+    if (!widget->isWindow())
+        return false;
+    // QWidget::create() sets the attribute and makes the QWindow before it
+    // sends the WinIdChange event. QWidget::destroy() sends the same event
+    // with no QWindow, so the checks below are necessary.
+    if (!widget->testAttribute(Qt::WA_WState_Created))
+        return false;
+    QWindow *window = widget->windowHandle();
+    QTC_RET_IF_FAIL(window, false);
+
+    // A size of zero makes a clear shadow. Take away the shadow of an
+    // earlier size, and give the compositor nothing.
+    const int size = qtcX11ShadowSize();
+    if (size < 1) {
+        delete m_shadows.take(window);
+        return false;
+    }
+
+    const QVector<KWindowShadowTile::Ptr> &tiles = getShadowTiles(size);
+    KWindowShadow *&shadow = m_shadows[window];
+    if (!shadow) {
+        shadow = new KWindowShadow(window);
+        connect(window, &QWindow::destroyed, this,
+                &ShadowHelper::windowDeleted);
+    }
+    // KWindowShadow refuses a new tile and a new padding while it holds
+    // resources of the platform. Destroy the shadow first.
+    if (shadow->isCreated())
+        shadow->destroy();
+    shadow->setTopTile(tiles[0]);
+    shadow->setTopRightTile(tiles[1]);
+    shadow->setRightTile(tiles[2]);
+    shadow->setBottomRightTile(tiles[3]);
+    shadow->setBottomTile(tiles[4]);
+    shadow->setBottomLeftTile(tiles[5]);
+    shadow->setLeftTile(tiles[6]);
+    shadow->setTopLeftTile(tiles[7]);
+    shadow->setPadding(shadowMargins(widget));
+    shadow->setWindow(window);
+    return shadow->create();
+}
+
+void
+ShadowHelper::uninstallShadows(QWidget *widget)
+{
+    delete m_shadows.take(widget->windowHandle());
+}
