# Maintainer: Guru <anjanaya@gmail.com>
pkgname=agent-browser
pkgver=0.45.0
pkgrel=1
pkgdesc="Headless browser automation CLI for AI agents"
arch=('x86_64')
url="https://github.com/vercel-labs/agent-browser"
license=('Apache-2.0')
depends=('glibc')
optdepends=(
  'chromium: browser to automate (or google-chrome)'
  'google-chrome: browser to automate (or chromium)'
)
options=('!strip' '!debug')
# Since 0.43.0 the main npm tarball only carries the launcher and skill data;
# the prebuilt CLI ships in per-platform packages. Use the x86_64 glibc one.
source=("https://registry.npmjs.org/${pkgname}/-/${pkgname}-${pkgver}.tgz"
        "${pkgname}-cli-linux-x64-gnu-${pkgver}.tgz::https://registry.npmjs.org/@${pkgname}/cli-linux-x64-gnu/-/cli-linux-x64-gnu-${pkgver}.tgz")
# both tarballs unpack to package/, so extract the native one separately
noextract=("${pkgname}-cli-linux-x64-gnu-${pkgver}.tgz")
sha256sums=('81dc341752891b7e47c0c58226a9ecfe563066c5e69fed1628f1e01bc9b789c1'
            '6f94b49e3393e41d4c7355dca461d0d650addbf3adcc1ddca8a9af335ebe04f6')

prepare() {
  mkdir -p cli-linux-x64-gnu
  bsdtar -xf "${pkgname}-cli-linux-x64-gnu-${pkgver}.tgz" -C cli-linux-x64-gnu --strip-components=1
}

package() {
  cd package

  local _libdir="/usr/lib/${pkgname}"
  install -Dm755 "../cli-linux-x64-gnu/bin/${pkgname}" "${pkgdir}${_libdir}/bin/${pkgname}-linux-x64"
  cp -r --no-preserve=ownership skill-data skills "${pkgdir}${_libdir}/"
  find "${pkgdir}${_libdir}" -type d -exec chmod 755 {} + \
    -o -type f ! -path "*/bin/*" -exec chmod 644 {} +

  # Same as upstream's global npm install: the command points straight at the
  # native binary, which finds skill-data relative to its resolved path.
  install -d "${pkgdir}/usr/bin"
  ln -s "${_libdir}/bin/${pkgname}-linux-x64" "${pkgdir}/usr/bin/${pkgname}"

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
