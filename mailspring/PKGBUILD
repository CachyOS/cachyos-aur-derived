# Contributor: Eric S. Londres <ericlondres@protonmail.com>
# Contributor: Mandeep Sangwan <mandeep@sangwan.me>
# Contributor: Joakim Nylén <me@jnylen.nu>
# Contributor: Rashintha Maduneth <rashinthamaduneth@gmail.com>
# Contributor: Dhananjay Balan <mail@dbalan.in>
# Contributor: ahrs

pkgname=mailspring
pkgver=1.26.2
pkgrel=2
pkgdesc="A beautiful, fast and maintained fork of Nylas Mail by one of the original authors."
arch=(x86_64)
license=(GPL-3.0-only)
url="https://github.com/Foundry376/Mailspring"
depends=(alsa-lib gtk3 nss glibc)
makedepends=(git npm nodejs-lts-jod python chrpath)
source=("git+https://github.com/Foundry376/Mailspring.git#tag=${pkgver}")
sha256sums=('f1e560d32e026eaa392ad0f6be49a8c3380c82844bcc6677ce7a60452a47e7e0')

prepare() {
  cd Mailspring
  npm install --no-audit --no-fund
}

build() {
  cd Mailspring
  # Skip the .deb/.rpm installers
  npm run-script build -- --skip-installers
}

package() {
  cd Mailspring
  install -d "${pkgdir}/opt/mailspring"
  cp -r app/dist/mailspring-linux-x64/* "${pkgdir}/opt/mailspring"

  install -d "${pkgdir}/usr/bin"
  ln -s /opt/mailspring/mailspring "${pkgdir}/usr/bin/mailspring"

  cd app/build/resources/linux

  local _subst=(
    -e 's/<%= productName %>/Mailspring/g'
    -e 's/<%= description %>/Email client/g'
    -e 's/<%= name %>/mailspring/g'
    -e 's/<%= desktopName %>/Mailspring.desktop/g'
  )
  install -d "${pkgdir}/usr/share/applications" "${pkgdir}/usr/share/metainfo"
  sed "${_subst[@]}" Mailspring.desktop.in > "${pkgdir}/usr/share/applications/Mailspring.desktop"
  sed "${_subst[@]}" mailspring.metainfo.xml.in > "${pkgdir}/usr/share/metainfo/mailspring.metainfo.xml"

  local _size
  for _size in 16 32 64 128 256 512; do
    install -Dm644 "icons/${_size}.png" "${pkgdir}/usr/share/icons/hicolor/${_size}x${_size}/apps/mailspring.png"
  done

  # Insecure RPATH '/opt/openssl/lib' in mailsync.bin
  chrpath --delete "${pkgdir}/opt/mailspring/resources/app.asar.unpacked/mailsync.bin"
}
