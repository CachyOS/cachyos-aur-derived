# Maintainer: Chris Down <chris@chrisdown.name>

pkgname=zcfan
pkgver=1.4.0
pkgrel=1
pkgdesc='Zero-configuration fan control for ThinkPad'
url="https://github.com/cdown/zcfan"
license=('MIT')
arch=('any')
depends=()
makedepends=()
source=("$pkgname-$pkgver.zip::https://github.com/cdown/zcfan/archive/${pkgver}.zip")
sha256sums=('e3bcac89d3c458d3df9772b060ee5f5e0ba6137162c99ca7f86dd5a5c8734d29')

build() {
    cd -- "${srcdir?}/$pkgname-$pkgver"
    make prefix="/usr"
}

package() {
    cd -- "${srcdir?}/$pkgname-$pkgver"
    make prefix="/usr" DESTDIR="$pkgdir/" install
}
