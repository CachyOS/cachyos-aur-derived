     if (props & SCALE) {
         scaleWidth->setRange(MIN_SIZE, MAX_SIZE);
         scaleHeight->setRange(MIN_SIZE, MAX_SIZE);
+        connect(scaleImage, &QCheckBox::toggled,
+                scaleControls, &QWidget::setEnabled);
     }
 
     if (props & POS) {
@@ -111,6 +113,7 @@ CImagePropertiesDialog::set(const QString &file, int width, int height,
 {
     if (properties & SCALE) {
         scaleImage->setChecked(width || height);
