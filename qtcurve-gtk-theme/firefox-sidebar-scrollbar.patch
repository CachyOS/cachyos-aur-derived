+/**
+ * Returns the scroll bar rule of the sidebars of the browser. The rule takes
+ * !important, because a user rule of no !important loses to the author rule
+ * of the browser that greys those sidebars.
+ */
+QString
+sidebarScrollBar(const Options &opts, const Palette &pal)
+{
+    return QStringLiteral("\n:root[lwt-sidebar] {\n"
+                          "  scrollbar-color: %1 %2 !important;\n"
+                          "}\n")
+        .arg(Gtk::hex(ffColour(opts, pal, FfRole::ScrollThumb)),
+             Gtk::hex(ffColour(opts, pal, FfRole::ScrollTrack)));
+}
+
 }
 
