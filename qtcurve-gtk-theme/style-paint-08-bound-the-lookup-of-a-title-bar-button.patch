+// A configuration file can hold fewer colours than the title bar buttons need.
+// The lookup gives a null pointer for an absent entry, and the caller then
+// takes the colour of a configuration with no user colours.
+const QColor * Style::titlebarButtonColor(int entry) const
+{
+    TBCols::const_iterator col(opts.titlebarButtonColors.find(entry));
+
+    return col==opts.titlebarButtonColors.end() ? nullptr : &col->second;
+}
+
