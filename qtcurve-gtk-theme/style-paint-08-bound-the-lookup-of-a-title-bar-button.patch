                     opts->titlebarButtons &= ~TITLEBAR_BUTTON_ICON_COLOR;
+                } else {
+                    // A file of an older QtCurve holds one block of icon
+                    // colours for the two window states. The icons of an
+                    // inactive window take that block as well.
+                    for (int i = cols.count();
+                         i < (NUM_TITLEBAR_BUTTONS * 3); ++i) {
+                        opts->titlebarButtonColors[i] =
+                            opts->titlebarButtonColors[i - NUM_TITLEBAR_BUTTONS];
+                    }
                 }
             } else {
                 opts->titlebarButtons &= ~TITLEBAR_BUTTON_COLOR;
