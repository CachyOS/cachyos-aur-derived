+static void removeInstalledThemeFile(const QString &file)
+{
+    QDir dir(QtCurve::getConfDir());
+    QString name(QLatin1String(THEME_IMAGE_PREFIX)+file);
+    // The installer appends the extension of the source, or no extension.
+    const QStringList installed(dir.entryList({name, name+QLatin1String(".*")},
+                                              QDir::Files));
+
+    for (const QString &f : installed)
+        removeFile(dir.filePath(f));
+}
