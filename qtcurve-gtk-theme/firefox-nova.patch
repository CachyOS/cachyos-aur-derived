+
+/**
+ * Returns the rules of the find field, the search field of a sidebar and the
+ * address bar under the pointer. A field with no focus takes the mouse over
+ * frame, and the result is empty where the Qt style keeps the frame of a
+ * field.
+ */
+QString
+hoveredFields(const Options &opts, const FfPalette &pal)
+{
+    if (!ffFieldsMouseOver(opts)) {
+        return QString();
+    }
+    // Firefox 159 reads the first name of the sidebar rule, and Firefox 157
+    // and 158 read the second one.
+    return QStringLiteral("\n.findbar-textbox:not(:focus):hover {\n"
+                          "  border-color: %1 !important;\n"
+                          "}\n"
+                          "\n#search-box:not(:focus-within):hover {\n"
