+    int count = 0;
+    const FfBlock *const blocks = ffBlocks(count);
+    for (int block = 0;block < count;++block) {
+        out += QStringLiteral("\n%1 {\n")
+            .arg(QLatin1String(blocks[block].selector));
+        const FfRow *const rows = blocks[block].rows;
+        for (int row = 0;row < blocks[block].rowCount;++row) {
+            const QColor col = ffColour(opts, pal, rows[row].role);
+            for (int i = 0;i < rows[row].varCount;++i) {
+                out += QStringLiteral("  %1: %2 !important;\n")
+                    .arg(QLatin1String(rows[row].vars[i]), Gtk::hex(col));
+            }
+        }
+        out += QStringLiteral("}\n");
+    }
+    return out;
+}
