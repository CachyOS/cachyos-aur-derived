+                note "the hovered tree row of $c_sheet reads '$c_have'," \
+                     "and not $c_value, the highlight at $hover_alpha over" \
+                     "the sidebar ground"
+            else
+                note "tree rule $c_at of $c_sheet reads '$c_have', and not" \
+                     "$c_value"
+            fi
