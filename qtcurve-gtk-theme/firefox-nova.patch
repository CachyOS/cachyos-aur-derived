+
+/**
+ * The count of the luma steps of the link search. Each step moves 0.01 of
+ * luma, so the last step reaches black or white.
+ */
+const int linkSteps = 100;
+
+/**
+ * The luma move of the hover state of a link away from the ground, from 0.0 to
+ * 1.0. It is half of linkActiveStep, so the hover state stands between the
+ * rest state and the active state.
+ */
+const double linkHoverStep = 0.03;
+
+/**
+ * The luma move of the active state of a link away from the ground, from 0.0 to
+ * 1.0. The figure is near the luma move of the active accent of the chrome,
+ * which takes the step highlightActiveShade of the highlight ladder.
+ */
+const double linkActiveStep = 0.06;
+
+/** The ground of the light content half: the page canvas of the browser. */
+const QColor lightGround(0xf7, 0xf6, 0xfb);
+
+/** The ground of the dark content half: the box of the browser. */
+const QColor darkGround(0x25, 0x24, 0x28);
+
+/** The box of the light content half: the white card of the browser. */
+const QColor lightBox(0xff, 0xff, 0xff);
+
+/** The canvas of the dark content half: the page ground of the browser. */
+const QColor darkCanvas(0x13, 0x12, 0x15);
+
+/**
+ * The information box of the light content half, the Nova grey 15 of the
+ * browser. The box carries links, so a link of that half must read on it.
+ */
+const QColor lightInfo(0xe3, 0xe2, 0xe7);
+
+/**
+ * The information box of the dark content half, the Nova grey 65 of the
+ * browser. The box carries links, so a link of that half must read on it.
+ */
+const QColor darkInfo(0x31, 0x2f, 0x33);
+
+/**
+ * The step of the popup menu ladder under a hovered menu item. The Qt style
+ * fills that step while the settings take no highlight for menus.
+ */
+const int menuHoverShade = 4;
+
+/**
+ * The step of the window ladder that carries a progress groove under the dark
+ * groove colour. The Qt style fills the groove from this step.
+ */
+const int progressGrooveShade = 2;
+
+/**
+ * The factor of QColor::lighter() for the ground of a selected row under the
+ * pointer, in percent. The Qt style paints that row with this factor.
+ */
+const int selectedHoverFactor = 110;
+
+/**
+ * The share of currentColor of the deemphasized text of the browser, in
+ * percent. The share of a content half never goes under it.
+ */
+const int deemphasizedFloor = 69;
+
+/**
+ * The share of currentColor of the placeholder text of a field in the
+ * browser, in percent (forms.css of omni.ja). The share of a content half
+ * never goes under it.
+ */
+const int placeholderFloor = 54;
+
+/**
+ * The alpha of the highlight over the ground of a hovered view row, from 0.0
+ * to 1.0, as the Qt style paints that row.
+ */
+const double viewHoverAlpha = 0.20;
+
+/**
+ * Returns col at the alpha alpha over the opaque ground, in the eight bit form
+ * of the renderer. The file palette.cpp holds the same form for the inactive
+ * selection.
+ */
+QColor
+over(const QColor &col, double alpha, const QColor &ground)
+{
+    const auto div255 = [](int x) {
+        const int t = x + 0x80;
+        return (t + (t >> 8)) >> 8;
+    };
+    const int a8 = int(alpha * 65535.0 + 0.5) >> 8;
+    const auto chan = [&](int c, int g) {
+        return (int(c * alpha * 65535.0 / 255.0 + 0.5) >> 8) +
+            div255(g * (255 - a8));
+    };
+    return QColor(chan(col.red(), ground.red()),
+                  chan(col.green(), ground.green()),
+                  chan(col.blue(), ground.blue()));
+}
+
+/**
+ * Returns the WCAG 2 relative luminance of the eight bit channels of col, from
+ * 0.0 to 1.0.
+ */
+double
+luminance(const QColor &col)
+{
+    const auto linear = [](int channel) {
+        const double c = channel / 255.0;
+        return c <= 0.04045 ? c / 12.92 : std::pow((c + 0.055) / 1.055, 2.4);
+    };
+    return 0.2126 * linear(col.red()) + 0.7152 * linear(col.green()) +
+        0.0722 * linear(col.blue());
+}
+
+/** Returns the WCAG 2 contrast ratio of a and b, from 1.0 to 21.0. */
+double
+contrast(const QColor &a, const QColor &b)
+{
+    const double one = luminance(a);
+    const double two = luminance(b);
+    return one < two ? (two + 0.05) / (one + 0.05) :
+        (one + 0.05) / (two + 0.05);
+}
+
+/**
+ * Returns the luma move to the first HCY shade of highlight that reads at the
+ * floor plus the margin on ground, in steps of 0.01. The direction -1 moves
+ * toward black and 1 toward white, and a highlight that reads there gives 0.0.
+ */
+double
+linkMove(const QColor &highlight, const QColor &ground, int direction)
+{
+    const double target = linkRatioFloor + linkRatioMargin;
+    if (contrast(highlight, ground) >= target) {
+        return 0.0;
+    }
+    for (int n = 1;n <= linkSteps;++n) {
+        const double move = direction * n / (double)linkSteps;
+        if (contrast(qtcColorShade(&highlight, move, 0.0), ground) >= target) {
+            return move;
+        }
+    }
+    return direction * 1.0;
+}
+
+/**
+ * Returns the direction of the link search on ground: 1 toward white when
+ * white reads at or over black there, and else -1 toward black. The end of
+ * the search then reads over the target on every ground.
+ */
+int
+linkDirection(const QColor &ground)
+{
+    const QColor white(0xff, 0xff, 0xff);
+    const QColor black(0, 0, 0);
+    return contrast(white, ground) >= contrast(black, ground) ? 1 : -1;
+}
+
+/**
+ * Returns the link colour on ground: the highlight moved by linkMove() in
+ * the direction direction and by stateStep further. A whole move of 0.0
+ * gives pal.highlight.
+ */
+QColor
+linkOn(const Palette &pal, const QColor &ground, int direction,
+       double stateStep)
+{
+    const double move = linkMove(pal.highlight, ground, direction) +
+        direction * stateStep;
+    if (move == 0.0) {
+        return pal.highlight;
+    }
+    return qtcColorShade(&pal.highlight, move, 0.0);
+}
+
+/**
+ * Returns the link colour of one content half: the highlight moved by
+ * linkMove() on the ground of that half and by stateStep further from it.
+ * That ground is the one of the canvas, the box, the information box and the
+ * view hover of the half where the highlight reads lowest.
+ *
+ * \param darkHalf  true for the dark content half, false for the light one.
+ */
+QColor
+linkColour(const Palette &pal, bool darkHalf, double stateStep)
+{
+    const int direction = darkHalf ? 1 : -1;
+    const QColor &box = darkHalf ? darkGround : lightBox;
+    const QColor grounds[] = {
+        darkHalf ? darkCanvas : lightGround, box,
+        darkHalf ? darkInfo : lightInfo,
+        over(pal.highlight, viewHoverAlpha,
+             darkHalf == pal.dark ? pal.base : box)
+    };
+    const QColor *ground = &grounds[0];
+    for (const QColor &candidate : grounds) {
+        if (contrast(pal.highlight, candidate) <
+            contrast(pal.highlight, *ground)) {
+            ground = &candidate;
+        }
+    }
+    return linkOn(pal, *ground, direction, stateStep);
+}
+
+/**
+ * Returns one link state of the chrome on the menu ground: pal.link when it
+ * reads at the target there, else the highlight moved by linkOn(). A state
+ * moves stateStep of luma toward the end that reads higher on that ground.
+ */
+QColor
+chromeLink(const Palette &pal, double stateStep)
+{
+    const QColor &ground = pal.menu[ORIGINAL_SHADE];
+    const int direction = linkDirection(ground);
+    if (contrast(pal.link, ground) < linkRatioFloor + linkRatioMargin) {
+        return linkOn(pal, ground, direction, stateStep);
+    }
+    if (stateStep == 0.0) {
+        return pal.link;
+    }
+    return qtcColorShade(&pal.link, direction * stateStep, 0.0);
+}
+
+/** Returns the canvas of a content half: the page ground of the browser. */
+const QColor &
+canvasOf(bool darkHalf)
+{
+    return darkHalf ? darkCanvas : lightGround;
+}
+
+/** Returns the box of a content half: the card ground of the browser. */
+const QColor &
+boxOf(bool darkHalf)
+{
+    return darkHalf ? darkGround : lightBox;
+}
+
+/**
+ * Returns the colour of a ground role in the content half that does not match
+ * the polarity of pal. The role takes its rule on the canvas or the box of
+ * that half, and a hover role takes the view hover over the box.
+ */
+QColor
+otherGround(const Options &opts, const Palette &pal, FfRole role,
+            bool darkHalf)
+{
+    const QColor &box = boxOf(darkHalf);
+    switch (role) {
+    case FfRole::Window:
+        return canvasOf(darkHalf);
+    case FfRole::Base:
+    case FfRole::AlternateBase:
+    case FfRole::Button:
+        return box;
+    case FfRole::ButtonHover:
+    case FfRole::ViewHover:
+        return over(pal.highlight, viewHoverAlpha, box);
+    case FfRole::ProgressGroove:
+        if (opts.progressGrooveColor == ECOLOR_BACKGROUND) {
+            return canvasOf(darkHalf);
+        }
+        if (opts.progressGrooveColor == ECOLOR_BASE) {
+            return box;
+        }
+        break;
+    default:
+        break;
+    }
+    Gtk::Shades ladder;
+    Gtk::shadeLadder(opts, box, ladder);
+    switch (role) {
+    case FfRole::ButtonActive:
+        return ladder[activeShade];
+    case FfRole::ButtonOpen:
+        return ladder[openShade];
+    case FfRole::WindowBorder:
+    case FfRole::ButtonBorder:
+        return ladder[QTC_STD_BORDER];
+    case FfRole::ProgressGroove:
+        return ladder[progressGrooveShade];
+    case FfRole::MenuHover:
+        return opts.useHighlightForMenu ? pal.highlight :
+            ladder[menuHoverShade];
+    default:
+        break;
+    }
+    Gtk::failUnknown("FfRole", (int)role);
+    return QColor();
+}
+
+/** The count of the grounds of a content half that a text reads on. */
+const int halfGroundCount = 9;
+
+/**
+ * Fills grounds with the grounds of one content half that a text of that half
+ * paints on. They are the canvas, the box and the colours of the ground roles
+ * in that half.
+ */
+void
+halfGrounds(const Options &opts, const FfPalette &pal, bool darkHalf,
+            QColor (&grounds)[halfGroundCount])
+{
+    const FfRole roles[] = { FfRole::Window, FfRole::Base, FfRole::Button,
+                             FfRole::ButtonHover, FfRole::ButtonActive,
+                             FfRole::ViewHover, FfRole::MenuHover };
+    grounds[0] = canvasOf(darkHalf);
+    grounds[1] = boxOf(darkHalf);
+    for (int i = 0;i < (int)(sizeof(roles) / sizeof(*roles));++i) {
+        grounds[i + 2] = ffHalfColour(opts, pal, roles[i], darkHalf);
+    }
+}
+
+/**
+ * Returns the first HCY shade of a text role that reads at the target on each
+ * ground of the half that does not match pal. On the canvas the shade also
+ * keeps the ratio of the role on its own ground of the scheme.
  */
-const int activeShade = 2;
+QColor
+otherText(const Options &opts, const FfPalette &pal, FfRole role,
+          bool darkHalf)
+{
+    const QColor col = ffColour(opts, pal, role);
+    const QColor &system = role == FfRole::WindowText ? pal.window :
+        role == FfRole::Text ? pal.base : pal.button;
+    const double target = linkRatioFloor + linkRatioMargin;
+    const double canvasTarget = std::max(contrast(col, system), target);
+    QColor grounds[halfGroundCount];
+    halfGrounds(opts, pal, darkHalf, grounds);
+    const auto reads = [&](const QColor &c) {
+        for (const QColor &ground : grounds) {
+            if (contrast(c, ground) < target) {
+                return false;
+            }
+        }
+        return contrast(c, canvasOf(darkHalf)) >= canvasTarget;
+    };
+    if (reads(col)) {
+        return col;
+    }
+    const int direction = darkHalf ? 1 : -1;
+    QColor shade = col;
+    for (int n = 1;n <= linkSteps;++n) {
+        shade = qtcColorShade(&col, direction * n / (double)linkSteps, 0.0);
+        if (reads(shade)) {
+            return shade;
+        }
+    }
+    return shade;
+}
+
+/**
+ * Returns col at the share share, from 0.0 to 1.0, over the opaque ground,
+ * as the browser paints color-mix() of col and transparent there. Each
+ * channel rounds to the nearest eight bit value.
+ */
+QColor
+mixOver(const QColor &col, double share, const QColor &ground)
+{
+    const auto chan = [share](int c, int g) {
+        return int(std::floor(share * c + (1.0 - share) * g + 0.5));
+    };
+    return QColor(chan(col.red(), ground.red()),
+                  chan(col.green(), ground.green()),
+                  chan(col.blue(), ground.blue()));
+}
 
