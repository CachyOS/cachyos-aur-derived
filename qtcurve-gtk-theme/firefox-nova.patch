+                          "  --input-text-border: 1px solid %1 !important;\n"
+                          "}\n"
+                          "\n#urlbar:not([focused], [open]):hover >"
+                          " .urlbar-background {\n"
+                          "  border-color: %1 !important;\n"
+                          "}\n")
+        .arg(Gtk::hex(pal.mouseOver[QTC_STD_BORDER]));
+}
+
+/**
+ * The share of the highlight in the outline of the private browsing button,
+ * in percent: the share that the browser gives its violet there.
+ */
+const int privateOutlineShare = 15;
+
+/**
+ * Returns the two rules of the private browsing button of the tab strip, where
+ * the browser fixes a violet. The outline takes a mix of the highlight, and
