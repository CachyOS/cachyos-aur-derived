diff --git a/firefox/check/assert-ff-promo.sh b/firefox/check/assert-ff-promo.sh
new file mode 100644
index 00000000..301bacb1
--- /dev/null
+++ b/firefox/check/assert-ff-promo.sh
@@ -0,0 +1,211 @@
+#!/bin/sh
+# assert-ff-promo.sh SHEET: the rule of the promo box of the app menu in SHEET
+# must hold the four contracts of check() below. The run then doctors seven
+# copies of SHEET, and it fails if the check passes a copy.
+set -eu
+usage='usage: assert-ff-promo.sh SHEET'
+sheet=${1:?$usage}
+
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+
+# The head of the rule, which matches the promo host of the app menu alone.
+rule_head='#appMenu-nova-switch-device-promo {'
+# The names of the body of the rule, in the order of the writer.
+names='--promo-background-color --promo-border-color
+--promo-message-text-color --link-color --link-color-hover
+--link-color-active'
+# The root name of the chrome row of each promo name, one pair NAME=ROOT for
+# each promo name.
+roots='--promo-background-color=--panel-background-color
+--promo-border-color=--color-accent-primary
+--promo-message-text-color=--panel-text-color'
+# The link names of the body, which read against the ground of the rule.
+links='--link-color --link-color-hover --link-color-active'
+# The WCAG 2 floor of a link on the ground of the rule (AA, normal text).
+floor=4.5
+# The ground of the second promo rule of one control below.
+planted='#141618'
+
+# note WORD...: prints one fault of the check that runs now, on one line.
+note() {
+    echo "assert-ff-promo: $*" >&2
+}
+
+# body FILE: prints the lines of each promo rule of FILE, with no head line
+# and no brace line. A rule ends at the first closing brace at column 0.
+body() {
+    sed -n "/^$rule_head\$/,/^}\$/p" "$1" | sed '/^#appMenu-/d;/^}$/d'
+}
+
+# decl FILE NAME: prints the value of the custom property NAME in FILE.
+decl() {
+    sed -n "s/^  $2: \\(.*\\) !important;\$/\\1/p" "$1"
+}
+
+# rootvalue FILE NAME: prints the first value of the custom property NAME
+# over all the root rules of the chrome sheet FILE.
+rootvalue() {
+    sed -n '/^:root {$/,/^}$/p' "$1" |
+        sed -n "s/^  $2: \\(.*\\) !important;\$/\\1/p" | head -n 1
+}
+
+# lum HEX: prints the WCAG 2 relative luminance of the colour #rrggbb HEX.
+lum() {
+    l_hex=${1#\#}
+    awk -v r="$(printf '%d' "0x$(echo "$l_hex" | cut -c1-2)")" \
+        -v g="$(printf '%d' "0x$(echo "$l_hex" | cut -c3-4)")" \
+        -v b="$(printf '%d' "0x$(echo "$l_hex" | cut -c5-6)")" '
+function lin(c) { c = c / 255
+    return c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ^ 2.4 }
+BEGIN { printf "%.9f\n", 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b) }'
+}
+
+# ratio HEX HEX: prints the WCAG 2 contrast ratio of the two colours, from
+# 1.0 to 21.0.
+ratio() {
+    awk -v a="$(lum "$1")" -v b="$(lum "$2")" 'BEGIN {
+        if (a < b) { t = a; a = b; b = t }
+        printf "%.9f\n", (a + 0.05) / (b + 0.05) }'
+}
+
+# under FG BG: gives 0 when the ratio of FG on BG is under the floor.
+under() {
+    awk -v r="$(ratio "$1" "$2")" -v f="$floor" 'BEGIN { exit !(r < f) }'
+}
+
+# check SHEET: gives 0 while the four contracts hold. It names the first
+# contract that fails on the standard error.
+check() {
+    c_sheet=$1
+
+    # 1. The sheet holds one promo rule, whose head stands at column 0.
+    c_heads=$(grep -c "^$rule_head\$" "$c_sheet" || true)
+    if [ "$c_heads" -ne 1 ]; then
+        note "$c_sheet holds $c_heads promo rules, and not 1"
+        return 1
+    fi
+    body "$c_sheet" > "$tmp/body"
+
+    # 2. The body holds one line per name in the order of the writer, each
+    # with one hex colour under !important, and no other line.
+    c_at=0
+    for c_name in $names; do
+        c_at=$((c_at + 1))
+        c_line=$(sed -n "${c_at}p" "$tmp/body")
+        if ! printf '%s\n' "$c_line" |
+            grep -q "^  $c_name: #[0-9a-f]\\{6\\} !important;\$"
+        then
+            note "line $c_at of the promo rule of $c_sheet reads" \
+                 "'$c_line', and not $c_name with one hex colour"
+            return 1
+        fi
+    done
+    c_lines=$(wc -l < "$tmp/body")
+    if [ "$c_lines" -ne "$c_at" ]; then
+        note "the promo rule of $c_sheet holds $c_lines lines, and not $c_at"
+        return 1
+    fi
+
+    # 3. Each promo name holds the first root value of its chrome row in the
+    # same sheet.
+    for c_row in $roots; do
+        c_name=${c_row%%=*}
+        c_root=${c_row#*=}
+        c_have=$(decl "$tmp/body" "$c_name")
+        c_want=$(rootvalue "$c_sheet" "$c_root")
+        if [ -z "$c_want" ] || [ "$c_have" != "$c_want" ]; then
+            note "$c_name of $c_sheet holds $c_have over the root value" \
+                 "$c_want of $c_root"
+            return 1
+        fi
+    done
+
+    # 4. Each link name reads at the floor or over it on the ground of the
+    # rule.
+    c_ground=$(decl "$tmp/body" --promo-background-color)
+    for c_name in $links; do
+        c_link=$(decl "$tmp/body" "$c_name")
+        if under "$c_link" "$c_ground"; then
+            note "$c_name of $c_sheet is $c_link on $c_ground at" \
+                 "$(ratio "$c_link" "$c_ground" |
+                    awk '{ printf "%.2f", $1 }'), under $floor"
+            return 1
+        fi
+    done
+    return 0
+}
+
+if ! check "$sheet"; then
+    note "the sheet fails the check"
+    exit 1
+fi
+count=$c_at
+ground=$c_ground
+
+# The controls below. Each one doctors a copy of the sheet, and the check must
+# fail over that copy.
+broken=0
+
+# control NAME COPY: the check must fail over the copy that the caller gives.
+control() {
+    k_name=$1
+    if check "$2" 2> "$tmp/control.log"; then
+        note "the check passed the control copy of $k_name"
+        exit 1
+    fi
+    broken=$((broken + 1))
+}
+
+# The rule cut out, which is the sheet of a writer with no promo rule.
+sed "/^$rule_head\$/,/^}\$/d" "$sheet" > "$tmp/cut.css"
+control 'the rule cut out' "$tmp/cut.css"
+
+# The body indented by two more spaces, the nested layout of the rule.
+sed "/^$rule_head\$/,/^}\$/s/^  --/    --/" "$sheet" > "$tmp/nested.css"
+control 'the nested layout' "$tmp/nested.css"
+
+# The border at the hover accent of the root, a value apart from the
+# highlight.
+hover=$(rootvalue "$sheet" --color-accent-primary-hover)
+high=$(rootvalue "$sheet" --color-accent-primary)
+if [ -z "$hover" ] || [ "$hover" = "$high" ]; then
+    note "$sheet gives the hover accent '$hover', and not a value apart" \
+         "from the highlight $high"
+    exit 1
+fi
+sed "s/^  --promo-border-color: .* !important;\$/"\
+"  --promo-border-color: $hover !important;/" "$sheet" > "$tmp/hover.css"
+control 'the border at the hover accent' "$tmp/hover.css"
+
+# The link at rest in the colour of the ground, which reads 1.0.
+sed "s/^  --link-color: .* !important;\$/"\
+"  --link-color: $ground !important;/" "$sheet" > "$tmp/ground.css"
+control 'the link in the colour of the ground' "$tmp/ground.css"
+
+# The active link name cut out.
+sed '/^  --link-color-active:/d' "$sheet" > "$tmp/active.css"
+control 'the active link cut out' "$tmp/active.css"
+
+# The border line and the text line in the other order.
+sed '/^  --promo-border-color:/{
+h
+d
+}
+/^  --promo-message-text-color:/G' "$sheet" > "$tmp/order.css"
+control 'the border and the text in the other order' "$tmp/order.css"
+
+# A second promo rule at the end of the sheet.
+{
+    cat "$sheet"
+    echo
+    echo "$rule_head"
+    printf '  --promo-background-color: %s !important;\n' "$planted"
+    echo '}'
+} > "$tmp/twice.css"
+control 'a second promo rule' "$tmp/twice.css"
+
+echo "assert-ff-promo: $sheet holds one promo rule of $count names, each" \
+     "promo name holds the root value of its row, each link name reads at" \
+     "$floor or more on the ground $ground, and the check rejects each of" \
+     "the $broken control copies"
