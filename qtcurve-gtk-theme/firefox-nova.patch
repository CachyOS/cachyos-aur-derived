diff --git a/firefox/check/assert-ff-blocks.sh b/firefox/check/assert-ff-blocks.sh
new file mode 100644
index 00000000..c677b187
--- /dev/null
+++ b/firefox/check/assert-ff-blocks.sh
@@ -0,0 +1,796 @@
+#!/bin/sh
+# assert-ff-blocks.sh SHEET: the chrome sheet SHEET must hold the fifteen
+# contracts of check() below. The run then doctors forty-one copies of
+# SHEET, and it fails if the check passes a copy.
+set -eu
+usage='usage: assert-ff-blocks.sh SHEET'
+sheet=${1:?$usage}
+
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+
+# The scoped blocks in the order of the writer. The name of a block is the
+# prefix of its rows in the map.
+blocks='ring bar tabbutton account trust tabgroup private switch droplist'
+# The head of each block holds its selector lines, and the rows hold one pair
+# NAME=ROOT for each body line, in order. ROOT is a root name of the chrome row
+# of NAME.
+head_ring='sidebar-tab-row[current] {'
+rows_ring='--tab-border-color-selected-leading=--color-accent-primary
+--tab-border-color-selected-trailing=--color-accent-primary'
+head_bar='notification-message {'
+rows_bar='--info-bar-text-color=--toolbar-text-color
+--message-bar-icon-color=--color-accent-primary
+--info-bar-border-color=--color-accent-primary'
+head_tabbutton='.tab-close-button,
+#tabs-newtab-button {'
+rows_tabbutton=\
+'--button-background-color-ghost-hover=--toolbarbutton-background-color-hover
+--button-background-color-ghost-active=--toolbarbutton-background-color-active'
+head_account='#appMenu-fxa-sign-in-promo,
+#PanelUI-fxa-menu-sign-in-promo,
+moz-promo[type="vibrant"] {'
+rows_account='--promo-background-color-vibrant=--panel-background-color
+--promo-message-text-color-vibrant=--panel-text-color'
+head_trust='#trustpanel-popup {'
+rows_trust='--trustpanel-highlight-bg=--panel-background-color'
+head_tabgroup='.tab-group-editor-panel {'
+rows_tabgroup='--input-text-background-color=--toolbar-field-background-color
+--input-background-color=--toolbar-field-background-color
+--input-text-color=--toolbar-field-text-color'
+head_private='.private-browsing-info-description > a {'
+rows_private='--link-color=--link-color'
+# The switch rule and the rule of the drop down lists hold the frame of a
+# button. Its rows hold the root name none, and contract 15 reads that frame.
+# Under the pointer the frame holds the root hover name.
+head_switch='moz-toggle {'
+rows_switch='--toggle-dot-background-color=--button-text-color
+--toggle-dot-background-color-hover=--button-text-color
+--toggle-dot-background-color-active=--button-text-color
+--toggle-dot-background-color-on-pressed=--button-text-color-primary
+--toggle-border-color=none
+--toggle-border-color-active=none
+--toggle-border-color-hover=--border-color-interactive-hover'
+head_droplist='menulist {'
+rows_droplist='--select-background-color=--button-background-color-muted
+--select-border-color=none
+--select-border-color-hover=--border-color-interactive-hover'
+# The head of the rule of the bar button. The one line of the rule holds the
+# border of the button.
+head_button='.notification-button {'
+# The head of the rule of the progress line of a download. The first line of
+# the rule holds the canvas name at one hex colour. The second line holds a
+# frame: a shadow of one pixel at the root border of a text field.
+head_progress='.downloadProgress {'
+# The head of the rule of a selected result row of the address bar under the
+# pointer. The one line of the rule holds the ground of that row.
+head_result='.urlbarView-row[selected]:hover > .urlbarView-row-inner {'
+# The heads of the rules of the find field, of the search field of a sidebar
+# and of the address bar under the pointer. Each line of a rule holds the
+# root hover name, and the sidebar rule holds two border names.
+head_findfield='.findbar-textbox:not(:focus):hover {'
+head_sidefield='#search-box:not(:focus-within):hover {'
+head_urlfield='#urlbar:not([focused], [open]):hover > .urlbar-background {'
+# The heads of the two rules of the private browsing button. The share of the
+# highlight in its outline follows, in percent, then the two violets of the
+# browser.
+head_private_outline='.private-browsing-indicator-button {'
+head_private_icon='.private-browsing-indicator-button > .toolbarbutton-icon {'
+outline_share=15
+violet_outline='#75669f'
+violet_fill='#7338e2'
+# The heads of the three rules of a switch that is on, one on each line: at
+# rest, under the pointer and pressed. The names follow in the same order.
+# Each rule holds the border colour at the border name of a switch that is
+# off in that state.
+switchon='.toggle-button[aria-pressed="true"]'
+switchon_heads="$switchon {
+$switchon:enabled:hover {
+$switchon:enabled:hover:active {"
+switchon_names='--toggle-border-color
+--toggle-border-color-hover
+--toggle-border-color-active'
+# The one line of the separator token block, between a root head and a
+# closing brace.
+sep_line='  --tabs-navbar-separator-style: none !important;'
+# The selector of a row of the places tree of the sidebar.
+tree='.sidebar-placesTreechildren::-moz-tree-row'
+# The heads of the five tree rules, one on each line. The first rule holds the
+# hovered row, and the four guard rules hold a selected row under the pointer.
+tree_heads="$tree(hover) {
+$tree(hover, selected) {
+$tree(hover, selected, focus) {
+.sidebar-panel[lwt-sidebar] $tree(hover, selected) {
+.sidebar-panel[lwt-sidebar-highlight] $tree(hover, selected, focus) {"
+# The value of each tree rule in the order of the heads, with HOVER in place of
+# the value of the hovered row. The four guard values are the browser values of
+# a selected row under the pointer.
+tree_values='HOVER
+-moz-cellhighlight
+SelectedItem
+light-dark(hsla(0, 0%, 80%, 0.3), rgba(249, 249, 250, 0.1))
+var(--lwt-sidebar-highlight-background-color)'
+# The alpha of the highlight over the sidebar ground in the hovered row, from
+# 0.0 to 1.0.
+hover_alpha=0.20
+# The root link names.
+links='--link-color --link-color-hover --link-color-active'
+# The WCAG 2 floor of a root link name on the panel colour (AA, normal text).
+floor=4.5
+# The ground of the second trust rule of one control below.
+planted='#141618'
+
+# note WORD...: prints one fault of the check that runs now, on one line.
+note() {
+    echo "assert-ff-blocks: $*" >&2
+}
+
+# esc TEXT: prints TEXT as a basic regular expression that matches TEXT alone.
+esc() {
+    printf '%s\n' "$1" | sed 's/[][\.*^$/]/\\&/g'
+}
+
+# body FILE HEAD: prints the lines of one rule of FILE, with no head line and
+# no brace line. The rule runs from the last line of HEAD to the first closing
+# brace at column 0.
+body() {
+    b_last=$(printf '%s\n' "$2" | tail -n 1)
+    sed -n "/^$(esc "$b_last")\$/,/^}\$/p" "$1" | sed '1d;/^}$/d'
+}
+
+# decl FILE NAME: prints the value of the custom property NAME in FILE.
+decl() {
+    sed -n "s/^  $2: \\(.*\\) !important;\$/\\1/p" "$1"
+}
+
+# rootvalue FILE NAME: prints the first value of the custom property NAME
+# over all the root rules of the chrome sheet FILE.
+rootvalue() {
+    sed -n '/^:root {$/,/^}$/p' "$1" |
+        sed -n "s/^  $2: \\(.*\\) !important;\$/\\1/p" | head -n 1
+}
+
+# lum HEX: prints the WCAG 2 relative luminance of the colour #rrggbb HEX.
+lum() {
+    l_hex=${1#\#}
+    awk -v r="$(printf '%d' "0x$(echo "$l_hex" | cut -c1-2)")" \
+        -v g="$(printf '%d' "0x$(echo "$l_hex" | cut -c3-4)")" \
+        -v b="$(printf '%d' "0x$(echo "$l_hex" | cut -c5-6)")" '
+function lin(c) { c = c / 255
+    return c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ^ 2.4 }
+BEGIN { printf "%.9f\n", 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b) }'
+}
+
+# ratio HEX HEX: prints the WCAG 2 contrast ratio of the two colours, from
+# 1.0 to 21.0.
+ratio() {
+    awk -v a="$(lum "$1")" -v b="$(lum "$2")" 'BEGIN {
+        if (a < b) { t = a; a = b; b = t }
+        printf "%.9f\n", (a + 0.05) / (b + 0.05) }'
+}
+
+# under FG BG: gives 0 when the ratio of FG on BG is under the floor.
+under() {
+    awk -v r="$(ratio "$1" "$2")" -v f="$floor" 'BEGIN { exit !(r < f) }'
+}
+
+# over HEX ALPHA GROUND: prints the colour HEX at the alpha ALPHA, from 0.0 to
+# 1.0, over the opaque colour GROUND. The arithmetic is the eight bit form of
+# overColour() in gtk4/writer/palette.cpp.
+over() {
+    o_c=${1#\#}
+    o_g=${3#\#}
+    awk -v cr="$(printf '%d' "0x$(echo "$o_c" | cut -c1-2)")" \
+        -v cg="$(printf '%d' "0x$(echo "$o_c" | cut -c3-4)")" \
+        -v cb="$(printf '%d' "0x$(echo "$o_c" | cut -c5-6)")" \
+        -v gr="$(printf '%d' "0x$(echo "$o_g" | cut -c1-2)")" \
+        -v gg="$(printf '%d' "0x$(echo "$o_g" | cut -c3-4)")" \
+        -v gb="$(printf '%d' "0x$(echo "$o_g" | cut -c5-6)")" \
+        -v alpha="$2" '
+function div255(x,  t) { t = x + 128; return int((t + int(t / 256)) / 256) }
+function chan(c, g,  f) {
+    f = int(int(c * alpha * 65535.0 / 255.0 + 0.5) / 256)
+    return f + div255(g * (255 - a8)) }
+BEGIN { a8 = int(int(alpha * 65535.0 + 0.5) / 256)
+    printf "#%02x%02x%02x\n", chan(cr, gr), chan(cg, gg), chan(cb, gb) }'
+}
+
+# heads FILE HEAD: gives 0 when the lines of HEAD stand once in FILE, in their
+# order. Else it gives 1 and prints the count of the last line of HEAD, or the
+# word head when that line stands once.
+heads() {
+    h_last=$(printf '%s\n' "$2" | tail -n 1)
+    h_count=$(grep -cxF -- "$h_last" "$1" || true)
+    if [ "$h_count" -ne 1 ]; then
+        echo "$h_count"
+        return 1
+    fi
+    h_at=$(grep -nxF -- "$h_last" "$1" | cut -d: -f1)
+    h_from=$((h_at - $(printf '%s\n' "$2" | wc -l) + 1))
+    if [ "$h_from" -lt 1 ] ||
+        [ "$(sed -n "${h_from},${h_at}p" "$1")" != "$2" ]; then
+        echo head
+        return 1
+    fi
+    return 0
+}
+
+# check SHEET: gives 0 while the fifteen contracts hold. It names the first
+# contract that fails on the standard error.
+check() {
+    c_sheet=$1
+
+    for c_block in $blocks; do
+        eval "c_head=\$head_$c_block"
+        eval "c_rows=\$rows_$c_block"
+
+        # 1. Each block holds one rule. The last line of its head stands once
+        # at column 0, and the lines above it are its other head lines in
+        # order.
+        if ! c_count=$(heads "$c_sheet" "$c_head"); then
+            if [ "$c_count" = head ]; then
+                note "the head of the $c_block rule of $c_sheet does not" \
+                     "read its selector lines in order"
+            else
+                note "$c_sheet holds $c_count $c_block rules, and not 1"
+            fi
+            return 1
+        fi
+        body "$c_sheet" "$c_head" > "$tmp/body"
+
+        # 2. The body holds one line per name in the order of the writer,
+        # each with one hex colour under !important, and no other line.
+        c_at=0
+        for c_row in $c_rows; do
+            c_name=${c_row%%=*}
+            c_at=$((c_at + 1))
+            c_line=$(sed -n "${c_at}p" "$tmp/body")
+            if ! printf '%s\n' "$c_line" |
+                grep -q "^  $c_name: #[0-9a-f]\\{6\\} !important;\$"
+            then
+                note "line $c_at of the $c_block rule of $c_sheet reads" \
+                     "'$c_line', and not $c_name with one hex colour"
+                return 1
+            fi
+        done
+        c_lines=$(wc -l < "$tmp/body")
+        if [ "$c_lines" -ne "$c_at" ]; then
+            note "the $c_block rule of $c_sheet holds $c_lines lines, and" \
+                 "not $c_at"
+            return 1
+        fi
+
+        # 3. Each name holds the first root value of its chrome row in the
+        # same sheet. A row with the root name none holds no root value.
+        for c_row in $c_rows; do
+            c_name=${c_row%%=*}
+            c_root=${c_row#*=}
+            [ "$c_root" != none ] || continue
+            c_have=$(decl "$tmp/body" "$c_name")
+            c_want=$(rootvalue "$c_sheet" "$c_root")
+            if [ -z "$c_want" ] || [ "$c_have" != "$c_want" ]; then
+                note "$c_name of the $c_block rule of $c_sheet holds" \
+                     "$c_have over the root value $c_want of $c_root"
+                return 1
+            fi
+        done
+    done
+
+    # The contracts 4, 6 and 7 read these three root values.
+    for c_root in --color-accent-primary --sidebar-background-color \
+        --panel-background-color; do
+        if [ -z "$(rootvalue "$c_sheet" "$c_root")" ]; then
+            note "the root of $c_sheet sets no $c_root"
+            return 1
+        fi
+    done
+    c_high=$(rootvalue "$c_sheet" --color-accent-primary)
+    c_side=$(rootvalue "$c_sheet" --sidebar-background-color)
+    c_ground=$(rootvalue "$c_sheet" --panel-background-color)
+
+    # 4. The rule of the bar button stands once and holds one line: the
+    # border at one pixel in the root highlight.
+    if ! c_count=$(heads "$c_sheet" "$head_button"); then
+        note "$c_sheet holds $c_count bar button rules, and not 1"
+        return 1
+    fi
+    c_want="1px solid $c_high"
+    c_have=$(body "$c_sheet" "$head_button")
+    if [ "$c_have" != "  --button-border: $c_want !important;" ]; then
+        note "the bar button rule of $c_sheet reads '$c_have', and not" \
+             "--button-border at $c_want"
+        return 1
+    fi
+
+    # 5. The separator token block stands once: a root head, the token at
+    # none and a closing brace, on three lines in a row.
+    c_count=$(awk -v l="$sep_line" '
+        p2 == ":root {" && p1 == l && $0 == "}" { n++ }
+        { p2 = p1; p1 = $0 }
+        END { print n + 0 }' "$c_sheet")
+    if [ "$c_count" -ne 1 ]; then
+        c_have=$(grep -- '^  --tabs-navbar-separator-style: ' "$c_sheet" |
+                     head -n 1)
+        note "$c_sheet holds $c_count separator token blocks, and not 1;" \
+             "the token line reads '$c_have'"
+        return 1
+    fi
+
+    # 6. The five tree rules stand once each, with one line each. The hovered
+    # row holds the root highlight at the alpha over the root sidebar ground,
+    # and each guard rule holds its browser value.
+    c_hover=$(over "$c_high" "$hover_alpha" "$c_side")
+    printf '%s\n' "$tree_heads" > "$tmp/tree-heads"
+    printf '%s\n' "$tree_values" > "$tmp/tree-values"
+    c_at=0
+    while IFS= read -r c_head; do
+        c_at=$((c_at + 1))
+        c_value=$(sed -n "${c_at}p" "$tmp/tree-values")
+        [ "$c_value" != HOVER ] || c_value=$c_hover
+        if ! c_count=$(heads "$c_sheet" "$c_head"); then
+            note "$c_sheet holds $c_count tree rules of the head" \
+                 "'$c_head', and not 1"
+            return 1
+        fi
+        c_have=$(body "$c_sheet" "$c_head")
+        if [ "$c_have" != "  background-color: $c_value !important;" ]; then
+            if [ $c_at -eq 1 ]; then
+                note "the hovered tree row of $c_sheet reads '$c_have'," \
+                     "and not $c_value, the highlight at $hover_alpha over" \
+                     "the sidebar ground"
+            else
+                note "tree rule $c_at of $c_sheet reads '$c_have', and not" \
+                     "$c_value"
+            fi
+            return 1
+        fi
+    done < "$tmp/tree-heads"
+
+    # 7. Each root link name reads at the floor or over it on the root panel
+    # colour.
+    for c_name in $links; do
+        c_link=$(rootvalue "$c_sheet" "$c_name")
+        if [ -z "$c_link" ]; then
+            note "the root of $c_sheet sets no $c_name"
+            return 1
+        fi
+        if under "$c_link" "$c_ground"; then
+            note "$c_name of $c_sheet is $c_link on $c_ground at" \
+                 "$(ratio "$c_link" "$c_ground" |
+                    awk '{ printf "%.2f", $1 }'), under $floor"
+            return 1
+        fi
+    done
+
+    # 8. The rule of the progress line stands once and holds two lines: the
+    # canvas name at one hex colour, then the frame line. The frame is a
+    # shadow of one pixel at the root border of a text field.
+    if ! c_count=$(heads "$c_sheet" "$head_progress"); then
+        note "$c_sheet holds $c_count progress rules, and not 1"
+        return 1
+    fi
+    c_have=$(body "$c_sheet" "$head_progress")
+    c_edge=$(rootvalue "$c_sheet" --toolbar-field-border-color)
+    if [ "$(printf '%s\n' "$c_have" | wc -l)" -ne 2 ] ||
+        ! printf '%s\n' "$c_have" | sed -n 1p | grep -qx \
+        '  --background-color-canvas: #[0-9a-f]\{6\} !important;' ||
+        [ -z "$c_edge" ] || [ "$(printf '%s\n' "$c_have" | sed -n 2p)" != \
+        "  box-shadow: 0 0 0 1px $c_edge !important;" ]; then
+        note "the progress rule of $c_sheet reads '$c_have', and not the" \
+             "canvas name with one hex colour and a frame of 1px at the" \
+             "field border $c_edge"
+        return 1
+    fi
+
+    # 9. The rule of a selected result row under the pointer stands once and
+    # holds one line. The line holds the ground of that row at one hex
+    # colour, apart from the root ground of a selected row.
+    if ! c_count=$(heads "$c_sheet" "$head_result"); then
+        note "$c_sheet holds $c_count result row rules, and not 1"
+        return 1
+    fi
+    c_have=$(body "$c_sheet" "$head_result")
+    c_rest=$(rootvalue "$c_sheet" --urlbarview-background-color-selected)
+    if [ "$(printf '%s\n' "$c_have" | wc -l)" -ne 1 ] ||
+        ! printf '%s\n' "$c_have" | grep -qx \
+        '  background-color: #[0-9a-f]\{6\} !important;' ||
+        [ "$c_have" = "  background-color: $c_rest !important;" ]; then
+        note "the result row rule of $c_sheet reads '$c_have', and not one" \
+             "hex ground apart from the selected ground $c_rest"
+        return 1
+    fi
+
+    # 10. The root holds the attention accent at the root highlight.
+    c_have=$(rootvalue "$c_sheet" --color-accent-attention)
+    if [ "$c_have" != "$c_high" ]; then
+        note "the root of $c_sheet holds the attention accent at" \
+             "'$c_have', and not at the highlight $c_high"
+        return 1
+    fi
+
+    # 11. The three rules of the text fields under the pointer stand once
+    # each. The find field and the address bar hold their border colour at
+    # the root hover name. The sidebar field holds its two border names at
+    # one pixel of that colour.
+    c_hoverframe=$(rootvalue "$c_sheet" --border-color-interactive-hover)
+    if [ -z "$c_hoverframe" ]; then
+        note "the root of $c_sheet sets no --border-color-interactive-hover"
+        return 1
+    fi
+    for c_head in "$head_findfield" "$head_sidefield" "$head_urlfield"; do
+        if ! c_count=$(heads "$c_sheet" "$c_head"); then
+            note "$c_sheet holds $c_count rules of the head '$c_head', and" \
+                 "not 1"
+            return 1
+        fi
+        if [ "$c_head" = "$head_sidefield" ]; then
+            c_want="  --input-border: 1px solid $c_hoverframe !important;
+  --input-text-border: 1px solid $c_hoverframe !important;"
+        else
+            c_want="  border-color: $c_hoverframe !important;"
+        fi
+        c_have=$(body "$c_sheet" "$c_head")
+        if [ "$c_have" != "$c_want" ]; then
+            note "the rule '$c_head' of $c_sheet reads '$c_have', and not" \
+                 "the hover frame $c_hoverframe"
+            return 1
+        fi
+    done
+
+    # 12. The two rules of the private browsing button stand once each. The
+    # outline holds one pixel of the root highlight at the share of the
+    # browser, and the icon holds its fill at the root highlight.
+    for c_head in "$head_private_outline" "$head_private_icon"; do
+        if ! c_count=$(heads "$c_sheet" "$c_head"); then
+            note "$c_sheet holds $c_count rules of the head '$c_head', and" \
+                 "not 1"
+            return 1
+        fi
+    done
+    c_want="  --toolbarbutton-outline: 1px solid color-mix(in srgb, $c_high"
+    c_want="$c_want $outline_share%, transparent) !important;"
+    c_have=$(body "$c_sheet" "$head_private_outline")
+    if [ "$c_have" != "$c_want" ]; then
+        note "the outline rule of the private button of $c_sheet reads" \
+             "'$c_have', and not a mix of the highlight $c_high"
+        return 1
+    fi
+    c_have=$(body "$c_sheet" "$head_private_icon")
+    if [ "$c_have" != "  fill: $c_high !important;" ]; then
+        note "the icon rule of the private button of $c_sheet reads" \
+             "'$c_have', and not the fill at the highlight $c_high"
+        return 1
+    fi
+
+    # 13. The root holds the focus colour and the focus frame of a text field
+    # at one hex colour. The shipped schemes give the highlight and the focus
+    # decoration one colour, so that colour stands apart from the root
+    # highlight.
+    c_focus=$(rootvalue "$c_sheet" --focus-outline-color)
+    c_have=$(rootvalue "$c_sheet" --toolbar-field-border-color-focus)
+    if ! printf '%s\n' "$c_focus" | grep -qx '#[0-9a-f]\{6\}' ||
+        [ "$c_have" != "$c_focus" ] || [ "$c_focus" = "$c_high" ]; then
+        note "the root of $c_sheet holds the focus colour at '$c_focus' and" \
+             "the focus frame of a field at '$c_have', and not one hex" \
+             "colour apart from the highlight $c_high"
+        return 1
+    fi
+
+    # 14. The three rules of a switch that is on stand once each, with one
+    # line each. Each line holds the border colour at the border name of a
+    # switch that is off in the same state.
+    printf '%s\n' "$switchon_heads" > "$tmp/switch-heads"
+    printf '%s\n' "$switchon_names" > "$tmp/switch-names"
+    c_at=0
+    while IFS= read -r c_head; do
+        c_at=$((c_at + 1))
+        c_name=$(sed -n "${c_at}p" "$tmp/switch-names")
+        if ! c_count=$(heads "$c_sheet" "$c_head"); then
+            note "$c_sheet holds $c_count rules of the head '$c_head', and" \
+                 "not 1"
+            return 1
+        fi
+        c_have=$(body "$c_sheet" "$c_head")
+        if [ "$c_have" != "  border-color: var($c_name) !important;" ]; then
+            note "the rule '$c_head' of $c_sheet reads '$c_have', and not" \
+                 "the border colour at $c_name"
+            return 1
+        fi
+    done < "$tmp/switch-heads"
+
+    # 15. The frame of a button stands at one colour. The switch rule holds
+    # it at rest and pressed, and the rule of the drop down lists holds it at
+    # rest. That colour stands apart from the root border name of a field
+    # and from the root hover name.
+    c_frame=$(decl "$c_sheet" --toggle-border-color)
+    for c_name in --toggle-border-color-active --select-border-color; do
+        c_have=$(decl "$c_sheet" $c_name)
+        if [ -z "$c_frame" ] || [ "$c_have" != "$c_frame" ]; then
+            note "$c_name of $c_sheet holds '$c_have', and not the frame" \
+                 "'$c_frame' of the switch rule"
+            return 1
+        fi
+    done
+    for c_name in --border-color-interactive \
+        --border-color-interactive-hover; do
+        if [ "$c_frame" = "$(rootvalue "$c_sheet" $c_name)" ]; then
+            note "the frame of a button of $c_sheet holds $c_frame, the" \
+                 "root value of $c_name"
+            return 1
+        fi
+    done
+    return 0
+}
+
+if ! check "$sheet"; then
+    note "the sheet fails the check"
+    exit 1
+fi
+hover=$c_hover
+ground=$c_ground
+
+# The controls below. Each one doctors a copy of the sheet, and the check must
+# fail over that copy.
+broken=0
+
+# control NAME COPY: the check must fail over the copy that the caller gives.
+control() {
+    k_name=$1
+    if check "$2" 2> "$tmp/control.log"; then
+        note "the check passed the control copy of $k_name"
+        exit 1
+    fi
+    broken=$((broken + 1))
+}
+
+# (a) The ring rule cut out, which is the sheet of a writer with no block.
+sed "/^$(esc "$head_ring")\$/,/^}\$/d" "$sheet" > "$tmp/a.css"
+control 'the ring rule cut out' "$tmp/a.css"
+
+# (b) The body of the bar rule indented by two more spaces, the nested layout.
+sed "/^$(esc "$head_bar")\$/,/^}\$/s/^  --/    --/" "$sheet" > "$tmp/b.css"
+control 'the nested layout of the bar rule' "$tmp/b.css"
+
+# (c) The trust ground at the hover accent of the root, a value apart from the
+# panel colour.
+accent=$(rootvalue "$sheet" --color-accent-primary-hover)
+sed "s/^  --trustpanel-highlight-bg: .* !important;\$/"\
+"  --trustpanel-highlight-bg: $accent !important;/" "$sheet" > "$tmp/c.css"
+control 'the trust ground at the hover accent' "$tmp/c.css"
+
+# (d) The border of the bar button at two pixels.
+sed 's/^  --button-border: 1px /  --button-border: 2px /' "$sheet" \
+    > "$tmp/d.css"
+control 'the bar button border at 2px' "$tmp/d.css"
+
+# (e) The separator token at solid, which shows the line again.
+sed 's/^\(  --tabs-navbar-separator-style:\) none /\1 solid /' "$sheet" \
+    > "$tmp/e.css"
+control 'the separator token at solid' "$tmp/e.css"
+
+# (f) The hovered tree row at the button hover of the root.
+row=$(printf '%s\n' "$tree_heads" | head -n 1)
+fill=$(rootvalue "$sheet" --toolbarbutton-background-color-hover)
+sed "/^$(esc "$row")\$/,/^}\$/s/^  background-color: .* !important;\$/"\
+"  background-color: $fill !important;/" "$sheet" > "$tmp/f.css"
+control 'the hovered tree row at the button hover' "$tmp/f.css"
+
+# (g) The third tree rule cut out, the guard rule of a focused selected row.
+row=$(printf '%s\n' "$tree_heads" | sed -n 3p)
+sed "/^$(esc "$row")\$/,/^}\$/d" "$sheet" > "$tmp/g.css"
+control 'a guard rule cut out' "$tmp/g.css"
+
+# (h) Each line of the rest link name in the panel colour, which reads 1.0.
+sed "s/^  --link-color: .* !important;\$/"\
+"  --link-color: $ground !important;/" "$sheet" > "$tmp/h.css"
+control 'the root link in the colour of the panel' "$tmp/h.css"
+
+# (i) A second trust rule at the end of the sheet.
+{
+    cat "$sheet"
+    echo
+    echo "$head_trust"
+    printf '  --trustpanel-highlight-bg: %s !important;\n' "$planted"
+    echo '}'
+} > "$tmp/i.css"
+control 'a second trust rule' "$tmp/i.css"
+
+# (j) The ghost active line of the tab button rule cut out.
+sed '/^  --button-background-color-ghost-active:/d' "$sheet" > "$tmp/j.css"
+control 'the ghost active line cut out' "$tmp/j.css"
+
+# (k) The private link at the panel text, a value apart from the root link.
+text=$(rootvalue "$sheet" --panel-text-color)
+sed "/^$(esc "$head_private")\$/,/^}\$/s/^  --link-color: .* !important;\$/"\
+"  --link-color: $text !important;/" "$sheet" > "$tmp/k.css"
+control 'the private link at the panel text' "$tmp/k.css"
+
+# (l) The two names of the account rule in the other order.
+sed '/^  --promo-background-color-vibrant:/{
+h
+d
+}
+/^  --promo-message-text-color-vibrant:/G' "$sheet" > "$tmp/l.css"
+control 'the account names in the other order' "$tmp/l.css"
+
+# (m) The border line of the bar rule cut out.
+sed '/^  --info-bar-border-color:/d' "$sheet" > "$tmp/m.css"
+control 'the bar border line cut out' "$tmp/m.css"
+
+# (n) The new input ground line of the tab group rule cut out, the sheet of
+# the writer before Firefox 159.
+sed "/^$(esc "$head_tabgroup")\$/,/^}\$/{/^  --input-background-color:/d;}" \
+    "$sheet" > "$tmp/n.css"
+control 'the new input line of the tab group rule cut out' "$tmp/n.css"
+
+# (o) The switch rule cut out, which leaves the dot of a switch at the border
+# names of the root.
+sed "/^$(esc "$head_switch")\$/,/^}\$/d" "$sheet" > "$tmp/o.css"
+control 'the switch rule cut out' "$tmp/o.css"
+
+# (p) The dot of a switch that is off at the root border name, the colour of
+# the border of its track.
+edge=$(rootvalue "$sheet" --border-color-interactive)
+sed "s/^  --toggle-dot-background-color: .*\$/"\
+"  --toggle-dot-background-color: $edge !important;/" "$sheet" > "$tmp/p.css"
+control 'the off dot of the switch at the border name' "$tmp/p.css"
+
+# (q) The ground line of the drop down list cut out.
+sed '/^  --select-background-color:/d' "$sheet" > "$tmp/q.css"
+control 'the ground of the drop down list cut out' "$tmp/q.css"
+
+# (r) The progress rule cut out, which leaves the grey of the browser.
+sed "/^$(esc "$head_progress")\$/,/^}\$/d" "$sheet" > "$tmp/r.css"
+control 'the progress rule cut out' "$tmp/r.css"
+
+# (s) The result row rule cut out.
+sed "/^$(esc "$head_result")\$/,/^}\$/d" "$sheet" > "$tmp/s.css"
+control 'the result row rule cut out' "$tmp/s.css"
+
+# (t) The result row under the pointer at the root ground of a selected row,
+# the row at rest.
+rest=$(rootvalue "$sheet" --urlbarview-background-color-selected)
+sed "/^$(esc "$head_result")\$/,/^}\$/s/^  background-color: .*\$/"\
+"  background-color: $rest !important;/" "$sheet" > "$tmp/t.css"
+control 'the result row under the pointer at the rest ground' "$tmp/t.css"
+
+# (u) The attention accent cut out, which leaves the system accent of the
+# browser.
+sed '/^  --color-accent-attention:/d' "$sheet" > "$tmp/u.css"
+control 'the attention accent cut out' "$tmp/u.css"
+
+# (v) The attention accent at the root highlight text, the colour that the
+# system accent gives a dark scheme.
+hightext=$(rootvalue "$sheet" --button-text-color-primary)
+sed "s/^  --color-accent-attention: .*\$/"\
+"  --color-accent-attention: $hightext !important;/" "$sheet" > "$tmp/v.css"
+control 'the attention accent at the highlight text' "$tmp/v.css"
+
+# (w) The rule of the find field under the pointer cut out.
+sed "/^$(esc "$head_findfield")\$/,/^}\$/d" "$sheet" > "$tmp/w.css"
+control 'the find field rule cut out' "$tmp/w.css"
+
+# (x) The address bar under the pointer at the root field border, the frame
+# at rest.
+frame=$(rootvalue "$sheet" --toolbar-field-border-color)
+sed "/^$(esc "$head_urlfield")\$/,/^}\$/s/^  border-color: .*\$/"\
+"  border-color: $frame !important;/" "$sheet" > "$tmp/x.css"
+control 'the address bar under the pointer at the rest frame' "$tmp/x.css"
+
+# (y) The second border name of the sidebar rule cut out, the name that
+# Firefox 157 and 158 read.
+sed '/^  --input-text-border: /d' "$sheet" > "$tmp/y.css"
+control 'the older border name of the sidebar rule cut out' "$tmp/y.css"
+
+# (z) The outline of the private button at the violet of the browser.
+sed "/^$(esc "$head_private_outline")\$/,/^}\$/"\
+"s/color-mix(in srgb, #[0-9a-f]* /color-mix(in srgb, $violet_outline /" \
+    "$sheet" > "$tmp/z.css"
+control 'the private outline at the violet' "$tmp/z.css"
+
+# (aa) The disc of the private button at the violet of the browser.
+sed "/^$(esc "$head_private_icon")\$/,/^}\$/s/^  fill: .*\$/"\
+"  fill: $violet_fill !important;/" "$sheet" > "$tmp/aa.css"
+control 'the private disc at the violet' "$tmp/aa.css"
+
+# (ab) The icon rule of the private button cut out.
+sed "/^$(esc "$head_private_icon")\$/,/^}\$/d" "$sheet" > "$tmp/ab.css"
+control 'the private icon rule cut out' "$tmp/ab.css"
+
+# (ac) The canvas line of the progress rule twice, a body of three lines.
+sed "/^$(esc "$head_progress")\$/,/^}\$/{/^  --background-color-canvas: /p;}" \
+    "$sheet" > "$tmp/ac.css"
+control 'the progress rule of three lines' "$tmp/ac.css"
+
+# (ad) The ground line of the result row rule twice, a body of two lines.
+sed "/^$(esc "$head_result")\$/,/^}\$/{/^  background-color: /p;}" "$sheet" \
+    > "$tmp/ad.css"
+control 'the result row rule of two lines' "$tmp/ad.css"
+
+# (ae) The focus colour and the focus frame of a field at the root highlight,
+# the focus decoration of a shipped scheme.
+high=$(rootvalue "$sheet" --color-accent-primary)
+sed -e "s/^  --focus-outline-color: .*\$/"\
+"  --focus-outline-color: $high !important;/" \
+    -e "s/^  --toolbar-field-border-color-focus: .*\$/"\
+"  --toolbar-field-border-color-focus: $high !important;/" "$sheet" \
+    > "$tmp/ae.css"
+control 'the focus colour at the root highlight' "$tmp/ae.css"
+
+# (af) The focus frame of a field at the root hover accent, a colour apart
+# from the focus colour.
+sed "s/^  --toolbar-field-border-color-focus: .*\$/"\
+"  --toolbar-field-border-color-focus: $accent !important;/" "$sheet" \
+    > "$tmp/af.css"
+control 'the focus frame of a field apart from the focus colour' "$tmp/af.css"
+
+# (ag) The rest rule of a switch that is on cut out, which leaves the clear
+# border of the browser.
+sed "/^$(esc "$switchon {")\$/,/^}\$/d" "$sheet" > "$tmp/ag.css"
+control 'the rest rule of the on switch cut out' "$tmp/ag.css"
+
+# (ah) The switch that is on under the pointer at the border name at rest.
+sed "/^$(esc "$switchon:enabled:hover {")\$/,/^}\$/"\
+"s/var(--toggle-border-color-hover)/var(--toggle-border-color)/" "$sheet" \
+    > "$tmp/ah.css"
+control 'the on switch under the pointer at the rest name' "$tmp/ah.css"
+
+# (ai) The pressed rule of a switch that is on cut out, which leaves the
+# pressed switch at the frame under the pointer.
+sed "/^$(esc "$switchon:enabled:hover:active {")\$/,/^}\$/d" "$sheet" \
+    > "$tmp/ai.css"
+control 'the pressed rule of the on switch cut out' "$tmp/ai.css"
+
+# (aj) The frame line of the progress rule cut out, which leaves the line of
+# a download with no frame.
+sed "/^$(esc "$head_progress")\$/,/^}\$/{/^  box-shadow: /d;}" "$sheet" \
+    > "$tmp/aj.css"
+control 'the frame of the progress line cut out' "$tmp/aj.css"
+
+# (ak) The frame of the progress line at the root highlight, a colour apart
+# from the border of a field.
+sed "/^$(esc "$head_progress")\$/,/^}\$/s/^  box-shadow: .*\$/"\
+"  box-shadow: 0 0 0 1px $high !important;/" "$sheet" > "$tmp/ak.css"
+control 'the frame of the progress line at the highlight' "$tmp/ak.css"
+
+# (al) The frame of the switch at the root border name, the frame of a field.
+edge=$(rootvalue "$sheet" --border-color-interactive)
+sed "/^$(esc "$head_switch")\$/,/^}\$/s/^  --toggle-border-color: .*\$/"\
+"  --toggle-border-color: $edge !important;/" "$sheet" > "$tmp/al.css"
+control 'the frame of the switch at the frame of a field' "$tmp/al.css"
+
+# (am) The frame line of the rule of the drop down lists cut out, which
+# leaves a list at the frame of a field.
+sed "/^$(esc "$head_droplist")\$/,/^}\$/{/^  --select-border-color:/d;}" \
+    "$sheet" > "$tmp/am.css"
+control 'the frame of the drop down list cut out' "$tmp/am.css"
+
+# (an) Each frame of a button at the root border name, the state of one
+# frame for a button and a field.
+sed -e "s/^  --toggle-border-color: .*\$/"\
+"  --toggle-border-color: $edge !important;/" \
+    -e "s/^  --toggle-border-color-active: .*\$/"\
+"  --toggle-border-color-active: $edge !important;/" \
+    -e "s/^  --select-border-color: .*\$/"\
+"  --select-border-color: $edge !important;/" "$sheet" > "$tmp/an.css"
+control 'each frame of a button at the frame of a field' "$tmp/an.css"
+
+# (ao) The frame of the switch under the pointer at its frame at rest.
+frame=$(decl "$sheet" --toggle-border-color)
+sed "s/^  --toggle-border-color-hover: .*\$/"\
+"  --toggle-border-color-hover: $frame !important;/" "$sheet" > "$tmp/ao.css"
+control 'the hovered switch at its frame at rest' "$tmp/ao.css"
+
+echo "assert-ff-blocks: $sheet holds the $(echo $blocks | wc -w) block" \
+     "rules, the bar button rule, the progress rule, the result row rule," \
+     "the three rules of the fields under the pointer, the two rules of" \
+     "the private button, the three rules of a switch that is on," \
+     "the frame of a button at one colour," \
+     "the separator token" \
+     "block and the" \
+     "$(printf '%s\n' "$tree_heads" | wc -l) tree rules; each block name" \
+     "holds the root value of its row, the attention accent holds the" \
+     "highlight, the focus colour stands apart from it, the hovered tree row" \
+     "holds $hover," \
+     "each root link name reads at $floor or more on the ground $ground," \
+     "and the check rejects each of the $broken control copies"
diff --git a/firefox/check/assert-ff-content-blocks.sh b/firefox/check/assert-ff-content-blocks.sh
new file mode 100644
index 00000000..38aea14b
--- /dev/null
+++ b/firefox/check/assert-ff-content-blocks.sh
@@ -0,0 +1,1929 @@
+#!/bin/sh
+# assert-ff-content-blocks.sh SHEET: the content sheet SHEET must hold the
+# twelve contracts of check() below over the rules after its root rule. The
+# run then doctors one hundred and fourteen copies of SHEET, and it fails if
+# the check passes a copy.
+set -eu
+usage='usage: assert-ff-content-blocks.sh SHEET'
+sheet=${1:?$usage}
+
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+
+# The content blocks in the order of the writer. The name of a block is the
+# prefix of its rows in the map.
+blocks='nav menu list select selectopen switch color vibrant card search'
+blocks="$blocks mask lists tile lighttext darktext tab"
+# The head of each block holds its selector lines, and the rows hold one triple
+# NAME=ANCHOR=FORM for each body line, in order. ANCHOR is the root name of the
+# role of NAME or none, and contracts 2 and 3 read the value form FORM.
+viewhover=--button-background-color-menu-hover
+fieldground=--newtab-background-color-secondary
+fieldtext=--input-text-color
+head_nav='moz-page-nav {'
+rows_nav="--page-nav-button-background-color-hover=$viewhover=pair"
+head_menu='panel-list {'
+rows_menu="--button-background-color-menu-hover=$viewhover=menu
+--button-background-color-menu-active=$viewhover=menu
+--button-text-color-menu-hover=--button-text-color=menu
+--button-text-color-menu-active=--button-text-color=menu"
+head_list='panel-list[min-width-from-anchor] {'
+rows_list='--button-background-color-menu-hover=--color-accent-primary=hex
+--button-background-color-menu-active=--color-accent-primary=hex
+--button-text-color-menu-hover=--button-text-color-primary=hex
+--button-text-color-menu-active=--button-text-color-primary=hex'
+# The select rule holds the frame of a select at one pair with no anchor,
+# which contract 12 reads. Under the pointer the frame holds the root hover
+# name.
+head_select='moz-select {'
+rows_select='--button-background-color-selected=--color-accent-primary=same
+--button-text-color-selected=--button-text-color-primary=same
+--select-background-color=--button-background-color-muted=pair
+--select-border-color=none=loose
+--select-border-color-hover=--border-color-interactive-hover=pair'
+# The open rule holds a select with an open list at the frame of the select
+# rule, the frame at rest. It holds the ground of that select at one pair,
+# which contract 11 reads.
+head_selectopen='.select-wrapper:has(select:open),
+.select-wrapper:has(+ [open]) {'
+rows_selectopen='--select-border-color-hover=none=loose
+--select-background-color-hover=none=loose'
+# The switch rule holds the dot of a switch that is off at the button text.
+# It holds the dot of a switch that is on at the highlight text. It holds the
+# frame of a switch at rest and pressed at the pair of contract 12. Under the
+# pointer that frame holds the root hover name.
+head_switch='moz-toggle {'
+rows_switch='--toggle-dot-background-color=--button-text-color=pair
+--toggle-dot-background-color-hover=--button-text-color=pair
+--toggle-dot-background-color-active=--button-text-color=pair
+--toggle-dot-background-color-on-pressed=--button-text-color-primary=same
+--toggle-border-color=none=loose
+--toggle-border-color-active=none=loose
+--toggle-border-color-hover=--border-color-interactive-hover=pair'
+head_color='moz-input-color {'
+rows_color=\
+'--input-color-background-color-active=--button-background-color-active=pair'
+head_vibrant='moz-promo[type="vibrant"] {'
+rows_vibrant="--promo-background-color-vibrant=$fieldground=pair
+--promo-message-text-color-vibrant=$fieldtext=pair"
+head_card='.ai-controls-description {'
+rows_card="--ai-controls-description-background-color=$viewhover=pair"
+head_search='html.private content-search-handoff-ui {'
+rows_search="--content-search-handoff-ui-background-color=$fieldground=dark
+--content-search-handoff-ui-unfocused-border-color=none=free"
+head_mask='private-browsing-mask-intro {'
+rows_mask='--icon-mask-color=--color-accent-primary=hex'
+head_lists='.lists {'
+rows_lists='--lists-text-color=--text-color=pair
+--lists-button-background=--color-accent-primary=same'
+# The tile rule gives a tile of the new tab page, its menu button and its pin
+# icon the scheme of their container. It gives the preview tile of the shortcut
+# form and its title the scheme of the form. The row form follow names that
+# scheme line.
+head_tile='.top-site-outer :is(.tile, .context-menu-button, .icon-pin-small),
+.topsite-form :is(.top-site-outer, .title) {'
+rows_tile='color-scheme=none=follow'
+head_lighttext='.onboardingContainer .screen.light-text {'
+rows_lighttext='--text-color=--text-color=dark
+--button-background-color-primary=--color-accent-primary=hex
+--button-background-color-primary-hover=--color-accent-primary-hover=hex
+--button-background-color-primary-active=--color-accent-primary-active=hex
+--button-text-color-primary=--button-text-color-primary=hex
+--button-text-color-primary-hover=--button-text-color-primary=hex
+--link-color=--link-color=dark
+--link-color-hover=--link-color-hover=dark
+--link-color-active=--link-color-active=dark'
+head_darktext='.onboardingContainer .screen.dark-text {'
+rows_darktext='--text-color=--text-color=light
+--button-background-color-primary=--color-accent-primary=hex
+--button-background-color-primary-hover=--color-accent-primary-hover=hex
+--button-background-color-primary-active=--color-accent-primary-active=hex
+--button-text-color-primary=--button-text-color-primary=hex
+--button-text-color-primary-hover=--button-text-color-primary=hex
+--link-color=--link-color=light
+--link-color-hover=--link-color-hover=light
+--link-color-active=--link-color-active=light'
+head_tab='tab[selected] {'
+rows_tab='--button-background-color-primary=--link-color=pair'
+# The placeholder rule, which follows the last content block. It holds the
+# mix of the user agent sheet at one share per half.
+head_placeholder='::placeholder {'
+mixhalf='color-mix(in srgb, currentColor [0-9]*%, transparent)'
