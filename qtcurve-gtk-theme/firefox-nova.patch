+# mkfloors.sh SHEET [VAR]: prints the floor of assert-ff-varnames.sh from one
+# build. SHEET is a sheet of the build tree. VAR is the name of the CMake
+# variable that holds the floor, and it is qtc_ff_names by default. The CMake
+# file holds the number that this script prints, so no floor of the build
+# comes from a hand count.
 set -eu
-sheet=${1:?usage: mkfloors.sh SHEET}
+sheet=${1:?usage: mkfloors.sh SHEET [VAR]}
+var=${2:-qtc_ff_names}
 count=$(grep -o -- '--[A-Za-z0-9-]*:' "$sheet" | sed 's/:$//' | sort -u |
             wc -l)
-printf 'set(qtc_ff_names %s)\n' "$count"
+printf 'set(%s %s)\n' "$var" "$count"
