+# ratio HEX HEX: prints the WCAG 2 contrast ratio of the two colours, from
+# 1.0 to 21.0.
+ratio() {
+    awk -v a="$(lum "$1")" -v b="$(lum "$2")" 'BEGIN {
+        if (a < b) { t = a; a = b; b = t }
+        printf "%.9f\n", (a + 0.05) / (b + 0.05) }'
+}
+
+# under FG BG: gives 0 when the ratio of FG on BG is under the floor.
+under() {
+    awk -v r="$(ratio "$1" "$2")" -v f="$floor" 'BEGIN { exit !(r < f) }'
+}
+
+# over HEX ALPHA GROUND: prints the colour HEX at the alpha ALPHA, from 0.0 to
+# 1.0, over the opaque colour GROUND. The arithmetic is the eight bit form of
+# overColour() in gtk4/writer/palette.cpp.
+over() {
+    o_c=${1#\#}
+    o_g=${3#\#}
+    awk -v cr="$(printf '%d' "0x$(echo "$o_c" | cut -c1-2)")" \
+        -v cg="$(printf '%d' "0x$(echo "$o_c" | cut -c3-4)")" \
+        -v cb="$(printf '%d' "0x$(echo "$o_c" | cut -c5-6)")" \
+        -v gr="$(printf '%d' "0x$(echo "$o_g" | cut -c1-2)")" \
+        -v gg="$(printf '%d' "0x$(echo "$o_g" | cut -c3-4)")" \
+        -v gb="$(printf '%d' "0x$(echo "$o_g" | cut -c5-6)")" \
+        -v alpha="$2" '
+function div255(x,  t) { t = x + 128; return int((t + int(t / 256)) / 256) }
+function chan(c, g,  f) {
+    f = int(int(c * alpha * 65535.0 / 255.0 + 0.5) / 256)
+    return f + div255(g * (255 - a8)) }
+BEGIN { a8 = int(int(alpha * 65535.0 + 0.5) / 256)
+    printf "#%02x%02x%02x\n", chan(cr, gr), chan(cg, gg), chan(cb, gb) }'
+}
+
+# heads FILE HEAD: gives 0 when the lines of HEAD stand once in FILE, in their
+# order. Else it gives 1 and prints the count of the last line of HEAD, or the
+# word head when that line stands once.
+heads() {
+    h_last=$(printf '%s\n' "$2" | tail -n 1)
+    h_count=$(grep -cxF -- "$h_last" "$1" || true)
+    if [ "$h_count" -ne 1 ]; then
+        echo "$h_count"
+        return 1
+    fi
+    h_at=$(grep -nxF -- "$h_last" "$1" | cut -d: -f1)
+    h_from=$((h_at - $(printf '%s\n' "$2" | wc -l) + 1))
+    if [ "$h_from" -lt 1 ] ||
+        [ "$(sed -n "${h_from},${h_at}p" "$1")" != "$2" ]; then
+        echo head
+        return 1
+    fi
+    return 0
+}
+
+# check SHEET: gives 0 while the seven contracts hold. It names the first
+# contract that fails on the standard error.
+check() {
+    c_sheet=$1
+
+    for c_block in $blocks; do
+        eval "c_head=\$head_$c_block"
+        eval "c_rows=\$rows_$c_block"
+
+        # 1. Each block holds one rule. The last line of its head stands once
+        # at column 0, and the lines above it are its other head lines in
+        # order.
+        if ! c_count=$(heads "$c_sheet" "$c_head"); then
+            if [ "$c_count" = head ]; then
+                note "the head of the $c_block rule of $c_sheet does not" \
+                     "read its selector lines in order"
+            else
+                note "$c_sheet holds $c_count $c_block rules, and not 1"
+            fi
+            return 1
+        fi
+        body "$c_sheet" "$c_head" > "$tmp/body"
+
+        # 2. The body holds one line per name in the order of the writer,
