+            c_name=${c_row%%=*}
+            c_at=$((c_at + 1))
+            c_line=$(sed -n "${c_at}p" "$tmp/body")
+            if ! printf '%s\n' "$c_line" |
+                grep -q "^  $c_name: #[0-9a-f]\\{6\\} !important;\$"
+            then
+                note "line $c_at of the $c_block rule of $c_sheet reads" \
+                     "'$c_line', and not $c_name with one hex colour"
+                return 1
+            fi
+        done
+        c_lines=$(wc -l < "$tmp/body")
+        if [ "$c_lines" -ne "$c_at" ]; then
+            note "the $c_block rule of $c_sheet holds $c_lines lines, and" \
+                 "not $c_at"
+            return 1
+        fi
+
+        # 3. Each name holds the first root value of its chrome row in the
+        # same sheet.
+        for c_row in $c_rows; do
+            c_name=${c_row%%=*}
+            c_root=${c_row#*=}
+            c_have=$(decl "$tmp/body" "$c_name")
+            c_want=$(rootvalue "$c_sheet" "$c_root")
+            if [ -z "$c_want" ] || [ "$c_have" != "$c_want" ]; then
+                note "$c_name of the $c_block rule of $c_sheet holds" \
+                     "$c_have over the root value $c_want of $c_root"
+                return 1
+            fi
+        done
+    done
