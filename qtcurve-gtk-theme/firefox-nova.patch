+#!/bin/sh
+# assert-ff-blocks.sh SHEET: the chrome sheet SHEET must hold the seven
+# contracts of check() below. The run then doctors fourteen copies of SHEET,
+# and it fails if the check passes a copy.
+set -eu
+usage='usage: assert-ff-blocks.sh SHEET'
+sheet=${1:?$usage}
+
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+
+# The scoped blocks in the order of the writer. The name of a block is the
+# prefix of its rows in the map.
+blocks='ring bar tabbutton account trust tabgroup private'
+# The head of each block holds its selector lines, and the rows hold one pair
+# NAME=ROOT for each body line, in order. ROOT is a root name of the chrome row
+# of NAME.
+head_ring='sidebar-tab-row[current] {'
+rows_ring='--tab-border-color-selected-leading=--color-accent-primary
+--tab-border-color-selected-trailing=--color-accent-primary'
+head_bar='notification-message {'
+rows_bar='--info-bar-text-color=--toolbar-text-color
+--message-bar-icon-color=--color-accent-primary
+--info-bar-border-color=--color-accent-primary'
+head_tabbutton='.tab-close-button,
+#tabs-newtab-button {'
+rows_tabbutton=\
+'--button-background-color-ghost-hover=--toolbarbutton-background-color-hover
+--button-background-color-ghost-active=--toolbarbutton-background-color-active'
+head_account='#appMenu-fxa-sign-in-promo,
+#PanelUI-fxa-menu-sign-in-promo,
+moz-promo[type="vibrant"] {'
+rows_account='--promo-background-color-vibrant=--panel-background-color
+--promo-message-text-color-vibrant=--panel-text-color'
+head_trust='#trustpanel-popup {'
+rows_trust='--trustpanel-highlight-bg=--panel-background-color'
+head_tabgroup='.tab-group-editor-panel {'
+rows_tabgroup='--input-text-background-color=--toolbar-field-background-color
+--input-background-color=--toolbar-field-background-color
+--input-text-color=--toolbar-field-text-color'
+head_private='.private-browsing-info-description > a {'
+rows_private='--link-color=--link-color'
+# The head of the rule of the bar button. The one line of the rule holds the
+# border of the button.
+head_button='.notification-button {'
+# The one line of the separator token block, between a root head and a
+# closing brace.
+sep_line='  --tabs-navbar-separator-style: none !important;'
+# The selector of a row of the places tree of the sidebar.
+tree='.sidebar-placesTreechildren::-moz-tree-row'
+# The heads of the five tree rules, one on each line. The first rule holds the
+# hovered row, and the four guard rules hold a selected row under the pointer.
+tree_heads="$tree(hover) {
+$tree(hover, selected) {
+$tree(hover, selected, focus) {
+.sidebar-panel[lwt-sidebar] $tree(hover, selected) {
+.sidebar-panel[lwt-sidebar-highlight] $tree(hover, selected, focus) {"
+# The value of each tree rule in the order of the heads, with HOVER in place of
+# the value of the hovered row. The four guard values are the browser values of
+# a selected row under the pointer.
+tree_values='HOVER
+-moz-cellhighlight
+SelectedItem
+light-dark(hsla(0, 0%, 80%, 0.3), rgba(249, 249, 250, 0.1))
+var(--lwt-sidebar-highlight-background-color)'
+# The alpha of the highlight over the sidebar ground in the hovered row, from
+# 0.0 to 1.0.
+hover_alpha=0.20
+# The root link names.
+links='--link-color --link-color-hover --link-color-active'
+# The WCAG 2 floor of a root link name on the panel colour (AA, normal text).
+floor=4.5
+# The ground of the second trust rule of one control below.
+planted='#141618'
+
+# note WORD...: prints one fault of the check that runs now, on one line.
+note() {
+    echo "assert-ff-blocks: $*" >&2
+}
+
+# esc TEXT: prints TEXT as a basic regular expression that matches TEXT alone.
+esc() {
+    printf '%s\n' "$1" | sed 's/[][\.*^$/]/\\&/g'
+}
+
+# body FILE HEAD: prints the lines of one rule of FILE, with no head line and
+# no brace line. The rule runs from the last line of HEAD to the first closing
+# brace at column 0.
+body() {
+    b_last=$(printf '%s\n' "$2" | tail -n 1)
+    sed -n "/^$(esc "$b_last")\$/,/^}\$/p" "$1" | sed '1d;/^}$/d'
+}
+
+# decl FILE NAME: prints the value of the custom property NAME in FILE.
+decl() {
+    sed -n "s/^  $2: \\(.*\\) !important;\$/\\1/p" "$1"
+}
+
+# rootvalue FILE NAME: prints the first value of the custom property NAME
+# over all the root rules of the chrome sheet FILE.
+rootvalue() {
+    sed -n '/^:root {$/,/^}$/p' "$1" |
+        sed -n "s/^  $2: \\(.*\\) !important;\$/\\1/p" | head -n 1
+}
+
+# lum HEX: prints the WCAG 2 relative luminance of the colour #rrggbb HEX.
+lum() {
+    l_hex=${1#\#}
+    awk -v r="$(printf '%d' "0x$(echo "$l_hex" | cut -c1-2)")" \
+        -v g="$(printf '%d' "0x$(echo "$l_hex" | cut -c3-4)")" \
+        -v b="$(printf '%d' "0x$(echo "$l_hex" | cut -c5-6)")" '
+function lin(c) { c = c / 255
+    return c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ^ 2.4 }
+BEGIN { printf "%.9f\n", 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b) }'
