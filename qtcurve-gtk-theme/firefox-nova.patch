+
+/**
+ * Returns the five rules of the places tree of the sidebar. The hovered row
+ * takes the view hover colour, and the four guard rules keep the browser
+ * values of a selected row under the pointer.
+ */
+QString
+sidebarTreeRows(const Options &opts, const FfPalette &pal)
+{
+    const struct {
+        const char *head;
+        QString value;
+    } rules[] = {
+        { ".sidebar-placesTreechildren::-moz-tree-row(hover)",
+          Gtk::hex(ffColour(opts, pal, FfRole::ViewHover)) },
+        { ".sidebar-placesTreechildren::-moz-tree-row(hover, selected)",
+          QStringLiteral("-moz-cellhighlight") },
+        { ".sidebar-placesTreechildren::-moz-tree-row(hover, selected, focus)",
+          QStringLiteral("SelectedItem") },
+        { ".sidebar-panel[lwt-sidebar] .sidebar-placesTreechildren"
+          "::-moz-tree-row(hover, selected)",
+          QStringLiteral("light-dark(hsla(0, 0%, 80%, 0.3),"
+                         " rgba(249, 249, 250, 0.1))") },
+        { ".sidebar-panel[lwt-sidebar-highlight] .sidebar-placesTreechildren"
+          "::-moz-tree-row(hover, selected, focus)",
+          QStringLiteral("var(--lwt-sidebar-highlight-background-color)") }
+    };
+    QString out;
+    for (const auto &rule : rules) {
+        out += QStringLiteral("\n%1 {\n"
+                              "  background-color: %2 !important;\n"
+                              "}\n")
+            .arg(QLatin1String(rule.head), rule.value);
+    }
+    return out;
+}
+
+/**
+ * The text of a destructive button in the light content half: the white of
+ * the browser.
+ */
+const QColor destructiveTextLight(0xff, 0xff, 0xff);
+
+/**
+ * The text of a destructive button in the dark content half: the Nova grey
+ * 100 of the browser.
+ */
+const QColor destructiveTextDark(0x15, 0x14, 0x1a);
+
+/**
+ * Returns the light-dark() pair of role: the colour of the light content half
+ * first, then the colour of the dark one.
+ */
+QString
+halfPair(const Options &opts, const FfPalette &pal, FfRole role)
+{
+    return QStringLiteral("light-dark(%1, %2)")
+        .arg(Gtk::hex(ffHalfColour(opts, pal, role, false)),
+             Gtk::hex(ffHalfColour(opts, pal, role, true)));
+}
+
+/** Returns the value of role in the form form of a content block. */
+QString
+formValue(const Options &opts, const FfPalette &pal, FfRole role,
+          FfForm form)
+{
+    switch (form) {
+    case FfForm::Hex:
+        return Gtk::hex(ffColour(opts, pal, role));
+    case FfForm::Pair:
+        return halfPair(opts, pal, role);
+    case FfForm::Light:
+        return Gtk::hex(ffHalfColour(opts, pal, role, false));
+    case FfForm::Dark:
+        return Gtk::hex(ffHalfColour(opts, pal, role, true));
+    }
+    Gtk::failUnknown("FfForm", (int)form);
+    return QString();
+}
+
+/**
+ * Returns the rule of block: the text prefix before its selector, then one
+ * line per name in the form of block. The frame line and the scheme line of
+ * block follow where block holds them, and the rule carries no leading blank
+ * line.
+ */
+QString
+blockRule(const Options &opts, const FfPalette &pal,
+          const FfContentBlock &block, const QString &prefix)
+{
+    QString out = QStringLiteral("%1%2 {\n")
+        .arg(prefix, QLatin1String(block.selector));
+    for (int row = 0;row < block.rowCount;++row) {
+        const QString value = formValue(opts, pal, block.rows[row].role,
+                                        block.form);
+        for (int i = 0;i < block.rows[row].varCount;++i) {
+            out += QStringLiteral("  %1: %2 !important;\n")
+                .arg(QLatin1String(block.rows[row].vars[i]), value);
+        }
+    }
+    if (block.frame) {
+        out += QStringLiteral("  box-shadow: 0 0 0 1px %1 !important;\n")
+            .arg(formValue(opts, pal, FfRole::WindowBorder, block.form));
+    }
+    if (block.scheme) {
+        out += QStringLiteral("  color-scheme: %1 !important;\n")
+            .arg(QLatin1String(block.scheme));
+    }
+    return out + QStringLiteral("}\n");
+}
+
+/**
+ * Returns one rule per scoped block of the content table, in the order of the
+ * table. Each host declares its names on an element of its own, so a rule of
+ * the root cannot reach them.
+ */
+QString
+contentBlocks(const Options &opts, const FfPalette &pal)
+{
+    QString out;
+    int count = 0;
+    const FfContentBlock *const blocks = ffContentBlocks(count);
+    for (int block = 0;block < count;++block) {
+        out += QLatin1Char('\n') +
+            blockRule(opts, pal, blocks[block], QString());
+    }
+    return out;
+}
+
+/**
+ * Returns the link rows of a root rule: the link pair of each state, which
+ * the two content halves read through light-dark(). The information icon
+ * takes the pair of the rest state.
+ */
+QString
+linkRows(const Options &opts, const FfPalette &pal)
+{
+    const struct {
+        const char *name;
+        FfRole light;
+        FfRole dark;
+    } links[] = {
+        { "--link-color", FfRole::LinkLight, FfRole::LinkDark },
+        { "--link-color-hover", FfRole::LinkHoverLight,
+          FfRole::LinkHoverDark },
+        { "--link-color-active", FfRole::LinkActiveLight,
+          FfRole::LinkActiveDark },
+        { "--icon-color-information", FfRole::LinkLight, FfRole::LinkDark }
+    };
+    QString out;
+    for (const auto &link : links) {
+        out += QStringLiteral("  %1: light-dark(%2, %3) !important;\n")
+            .arg(QLatin1String(link.name),
+                 Gtk::hex(ffColour(opts, pal, link.light)),
+                 Gtk::hex(ffColour(opts, pal, link.dark)));
+    }
+    return out;
+}
+
+/**
+ * Returns the deemphasized mix of the two content halves: color-mix() of
+ * currentColor at the share of each half.
+ */
+QString
+deemphasizedPair(const Options &opts, const FfPalette &pal)
+{
+    return QStringLiteral("light-dark("
+                          "color-mix(in srgb, currentColor %1%, transparent), "
+                          "color-mix(in srgb, currentColor %2%, transparent))")
+        .arg(ffDeemphasizedShare(opts, pal, false))
+        .arg(ffDeemphasizedShare(opts, pal, true));
+}
+
+/**
+ * Returns the line of the destructive button text of the root rule. The line
+ * holds the pair of the browser: white in the light half and the Nova grey
+ * 100 in the dark one.
+ */
+QString
+destructiveText()
+{
+    return QStringLiteral("  --button-text-color-destructive: "
+                          "light-dark(%1, %2) !important;\n")
+        .arg(Gtk::hex(destructiveTextLight), Gtk::hex(destructiveTextDark));
+}
+
+/**
+ * Returns the selection rule on selector: the selection text and ground, the
+ * image of the selection appearance over that ground and the selection
+ * radius. A flat appearance gives the image none, and the radius takes the
+ * size of the selection radius call of widgets.cpp.
+ */
+QString
+selectionRule(const Options &opts, const FfPalette &pal,
+              const char *selector)
+{
+    const QColor ground = ffColour(opts, pal, FfRole::Highlight);
+    return QStringLiteral("\n%1 {\n"
+                          "  color: %2 !important;\n"
+                          "  background-color: %3 !important;\n"
+                          "  background-image: %4 !important;\n"
+                          "  border-radius: %5 !important;\n"
+                          "}\n")
+        .arg(QLatin1String(selector),
+             Gtk::hex(ffColour(opts, pal, FfRole::HighlightText)),
+             Gtk::hex(ground),
+             Gtk::gradientImage(opts, opts.selectionAppearance,
+                                Gtk::fixedTone(ground)),
+             Gtk::radius(opts, 200, 20, WIDGET_SELECTION));
+}
+
+/**
+ * Returns the hover rule on selector, which holds the ground of a selected
+ * row under the pointer. Where image is true, the rule also holds the image
+ * of the selection appearance over that ground.
+ */
+QString
+selectedHoverRule(const Options &opts, const FfPalette &pal,
+                  const char *selector, bool image)
+{
+    const QColor ground = ffColour(opts, pal, FfRole::SelectedHover);
+    QString out = QStringLiteral("\n%1 {\n"
+                                 "  background-color: %2 !important;\n")
+        .arg(QLatin1String(selector), Gtk::hex(ground));
+    if (image) {
+        out += QStringLiteral("  background-image: %1 !important;\n")
+            .arg(Gtk::gradientImage(opts, opts.selectionAppearance,
+                                    Gtk::fixedTone(ground)));
+    }
+    return out + QStringLiteral("}\n");
+}
+
+/**
+ * Returns the row rule on selector: the view text and the view hover ground
+ * of a row under the pointer. Each value is the pair of the two content
+ * halves.
+ */
+QString
+rowHoverRule(const Options &opts, const FfPalette &pal, const char *selector)
+{
+    return QStringLiteral("\n%1 {\n"
+                          "  color: %2 !important;\n"
+                          "  background-color: %3 !important;\n"
+                          "}\n")
+        .arg(QLatin1String(selector), halfPair(opts, pal, FfRole::Text),
+             halfPair(opts, pal, FfRole::ViewHover));
+}
+
+/**
+ * Returns the current rule on selector: the outline colour of the current
+ * selected row at the selection text.
+ */
+QString
+currentRule(const Options &opts, const FfPalette &pal, const char *selector)
+{
+    return QStringLiteral("\n%1 {\n"
+                          "  outline-color: %2 !important;\n"
+                          "}\n")
+        .arg(QLatin1String(selector),
+             Gtk::hex(ffColour(opts, pal, FfRole::HighlightText)));
+}
+
+/**
+ * Returns the field rule on selector: the field text, the field ground and the
+ * frame, each as the pair of the two content halves. The rule reaches a plain
+ * text field that reads no custom property of its own, and flat gives it a
+ * solid border style.
+ */
+QString
+fieldRule(const Options &opts, const FfPalette &pal, const char *selector,
+          bool flat)
+{
+    QString out = QStringLiteral("\n%1 {\n"
+                                 "  color: %2 !important;\n"
+                                 "  background-color: %3 !important;\n"
+                                 "  border-color: %4 !important;\n")
+        .arg(QLatin1String(selector), halfPair(opts, pal, FfRole::Text),
+             halfPair(opts, pal, FfRole::Base),
+             halfPair(opts, pal, FfRole::WindowBorder));
+    if (flat) {
+        out += QStringLiteral("  border-style: solid !important;\n");
+    }
+    return out + QStringLiteral("}\n");
+}
+
+/**
+ * The selected item of a category list of a page, by its attribute or by its
+ * class. An item with subsections holds a second selection, and the selector
+ * leaves it out.
+ */
+const char *const categorySelector =
+    "#categories > .category:is([selected], .selected)"
+    ":not(:has(> .category-subsection))";
+
+/**
+ * Returns the two rules of the selected item of a category list: the
+ * selection text on the selection ground, and the ground under the pointer.
+ * An item can hold an icon as its background image, so no rule holds an image.
+ */
+QString
+categoryRows(const Options &opts, const FfPalette &pal)
+{
+    const QByteArray hover = QByteArray(categorySelector) + ":hover";
+    return QStringLiteral("\n%1 {\n"
+                          "  color: %2 !important;\n"
+                          "  background-color: %3 !important;\n"
+                          "}\n")
+        .arg(QLatin1String(categorySelector),
+             Gtk::hex(ffColour(opts, pal, FfRole::HighlightText)),
+             Gtk::hex(ffColour(opts, pal, FfRole::Highlight))) +
+        selectedHoverRule(opts, pal, hover.constData(), false);
+}
+
+/** The states of a text field that takes the mouse over frame. */
+const char *const fieldHoverStates = ":enabled:not(:focus):hover";
+
+/**
+ * Returns the body and the close of a rule of a text field under the
+ * pointer. The body holds the frame at the border step of the mouse over
+ * ladder.
+ */
+QString
+fieldHoverBody(const FfPalette &pal)
+{
+    return QStringLiteral(" {\n  border-color: light-dark(%1, %1) !important;\n"
+                          "}\n")
+        .arg(Gtk::hex(pal.mouseOver[QTC_STD_BORDER]));
+}
+
+/**
+ * Returns the rule of the field rule selector under the pointer. Each line of
+ * selector takes the states of fieldHoverStates, so the rule wins over the
+ * frame of the field rule.
+ */
+QString
+fieldHoverRule(const FfPalette &pal, const char *selector)
+{
+    QStringList heads = QString::fromLatin1(selector)
+        .split(QStringLiteral(",\n"));
+    for (QString &head : heads) {
+        head += QLatin1String(fieldHoverStates);
+    }
+    return QLatin1Char('\n') + heads.join(QStringLiteral(",\n")) +
+        fieldHoverBody(pal);
+}
+
+/**
+ * Returns the rule of the text fields of the pages under the pointer. The
+ * result is empty where the Qt style keeps the frame of a field.
+ */
+QString
+pageFields(const Options &opts, const FfPalette &pal)
+{
+    if (!ffFieldsMouseOver(opts)) {
+        return QString();
+    }
+    return QStringLiteral("\ninput:where([type=\"email\" i], [type=\"tel\" i],"
+                          " [type=\"text\" i], [type=\"password\" i],"
+                          " [type=\"url\" i], [type=\"number\" i],"
+                          " [type=\"search\" i])%1,\n"
+                          "input:not([type])%1,\n"
+                          "textarea%1")
+        .arg(QLatin1String(fieldHoverStates)) + fieldHoverBody(pal);
+}
+
+/**
+ * Returns the page blocks of the content sheet: one scope line per block with
+ * the rules of the block. Where it names them, a block then holds its view
+ * rule at the field pairs and its selection, hover, row, current and field
+ * rules.
+ */
+QString
+pageBlocks(const Options &opts, const FfPalette &pal)
+{
+    QString out;
+    int count = 0;
+    const FfPageBlock *const blocks = ffPageBlocks(count);
+    for (int block = 0;block < count;++block) {
+        out += QStringLiteral("\n@-moz-document %1 {\n")
+            .arg(QLatin1String(blocks[block].scope));
+        const int first = out.size();
+        for (int rule = 0;rule < blocks[block].ruleCount;++rule) {
+            if (rule > 0) {
+                out += QLatin1Char('\n');
+            }
+            out += blockRule(opts, pal, blocks[block].rules[rule], QString());
+        }
+        if (blocks[block].textSelector) {
+            out += QStringLiteral("\n%1 {\n  color: %2 !important;\n"
+                                  "  background-color: %3 !important;\n}\n")
+                .arg(QLatin1String(blocks[block].textSelector),
+                     halfPair(opts, pal, FfRole::Text),
+                     halfPair(opts, pal, FfRole::Base));
+        }
+        if (blocks[block].selectedSelector) {
+            out += selectionRule(opts, pal, blocks[block].selectedSelector);
+        }
+        if (blocks[block].selectedHoverSelector) {
+            out += selectedHoverRule(
+                opts, pal, blocks[block].selectedHoverSelector,
+                blocks[block].selectedSelector != nullptr);
+        }
+        if (blocks[block].rowHoverSelector) {
+            out += rowHoverRule(opts, pal, blocks[block].rowHoverSelector);
+        }
+        if (blocks[block].currentSelector) {
+            out += currentRule(opts, pal, blocks[block].currentSelector);
+        }
+        if (blocks[block].fieldSelector) {
+            out += fieldRule(opts, pal, blocks[block].fieldSelector,
+                             blocks[block].flatField);
+            if (ffFieldsMouseOver(opts)) {
+                out += fieldHoverRule(pal, blocks[block].fieldSelector);
+            }
+        }
+        // A rule of a selector carries one blank line in front, which a
+        // block with no table rule does not take after its scope line.
+        if (blocks[block].ruleCount == 0 && out.size() > first) {
+            out.remove(first, 1);
+        }
+        out += QStringLiteral("}\n");
+    }
+    return out;
+}
+
+/**
+ * Returns the rule that keeps a closed drop down box of the viewer at the
+ * accent under the pointer, the colour of its rest border. The result is
+ * empty where the Qt style colours the frame of a button under the pointer.
+ */
+QString
+restBox(const Options &opts, const FfPalette &pal, const QString &scope)
+{
+    if (ffFramesMouseOver(opts)) {
+        return QString();
+    }
+    return QStringLiteral("\n%1 .dropdownToolbarButton"
+                          ":not(:has(> select:open)) {\n"
+                          "  --border-color-interactive-hover: %2"
+                          " !important;\n"
+                          "}\n")
+        .arg(scope, halfPair(opts, pal, FfRole::Highlight));
+}
+
+/**
+ * Returns the two rules of the colour inputs of the editor bars under scope:
+ * the rule at rest and the rule under the pointer. The frame and the ground
+ * ring take 1px each and fill the 2px border of the user agent sheet, so the
+ * swatch keeps its place.
+ */
+QString
+colourInputs(const Options &opts, const FfPalette &pal, const QString &scope)
+{
+    // The class names the two inputs of the editor bars. The type selector
+    // also reaches the colour button of an edit toolbar, a flat tool button.
+    return QStringLiteral("\n%1 .editorParamsColor {\n"
+                          "  background-color: %2 !important;\n"
+                          "  border-color: %3 !important;\n"
+                          "  border-style: solid !important;\n"
+                          "  border-width: 1px !important;\n"
+                          "  padding: 1px !important;\n"
+                          "}\n"
+                          "\n%1 .editorParamsColor:enabled:hover {\n"
+                          "  background-color: %4 !important;\n"
+                          "  border-color: %5 !important;\n"
+                          "}\n")
+        .arg(scope, halfPair(opts, pal, FfRole::Button),
+             halfPair(opts, pal, FfRole::ButtonBorder),
+             halfPair(opts, pal, FfRole::ButtonHover),
+             halfPair(opts, pal, FfRole::ButtonMouseOver));
+}
+
+/**
+ * Returns the rule of the tool buttons of the viewer under the pointer. A
+ * shadow of one pixel inside the button holds their frame, and a pressed or a
+ * toggled button takes none.
+ */
+QString
+toolButtons(const Options &opts, const FfPalette &pal, const QString &scope)
+{
+    // A button of the views manager holds a border of its own, so the first
+    // head leaves it out.
+    return QStringLiteral("\n%1 .toolbarButton"
+                          ":not(.labeled, .toggled, .viewsManagerButton)"
+                          ":hover:not(:active),\n"
+                          "%1 .editToolbar .buttons > :not(.divider)"
+                          ":hover:not(:active) {\n"
+                          "  box-shadow: inset 0 0 0 1px %2 !important;\n"
+                          "}\n")
+        .arg(scope, halfPair(opts, pal, FfRole::ButtonMouseOver));
+}
+
+/**
+ * Returns the root rule of the PDF viewer document with its hex, pair and
+ * link rows and the deemphasized mix, then its descendant rules. The rules of
+ * its colour inputs follow, and a last rule gives the secondary text of the
+ * dialogs and the disabled menu text that mix.
+ */
+QString
+viewerRules(const Options &opts, const FfPalette &pal)
+{
+    const QString scope = QLatin1String(ffViewerScope);
