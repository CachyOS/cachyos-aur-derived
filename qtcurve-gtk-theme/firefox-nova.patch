+/**
+ * Returns the least share of currentColor, in percent from floor, at which
+ * both texts read at the link floor plus the margin on each ground. The
+ * grounds are the first count colours of grounds, and a search with no such
+ * share under 100 gives 100.
+ */
+int
+leastShare(const QColor (&texts)[2], const QColor *grounds, int count,
+           int floor)
+{
+    const double target = linkRatioFloor + linkRatioMargin;
+    for (int share = floor;share < 100;++share) {
+        bool reads = true;
+        for (const QColor &text : texts) {
+            for (int i = 0;i < count && reads;++i) {
+                if (contrast(mixOver(text, share / 100.0, grounds[i]),
+                             grounds[i]) < target) {
+                    reads = false;
+                }
+            }
+        }
+        if (reads) {
+            return share;
+        }
+    }
+    return 100;
+}
