+
+# share VALUE N: prints the share, in percent, of the half N (1 light, 2
+# dark) of the placeholder mix VALUE.
+share() {
+    s_half='color-mix(in srgb, currentColor \([0-9]*\)%, transparent)'
+    printf '%s\n' "$1" | sed -n "s/^light-dark($s_half, $s_half)\$/\\$2/p"
+}
+
+# lum HEX: prints the WCAG 2 relative luminance of the colour #rrggbb HEX.
+lum() {
+    l_hex=${1#\#}
+    awk -v r="$(printf '%d' "0x$(echo "$l_hex" | cut -c1-2)")" \
+        -v g="$(printf '%d' "0x$(echo "$l_hex" | cut -c3-4)")" \
+        -v b="$(printf '%d' "0x$(echo "$l_hex" | cut -c5-6)")" '
+function lin(c) { c = c / 255
+    return c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ^ 2.4 }
+BEGIN { printf "%.9f\n", 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b) }'
+}
+
+# ratio HEX HEX: prints the WCAG 2 contrast ratio of the two colours, from
+# 1.0 to 21.0.
+ratio() {
+    awk -v a="$(lum "$1")" -v b="$(lum "$2")" 'BEGIN {
+        if (a < b) { t = a; a = b; b = t }
+        printf "%.9f\n", (a + 0.05) / (b + 0.05) }'
+}
+
+# under FG BG: gives 0 when the ratio of FG on BG is under the floor.
+under() {
+    awk -v r="$(ratio "$1" "$2")" -v f="$floor" 'BEGIN { exit !(r < f) }'
+}
+
+# mix HEX SHARE GROUND: prints the colour that the browser paints for HEX at
+# the share SHARE, in percent, over the opaque colour GROUND. The mix of HEX
+# with transparent gives that colour, and each channel rounds to the nearest
+# eight bit value.
+mix() {
+    m_c=${1#\#}
+    m_g=${3#\#}
+    awk -v cr="$(printf '%d' "0x$(echo "$m_c" | cut -c1-2)")" \
+        -v cg="$(printf '%d' "0x$(echo "$m_c" | cut -c3-4)")" \
+        -v cb="$(printf '%d' "0x$(echo "$m_c" | cut -c5-6)")" \
+        -v gr="$(printf '%d' "0x$(echo "$m_g" | cut -c1-2)")" \
+        -v gg="$(printf '%d' "0x$(echo "$m_g" | cut -c3-4)")" \
+        -v gb="$(printf '%d' "0x$(echo "$m_g" | cut -c5-6)")" \
+        -v s="$2" '
+function chan(c, g) { return int(s / 100 * c + (1 - s / 100) * g + 0.5) }
+BEGIN { printf "#%02x%02x%02x\n", chan(cr, gr), chan(cg, gg), chan(cb, gb) }'
+}
+
+# want FILE ROW: prints the value that ROW (NAME=ANCHOR=FORM) must hold in
+# FILE, or nothing for the forms free, loose, scheme, menu, image and px.
+want() {
+    w_rest=${2#*=}
+    w_anchor=${w_rest%%=*}
+    case ${2##*=} in
+        hex|pair|mix) anchor "$1" "$w_anchor";;
+        same) w_one=$(anchor "$1" "$w_anchor")
+              [ -z "$w_one" ] || echo "light-dark($w_one, $w_one)";;
+        light) half "$(anchor "$1" "$w_anchor")" 1;;
+        dark) half "$(anchor "$1" "$w_anchor")" 2;;
+        panel) panelvalue "$1" "$w_anchor";;
+        vpair) vanchor "$1" "$w_anchor";;
+        vsame) w_one=$(vanchor "$1" "$w_anchor")
+               [ -z "$w_one" ] || echo "light-dark($w_one, $w_one)";;
+    esac
+}
+
+# shape ROW: prints the value shape of the row ROW.
+shape() {
+    case ${1##*=} in
+        hex|light|dark|free) echo "$hex";;
+        mix) echo "$mixshape";;
+        scheme) echo 'light dark';;
+        image) echo "$image";;
+        px) echo "$px";;
+        *) echo "$pair";;
+    esac
+}
+
+# expect FILE N TEXT WHAT: gives 0 when line N of FILE reads TEXT.
+expect() {
+    e_have=$(sed -n "${2}p" "$1")
+    if [ "$e_have" != "$3" ]; then
+        note "line $2 of $1 reads '$e_have', and not $4"
+        return 1
+    fi
+    return 0
+}
+
+# rule FILE N HEAD ROWS WHAT: gives 0 when line N of FILE starts the rule WHAT
+# of the head HEAD and the rows ROWS. It then leaves the line after the close
+# in r_next; else it gives 1 and names the first fault on the standard error.
+rule() {
+    r_file=$1
+    r_at=$2
+    r_what=$5
+    printf '%s\n' "$3" > "$tmp/rule-head"
+    while IFS= read -r r_line; do
+        expect "$r_file" "$r_at" "$r_line" "a head line of the $r_what rule" ||
+            return 1
+        r_at=$((r_at + 1))
+    done < "$tmp/rule-head"
+    for r_row in $4; do
+        r_name=${r_row%%=*}
+        r_form=${r_row##*=}
+        r_line=$(sed -n "${r_at}p" "$r_file")
+        if ! printf '%s\n' "$r_line" |
+            grep -q "^  $r_name: $(shape "$r_row") !important;\$"
+        then
+            note "line $r_at of $r_file reads '$r_line', and not $r_name of" \
+                 "the $r_what rule in the form $r_form"
+            return 1
+        fi
+        r_want=$(want "$r_file" "$r_row")
+        case $r_form in
+            free|loose|scheme|image|px) ;;
+            *)
+                r_have=$(printf '%s\n' "$r_line" |
+                    sed -n "s/^  $r_name: \\(.*\\) !important;\$/\\1/p")
+                if [ -z "$r_want" ] || [ "$r_have" != "$r_want" ]; then
+                    r_rest=${r_row#*=}
+                    note "$r_name of the $r_what rule of $r_file holds" \
+                         "$r_have over the $r_form value $r_want of" \
+                         "${r_rest%%=*}"
+                    return 1
+                fi;;
+        esac
+        r_at=$((r_at + 1))
+    done
+    expect "$r_file" "$r_at" '}' "the close of the $r_what rule" || return 1
+    r_next=$((r_at + 1))
+    return 0
+}
+
+# check SHEET: gives 0 while the ten contracts hold. It names the first
+# contract that fails on the standard error.
+check() {
+    c_sheet=$1
+    if [ "$(sed -n 6p "$c_sheet")" != "$scope" ]; then
+        note "line 6 of $c_sheet reads '$(sed -n 6p "$c_sheet")', and not" \
+             "the scope line"
+        return 1
+    fi
+    c_root_end=$(sed -n '7,$p' "$c_sheet" | grep -n '^}$' | head -n 1 |
+                     cut -d: -f1)
+    c_root_end=$((c_root_end + 6))
+    c_prev=$c_root_end
+    for c_block in $blocks; do
+        eval "c_head=\$head_$c_block"
+        eval "c_rows=\$rows_$c_block"
+
+        # 1. Each block holds one rule, in the order of the writer, after one
+        # blank line. The last line of its head stands once at column 0, and
+        # the lines above it are its other head lines in order.
+        if ! c_count=$(heads "$c_sheet" "$c_head"); then
+            if [ "$c_count" = head ]; then
+                note "the head of the $c_block rule of $c_sheet does not" \
+                     "read its selector lines in order"
+            else
+                note "$c_sheet holds $c_count $c_block rules, and not 1"
+            fi
+            return 1
+        fi
+        c_at=$(at "$c_sheet" "$c_head")
+        c_first=$((c_at - $(printf '%s\n' "$c_head" | wc -l) + 1))
+        if [ "$c_first" -ne $((c_prev + 2)) ] ||
+            [ -n "$(sed -n "$((c_prev + 1))p" "$c_sheet")" ]; then
+            note "the $c_block rule of $c_sheet starts at line $c_first," \
+                 "and not after one blank line at $((c_prev + 2))"
+            return 1
+        fi
+        body "$c_sheet" "$c_head" > "$tmp/body"
+        c_prev=$((c_at + $(wc -l < "$tmp/body") + 1))
+
+        # 2. The body holds one line per name in the order of the writer and
+        # no other line. Each line holds the value form of its row under
+        # !important.
+        c_n=0
+        for c_row in $c_rows; do
+            c_name=${c_row%%=*}
+            c_form=${c_row##*=}
+            c_n=$((c_n + 1))
+            c_line=$(sed -n "${c_n}p" "$tmp/body")
+            if ! printf '%s\n' "$c_line" |
+                grep -q "^  $c_name: $(shape "$c_row") !important;\$"
+            then
+                note "line $c_n of the $c_block rule of $c_sheet reads" \
+                     "'$c_line', and not $c_name in the form $c_form"
+                return 1
+            fi
+        done
+        c_lines=$(wc -l < "$tmp/body")
+        if [ "$c_lines" -ne "$c_n" ]; then
+            note "the $c_block rule of $c_sheet holds $c_lines lines, and" \
+                 "not $c_n"
+            return 1
+        fi
+
+        # 3. Each name holds the value of its anchor in the root rule of the
+        # same sheet, in the form of its row.
+        for c_row in $c_rows; do
+            c_name=${c_row%%=*}
+            c_rest=${c_row#*=}
+            c_anchor=${c_rest%%=*}
+            c_form=${c_row##*=}
+            c_have=$(value "$tmp/body" "$c_name")
+            case $c_form in
+                menu|free) continue;;
+            esac
+            c_want=$(want "$c_sheet" "$c_row")
+            if [ -z "$c_want" ] || [ "$c_have" != "$c_want" ]; then
+                note "$c_name of the $c_block rule of $c_sheet holds" \
+                     "$c_have over the $c_form value $c_want of $c_anchor"
+                return 1
+            fi
+        done
+    done
+
+    # 4. The menu rule. In each half, a hovered row on the root highlight
+    # holds the root highlight text. A hovered row on another ground holds
+    # the root button text, and that ground differs from the root view hover.
+    # The pressed row holds the hovered values.
+    body "$c_sheet" "$head_menu" > "$tmp/menu"
+    c_hover=$(value "$tmp/menu" --button-background-color-menu-hover)
+    c_active=$(value "$tmp/menu" --button-background-color-menu-active)
+    c_text=$(value "$tmp/menu" --button-text-color-menu-hover)
+    c_textactive=$(value "$tmp/menu" --button-text-color-menu-active)
+    if [ "$c_hover" != "$c_active" ] || [ "$c_text" != "$c_textactive" ]; then
+        note "the pressed menu row of $c_sheet differs from the hovered row"
+        return 1
+    fi
+    c_high=$(anchor "$c_sheet" --color-accent-primary)
+    c_hightext=$(anchor "$c_sheet" --button-text-color-primary)
+    c_view=$(anchor "$c_sheet" --button-background-color-menu-hover)
+    c_button=$(anchor "$c_sheet" --button-text-color)
+    for c_n in 1 2; do
+        c_h=$(half "$c_hover" $c_n)
+        c_t=$(half "$c_text" $c_n)
+        if [ "$c_h" = "$c_high" ]; then
+            if [ "$c_t" != "$c_hightext" ]; then
+                note "the menu row of $c_sheet holds the highlight $c_h with" \
+                     "the text $c_t, and not the highlight text $c_hightext"
+                return 1
+            fi
+        else
+            if [ "$c_h" = "$(half "$c_view" $c_n)" ]; then
+                note "the menu row of $c_sheet holds the view hover $c_h"
+                return 1
+            fi
+            if [ "$c_t" != "$(half "$c_button" $c_n)" ]; then
+                note "the menu row of $c_sheet holds the text $c_t over the" \
+                     "button text $(half "$c_button" $c_n)"
+                return 1
+            fi
+        fi
+    done
+
+    # 5. The placeholder rule follows the last content block after one blank
+    # line: its head, one mix line and its close. Each share stands from the
+    # share of the browser to 100, and it applies to the page text and the
+    # field text of its half. At that share, each text reads at the floor or
+    # over it on the box and on the field of the half.
+    c_line=$(sed -n "$((c_prev + 2))p" "$c_sheet")
+    if [ -n "$(sed -n "$((c_prev + 1))p" "$c_sheet")" ] ||
+        [ "$c_line" != "$head_placeholder" ]; then
+        note "line $((c_prev + 2)) of $c_sheet reads '$c_line', and not the" \
+             "placeholder rule after one blank line"
+        return 1
+    fi
+    c_mixline=$(sed -n "$((c_prev + 3))p" "$c_sheet")
+    if ! printf '%s\n' "$c_mixline" |
+        grep -q "^  color: $mixshape !important;\$"
+    then
+        note "line $((c_prev + 3)) of $c_sheet reads '$c_mixline', and not" \
+             "the placeholder mix with a pair of shares"
+        return 1
+    fi
+    if [ "$(sed -n "$((c_prev + 4))p" "$c_sheet")" != '}' ]; then
+        note "line $((c_prev + 4)) of $c_sheet reads" \
+             "'$(sed -n "$((c_prev + 4))p" "$c_sheet")', and not the close" \
+             "of the placeholder rule"
+        return 1
+    fi
+    c_mix=$(printf '%s\n' "$c_mixline" |
+                sed -n 's/^  color: \(.*\) !important;$/\1/p')
+    c_field=$(anchor "$c_sheet" --newtab-background-color-secondary)
+    for c_n in 1 2; do
+        c_share=$(share "$c_mix" $c_n)
+        if [ -z "$c_share" ] || [ "$c_share" -lt "$minshare" ] ||
+            [ "$c_share" -gt 100 ]; then
+            note "half $c_n of the placeholder rule of $c_sheet holds the" \
+                 "share '$c_share', outside $minshare to 100"
+            return 1
+        fi
+        if [ $c_n -eq 1 ]; then
+            c_grounds="$light_box $(half "$c_field" 1)"
+        else
+            c_grounds="$dark_box $(half "$c_field" 2)"
+        fi
+        for c_name in --text-color --input-text-color; do
+            c_text=$(half "$(anchor "$c_sheet" $c_name)" $c_n)
+            for c_g in $c_grounds; do
+                c_mixed=$(mix "$c_text" "$c_share" "$c_g")
+                if under "$c_mixed" "$c_g"; then
+                    note "half $c_n of the placeholder rule of $c_sheet" \
+                         "paints $c_name as $c_mixed on $c_g at" \
+                         "$(ratio "$c_mixed" "$c_g" |
+                            awk '{ printf "%.2f", $1 }'), under $floor"
+                    return 1
+                fi
+            done
+        done
+    done
+    c_prev=$((c_prev + 4))
+
+    # 6. The accent block closes after the placeholder rule.
+    expect "$c_sheet" $((c_prev + 1)) '}' 'the close of the accent block' ||
+        return 1
+    c_at=$((c_prev + 2))
+
+    # 7. The page blocks follow, each after one blank line. A block holds its
+    # scope line and its rules, with one blank line between two rules. A
+    # block with a view rule then holds it, after one blank line. The view
+    # rule holds the view text at the field text pair and the view ground at
+    # the field ground pair. A block with a selection rule or a field rule
+    # then holds them, each after one blank line, at the anchors of their
+    # rows. The close of the block follows.
+    c_fieldtext=$(anchor "$c_sheet" "$fieldtext")
+    c_fieldground=$(anchor "$c_sheet" "$fieldground")
+    for c_page in $pages; do
+        eval "c_scope=\$scope_$c_page"
+        eval "c_rules=\$rules_$c_page"
+        eval "c_text=\$text_$c_page"
+        expect "$c_sheet" "$c_at" '' "a blank line before the $c_page block" ||
+            return 1
+        expect "$c_sheet" $((c_at + 1)) "$c_scope" \
+               "the scope line of the $c_page block" || return 1
+        c_at=$((c_at + 2))
+        c_first=1
+        for c_rule in $c_rules; do
+            if [ "$c_first" -eq 0 ]; then
+                expect "$c_sheet" "$c_at" '' \
+                       "a blank line before the $c_rule rule" || return 1
+                c_at=$((c_at + 1))
+            fi
+            c_first=0
+            eval "c_head=\$head_$c_rule"
+            eval "c_rows=\$rows_$c_rule"
+            rule "$c_sheet" "$c_at" "$c_head" "$c_rows" "$c_rule" || return 1
+            c_at=$r_next
+        done
+        if [ -n "$c_text" ]; then
+            expect "$c_sheet" "$c_at" '' \
+                   "a blank line before the view rule of the $c_page block" ||
+                return 1
+            c_at=$((c_at + 1))
+            printf '%s\n' "$c_text" > "$tmp/text-head"
+            while IFS= read -r c_line; do
+                expect "$c_sheet" "$c_at" "$c_line" \
+                       "a head line of the view rule of the $c_page block" ||
+                    return 1
+                c_at=$((c_at + 1))
+            done < "$tmp/text-head"
+            expect "$c_sheet" "$c_at" "  color: $c_fieldtext !important;" \
+                   "the view rule of the $c_page block at the field text" \
+                   "pair" || return 1
+            expect "$c_sheet" $((c_at + 1)) \
+                   "  background-color: $c_fieldground !important;" \
+                   "the view ground of the $c_page block at the field" \
+                   "ground pair" || return 1
+            expect "$c_sheet" $((c_at + 2)) '}' \
+                   "the close of the view rule of the $c_page block" ||
+                return 1
+            c_at=$((c_at + 3))
+        fi
+        eval "c_sel=\$sel_$c_page"
+        if [ -n "$c_sel" ]; then
+            eval "c_selrows=\$selrows_$c_page"
+            expect "$c_sheet" "$c_at" '' "a blank line before the selection \
+rule of the $c_page block" || return 1
+            rule "$c_sheet" $((c_at + 1)) "$c_sel" "$c_selrows" \
+                 "$c_page selection" || return 1
+            c_at=$r_next
+        fi
+        eval "c_field=\$field_$c_page"
+        if [ -n "$c_field" ]; then
+            expect "$c_sheet" "$c_at" '' "a blank line before the field rule \
+of the $c_page block" || return 1
+            rule "$c_sheet" $((c_at + 1)) "$c_field" "$fieldrows" \
+                 "$c_page field" || return 1
+            c_at=$r_next
+        fi
+        expect "$c_sheet" "$c_at" '}' "the close of the $c_page block" ||
+            return 1
+        c_at=$((c_at + 1))
+    done
+
+    # 8. The root rule of the viewer follows after one blank line. Its focus
+    # colour holds one hex colour, and its other hex names hold their root
+    # values. Its pair names and its link names hold their root pairs. Its
+    # menu names hold the values of the menu rule, its border names hold one
+    # pair, and its mix holds its root value.
+    expect "$c_sheet" "$c_at" '' 'a blank line before the viewer rule' ||
+        return 1
+    rule "$c_sheet" $((c_at + 1)) "$head_viewer" "$rows_viewer" viewer ||
+        return 1
+    c_at=$r_next
+
+    # 9. The descendant rules of the viewer follow in order, each after one
+    # blank line. Each row with an anchor holds the value of that anchor in the
+    # form of its row. The scheme row of the editbar rule holds light dark.
+    for c_block in $vblocks; do
+        eval "c_head=\$head_$c_block"
+        eval "c_rows=\$rows_$c_block"
+        expect "$c_sheet" "$c_at" '' "a blank line before the $c_block rule" ||
+            return 1
+        rule "$c_sheet" $((c_at + 1)) "$c_head" "$c_rows" "$c_block" ||
+            return 1
+        c_at=$r_next
+    done
+
+    # 10. The rules of the blocked site page follow byte for byte, nothing
+    # follows them, and the sheet holds the scope lines of its blocks.
+    c_tail=$(sed -n "$c_at,\$p" "$c_sheet")
+    if [ "$c_tail" != "$blocked" ]; then
+        note "the blocked site rule of $c_sheet differs from its text"
+        return 1
+    fi
+    if [ "$(grep -c '^@-moz-document ' "$c_sheet")" -ne "$scopes" ]; then
+        note "$c_sheet holds $(grep -c '^@-moz-document ' "$c_sheet")" \
+             "scope lines, and not $scopes"
+        return 1
+    fi
+    return 0
+}
+
+if ! check "$sheet"; then
+    note "the sheet fails the check"
+    exit 1
+fi
+
+# The controls below. Each one doctors a copy of the sheet, and the check must
+# fail over that copy.
+broken=0
+
+# control NAME COPY: the check must fail over the copy that the caller gives.
+control() {
+    k_name=$1
+    if check "$2" 2> "$tmp/control.log"; then
+        note "the check passed the control copy of $k_name"
+        exit 1
+    fi
+    broken=$((broken + 1))
+}
+
+# (a) The nav rule cut out, with its blank line.
+sed "/^$(esc "$head_nav")\$/,/^}\$/d" "$sheet" | sed '/^$/N;/^\n$/D' \
+    > "$tmp/a.css"
+control 'the nav rule cut out' "$tmp/a.css"
+
+# (b) The body of the select rule indented by two more spaces, the nested
+# layout.
+sed "/^$(esc "$head_select")\$/,/^}\$/s/^  --/    --/" "$sheet" > "$tmp/b.css"
+control 'the nested layout of the select rule' "$tmp/b.css"
+
+# (c) The selected option at the hover accent of the root.
+accent=$(anchor "$sheet" --color-accent-primary-hover)
+range="/^$(esc "$head_select")\$/,/^}\$/"
+row="  --button-background-color-selected: $accent !important;"
+sed "${range}s/^  --button-background-color-selected: .*\$/$row/" "$sheet" \
+    > "$tmp/c.css"
+control 'the selected option at the hover accent' "$tmp/c.css"
+
+# (d) The nav pair with its halves swapped.
+nav=$(anchor "$sheet" --button-background-color-menu-hover)
+swapped="light-dark($(half "$nav" 2), $(half "$nav" 1))"
+sed "s/^  --page-nav-button-background-color-hover: .*\$/"\
+"  --page-nav-button-background-color-hover: $swapped !important;/" "$sheet" \
+    > "$tmp/d.css"
+control 'the nav pair with its halves swapped' "$tmp/d.css"
+
+# (e) The search box ground at the light half of the field pair.
+field=$(anchor "$sheet" --newtab-background-color-secondary)
+name=--content-search-handoff-ui-background-color
+sed "s/^  $name: .*\$/  $name: $(half "$field" 1) !important;/" "$sheet" \
+    > "$tmp/e.css"
+control 'the search box ground at the light half' "$tmp/e.css"
+
+# (f) The menu row at the view hover pair of the root.
+range="/^$(esc "$head_menu")\$/,/^}\$/"
+menurow='--button-background-color-menu-'
+sed "${range}s/^  $menurow\\(hover\\|active\\): .*\$/"\
+"  $menurow\\1: $nav !important;/" "$sheet" > "$tmp/f.css"
+control 'the menu row at the view hover' "$tmp/f.css"
+
+# (g) The menu row at the highlight with the button text kept.
+high=$(anchor "$sheet" --color-accent-primary)
+sed "${range}s/^  $menurow\\(hover\\|active\\): .*\$/"\
+"  $menurow\\1: light-dark($high, $high) !important;/" "$sheet" > "$tmp/g.css"
+control 'the menu row at the highlight with the button text' "$tmp/g.css"
+
+# (h) The blocked site rule cut out.
+sed '/^@-moz-document url-prefix("about:blocked") {$/,$d' "$sheet" |
+    sed '$d' > "$tmp/h.css"
+control 'the blocked site rule cut out' "$tmp/h.css"
+
+# (i) The blocked site text at the dark half of the page text.
+text=$(half "$(anchor "$sheet" --text-color)" 2)
+range='/^@-moz-document url-prefix("about:blocked") {$/,$'
+sed "${range}s/^  --text-color: .*\$/  --text-color: $text !important;/" \
