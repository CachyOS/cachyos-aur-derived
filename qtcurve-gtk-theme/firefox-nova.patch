+                          "  --toolbarbutton-outline: 1px solid"
+                          " color-mix(in srgb, %1 %2%, transparent)"
+                          " !important;\n"
+                          "}\n"
+                          "\n.private-browsing-indicator-button >"
+                          " .toolbarbutton-icon {\n"
+                          "  fill: %1 !important;\n"
+                          "}\n")
+        .arg(Gtk::hex(ffColour(opts, pal, FfRole::Highlight)))
+        .arg(privateOutlineShare);
+}
+
+/**
+ * Returns the three rules of a switch that is on, where the browser holds a
+ * clear border. The rules give that switch the border names of a switch that
+ * is off: at rest, under the pointer and pressed.
+ */
+QString
+switchFrames()
+{
+    return QStringLiteral(
+        "\n.toggle-button[aria-pressed=\"true\"] {\n"
+        "  border-color: var(--toggle-border-color) !important;\n"
+        "}\n"
+        "\n.toggle-button[aria-pressed=\"true\"]:enabled:hover {\n"
+        "  border-color: var(--toggle-border-color-hover) !important;\n"
+        "}\n"
+        "\n.toggle-button[aria-pressed=\"true\"]:enabled:hover:active {\n"
+        "  border-color: var(--toggle-border-color-active) !important;\n"
+        "}\n");
