+control 'the hover rule of the row pages cut out' "$tmp/bd.css"
+
+# (be) The hover ground of the row pages at the root highlight, the ground of
+# a selected row at rest.
+hrange="/^$(esc "$hover_rows")\$/,/^}\$/"
+sed "${hrange}s/^  background-color: .*\$/"\
+"  background-color: $high !important;/" "$sheet" > "$tmp/be.css"
+control 'the hover ground at the root highlight' "$tmp/be.css"
+
+# (bf) The image line of the hover rule of the row pages cut out.
+sed "${hrange}{/^  background-image: /d;}" "$sheet" > "$tmp/bf.css"
+control 'the hover image cut out' "$tmp/bf.css"
+
+# (bg) The current rule of the downloads block cut out, with its blank line.
+currentlast=$(printf '%s\n' "$current_downloads" | tail -n 1)
+sed "/^$(esc "$currentlast")\$/,/^}\$/d" "$sheet" | sed '/^$/N;/^\n$/D' \
+    > "$tmp/bg.css"
+control 'the current rule cut out' "$tmp/bg.css"
+
+# (bh) The outline of the current row at the root highlight, the colour of
+# the ground of that row.
+sed "s/^  outline-color: .*\$/  outline-color: $high !important;/" "$sheet" \
+    > "$tmp/bh.css"
+control 'the current outline at the highlight' "$tmp/bh.css"
+
+# (bi) The block of the passkey page cut out, with its blank line.
+sed "/^$(esc "$scope_webauthn")\$/,/^}\$/{/^}\$/N;d;}" "$sheet" |
+    sed '/^$/N;/^\n$/D' > "$tmp/bi.css"
+control 'the passkey block cut out' "$tmp/bi.css"
+
+# (bj) The scope line of the passkey block widened to every about: page.
+sed 's/^@-moz-document url-prefix("about:webauthn") {$/'\
+'@-moz-document url-prefix("about:") {/' "$sheet" > "$tmp/bj.css"
+control 'the passkey scope line widened' "$tmp/bj.css"
+
+# (bk) The rest rule of the colour inputs cut out, with its blank line.
+sed "/^$(esc "$head_colour")\$/,/^}\$/d" "$sheet" | sed '/^$/N;/^\n$/D' \
+    > "$tmp/bk.css"
+control 'the colour input rule cut out' "$tmp/bk.css"
+
+# (bl) The frame of a colour input under the pointer at the frame pair of the
+# root rule, the frame at rest.
+sed "/^$(esc "$head_colourhover")\$/,/^}\$/s/^  border-color: .*\$/"\
+"  border-color: $frame !important;/" "$sheet" > "$tmp/bl.css"
+control 'the hovered colour frame at the rest frame' "$tmp/bl.css"
+
+# (bm) The rest rule of the colour inputs under the type selector, which also
+# reaches the colour button of an edit toolbar.
+typehead="$viewer input[type=\"color\"] {"
+sed "s/^$(esc "$head_colour")\$/$typehead/" "$sheet" > "$tmp/bm.css"
+control 'the colour rule under the type selector' "$tmp/bm.css"
+
+# (bn) The width line of the rest rule of the colour inputs cut out, which
+# leaves the 2px frame and moves the swatch.
+crange="/^$(esc "$head_colour")\$/,/^}\$/"
+sed "${crange}{/^  border-width: /d;}" "$sheet" > "$tmp/bn.css"
+control 'the width of the colour frame cut out' "$tmp/bn.css"
+
+# (bo) The padding line of the rest rule of the colour inputs cut out, which
+# hides the ground under the swatch.
+sed "${crange}{/^  padding: /d;}" "$sheet" > "$tmp/bo.css"
+control 'the ring of the colour input cut out' "$tmp/bo.css"
+
+# (bp) The style line of the field rule of the passkey block cut out, which
+# leaves the inset frame of the browser.
+sed "/^$(esc "$field_webauthn")\$/,/^}\$/{/^  border-style: /d;}" "$sheet" \
+    > "$tmp/bp.css"
+control 'the frame style of the passkey field cut out' "$tmp/bp.css"
+
+# (bq) The logo rule of the private page cut out, with its blank line.
+sed "/^$(esc "$head_logo")\$/,/^}\$/d" "$sheet" | sed '/^$/N;/^\n$/D' \
+    > "$tmp/bq.css"
+control 'the logo rule cut out' "$tmp/bq.css"
+
+# (br) The context line of the logo rule cut out, which leaves the violet of
+# the image.
+sed '/^  -moz-context-properties: /d' "$sheet" > "$tmp/br.css"
+control 'the context line of the logo rule cut out' "$tmp/br.css"
+
+# (bs) The disc of the logo at the hover accent of the root.
+sed "/^$(esc "$head_logo")\$/,/^}\$/s/^  fill: .*\$/"\
+"  fill: $accent !important;/" "$sheet" > "$tmp/bs.css"
+control 'the logo disc at the hover accent' "$tmp/bs.css"
+
+# (fa) The focus rule of the inner text fields cut out, with its blank line.
+focus=$(esc "$(printf '%s\n' "$head_focusfield" | head -n 1)")
+sed "/^$focus\$/,/^}\$/d" "$sheet" | sed '/^$/N;/^\n$/D' > "$tmp/fa.css"
+control 'the focus rule of the inner fields cut out' "$tmp/fa.css"
+
+# (fb) The head of the focus rule with no id, which reaches each text field
+# of the pages.
+sed 's/^input#input:where(/input:where(/' "$sheet" > "$tmp/fb.css"
+control 'the focus rule on each text field' "$tmp/fb.css"
+
+# (fc) The focus rule at the native ring of the browser.
+sed 's/^  outline: var(--focus-outline) !important;$/'\
+'  outline: auto !important;/' "$sheet" > "$tmp/fc.css"
+control 'the focus rule at the native ring' "$tmp/fc.css"
+
+# (bt) The tile rule of the new tab page cut out, with its blank line.
+tile=$(esc "$(printf '%s\n' "$head_tile" | head -n 1)")
+sed "/^$tile\$/,/^}\$/d" "$sheet" | sed '/^$/N;/^\n$/D' > "$tmp/bt.css"
+control 'the tile rule cut out' "$tmp/bt.css"
+
+# (bu) The scheme line of the tile rule at the scheme of the content, which
+# the browser gives a tile.
+sed "/^$tile\$/,/^}\$/s/^  color-scheme: .*\$/"\
+"  color-scheme: light dark !important;/" "$sheet" > "$tmp/bu.css"
+control 'the tile at the scheme of the content' "$tmp/bu.css"
+
+# (bv) The first head without the menu button and the pin icon, which leaves
+# both at the scheme of the content on a wallpaper.
+sed "s/^$tile\$/.top-site-outer .tile,/" "$sheet" > "$tmp/bv.css"
+control 'the tile rule with no menu button and no pin icon' "$tmp/bv.css"
+
+# (bw) The head of the shortcut form cut out, which leaves the title of its
+# preview at the scheme of the content.
+form=$(esc "$(printf '%s\n' "$head_tile" | tail -n 1)")
+sed -e "s/^$tile\$/$(printf '%s\n' "$tile" | sed 's/,$/ {/')/" \
+    -e "/^$form\$/d" "$sheet" > "$tmp/bw.css"
+control 'the form head of the tile rule cut out' "$tmp/bw.css"
+
+# (bx) The rule of the drop down lists cut out, with its blank line.
+sed "/^$(esc "$head_droplist")\$/,/^}\$/d" "$sheet" | sed '/^$/N;/^\n$/D' \
+    > "$tmp/bx.css"
+control 'the rule of the drop down lists cut out' "$tmp/bx.css"
+
+# (by) The border of a drop down list as its colour alone, which gives the
+# border name no width and no style.
+lrange="/^$(esc "$head_droplist")\$/,/^}\$/"
+sed "${lrange}s/^  --button-border: 1px solid /  --button-border: /" "$sheet" \
+    > "$tmp/by.css"
+control 'the border of a drop down list as a colour alone' "$tmp/by.css"
+
+# (bz) The border of a drop down list at the root highlight, the border of a
+# button of the browser.
+sed "${lrange}s/^  --button-border: .*\$/"\
+"  --button-border: 1px solid light-dark($high, $high) !important;/" "$sheet" \
+    > "$tmp/bz.css"
+control 'the border of a drop down list at the highlight' "$tmp/bz.css"
+
+# (ca) The ground line of the rule of the drop down lists cut out, which
+# leaves a list with no ground.
+sed "${lrange}{/^  --button-background-color: /d;}" "$sheet" > "$tmp/ca.css"
+control 'the ground of a drop down list cut out' "$tmp/ca.css"
+
+# (cb) The ground of an open select at the pressed button pair of the root
+# rule, the ground of a list that a key opens.
+pressed=$(anchor "$sheet" --button-background-color-active)
+sed "/^$(esc "$openlast")\$/,/^}\$/"\
+"s/^  --select-background-color-hover: .*\$/"\
+"  --select-background-color-hover: $pressed !important;/" "$sheet" \
+    > "$tmp/cb.css"
+control 'the open select at the pressed button pair' "$tmp/cb.css"
+
+# (cc) The ground line of the open rule of the viewer cut out, which leaves
+# the open box at the hovered button pair.
+sed "/^$(esc "$head_open")\$/,/^}\$/"\
+"{/^  --button-background-color-hover: /d;}" "$sheet" > "$tmp/cc.css"
+control 'the ground of the open box cut out' "$tmp/cc.css"
+
+# (cd) Each open ground at the hovered button pair of the root rule, the
+# ground that the browser gives an open list.
+sed -e "s/^  --select-background-color-hover: .*\$/"\
+"  --select-background-color-hover: $hover !important;/" \
+    -e "/^$(esc "$head_open")\$/,/^}\$/"\
+"s/^  --button-background-color-hover: .*\$/"\
+"  --button-background-color-hover: $hover !important;/" \
+    -e "${lrange}s/^  --button-background-color-active: .*\$/"\
+"  --button-background-color-active: $hover !important;/" "$sheet" \
+    > "$tmp/cd.css"
+control 'each open ground at the hovered button pair' "$tmp/cd.css"
+
+# (ce) The rule of the text fields of the pages under the pointer cut out,
+# with its blank line.
+fieldlast=$(printf '%s\n' "$head_fieldhover" | tail -n 1)
+sed "/^input:where(/,/^}\$/d" "$sheet" | sed '/^$/N;/^\n$/D' > "$tmp/ce.css"
+control 'the rule of the fields under the pointer cut out' "$tmp/ce.css"
+
+# (cf) The head line of the fields with no type cut out.
+sed '/^input:not(\[type\]):enabled:not(:focus):hover,$/d' "$sheet" \
+    > "$tmp/cf.css"
+control 'the head line of the fields with no type cut out' "$tmp/cf.css"
+
+# (cg) The frame of a field under the pointer at the frame pin of the root
+# rule, the frame at rest.
+sed "/^$(esc "$fieldlast")\$/,/^}\$/s/^  border-color: .*\$/"\
+"  border-color: $frame !important;/" "$sheet" > "$tmp/cg.css"
+control 'the hovered field at the rest frame' "$tmp/cg.css"
+
+# (ch) The rule of the config field under the pointer cut out, with its blank
+# line. The id rule of that field then wins over the rule of the pages.
+sed "/^$(esc "$(hoverhead "$field_config")")\$/,/^}\$/d" "$sheet" |
+    sed '/^$/N;/^\n$/D' > "$tmp/ch.css"
+control 'the config field rule under the pointer cut out' "$tmp/ch.css"
+
+# (ci) The focus guard of each rule of a field under the pointer cut out,
+# which takes the frame of a field with the focus.
+sed 's/:enabled:not(:focus):hover/:enabled:hover/' "$sheet" > "$tmp/ci.css"
+control 'the focus guard of the hovered fields cut out' "$tmp/ci.css"
+
+# (cj) The selection rule of a category cut out, with its blank line.
+sed "/^$(esc "$head_category")\$/,/^}\$/d" "$sheet" | sed '/^$/N;/^\n$/D' \
+    > "$tmp/cj.css"
+control 'the selection rule of a category cut out' "$tmp/cj.css"
+
+# (ck) The text of a selected category at the root highlight, the text that
+# the browser gives it on the page ground.
+sed "/^$(esc "$head_category")\$/,/^}\$/s/^  color: .*\$/"\
+"  color: $high !important;/" "$sheet" > "$tmp/ck.css"
+control 'the text of a selected category at the highlight' "$tmp/ck.css"
+
+# (cl) The hover rule of a category at the root highlight, the ground of a
+# selected category at rest.
+sed "/^$(esc "$head_categoryhover")\$/,/^}\$/s/^  background-color: .*\$/"\
+"  background-color: $high !important;/" "$sheet" > "$tmp/cl.css"
+control 'the hover ground of a category at the highlight' "$tmp/cl.css"
+
+# (cm) The row rule of the row pages cut out, with its blank line.
+sed "/^$(esc "$rowhover_rows")\$/,/^}\$/d" "$sheet" | sed '/^$/N;/^\n$/D' \
+    > "$tmp/cm.css"
+control 'the row rule of the row pages cut out' "$tmp/cm.css"
+
+# (cn) The row under the pointer at the hovered button pair of the root rule,
+# the ground that the browser gives it.
+rrange="/^$(esc "$rowhover_rows")\$/,/^}\$/"
+sed "${rrange}s/^  background-color: .*\$/"\
+"  background-color: $hover !important;/" "$sheet" > "$tmp/cn.css"
+control 'the row under the pointer at the hovered button pair' "$tmp/cn.css"
+
+# (co) The text line of the row rule cut out, which leaves the button text of
+# the browser on the view hover ground.
+sed "${rrange}{/^  color: /d;}" "$sheet" > "$tmp/co.css"
+control 'the text of the row under the pointer cut out' "$tmp/co.css"
+
+# (cp) The rest rule of a switch that is on cut out, with its blank line.
+sed "/^$(esc "$head_switchon")\$/,/^}\$/d" "$sheet" | sed '/^$/N;/^\n$/D' \
+    > "$tmp/cp.css"
+control 'the rest rule of the on switch cut out' "$tmp/cp.css"
+
+# (cq) The switch that is on under the pointer at the border name at rest.
+sed "/^$(esc "$head_switchonhover")\$/,/^}\$/"\
+"s/var(--toggle-border-color-hover)/var(--toggle-border-color)/" "$sheet" \
+    > "$tmp/cq.css"
+control 'the on switch under the pointer at the rest name' "$tmp/cq.css"
+
+# (cr) The pressed rule of a switch that is on cut out, with its blank line.
+sed "/^$(esc "$head_switchonactive")\$/,/^}\$/d" "$sheet" |
+    sed '/^$/N;/^\n$/D' > "$tmp/cr.css"
+control 'the pressed rule of the on switch cut out' "$tmp/cr.css"
+
+# (cs) The frame line of the progress rule of the downloads block cut out.
+prange="/^$(esc "$head_progress")\$/,/^}\$/"
+sed "${prange}{/^  box-shadow: /d;}" "$sheet" > "$tmp/cs.css"
+control 'the frame of the progress line cut out' "$tmp/cs.css"
+
+# (ct) The frame of the progress line at the view hover pair of the root
+# rule, a pair apart from the frame pin.
+sed "${prange}s/^  box-shadow: .*\$/"\
+"  box-shadow: 0 0 0 1px $nav !important;/" "$sheet" > "$tmp/ct.css"
+control 'the frame of the progress line at the view hover' "$tmp/ct.css"
+
+# (cu) The rule of the tool buttons under the pointer cut out, with its
+# blank line.
+toolfirst=$(printf '%s\n' "$head_toolhover" | head -n 1)
+sed "/^$(esc "$toolfirst")\$/,/^}\$/d" "$sheet" | sed '/^$/N;/^\n$/D' \
+    > "$tmp/cu.css"
+control 'the rule of the tool buttons cut out' "$tmp/cu.css"
+
+# (cv) The head of the edit toolbar buttons cut out, which leaves the colour
+# button of an edit toolbar with no frame.
+toollast=$(printf '%s\n' "$head_toolhover" | tail -n 1)
+sed -e "s/^$(esc "$toolfirst")\$/$(esc "${toolfirst%,}") {/" \
+    -e "/^$(esc "$toollast")\$/d" "$sheet" > "$tmp/cv.css"
+control 'the head of the edit toolbar buttons cut out' "$tmp/cv.css"
+
+# (cw) The frame of a tool button under the pointer at the border pair of
+# the viewer root rule, the frame at rest.
+edge=$(vanchor "$sheet" --border-color-deemphasized)
+sed "/^$(esc "$toollast")\$/,/^}\$/s/^  box-shadow: .*\$/"\
+"  box-shadow: inset 0 0 0 1px $edge !important;/" "$sheet" > "$tmp/cw.css"
+control 'the hovered tool button at the rest frame' "$tmp/cw.css"
+
+# (cx) The frame of a tool button as a shadow outside the button, which
+# paints over the bar ground.
+sed "/^$(esc "$toollast")\$/,/^}\$/s/^  box-shadow: inset /  box-shadow: /" \
+    "$sheet" > "$tmp/cx.css"
+control 'the frame of a tool button outside the button' "$tmp/cx.css"
+
+# (cy) The frame line of the select rule cut out, which leaves the select at
+# the frame of a field.
+sed "/^$(esc "$head_select")\$/,/^}\$/{/^  --select-border-color:/d;}" \
+    "$sheet" > "$tmp/cy.css"
+control 'the frame of the select cut out' "$tmp/cy.css"
+
+# (cz) The frame of the select at the frame pair of the root rule, the frame
+# of a field.
+field=$(anchor "$sheet" --input-border-color)
+sed "/^$(esc "$head_select")\$/,/^}\$/s/^  --select-border-color: .*\$/"\
+"  --select-border-color: $field !important;/" "$sheet" > "$tmp/cz.css"
+control 'the frame of the select at the frame of a field' "$tmp/cz.css"
+
+# (da) The open select at the frame pair of the root rule.
+openlast=$(printf '%s\n' "$head_selectopen" | tail -n 1)
+sed "/^$(esc "$openlast")\$/,/^}\$/s/^  --select-border-color-hover: .*\$/"\
+"  --select-border-color-hover: $field !important;/" "$sheet" > "$tmp/da.css"
+control 'the open select at the frame of a field' "$tmp/da.css"
+
+# (db) The border of the drop down lists at the frame pair of the root rule.
+sed "/^$(esc "$head_droplist")\$/,/^}\$/s/^  --button-border: .*\$/"\
+"  --button-border: 1px solid $field !important;/" "$sheet" > "$tmp/db.css"
+control 'the border of the drop down lists at the frame of a field' \
+    "$tmp/db.css"
+
+# (dc) The pressed frame of the switch rule cut out, which leaves a pressed
+# switch at the frame of a field.
+sed "/^$(esc "$head_switch")\$/,/^}\$/{/^  --toggle-border-color-active:/d;}" \
+    "$sheet" > "$tmp/dc.css"
+control 'the pressed frame of the switch cut out' "$tmp/dc.css"
+
+# (dd) The frame of the switch at the frame pair of the root rule.
+sed "/^$(esc "$head_switch")\$/,/^}\$/s/^  --toggle-border-color: .*\$/"\
+"  --toggle-border-color: $field !important;/" "$sheet" > "$tmp/dd.css"
+control 'the frame of the switch at the frame of a field' "$tmp/dd.css"
+
+# (de) The frame of the colour inputs at the frame pair of the root rule.
+sed "/^$(esc "$head_colour")\$/,/^}\$/s/^  border-color: .*\$/"\
+"  border-color: $field !important;/" "$sheet" > "$tmp/de.css"
+control 'the frame of the colour inputs at the frame of a field' "$tmp/de.css"
+
+# (df) Each frame of a button at the frame pair of the root rule, the state
+# of one frame for a button and a field.
+frame=$(body "$sheet" "$head_select" |
+    sed -n 's/^  --select-border-color: \(.*\) !important;$/\1/p')
+sed "s/$(esc "$frame") !important;\$/$(esc "$field") !important;/" "$sheet" \
+    > "$tmp/df.css"
+control 'each frame of a button at the frame of a field' "$tmp/df.css"
+
+# (dg) The frame of the select under the pointer cut out.
+sed "/^$(esc "$head_select")\$/,/^}\$/{/^  --select-border-color-hover:/d;}" \
+    "$sheet" > "$tmp/dg.css"
+control 'the hovered frame of the select cut out' "$tmp/dg.css"
+
+echo "assert-ff-content-blocks: $sheet holds the $(echo $blocks | wc -w)" \
+     "content rules in the order of the writer, the placeholder rule, the" \
+     "logo rule of the private page, the rule of the drop down lists, the" \
+     "rule of the fields under the pointer, the two rules of a selected" \
+     "category, the three rules of a switch that is on, the frame of a" \
+     "button at one pair, the" \
+     "focus rule of the inner text fields, the" \
+     "$(echo $pages | wc -w) page blocks with the selection rule of the" \
+     "row pages and the field rules of four blocks, the viewer rule with its" \
+     "$(echo $vblocks | wc -w) descendant rules and the blocked site rules;" \
+     "each name holds the value of its anchor in the form of its row, the" \
+     "menu row follows the menu rule, each placeholder share reads at" \
+     "$floor or more on the field grounds, the sheet holds $scopes scope" \
+     "lines, and the check rejects each of the $broken control copies"
diff --git a/firefox/check/assert-ff-content.sh b/firefox/check/assert-ff-content.sh
index e4d28540..dcfb6e75 100644
--- a/firefox/check/assert-ff-content.sh
+++ b/firefox/check/assert-ff-content.sh
@@ -1,15 +1,57 @@
 #!/bin/sh
 # assert-ff-content.sh WRITER WORKDIR LIGHT DARK: the owned content sheet must
-# hold the header line of the writer and one universal rule of one
-# declaration. The rule states two literal colours under !important. The
-# sheet must carry no width row, no custom property and no other property.
-# The pair must follow the slider keys. It must hold one track under every
-# key. It must equal the pair of the sidebar rule of the chrome sheet of the
-# same settings. The run writes one settings file, one content sheet and one
-# chrome sheet for each arm under WORKDIR, over the colour file LIGHT. It
-# then breaks one contract in a copy of an arm, and it fails if the check
-# passes the broken copy. One control carries the pair of the colour file
-# DARK, which the writer emits.
+# hold the header line of the writer, one universal rule and one accent block.
+# The rule holds one declaration of two literal colours under !important, and
+# the sheet carries no width row. The pair must follow the slider keys and hold
+# one track under every key. It must equal the pair of the sidebar rule of the
+# chrome sheet of the same settings.
+#
+# The accent block holds one scope line of the about: and chrome:// addresses
+# and one root rule of the accent names. No custom property stands before
+# the block. Each hex name holds the root value of its role in the chrome
+# sheet. Each pair name holds that value in the half of the scheme of the
+# colour file. The destructive text holds the pair of the browser.
+#
+# The content rules after the root rule, the page blocks and the viewer rules
+# are the contract of assert-ff-content-blocks.sh. The viewer rule holds the
+# focus colour of the chrome sheet and its border colour in the half of the
+# scheme.
+#
+# Each text half reads at the floor or over it on the box of its half. The
+# page text, the new tab text and the button text also read at that floor on
+# the canvas. The button text also reads at that floor on the hovered, pressed
+# and muted buttons. Each link half reads at the floor or over it on the
+# canvas, the box, the information box and the view hover of its half. Each
+# share of the deemphasized text stands from the share of the browser to 100.
+# The page text at that share reads at the floor or over it on the view hover
+# of its half.
+#
+# The hover rule of the row pages holds the ground of the result row rule of
+# the chrome sheet, the selection ground under the pointer.
+#
+# The progress rule of the downloads block follows the groove colour key. It
+# holds the field ground pair under the base groove and the page ground pair
+# under the window groove. Under the dark groove it holds a pair of its own.
+# The progress rule of the chrome sheet holds the half of the scheme.
+#
+# The hover name of the viewer rule holds a pair of one colour. It follows the
+# hover decoration of the view set of the colour file and no other colour.
+# Under the settings that colour no frame of a button, it holds the border
+# pair. A rest rule then keeps the drop down box of the viewer at the accent.
+# The root rule of the accent block holds the hover name at the viewer pair.
+# The chrome sheet holds the rule of a field under the pointer only where the
+# settings colour the frame of a field.
+#
+# The focus colour of the viewer rule follows the focus decoration of the view
+# set of the colour file and no other colour. The root rule of the accent block
+# holds the same colour. The content sheet holds the rule of the page fields
+# under the pointer only where the settings colour the frame of a field.
+#
+# The run writes one settings file, one content sheet and one chrome sheet for
+# each arm under WORKDIR, over the colour file LIGHT. LIGHT must give a light
+# scheme. The run then breaks one contract in a copy of an arm, and it fails if
+# the check passes the broken copy. Three controls carry values of the colour
+# file DARK, which the writer emits.
 set -eu
 usage='usage: assert-ff-content.sh WRITER WORKDIR LIGHT DARK'
 writer=${1:?$usage}
@@ -29,9 +71,118 @@ custom='#ff8800'
 # The arms of the slider keys and the arms of the groove keys.
 sliders='none darken selected blend custom mo'
 grooves='thin wide page corner square'
