+    for c_root in --color-accent-primary --sidebar-background-color \
+        --panel-background-color; do
+        if [ -z "$(rootvalue "$c_sheet" "$c_root")" ]; then
+            note "the root of $c_sheet sets no $c_root"
+            return 1
+        fi
+    done
+    c_high=$(rootvalue "$c_sheet" --color-accent-primary)
+    c_side=$(rootvalue "$c_sheet" --sidebar-background-color)
+    c_ground=$(rootvalue "$c_sheet" --panel-background-color)
+
+    # 4. The rule of the bar button stands once and holds one line: the
+    # border at one pixel in the root highlight.
+    if ! c_count=$(heads "$c_sheet" "$head_button"); then
+        note "$c_sheet holds $c_count bar button rules, and not 1"
+        return 1
+    fi
+    c_want="1px solid $c_high"
+    c_have=$(body "$c_sheet" "$head_button")
+    if [ "$c_have" != "  --button-border: $c_want !important;" ]; then
+        note "the bar button rule of $c_sheet reads '$c_have', and not" \
+             "--button-border at $c_want"
+        return 1
+    fi
