         printf(DEBUG_PREFIX "%s %p\n", __FUNCTION__, widget);
 
+    if (!opts.popupShadow)
+        return false;
+
     if (widget && GTK_IS_WINDOW(widget)) {
         if (qtSettings.app == GTK_APP_OPEN_OFFICE) {
             return true;
