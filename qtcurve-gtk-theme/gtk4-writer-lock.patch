+ *   License, or (at your option) version 3, or any later version accepted   *
+ *   by the membership of KDE e.V. (or its successor approved by the         *
+ *   membership of KDE e.V.), which shall act as a proxy defined in          *
+ *   Section 6 of version 3 of the license.                                  *
+ *                                                                           *
+ *   This program is distributed in the hope that it will be useful,         *
+ *   but WITHOUT ANY WARRANTY; without even the implied warranty of          *
+ *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU       *
+ *   Lesser General Public License for more details.                         *
+ *                                                                           *
+ *   You should have received a copy of the GNU Lesser General Public        *
+ *   License along with this library. If not,                                *
+ *   see <http://www.gnu.org/licenses/>.                                     *
+ *****************************************************************************/
+
+#ifndef QTC_GTK4_LOCK_H
+#define QTC_GTK4_LOCK_H
+
+#include <QString>
+
+#include <sys/types.h>
+
+namespace QtCurve {
+namespace Gtk {
+
+/** The exit code of a mode that does not get the write lock. */
+const int lockBusyCode = 7;
+
+/** The file name of the lock of the one watch instance. */
+extern const char *const daemonLockName;
+
+/** The file name of the lock of the shared state of the user. */
+extern const char *const writeLockName;
+
+/**
+ * Returns the path of the lock file name in the configuration home of the
+ * user, and makes that directory. The two lock files stay for ever, because
+ * no mode deletes a file that another process can hold at that moment.
+ *
+ * \param name the file name of a lock, with no directory part.
+ * \return the absolute path of that lock file.
+ */
+QString lockPath(const char *name);
+
+/**
+ * Takes the lock of the one watch instance and writes the process identifier
+ * of the caller into the file. The kernel gives a lock of flock(2) up at
+ * every death of the holder, so no stale state can stay. flock(2) over NFS is
+ * an emulation over the record locks of POSIX since Linux 2.6.37.
+ *
+ * \param holder takes the process identifier that the file holds when another
+ *     process holds the lock, and 0 when the file holds no number. The number
+ *     is for a reader alone, and no contract binds on it.
+ * \return the open file descriptor of the lock, or -1 when another process
+ *     holds the lock or the file does not open.
+ */
+int acquireDaemonLock(pid_t *holder);
+
+/**
+ * Takes the lock of the shared state of the user under a deadline, and writes
+ * the process identifier of the caller into the file. The wait is a poll of
+ * steps of 50 ms.
+ *
+ * \param deadlineMs the longest wait for the lock, in milliseconds.
+ * \param holder takes the process identifier that the file holds at the
+ *     deadline, and 0 when the file holds no number.
+ * \return the open file descriptor of the lock, or -1 at the deadline or
+ *     when the file does not open.
+ */
+int acquireWriteLock(int deadlineMs, pid_t *holder);
+
+/** Gives the lock of the descriptor fd up, and closes that descriptor. */
+void releaseLock(int fd);
+
+/**
+ * Takes the lock descriptor that QTC_GTK_WRITER_LOCK_FD names over from the
+ * image before an execv(2), and writes the new process identifier into the
+ * file. The function drops the variable in every path.
+ *
+ * \param path the lock file that the descriptor must name. The check reads
+ *     st_dev and st_ino of the descriptor and of the path.
+ * \return the open file descriptor of the lock, or -1 for a failure. The
+ *     variable can be absent, or it can name a standard stream, a bad number
+ *     or another file. The call also fails when another process holds that
+ *     lock.
+ */
+int adoptLockFd(const QString &path);
+
+/**
+ * Clears FD_CLOEXEC of the lock descriptor fd and names fd in
+ * QTC_GTK_WRITER_LOCK_FD, for the image after an execv(2). The descriptor
+ * holds FD_CLOEXEC at every other moment, so no child of the writer gets it.
+ */
+void prepareLockFdForExec(int fd);
+
+/**
+ * Sets FD_CLOEXEC of the lock descriptor fd again and drops
+ * QTC_GTK_WRITER_LOCK_FD, after an execv(2) that failed.
+ */
+void restoreLockFdAfterExecFailure(int fd);
+
+}
+}
+
+#endif
diff --git a/gtk4/writer/main.cpp b/gtk4/writer/main.cpp
index 3b78d8f6..f39d7731 100644
--- a/gtk4/writer/main.cpp
+++ b/gtk4/writer/main.cpp
@@ -20,6 +20,7 @@
  *****************************************************************************/
 
 #include "dialect.h"
+#include "lock.h"
 #include "userfile.h"
 #include "watch.h"
 
@@ -34,6 +35,10 @@
 #include <QFile>
 #include <QTextStream>
 
+#include <unistd.h>
+
+#include <functional>
+
 using namespace QtCurve;
 using namespace QtCurve::Gtk;
 
@@ -139,6 +144,71 @@ testFault()
     return !env.isEmpty() && QFile::exists(QString::fromLocal8Bit(env));
 }
 
+/**
+ * The longest wait for the write lock, in milliseconds. The deadline bounds
+ * the wait of a mode that meets a holder, and it leaves a pass that runs
+ * enough time to finish.
+ */
+const int writeLockDeadlineMs = 2000;
+
+/** The step of the wait of a test hold, in milliseconds. */
+const int testHoldStepMs = 100;
+
+/**
+ * The count of the steps of a test hold. The cap of 30 s stops a hold that
+ * outlives the check script that started it.
+ */
+const int testHoldSteps = 300;
+
+/**
+ * Holds the write lock while the file that QTC_GTK_TEST_HOLD names exists,
+ * for 30 s at most. The build time checks set the variable, and a run of a
+ * user leaves it unset.
+ */
+void
+testHold()
+{
+    const QByteArray env = qgetenv("QTC_GTK_TEST_HOLD");
+    if (env.isEmpty()) {
+        return;
+    }
+    const QString path = QString::fromLocal8Bit(env);
+    if (!QFile::exists(path)) {
+        return;
+    }
+    printf("qtcurve-gtk-writer: the test hold starts\n");
+    fflush(stdout);
+    for (int step = 0;step < testHoldSteps && QFile::exists(path);++step) {
+        usleep((useconds_t)testHoldStepMs * 1000);
+    }
+}
+
+/**
+ * Runs the body of one mode inside the write lock, and returns the exit code
+ * of that body. The lock holds every mode that rewrites the shared files of
+ * the user apart from each other.
+ *
+ * \param body the body of the mode, which runs one time on success.
+ * \return the exit code of body, or lockBusyCode when the lock stays with
+ *     another process up to the deadline. The body does not run in that case,
+ *     and one line on standard error names the holder.
+ */
+int
+lockedRun(const std::function<int()> &body)
+{
+    pid_t holder = 0;
+    const int fd = acquireWriteLock(writeLockDeadlineMs, &holder);
+    if (fd < 0) {
+        fprintf(stderr, "qtcurve-gtk-writer: the pid %d holds the write lock"
+                " after 2 s, and this pass stops\n", (int)holder);
+        return lockBusyCode;
+    }
+    testHold();
+    const int code = body();
+    releaseLock(fd);
+    return code;
+}
