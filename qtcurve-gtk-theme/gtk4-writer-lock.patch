+ *   it under the terms of the GNU Lesser General Public License as          *
+ *   published by the Free Software Foundation; either version 2.1 of the    *
+ *   License, or (at your option) version 3, or any later version accepted   *
+ *   by the membership of KDE e.V. (or its successor approved by the         *
+ *   membership of KDE e.V.), which shall act as a proxy defined in          *
+ *   Section 6 of version 3 of the license.                                  *
+ *                                                                           *
+ *   This program is distributed in the hope that it will be useful,         *
+ *   but WITHOUT ANY WARRANTY; without even the implied warranty of          *
+ *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU       *
+ *   Lesser General Public License for more details.                         *
+ *                                                                           *
+ *   You should have received a copy of the GNU Lesser General Public        *
+ *   License along with this library. If not,                                *
+ *   see <http://www.gnu.org/licenses/>.                                     *
+ *****************************************************************************/
+
+#include "lock.h"
+
+#include <qtcurve-utils/dirs.h>
+
+#include <QDir>
+
+#include <fcntl.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/file.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace QtCurve {
+namespace Gtk {
+
+const char *const daemonLockName = "qtcurve-gtk-writer.lock";
+const char *const writeLockName = "qtcurve-gtk-writer-write.lock";
+
+namespace {
+
+/** The name of the variable that carries the lock descriptor over an exec. */
+const char *const lockFdEnv = "QTC_GTK_WRITER_LOCK_FD";
+
+/**
+ * The step of the poll of the write lock, in milliseconds. The step is short
+ * against the deadline of the callers, so a loser waits for the holder and
+ * not for the next step.
+ */
+const int stepMs = 50;
+
+/** The mode of a lock file, which one user reads and writes. */
+const mode_t lockMode = 0600;
+
+/** Opens the lock file of path, and returns -1 when the open fails. */
+int
+openLock(const QString &path)
+{
+    return open(path.toLocal8Bit().constData(),
+                O_CREAT | O_RDWR | O_CLOEXEC, lockMode);
+}
+
+/** Writes the process identifier of the caller into the lock file fd. */
+void
+writePid(int fd)
+{
+    char text[32];
+    const int len = snprintf(text, sizeof(text), "%d\n", (int)getpid());
+    if (len <= 0 || ftruncate(fd, 0) != 0) {
+        return;
+    }
+    if (pwrite(fd, text, (size_t)len, 0) != len) {
+        return;
+    }
+}
+
+/** Returns the process identifier that the lock file fd holds, or 0. */
+pid_t
+readPid(int fd)
+{
+    char text[32];
+    const ssize_t got = pread(fd, text, sizeof(text) - 1, 0);
+    if (got <= 0) {
+        return 0;
+    }
+    text[got] = '\0';
+    return (pid_t)strtol(text, nullptr, 10);
+}
+
+}
+
+QString
+lockPath(const char *name)
+{
+    const QString dir = QString::fromLocal8Bit(getXDGConfigHome());
+    QDir().mkpath(dir);
+    return dir + QString::fromLatin1(name);
+}
+
+int
+acquireDaemonLock(pid_t *holder)
+{
+    const int fd = openLock(lockPath(daemonLockName));
+    if (fd < 0) {
+        return -1;
+    }
+    if (flock(fd, LOCK_EX | LOCK_NB) == 0) {
+        writePid(fd);
+        return fd;
+    }
+    if (holder) {
+        *holder = readPid(fd);
+    }
+    close(fd);
+    return -1;
+}
+
+int
+acquireWriteLock(int deadlineMs, pid_t *holder)
+{
+    const int fd = openLock(lockPath(writeLockName));
+    if (fd < 0) {
+        return -1;
+    }
+    for (int waited = 0;;waited += stepMs) {
+        if (flock(fd, LOCK_EX | LOCK_NB) == 0) {
+            writePid(fd);
+            return fd;
+        }
+        if (waited >= deadlineMs) {
+            break;
+        }
+        usleep((useconds_t)stepMs * 1000);
+    }
+    if (holder) {
+        *holder = readPid(fd);
+    }
+    close(fd);
+    return -1;
+}
+
+void
+releaseLock(int fd)
+{
+    close(fd);
+}
+
+int
+adoptLockFd(const QString &path)
+{
+    const char *const env = getenv(lockFdEnv);
+    if (!env || !*env) {
+        return -1;
+    }
+    char *end = nullptr;
+    const long value = strtol(env, &end, 10);
+    unsetenv(lockFdEnv);
+    if (!end || *end != '\0' || value <= STDERR_FILENO || value > INT_MAX) {
+        return -1;
+    }
+    const int fd = (int)value;
+    struct stat held;
+    struct stat want;
+    if (fstat(fd, &held) != 0 ||
+        stat(path.toLocal8Bit().constData(), &want) != 0 ||
+        held.st_dev != want.st_dev || held.st_ino != want.st_ino ||
+        flock(fd, LOCK_EX | LOCK_NB) != 0) {
+        close(fd);
+        return -1;
+    }
+    writePid(fd);
+    return fd;
+}
+
+void
+prepareLockFdForExec(int fd)
+{
+    const int flags = fcntl(fd, F_GETFD);
+    if (flags >= 0) {
+        fcntl(fd, F_SETFD, flags & ~FD_CLOEXEC);
+    }
+    char text[32];
+    snprintf(text, sizeof(text), "%d", fd);
+    setenv(lockFdEnv, text, 1);
+}
+
+void
+restoreLockFdAfterExecFailure(int fd)
+{
+    const int flags = fcntl(fd, F_GETFD);
+    if (flags >= 0) {
+        fcntl(fd, F_SETFD, flags | FD_CLOEXEC);
+    }
+    unsetenv(lockFdEnv);
+}
+
+}
+}
