diff --git a/gtk4/check/assert-lock.sh b/gtk4/check/assert-lock.sh
new file mode 100644
index 00000000..5f4fc43b
--- /dev/null
+++ b/gtk4/check/assert-lock.sh
@@ -0,0 +1,204 @@
+#!/bin/sh
+# assert-lock.sh WRITER WORKDIR: one watch instance runs at a time, and one
+# mode body rewrites the shared files at a time. The run starts the writer over
+# a private home. It reads the two locks through the exit codes, the log lines
+# and the liveness of each run. No arm reads a sheet of the user, because
+# copyAssets() stops a pass of a build host before the sheet lands. HOME,
+# XDG_CONFIG_HOME and QTCURVE_CONFIG_DIR point into WORKDIR, because the writer
+# rewrites the files of the caller. Every wait is a counted poll of steps of
+# one second, so no arm can stop the build.
+set -eu
+usage='usage: assert-lock.sh WRITER WORKDIR'
+writer=${1:?$usage}
+work=${2:?$usage}
+
+conf=$work/config
+qtc=$work/qtcurve
+hold=$work/hold
+lock=$conf/qtcurve-gtk-writer.lock
+holdvar=
+pids=
+last=
+code=0
+sevens=0
+
+clean() {
+    for p in $pids; do
+        kill "$p" 2>/dev/null || true
+    done
+    rm -f "$hold" 2>/dev/null || true
+}
+
+# A signal that stops the run leaves a writer of the run alive and a hold file
+# in place. The trap takes both away, and SIGKILL runs no trap.
+trap clean EXIT
+trap 'clean; exit 1' HUP INT QUIT TERM
+
+rm -rf "$work"
+mkdir -p "$conf/gtk-3.0" "$conf/gtk-4.0" "$qtc"
+printf '[Settings]\nappearance=gradient\n' > "$qtc/stylerc"
+ulimit -c 0
+
+fail() {
+    echo "assert-lock: $1" >&2
+    exit 1
+}
+
+# running PID: gives 0 while the process PID runs. A process that ended and
+# waits for its parent holds the state Z, and it does not run.
+running() {
+    state=$(sed -n 's/^State:[[:space:]]*//p' "/proc/$1/status" 2>/dev/null) ||
+        return 1
+    case $state in
+        Z*|'') return 1;;
+        *) return 0;;
+    esac
+}
+
+# start LOG ARGS...: starts one run of the writer over the private home, and
+# holds the pid of that run in the variable last. The variable holdvar names
+# the hold file of a holder, and it is empty for every other run.
+start() {
+    log=$1
+    shift
+    HOME=$work XDG_CONFIG_HOME=$conf QTCURVE_CONFIG_DIR=$qtc \
+        QTC_GTK_TEST_HOLD=$holdvar "$writer" "$@" > "$log" 2>&1 &
+    last=$!
+    pids="$pids $last"
+}
+
+# wait_exit PID LIMIT NAME: waits at most LIMIT seconds for the run PID to
+# end, and holds the exit code of that run in the variable code. A run that
+# stays at the limit takes a signal, and the check fails.
+wait_exit() {
+    i=0
+    while [ "$i" -lt "$2" ]; do
+        if ! running "$1"; then
+            code=0
+            wait "$1" || code=$?
+            return 0
+        fi
+        sleep 1
+        i=$((i + 1))
+    done
+    kill "$1" 2>/dev/null || true
+    fail "$3 runs after $2 seconds"
+}
+
+# wait_line LIMIT FILE TEXT NAME: waits at most LIMIT seconds for the file
+# FILE to hold the text TEXT.
+wait_line() {
+    i=0
+    while [ "$i" -lt "$1" ]; do
+        if grep -qF "$3" "$2" 2>/dev/null; then
+            return 0
+        fi
+        sleep 1
+        i=$((i + 1))
+    done
+    fail "$4"
+}
+
+# wait_file LIMIT FILE NAME: waits at most LIMIT seconds for the file FILE to
+# hold a byte.
+wait_file() {
+    i=0
+    while [ "$i" -lt "$1" ]; do
+        if [ -s "$2" ]; then
+            return 0
+        fi
+        sleep 1
+        i=$((i + 1))
+    done
+    fail "$3"
+}
+
+# 1. The first watch instance takes the daemon lock and names its pid there.
+start "$work/watch1.log" --watch --force
+daemon=$last
+sleep 2
+running "$daemon" || fail "the watch mode stopped at the first pass"
+wait_file 15 "$lock" "the watch mode wrote no pid into the daemon lock"
+
+# 2. The second watch instance stops at once, and it names the holder.
+start "$work/watch2.log" --watch --force
+wait_exit "$last" 10 "the second watch instance"
+if [ "$code" -ne 0 ]; then
+    fail "the second watch instance gave the code $code and not 0"
+fi
+grep -qF "a watch instance runs with the pid" "$work/watch2.log" ||
+    fail "the second watch instance named no holder of the daemon lock"
+running "$daemon" || fail "the first watch instance stopped at the second one"
+
+# 3. A write behind a holder waits for the deadline, and it gives the code 7.
+# The hold runs inside the write lock. The wait of the loser is therefore the
+# wait of the deadline and not the wait of a pass.
+kill "$daemon" 2>/dev/null || true
+wait_exit "$daemon" 10 "the first watch instance"
+: > "$hold"
+holdvar=$hold
+start "$work/hold1.log" --write --force
+holder=$last
+holdvar=
+wait_line 15 "$work/hold1.log" "the test hold starts" \
+    "the holder took no write lock"
+start "$work/loser.log" --write --force
+sleep 1
+running "$last" || fail "the write of the loser gave a code inside one second"
+wait_exit "$last" 8 "the write of the loser"
+if [ "$code" -ne 7 ]; then
+    fail "the write of the loser gave the code $code and not 7"
+fi
+grep -qF "holds the write lock" "$work/loser.log" ||
+    fail "the write of the loser named no holder of the write lock"
+sevens=$((sevens + 1))
+
+# 4. The sheet mode takes no lock, and the four sheet rules of the build run
+# beside each other.
+start "$work/sheet.log" --stdout --default --force
+wait_exit "$last" 5 "the sheet run"
+if [ "$code" -ne 0 ]; then
+    fail "the sheet run gave the code $code behind a holder"
+fi
+
+# 5. The holder keeps the code of its own body, and so does the write after
+# it. A build host holds no installed asset, so that code is 0 or 1.
+rm -f "$hold"
+wait_exit "$holder" 10 "the holder"
+if [ "$code" -eq 7 ]; then
+    fail "the holder gave the code 7 for a lock that it held"
+fi
+start "$work/after.log" --write --force
+wait_exit "$last" 5 "the write after the holder"
+if [ "$code" -eq 7 ]; then
+    fail "the write after the holder gave the code 7"
+fi
+
+# 6. A pass of the watch mode that meets the deadline gives the code 7, prints
+# one line and stays alive. The watcher starts the debounce again, so the edit
+# reaches the sheet after the holder.
+start "$work/watch3.log" --watch --force
+daemon=$last
+sleep 2
+running "$daemon" || fail "the watch mode stopped at the second start"
+: > "$hold"
+holdvar=$hold
+start "$work/hold2.log" --write --force
+holder=$last
+holdvar=
+wait_line 15 "$work/hold2.log" "the test hold starts" \
+    "the second holder took no write lock"
+printf 'appearance=soft\n' >> "$qtc/stylerc"
+wait_line 15 "$work/watch3.log" "the write failed with the code 7" \
+    "the watch mode gave no line of the code 7 behind a holder"
+running "$daemon" || fail "the watch mode stopped at the busy write lock"
+sevens=$((sevens + 1))
+rm -f "$hold"
+wait_exit "$holder" 10 "the second holder"
+kill "$daemon" 2>/dev/null || true
+wait_exit "$daemon" 10 "the watch mode"
+
+echo "assert-lock: the daemon lock held one watch instance, and the write" \
+     "lock gave the code 7 to the $sevens passes of the deadline"
+echo "assert-lock: the sheet run took no lock, and the holder and the run" \
+     "after it gave a code other than 7"
