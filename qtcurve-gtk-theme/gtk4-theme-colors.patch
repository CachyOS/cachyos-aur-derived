+# The shipped preset takes one arm of each branch that picks a ground or a
+# colour role. Each settings file below takes the other arm. A trailing -c
+# asks for the coverage test, which needs a table that holds every rule.
+function(qtc_gtk_check_arm name settings table rows3 rows4 names4 follow3
+         follow4 rules3 rules4 layers3 layers4)
+  add_custom_command(TARGET qtcurve-gtk-theme POST_BUILD
+    COMMAND "${CMAKE_COMMAND}" -E make_directory "${qtc_cover_dir}"
+    COMMAND "${qtc_writer_command}" --stdout --force
+            --settings "${qtc_check}/${settings}" --scheme "${qtc_light}"
+            --dialect gtk4 --asset-base "../assets/"
+            --out "${qtc_cover_dir}/${name}-gtk-4.0.css"
+    COMMAND "${qtc_writer_command}" --stdout --force
+            --settings "${qtc_check}/${settings}" --scheme "${qtc_light}"
+            --dialect gtk3 --asset-base "../assets/"
+            --out "${qtc_cover_dir}/${name}-gtk-3.0.css"
+    # A var() read of an arm sheet must hold the :root value of the arm in
+    # its fallback. A read of a shipped sheet must do the same.
+    COMMAND sh "${qtc_check}/assert-varnames.sh" -n "${names4}"
+            "${qtc_cover_dir}/${name}-gtk-4.0.css"
+    # An arm sheet must follow the colour scheme as a shipped sheet does.
+    COMMAND sh "${qtc_check}/assert-follow.sh" "${follow3}"
+            "${qtc_cover_dir}/${name}-gtk-3.0.css"
+    COMMAND sh "${qtc_check}/assert-follow.sh" -r "${follow4}"
+            "${qtc_cover_dir}/${name}-gtk-4.0.css"
+    COMMAND sh "${qtc_check}/assert-paths.sh" -a ${ARGN} -d gtk4 -n "${rows4}"
+            "${qtc_check}/${table}" "${qtc_cover_dir}/${name}-gtk-4.0.css"
+    COMMAND sh "${qtc_check}/assert-paths.sh" -a ${ARGN} -d gtk3 -n "${rows3}"
+            "${qtc_check}/${table}" "${qtc_cover_dir}/${name}-gtk-3.0.css"
+    # An arm that paints a new translucent value fails here, and a row of the
+    # table that the arm does not paint is no fault.
+    COMMAND sh "${qtc_check}/assert-alphas.sh" -a -d gtk4 -m ${qtc_avals4_arm}
+            -n ${qtc_alphas4_arm}
+            "${qtc_check}/alphas.txt" "${qtc_cover_dir}/${name}-gtk-4.0.css"
+    COMMAND sh "${qtc_check}/assert-alphas.sh" -a -d gtk3 -m ${qtc_avals3_arm}
+            -n ${qtc_alphas3}
+            "${qtc_check}/alphas.txt" "${qtc_cover_dir}/${name}-gtk-3.0.css"
+    # An arm sheet holds the node set and the pair set of a shipped sheet. A
+    # rule that the arm drops fails here, and so does a pair that it breaks.
+    COMMAND sh "${qtc_check}/assert-nodes.sh" -n "${rules4}"
+            "${qtc_cover_dir}/${name}-gtk-4.0.css" gtk4
+    COMMAND sh "${qtc_check}/assert-nodes.sh" -n "${rules3}"
+            "${qtc_cover_dir}/${name}-gtk-3.0.css" gtk3
+    COMMAND sh "${qtc_check}/assert-pairs.sh" -n "${rules4}"
+            "${qtc_cover_dir}/${name}-gtk-4.0.css"
+    COMMAND sh "${qtc_check}/assert-pairs.sh" -n "${rules3}"
+            "${qtc_cover_dir}/${name}-gtk-3.0.css"
+    COMMAND sh "${qtc_check}/assert-layers.sh" -n "${layers4}"
+            "${qtc_cover_dir}/${name}-gtk-4.0.css"
+    COMMAND sh "${qtc_check}/assert-layers.sh" -n "${layers3}"
+            "${qtc_cover_dir}/${name}-gtk-3.0.css"
+    # An arm sheet holds the box of a shipped sheet in every state as well.
+    COMMAND sh "${qtc_check}/assert-boxes.sh" -k "${qtc_check}/boxes-keep.txt"
+            -n ${qtc_boxes_arm4} "${qtc_cover_dir}/${name}-gtk-4.0.css"
+    COMMAND sh "${qtc_check}/assert-boxes.sh" -k "${qtc_check}/boxes-keep.txt"
+            -n ${qtc_boxes_arm3} "${qtc_cover_dir}/${name}-gtk-3.0.css"
+    VERBATIM)
+endfunction()
