@@ -0,0 +1,33 @@
+#!/bin/sh
+# assert-names.sh [-t TIES] COUNT SHEET...: each SHEET must declare COUNT
+# colour names, and TIES of them may hold the value of another name. A role
+# check of a pinned sheet cannot see a swap of two names of one value.
+set -eu
+usage='usage: assert-names.sh [-t TIES] COUNT SHEET...'
+ties=0
+if [ "${1:-}" = "-t" ]; then
+    ties=${2:?$usage}
+    shift 2
+fi
+want=${1:?$usage}
+shift
+if [ $# -eq 0 ]; then
+    echo "$usage" >&2
+    exit 1
+fi
+
+status=0
+for sheet in "$@"; do
+    names=$(grep -cE '^@define-color +[a-z][a-z_0-9]* +#[0-9a-fA-F]{6};$' \
+            "$sheet" || true)
+    values=$(grep -oE '^@define-color +[a-z][a-z_0-9]* +#[0-9a-fA-F]{6};$' \
+             "$sheet" | awk '{print tolower($3)}' | sort -u | wc -l)
+    if [ "$names" -ne "$want" ] || [ "$values" -ne $((want - ties)) ]; then
+        echo "assert-names: $sheet declares $names names with $values values,"\
+             "and not $want names with $((want - ties)) values" >&2
+        status=1
+        continue
+    fi
+    echo "assert-names: $sheet ok, $names names with $values values"
+done
+exit $status
