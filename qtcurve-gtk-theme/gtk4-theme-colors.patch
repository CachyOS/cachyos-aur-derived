+qtc_gtk_check_arm(cover covered-window.qtcurve paths.txt
+  ${qtc_rows3} ${qtc_rows4} ${qtc_names_cover}
+  ${qtc_follow_cover3} ${qtc_follow_cover4} ${qtc_rules3} ${qtc_rules4}
+  ${qtc_layers_cover3} ${qtc_layers_cover4} -c)
+qtc_gtk_check_arm(grad gradient.qtcurve paths.txt ${qtc_rows3} ${qtc_rows4}
+  ${qtc_names_grad} ${qtc_follow_grad3} ${qtc_follow_grad4}
+  ${qtc_rules3} ${qtc_rules4} ${qtc_layers_grad3} ${qtc_layers_grad4} -c)
+qtc_gtk_check_arm(flat flat.qtcurve paths.txt ${qtc_rows3} ${qtc_rows4}
+  ${qtc_names_flat} ${qtc_follow_flat3} ${qtc_follow_flat4}
+  ${qtc_rules3} ${qtc_rules4} ${qtc_layers_flat3} ${qtc_layers_flat4} -c)
+qtc_gtk_check_arm(opt options.qtcurve paths-options.txt
+  ${qtc_rows_opt3} ${qtc_rows_opt4} ${qtc_names_opt}
+  ${qtc_follow_opt3} ${qtc_follow_opt4} ${qtc_rules_opt3}
+  ${qtc_rules_opt4} ${qtc_layers_opt3} ${qtc_layers_opt4})
+
+# Each arm above takes an appearance of its own, so its shade factors need a
+# table of its own. The flat arm paints no gradient and the option arm moves
+# the ground of a menu bar and of a tool bar.
+set(qtc_shades_cover3 106)
+set(qtc_shades_cover4 186)
+set(qtc_shades_grad3 110)
+set(qtc_shades_grad4 194)
+set(qtc_shades_flat3 66)
+set(qtc_shades_flat4 112)
+set(qtc_shades_opt3 103)
+set(qtc_shades_opt4 179)
+add_custom_command(TARGET qtcurve-gtk-theme POST_BUILD
+  COMMAND sh "${qtc_check}/assert-alphas.sh" -s -a -d gtk4
+          -m ${qtc_shades_cover4} -n ${qtc_shades_cover4}
+          "${qtc_check}/shades-cover.txt"
+          "${qtc_cover_dir}/cover-gtk-4.0.css"
+  COMMAND sh "${qtc_check}/assert-alphas.sh" -s -a -d gtk3
+          -m ${qtc_shades_cover3} -n ${qtc_shades_cover3}
+          "${qtc_check}/shades-cover.txt"
+          "${qtc_cover_dir}/cover-gtk-3.0.css"
+  COMMAND sh "${qtc_check}/assert-alphas.sh" -s -a -d gtk4
+          -m ${qtc_shades_grad4} -n ${qtc_shades_grad4}
+          "${qtc_check}/shades-grad.txt"
+          "${qtc_cover_dir}/grad-gtk-4.0.css"
+  COMMAND sh "${qtc_check}/assert-alphas.sh" -s -a -d gtk3
+          -m ${qtc_shades_grad3} -n ${qtc_shades_grad3}
+          "${qtc_check}/shades-grad.txt"
+          "${qtc_cover_dir}/grad-gtk-3.0.css"
+  COMMAND sh "${qtc_check}/assert-alphas.sh" -s -a -d gtk4
+          -m ${qtc_shades_flat4} -n ${qtc_shades_flat4}
+          "${qtc_check}/shades-flat.txt"
+          "${qtc_cover_dir}/flat-gtk-4.0.css"
+  COMMAND sh "${qtc_check}/assert-alphas.sh" -s -a -d gtk3
+          -m ${qtc_shades_flat3} -n ${qtc_shades_flat3}
+          "${qtc_check}/shades-flat.txt"
+          "${qtc_cover_dir}/flat-gtk-3.0.css"
+  COMMAND sh "${qtc_check}/assert-alphas.sh" -s -a -d gtk4
+          -m ${qtc_shades_opt4} -n ${qtc_shades_opt4}
+          "${qtc_check}/shades-opt.txt"
+          "${qtc_cover_dir}/opt-gtk-4.0.css"
+  COMMAND sh "${qtc_check}/assert-alphas.sh" -s -a -d gtk3
+          -m ${qtc_shades_opt3} -n ${qtc_shades_opt3}
+          "${qtc_check}/shades-opt.txt"
+          "${qtc_cover_dir}/opt-gtk-3.0.css"
+  VERBATIM)
+
+add_custom_command(TARGET qtcurve-gtk-theme POST_BUILD
+  COMMAND sh "${qtc_check}/assert-paths.sh" -a -d gtk4 -n ${qtc_rows_rest4}
+          -x "${qtc_check}/paths-options.txt"
+          "${qtc_check}/paths.txt" "${qtc_cover_dir}/opt-gtk-4.0.css"
+  COMMAND sh "${qtc_check}/assert-paths.sh" -a -d gtk3 -n ${qtc_rows_rest3}
+          -x "${qtc_check}/paths-options.txt"
+          "${qtc_check}/paths.txt" "${qtc_cover_dir}/opt-gtk-3.0.css"
+  # Every run above reads -a, which takes the ground class off the sheet. The
+  # two runs below read no -a, so the ground class of each row of the option
+  # table holds against the arm sheet.
+  COMMAND sh "${qtc_check}/assert-paths.sh" -d gtk4 -n ${qtc_rows_opt4}
+          "${qtc_check}/paths-options.txt" "${qtc_cover_dir}/opt-gtk-4.0.css"
+  COMMAND sh "${qtc_check}/assert-paths.sh" -d gtk3 -n ${qtc_rows_opt3}
+          "${qtc_check}/paths-options.txt" "${qtc_cover_dir}/opt-gtk-3.0.css"
+  # The two tables above together hold every rule of the option arm. The run
+  # below reads them as one, so the coverage test can run.
+  COMMAND sh "${qtc_check}/assert-paths.sh" -a -c -u -d gtk4
+          -n ${qtc_rows_both4} -x "${qtc_check}/paths-options.txt"
+          "${qtc_check}/paths.txt" "${qtc_cover_dir}/opt-gtk-4.0.css"
+  COMMAND sh "${qtc_check}/assert-paths.sh" -a -c -u -d gtk3
+          -n ${qtc_rows_both3} -x "${qtc_check}/paths-options.txt"
+          "${qtc_check}/paths.txt" "${qtc_cover_dir}/opt-gtk-3.0.css"
+  # The window of the two arms below paints an opaque gradient that follows
+  # the colour scheme. The run reads no -a, so every row of the table holds
+  # against the sheet.
+  COMMAND sh "${qtc_check}/assert-paths.sh" -d gtk4 -n ${qtc_rows_cover}
+          "${qtc_check}/paths-cover.txt" "${qtc_cover_dir}/cover-gtk-4.0.css"
+  COMMAND sh "${qtc_check}/assert-paths.sh" -d gtk3 -n ${qtc_rows_cover}
+          "${qtc_check}/paths-cover.txt" "${qtc_cover_dir}/cover-gtk-3.0.css"
+  COMMAND sh "${qtc_check}/assert-paths.sh" -d gtk4 -n ${qtc_rows_cover}
+          "${qtc_check}/paths-cover.txt" "${qtc_cover_dir}/grad-gtk-4.0.css"
+  COMMAND sh "${qtc_check}/assert-paths.sh" -d gtk3 -n ${qtc_rows_cover}
+          "${qtc_check}/paths-cover.txt" "${qtc_cover_dir}/grad-gtk-3.0.css"
+  VERBATIM)
+
+# The shading arm takes a model that the GTK function shade() does not
+# compute, so the emitter writes a literal for every derived ground. The arm
+# reads the distinct colour scheme, so no two roles hold one value.
+add_custom_command(TARGET qtcurve-gtk-theme POST_BUILD
+  COMMAND "${qtc_writer_command}" --stdout --force
+          --settings "${qtc_check}/shading.qtcurve" --scheme "${qtc_distinct}"
+          --dialect gtk4 --asset-base "../assets/"
+          --out "${qtc_cover_dir}/shade-gtk-4.0.css"
+  COMMAND "${qtc_writer_command}" --stdout --force
+          --settings "${qtc_check}/shading.qtcurve" --scheme "${qtc_distinct}"
+          --dialect gtk3 --asset-base "../assets/"
+          --out "${qtc_cover_dir}/shade-gtk-3.0.css"
+  COMMAND sh "${qtc_check}/assert-varnames.sh" -n ${qtc_names_shade}
+          "${qtc_cover_dir}/shade-gtk-4.0.css"
+  # The run reads no -a, so the ground class of every row of the table holds.
+  COMMAND sh "${qtc_check}/assert-paths.sh" -c -p -d gtk4 -n ${qtc_rows_shade4}
+          "${qtc_check}/paths-shading.txt"
+          "${qtc_cover_dir}/shade-gtk-4.0.css"
+  COMMAND sh "${qtc_check}/assert-paths.sh" -c -p -d gtk3 -n ${qtc_rows_shade3}
+          "${qtc_check}/paths-shading.txt"
+          "${qtc_cover_dir}/shade-gtk-3.0.css"
+  COMMAND sh "${qtc_check}/assert-alphas.sh" -a -d gtk4
+          -m ${qtc_avals4_shade} -n ${qtc_alphas4_arm}
+          "${qtc_check}/alphas.txt" "${qtc_cover_dir}/shade-gtk-4.0.css"
+  COMMAND sh "${qtc_check}/assert-alphas.sh" -a -d gtk3
+          -m ${qtc_avals3_shade} -n ${qtc_alphas3}
+          "${qtc_check}/alphas.txt" "${qtc_cover_dir}/shade-gtk-3.0.css"
+  COMMAND sh "${qtc_check}/assert-follow.sh" ${qtc_follow_shade3}
+          "${qtc_cover_dir}/shade-gtk-3.0.css"
+  COMMAND sh "${qtc_check}/assert-follow.sh" -r ${qtc_follow_shade4}
+          "${qtc_cover_dir}/shade-gtk-4.0.css"
+  COMMAND sh "${qtc_check}/assert-nodes.sh" -n ${qtc_rules_shade4}
+          "${qtc_cover_dir}/shade-gtk-4.0.css" gtk4
+  COMMAND sh "${qtc_check}/assert-nodes.sh" -n ${qtc_rules_shade3}
+          "${qtc_cover_dir}/shade-gtk-3.0.css" gtk3
+  COMMAND sh "${qtc_check}/assert-pairs.sh" -n ${qtc_rules_shade4}
+          "${qtc_cover_dir}/shade-gtk-4.0.css"
+  COMMAND sh "${qtc_check}/assert-pairs.sh" -n ${qtc_rules_shade3}
+          "${qtc_cover_dir}/shade-gtk-3.0.css"
+  COMMAND sh "${qtc_check}/assert-layers.sh" -n ${qtc_layers_shade4}
+          "${qtc_cover_dir}/shade-gtk-4.0.css"
+  COMMAND sh "${qtc_check}/assert-layers.sh" -n ${qtc_layers_shade3}
+          "${qtc_cover_dir}/shade-gtk-3.0.css"
+  COMMAND sh "${qtc_check}/assert-boxes.sh" -k "${qtc_check}/boxes-keep.txt"
+          -n ${qtc_boxes_arm4} "${qtc_cover_dir}/shade-gtk-4.0.css"
+  COMMAND sh "${qtc_check}/assert-boxes.sh" -k "${qtc_check}/boxes-keep.txt"
+          -n ${qtc_boxes_arm3} "${qtc_cover_dir}/shade-gtk-3.0.css"
+  VERBATIM)
+
+# The raised arm gives the sheets of the flat arm, byte for byte, because
+# qtcIsFlat() holds both values. A path table run of that arm reads nothing
+# new, so the control below states the identity in place of the run.
+add_custom_command(TARGET qtcurve-gtk-theme POST_BUILD
+  COMMAND "${qtc_writer_command}" --stdout --force
+          --settings "${qtc_check}/raised.qtcurve" --scheme "${qtc_light}"
+          --dialect gtk4 --asset-base "../assets/"
+          --out "${qtc_cover_dir}/raised-gtk-4.0.css"
+  COMMAND "${qtc_writer_command}" --stdout --force
+          --settings "${qtc_check}/raised.qtcurve" --scheme "${qtc_light}"
+          --dialect gtk3 --asset-base "../assets/"
+          --out "${qtc_cover_dir}/raised-gtk-3.0.css"
+  COMMAND "${CMAKE_COMMAND}" -E compare_files
+          "${qtc_cover_dir}/raised-gtk-4.0.css"
+          "${qtc_cover_dir}/flat-gtk-4.0.css"
+  COMMAND "${CMAKE_COMMAND}" -E compare_files
+          "${qtc_cover_dir}/raised-gtk-3.0.css"
+          "${qtc_cover_dir}/flat-gtk-3.0.css"
+  VERBATIM)
+
+# Every check above reads a sheet as text. The check below reads one in GTK 3
+# itself. It builds a menu bar with an open menu. It then reads the node path,
+# the caption colour and the box of each state that the toolkit gives. A text
+# check reads the path that a table states, and this run reads the path that
+# the toolkit builds. GTK is no build dependency of this module, and the run
+# needs a display, so the caller asks for the check.
+option(QTC_GTK3_RENDER "Read the GTK 3 sheets in GTK 3. Needs a display." OFF)
+if(QTC_GTK3_RENDER)
+  find_package(PkgConfig REQUIRED)
+  pkg_check_modules(QTC_GTK3 REQUIRED IMPORTED_TARGET gtk+-3.0)
+  add_executable(qtcurve-gtk3-render check/render-gtk3.c)
+  target_link_libraries(qtcurve-gtk3-render PkgConfig::QTC_GTK3 m)
+  add_dependencies(qtcurve-gtk-theme qtcurve-gtk3-render)
+  add_custom_command(TARGET qtcurve-gtk-theme POST_BUILD
+    COMMAND "$<TARGET_FILE:qtcurve-gtk3-render>"
+            "${qtc_theme_dir}/gtk-3.0/gtk.css"
+    COMMAND "$<TARGET_FILE:qtcurve-gtk3-render>"
+            "${qtc_theme_dir}/gtk-3.0/gtk-dark.css"
+    VERBATIM)
+endif()
+
+# The cross check against the daemon itself, which the caller asks for. Set
+# QTC_KDED_NAMES to kded/configvalueprovider.cpp of a kde-gtk-config checkout,
+# or to the installed kded plugin gtkconfig.so of that daemon.
+set(QTC_KDED_NAMES "" CACHE FILEPATH
+  "File of kde-gtk-config that holds the colour names.")
+if(QTC_KDED_NAMES)
+  add_custom_command(TARGET qtcurve-gtk-theme POST_BUILD
+    COMMAND sh "${qtc_check}/assert-kded-names.sh"
+            "${QTC_KDED_NAMES}" ${qtc_sheets}
+    VERBATIM)
+endif()
+
 configure_file(autostart/qtcurve-gtk-writer.desktop.in
   "${CMAKE_CURRENT_BINARY_DIR}/qtcurve-gtk-writer.desktop" @ONLY)
 
