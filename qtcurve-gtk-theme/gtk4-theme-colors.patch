diff --git a/gtk4/check/render-gtk3.c b/gtk4/check/render-gtk3.c
new file mode 100644
index 00000000..6921cbbd
--- /dev/null
+++ b/gtk4/check/render-gtk3.c
@@ -0,0 +1,311 @@
+/*****************************************************************************
+ *   Copyright 2026 QtCurve authors                                          *
+ *                                                                           *
+ *   This program is free software; you can redistribute it and/or modify    *
+ *   it under the terms of the GNU Lesser General Public License as          *
+ *   published by the Free Software Foundation; either version 2.1 of the    *
+ *   License, or (at your option) version 3, or any later version accepted   *
+ *   by the membership of KDE e.V. (or its successor approved by the         *
+ *   membership of KDE e.V.), which shall act as a proxy defined in          *
+ *   Section 6 of version 3 of the license.                                  *
+ *                                                                           *
+ *   This program is distributed in the hope that it will be useful,         *
+ *   but WITHOUT ANY WARRANTY; without even the implied warranty of          *
+ *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU       *
+ *   Lesser General Public License for more details.                         *
+ *                                                                           *
+ *   You should have received a copy of the GNU Lesser General Public        *
+ *   License along with this library. If not,                                *
+ *   see <http://www.gnu.org/licenses/>.                                     *
+ *****************************************************************************/
+
+/* render-gtk3 SHEET: read one GTK 3 sheet in GTK 3 itself.
+ *
+ * The run needs a display, and it gives 0 for a sound sheet and 1 for a
+ * fault.
+ */
+
+#include <gtk/gtk.h>
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+
+/* The least contrast of a caption over the ground under it, from 1.0 to
+ * 21.0. The WCAG model gives this value to the large text step, and a caption
+ * under it reads as a shadow of the ground. */
+#define CONTRAST_FLOOR 3.0
+
+static int faults;
+static int criticals;
+static int captions;
+static int states;
+
+static void
+fault(const char *fmt, ...)
+{
+  va_list ap;
+  va_start (ap, fmt);
+  fprintf (stderr, "render-gtk3: ");
+  vfprintf (stderr, fmt, ap);
+  fprintf (stderr, "\n");
+  va_end (ap);
+  faults++;
+}
+
+static void
+log_handler (const gchar *domain, GLogLevelFlags level, const gchar *msg,
+             gpointer data)
+{
+  (void) data;
+  if (level & (G_LOG_LEVEL_CRITICAL | G_LOG_LEVEL_ERROR)) {
+    fprintf (stderr, "render-gtk3: %s: %s\n", domain ? domain : "-", msg);
+    criticals++;
+  }
+}
+
+static void
+pump (void)
+{
+  for (int i = 0; i < 4; i++)
+    while (gtk_events_pending ())
+      gtk_main_iteration ();
+}
+
+/* Returns the relative luminance of c, of the WCAG contrast model. */
+static double
+luma (const GdkRGBA *c)
+{
+  const double ch[3] = { c->red, c->green, c->blue };
+  const double w[3] = { 0.2126, 0.7152, 0.0722 };
+  double out = 0;
+  for (int i = 0; i < 3; i++) {
+    double v = ch[i] <= 0.03928 ? ch[i] / 12.92 :
+      pow ((ch[i] + 0.055) / 1.055, 2.4);
+    out += w[i] * v;
+  }
+  return out;
+}
+
+/* Returns the contrast of a over b, from 1.0 to 21.0. */
+static double
+contrast (const GdkRGBA *a, const GdkRGBA *b)
+{
+  double la = luma (a);
+  double lb = luma (b);
+  return (MAX (la, lb) + 0.05) / (MIN (la, lb) + 0.05);
+}
+
+static gboolean
+same (const GdkRGBA *a, const GdkRGBA *b)
+{
+  return fabs (a->red - b->red) < 1.0 / 255 &&
+    fabs (a->green - b->green) < 1.0 / 255 &&
+    fabs (a->blue - b->blue) < 1.0 / 255;
+}
+
+static char *
+hex (const GdkRGBA *c)
+{
+  static char buf[4][16];
+  static int at;
+  at = (at + 1) % 4;
+  g_snprintf (buf[at], sizeof buf[at], "#%02x%02x%02x",
+              (int) (c->red * 255 + 0.5), (int) (c->green * 255 + 0.5),
+              (int) (c->blue * 255 + 0.5));
+  return buf[at];
+}
+
+static GdkRGBA
+colour_of (GtkWidget *w)
+{
+  GdkRGBA out;
+  GtkStyleContext *ctx = gtk_widget_get_style_context (w);
+  gtk_style_context_get_color (ctx, gtk_style_context_get_state (ctx), &out);
+  return out;
+}
+
+/* Reads the colour name name against the style of w. */
+static GdkRGBA
+name_of (GtkWidget *w, const char *name)
+{
+  GdkRGBA out = { 0, 0, 0, 1 };
+  if (!gtk_style_context_lookup_color (gtk_widget_get_style_context (w),
+                                       name, &out))
+    fault ("the sheet declares no colour name %s", name);
+  return out;
+}
+
+/* Returns the label child of the menu item item. */
+static GtkWidget *
+label_of (GtkWidget *item)
+{
+  GtkWidget *child = gtk_bin_get_child (GTK_BIN (item));
+  return GTK_IS_LABEL (child) ? child : NULL;
+}
+
+static char *
+path_of (GtkWidget *w)
+{
+  return gtk_widget_path_to_string (gtk_widget_get_path (w));
+}
+
+/* Reads the caption of every item of the popup that the bar item opens. The
+ * popup must keep the menu foreground, and not the caption of the bar item
+ * under the mouse. */
+static void
+check_menu (GtkWidget *bar_item, GtkWidget *menu, GtkWidget **items, int n)
+{
+  gtk_widget_set_state_flags (bar_item, GTK_STATE_FLAG_PRELIGHT, FALSE);
+  pump ();
+
+  char *path = path_of (label_of (items[0]));
+  printf ("render-gtk3: the popup caption takes the path %s\n", path);
+  if (!strstr (path, "menubar"))
+    fault ("the toolkit holds the popup outside the menu bar item, so the "
+           "path of the sheet no longer models it");
+  g_free (path);
+
+  GdkRGBA fg = name_of (menu, "theme_fg_color_breeze");
+  GdkRGBA bg = name_of (menu, "theme_bg_color_breeze");
+  GdkRGBA sel = name_of (menu, "theme_selected_fg_color_breeze");
+  for (int i = 0; i < n; i++) {
+    GtkWidget *lb = label_of (items[i]);
+    GdkRGBA got = colour_of (lb);
+    captions++;
+    if (!same (&got, &fg))
+      fault ("the popup caption %d takes %s, and the menu foreground is %s",
+             i, hex (&got), hex (&fg));
+    /* A colour scheme that holds one value for the two names hides the
+     * fault, so the run reads the second name only where they differ. */
+    if (!same (&fg, &sel) && same (&got, &sel))
+      fault ("the popup caption %d takes the caption of the bar item", i);
+    double c = contrast (&got, &bg);
+    if (c < CONTRAST_FLOOR)
+      fault ("the popup caption %d holds the contrast %.2f over the menu "
+             "ground %s, under %.2f", i, c, hex (&bg), CONTRAST_FLOOR);
+  }
+  gtk_widget_unset_state_flags (bar_item, GTK_STATE_FLAG_PRELIGHT);
+  pump ();
+}
+
+static void
+resize_up (GtkWidget *w)
+{
+  for (GtkWidget *x = w; x; x = gtk_widget_get_parent (x))
+    gtk_widget_queue_resize (x);
+  pump ();
+}
+
+/* Reads the size that the widget w asks for in the plain state and in each
+ * cue state. A difference moves the widget and the layout around it. */
+static void
+check_boxes (GtkWidget *w, gpointer data)
+{
+  static const struct { const char *name; GtkStateFlags flag; } cues[] = {
+    { "hover", GTK_STATE_FLAG_PRELIGHT },
+    { "focus", GTK_STATE_FLAG_FOCUSED },
+    { "active", GTK_STATE_FLAG_ACTIVE },
+    { "checked", GTK_STATE_FLAG_CHECKED },
+  };
+  (void) data;
+  if (gtk_widget_get_visible (w)) {
+    GtkRequisition plain, cue;
+    resize_up (w);
+    gtk_widget_get_preferred_size (w, &plain, NULL);
+    for (guint i = 0; i < G_N_ELEMENTS (cues); i++) {
+      gtk_widget_set_state_flags (w, cues[i].flag, FALSE);
+      resize_up (w);
+      gtk_widget_get_preferred_size (w, &cue, NULL);
+      gtk_widget_unset_state_flags (w, cues[i].flag);
+      resize_up (w);
+      states++;
+      if (cue.width == plain.width && cue.height == plain.height)
+        continue;
+      char *path = path_of (w);
+      fault ("%s asks for %dx%d under %s, and %dx%d in the plain state",
+             path, cue.width, cue.height, cues[i].name, plain.width,
+             plain.height);
+      g_free (path);
+    }
+  }
+  if (GTK_IS_CONTAINER (w))
+    gtk_container_forall (GTK_CONTAINER (w), check_boxes, NULL);
+}
+
+int
+main (int argc, char **argv)
+{
+  if (argc != 2) {
+    fprintf (stderr, "usage: render-gtk3 SHEET\n");
+    return 1;
+  }
+  g_log_set_default_handler (log_handler, NULL);
+  if (!gtk_init_check (&argc, &argv)) {
+    fprintf (stderr, "render-gtk3: no display, and the check reads one\n");
+    return 1;
+  }
+
+  GtkCssProvider *prov = gtk_css_provider_new ();
+  GError *err = NULL;
+  if (!gtk_css_provider_load_from_path (prov, argv[1], &err)) {
+    fprintf (stderr, "render-gtk3: %s: %s\n", argv[1], err->message);
+    return 1;
+  }
+  gtk_style_context_add_provider_for_screen (gdk_screen_get_default (),
+                                             GTK_STYLE_PROVIDER (prov),
+                                             GTK_STYLE_PROVIDER_PRIORITY_USER);
+
+  GtkWidget *win = gtk_offscreen_window_new ();
+  GtkWidget *box = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+  gtk_container_add (GTK_CONTAINER (win), box);
+
+  GtkWidget *bar = gtk_menu_bar_new ();
+  GtkWidget *bar_item = gtk_menu_item_new_with_label ("File");
+  GtkWidget *menu = gtk_menu_new ();
+  const char *names[] = { "New", "Open", "Save" };
+  GtkWidget *items[G_N_ELEMENTS (names)];
+  for (guint i = 0; i < G_N_ELEMENTS (names); i++) {
+    items[i] = gtk_menu_item_new_with_label (names[i]);
+    gtk_menu_shell_append (GTK_MENU_SHELL (menu), items[i]);
+  }
+  gtk_menu_item_set_submenu (GTK_MENU_ITEM (bar_item), menu);
+  gtk_menu_shell_append (GTK_MENU_SHELL (bar), bar_item);
+  gtk_box_pack_start (GTK_BOX (box), bar, FALSE, FALSE, 0);
+
+  GtkWidget *flat = gtk_button_new_with_label ("Flat");
+  gtk_style_context_add_class (gtk_widget_get_style_context (flat), "flat");
+  gtk_box_pack_start (GTK_BOX (box), flat, FALSE, FALSE, 0);
+
+  GtkWidget *tools = gtk_toolbar_new ();
+  GtkToolItem *tool = gtk_tool_button_new (NULL, "Tool");
+  gtk_toolbar_insert (GTK_TOOLBAR (tools), tool, -1);
+  gtk_box_pack_start (GTK_BOX (box), tools, FALSE, FALSE, 0);
+
+  gtk_box_pack_start (GTK_BOX (box), gtk_entry_new (), FALSE, FALSE, 0);
+  gtk_box_pack_start (GTK_BOX (box),
+                      gtk_spin_button_new_with_range (0, 100, 1),
+                      FALSE, FALSE, 0);
+  gtk_box_pack_start (GTK_BOX (box), gtk_button_new_with_label ("Plain"),
+                      FALSE, FALSE, 0);
+  gtk_box_pack_start (GTK_BOX (box), gtk_check_button_new_with_label ("Check"),
+                      FALSE, FALSE, 0);
+
+  gtk_widget_show_all (win);
+  gtk_widget_show_all (menu);
+  pump ();
+
+  check_menu (bar_item, menu, items, G_N_ELEMENTS (items));
+  check_boxes (box, NULL);
+  check_boxes (menu, NULL);
+
+  if (criticals)
+    fault ("the toolkit gave %d critical messages", criticals);
+  if (faults) {
+    fprintf (stderr, "render-gtk3: %s holds %d faults\n", argv[1], faults);
+    return 1;
+  }
+  printf ("render-gtk3: %s ok, %d popup captions keep the menu foreground "
+          "and %d cue states hold the box of the plain state\n",
+          argv[1], captions, states);
+  return 0;
+}
