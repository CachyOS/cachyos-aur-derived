diff --git a/gtk4/check/assert-alphas.sh b/gtk4/check/assert-alphas.sh
new file mode 100644
index 00000000..42756409
--- /dev/null
+++ b/gtk4/check/assert-alphas.sh
@@ -0,0 +1,198 @@
+#!/bin/sh
+# assert-alphas.sh [-a] [-d DIALECT] [-m HITS] [-n MIN] [-s] TABLE SHEET...:
+# every translucent value of a sheet holds the alpha of its row of TABLE. The
+# -s flag binds the shade and mix factors in place of the alpha values. Every
+# row of the dialect reaches a value, and MIN is the floor of the row count.
+usage='usage: assert-alphas.sh [-a] [-d DIALECT] [-m HITS] [-n MIN] [-s] TABLE SHEET...'
+set -eu
+all=0
+dialect=
+min=1
+hits=1
+shades=0
+while true; do
+    case ${1:-} in
+        # -a reads the rows of an arm sheet as well, and a row that reaches no
+        # value is then no fault. A value with no row still fails.
+        -a) all=1; shift;;
+        # -d drops every row of the other dialect, gtk3 or gtk4.
+        -d) dialect=${2:?$usage}; shift 2;;
+        # -m is the floor of the translucent values that the sheet holds. An
+        # empty sheet and a sheet that loses an alpha both fall under it.
+        -m) hits=${2:?$usage}; shift 2;;
+        # -n is the floor of the row count that the run reads.
+        -n) min=${2:?$usage}; shift 2;;
+        # -s reads the factor of every shade() and mix() call in place of the
+        # alpha of every rgba() and alpha() call.
+        -s) shades=1; shift;;
+        *) break;;
+    esac
+done
+table=${1:?$usage}
+shift
+if [ $# -eq 0 ]; then
+    echo "$usage" >&2
+    exit 1
+fi
+
+status=0
+for sheet in "$@"; do
+    awk -v sheet="$sheet" -v table="$table" -v dialect="$dialect" \
+        -v min="$min" -v all="$all" -v hits="$hits" -v shades="$shades" '
+# Returns the last argument of every colour function call of the value v, in
+# order and with one space between two of them. The call set is rgba() and
+# alpha(), or shade() and mix() under -s.
+function alphas(v,   i, j, d, c, last, n, out, at) {
+    out = ""
+    for (i = 1;i <= length(v);i++) {
+        at = 0
+        if (shades) {
+            if (substr(v, i, 6) == "shade(")
+                at = 6
+            else if (substr(v, i, 4) == "mix(")
+                at = 4
+        } else if (substr(v, i, 5) == "rgba(") {
+            at = 5
+        } else if (substr(v, i, 6) == "alpha(") {
+            at = 6
+        }
+        if (at == 0)
+            continue
+        d = 1
+        j = i + at
+        last = j
+        for (;j <= length(v);j++) {
+            c = substr(v, j, 1)
+            if (c == "(") {
+                d++
+            } else if (c == ")") {
+                if (--d == 0)
+                    break
+            } else if (c == "," && d == 1) {
+                last = j + 1
+            }
+        }
+        n = substr(v, last, j - last)
+        gsub(/^ +| +$/, "", n)
+        out = out (out == "" ? "" : " ") n
+    }
+    return out
+}
+
+# The table rows come first, keyed by the selector and the property.
+FILENAME == table {
+    sub(/#.*/, "")
+    if ($0 ~ /^[ \t]*$/)
+        next
+    n = split($0, f, / *\| */)
+    if (n < 3) {
+        printf "assert-alphas: %s: bad row %s\n", table, $0 > "/dev/stderr"
+        bad++
+        next
+    }
+    d = (n >= 4 ? f[4] : "")
+    gsub(/^ +| +$/, "", d)
+    if (d != "" && dialect != "" && d != dialect)
+        next
+    # An arm row holds a value that no shipped sheet paints, so a strict run
+    # drops it and an arm run reads it.
+    arm = (n >= 5 ? f[5] : "")
+    gsub(/^ +| +$/, "", arm)
+    if (arm != "" && !all)
+        next
+    gsub(/^ +| +$/, "", f[1])
+    gsub(/^ +| +$/, "", f[2])
+    gsub(/^ +| +$/, "", f[3])
+    key = f[1] "|" f[2]
+    if (key in want) {
+        printf "assert-alphas: %s: two rows for %s\n", table, key \
+            > "/dev/stderr"
+        bad++
+    }
+    want[key] = f[3]
+    rows++
+    next
+}
+# The sheet follows. A rule keeps the first of its selectors, with no rank
+# guard, and every declaration that paints a translucent colour gives one row.
+/\{$/ && depth == 0 {
+    sel = substr($0, 1, length($0) - 2)
+    gsub(/:not\(#qtc-rank\)/, "", sel)
+    split(sel, a, ", ")
+    sel = a[1]
+    depth = 1
+    # An at rule such as @keyframes holds its declarations in a nested block,
+    # which the line parse below does not read. No alpha may hide there.
+    atrule = (substr(sel, 1, 1) == "@")
+    next
+}
+depth > 0 && $0 == "}" {
+    depth = 0
+    atrule = 0
+    next
+}
+depth > 0 && atrule {
+    if ($0 ~ /rgba\(|alpha\(|mix\(|shade\(/) {
+        printf "assert-alphas: %s: %s holds the translucent value %s\n", \
+            sheet, sel, $0 > "/dev/stderr"
+        bad++
+    }
+    next
+}
+depth > 0 && $0 ~ /^  [-a-zA-Z]+: .*;$/ {
+    if (shades) {
+        if ($0 !~ /shade\(|mix\(/)
+            next
+    } else if ($0 !~ /rgba\(|alpha\(|mix\(/) {
+        next
+    }
+    prop = substr($0, 3, index($0, ":") - 3)
+    val = substr($0, index($0, ":") + 2, length($0) - index($0, ":") - 2)
+    got = alphas(val)
+    # A mix() of two opaque colours paints no translucent value.
+    if (got == "")
+        next
+    # A nested shade of one property gives its factors in one row.
+    key = sel "|" prop
+    if (!(key in want)) {
+        printf "assert-alphas: %s: %s %s holds the alpha %s and no row\n", \
+            sheet, sel, prop, got > "/dev/stderr"
+        bad++
+        next
+    }
+    if (want[key] != got) {
+        printf "assert-alphas: %s: %s %s holds the alpha %s and not %s\n", \
+            sheet, sel, prop, got, want[key] > "/dev/stderr"
+        bad++
+    }
+    seen[key] = 1
+    hit++
+    next
+}
+END {
+    for (key in want) {
+        if (!all && !(key in seen)) {
+            split(key, k, "|")
+            printf "assert-alphas: %s: no rule %s paints the alpha %s of %s\n",\
+                sheet, k[1], want[key], k[2] > "/dev/stderr"
+            bad++
+        }
+    }
+    if (bad)
+        exit 1
+    if (rows < min) {
+        printf "assert-alphas: %s reads %d rows, under %d\n", table, \
+            rows + 0, min > "/dev/stderr"
+        exit 1
+    }
+    if (hit < hits) {
+        printf "assert-alphas: %s holds %d translucent values, under %d\n", \
+            sheet, hit + 0, hits > "/dev/stderr"
+        exit 1
+    }
+    printf "assert-alphas: %s ok, %d %s rows and %d values\n", sheet, \
+        rows, (shades ? "shade" : "alpha"), hit + 0
+}
+' "$table" "$sheet" || status=1
+done
+exit $status
diff --git a/gtk4/check/assert-boxes.sh b/gtk4/check/assert-boxes.sh
new file mode 100644
index 00000000..61128ab1
--- /dev/null
+++ b/gtk4/check/assert-boxes.sh
@@ -0,0 +1,298 @@
+#!/bin/sh
+# assert-boxes.sh [-k KEEP] [-n MIN] SHEET...: a rule of a cue state must
+# hold the box of the plain rule under it. A state that declares a padding, a
+# margin, a least size or a border width of another value moves the widget.
+# The run then fails. MIN is the floor of the state count, and KEEP names the
+# states that may hold another box.
+usage='usage: assert-boxes.sh [-k KEEP] [-n MIN] SHEET...'
+set -eu
+keep=
+min=1
+while true; do
+    case ${1:-} in
+        -k) keep=${2:?$usage}; shift 2;;
+        -n) min=${2:?$usage}; shift 2;;
+        *) break;;
+    esac
+done
+if [ $# -eq 0 ]; then
+    echo "$usage" >&2
+    exit 1
+fi
+
+status=0
+for sheet in "$@"; do
+    awk -v sheet="$sheet" -v min="$min" -v keepfile="$keep" '
+# Returns the value v with the fallback of every var() read in its place.
+function literal(v,   at, i, d, e, c, ch, fb) {
+    while ((at = index(v, "var(--qtc-")) > 0) {
+        d = 0
+        e = 0
+        for (i = at + 3;i <= length(v);i++) {
+            ch = substr(v, i, 1)
+            if (ch == "(") {
+                d++
+            } else if (ch == ")") {
+                if (--d == 0) {
+                    e = i
+                    break
+                }
+            }
+        }
+        if (e == 0)
+            return v
+        c = 0
+        d = 0
+        for (i = at + 3;i < e;i++) {
+            ch = substr(v, i, 1)
+            if (ch == "(") {
+                d++
+            } else if (ch == ")") {
+                d--
+            } else if (ch == "," && d == 1) {
+                c = i
+                break
+            }
+        }
+        fb = c > 0 ? substr(v, c + 1, e - c - 1) : ""
+        gsub(/^ +| +$/, "", fb)
+        v = substr(v, 1, at - 1) fb substr(v, e + 1)
+    }
+    return v
+}
+# Returns 1 while the property p takes room in the box of a widget. A radius
+# and a colour of one side take none, so neither reaches this test.
+function isgeo(p) {
+    return p == "padding" || p == "margin" || p == "min-width" ||
+        p == "min-height" || p == "border" || p == "border-width" ||
+        p ~ /^(padding|margin|border)-(top|right|bottom|left)(-width)?$/
+}
+# Returns the width of the border value v, in pixels and with no unit.
+function bwidth(v) {
+    v = literal(v)
+    gsub(/^ +| +$/, "", v)
+    if (v == "none" || v == "0")
+        return "0"
+    if (v ~ /^[0-9.]+px/) {
+        sub(/px.*/, "", v)
+        return v
+    }
+    return v
+}
+# Returns the value v of the property p, in the form that the two rules
+# compare.
+function shape(p, v) {
+    if (p == "border" || p ~ /-width$/)
+        return bwidth(v)
+    v = literal(v)
+    gsub(/^ +| +$/, "", v)
+    return v
+}
+# Returns 1 while the token t of a compound names a state of a widget.
+function isstate(t) {
+    if (substr(t, 1, 1) != ":" || index(t, "(") > 0)
+        return 0
+    return index(" hover active checked selected focus focus-within " \
+                 "focus-visible backdrop disabled indeterminate ",
+                 " " substr(t, 2) " ") > 0
+}
+# Returns the index one past the token of the compound c that starts at i.
+function tokend(c, i,   ch, d) {
+    ch = substr(c, i, 1)
+    if (ch == ":") {
+        i++
+        while (i <= length(c) && substr(c, i, 1) ~ /[A-Za-z0-9_-]/)
+            i++
+        if (substr(c, i, 1) == "(") {
+            d = 0
+            while (i <= length(c)) {
+                ch = substr(c, i, 1)
+                if (ch == "(") {
+                    d++
+                } else if (ch == ")") {
+                    if (--d == 0)
+                        return i + 1
+                }
+                i++
+            }
+        }
+        return i
+    }
+    if (ch == "." || ch == "#") {
+        i++
+        while (i <= length(c) && substr(c, i, 1) ~ /[A-Za-z0-9_-]/)
+            i++
+        return i
+    }
+    while (i <= length(c) && substr(c, i, 1) !~ /[.:#]/)
+        i++
+    return i
+}
+# Returns the index of the first character of the last compound of s.
+function lastcomp(s,   i, d, ch, at) {
+    at = 1
+    d = 0
+    for (i = 1;i <= length(s);i++) {
+        ch = substr(s, i, 1)
+        if (ch == "(") {
+            d++
+        } else if (ch == ")") {
+            d--
+        } else if (d == 0 && (ch == " " || ch == ">")) {
+            at = i + 1
+        }
+    }
+    return at
+}
+# Returns s with no state token on its last compound, or an empty string
+# while s names no state or holds a state alone.
+function nostate(s,   at, i, e, tok, out, had) {
+    at = lastcomp(s)
+    out = substr(s, 1, at - 1)
+    had = 0
+    i = at
+    while (i <= length(s)) {
+        e = tokend(s, i)
+        tok = substr(s, i, e - i)
+        if (isstate(tok)) {
+            had = 1
+        } else {
+            out = out tok
+        }
+        i = e
+    }
+    return (had && length(out) > at - 1) ? out : ""
+}
+# Returns s with no last class on its last compound, or an empty string while
+# that compound holds no class.
+function noclass(s,   at, i, e, tok, last) {
+    at = lastcomp(s)
+    last = 0
+    i = at
+    while (i <= length(s)) {
+        e = tokend(s, i)
+        if (substr(s, i, 1) == ".")
+            last = i
+        i = e
+    }
+    if (!last)
+        return ""
+    return substr(s, 1, last - 1) substr(s, tokend(s, last))
+}
+# Returns s with no first compound, or an empty string while s holds one.
+function nolead(s,   i, d, ch) {
+    d = 0
+    for (i = 1;i <= length(s);i++) {
+        ch = substr(s, i, 1)
+        if (ch == "(") {
+            d++
+        } else if (ch == ")") {
+            d--
+        } else if (d == 0 && ch == " ") {
+            s = substr(s, i + 1)
+            if (substr(s, 1, 2) == "> ")
+                s = substr(s, 3)
+            return s
+        }
+    }
+    return ""
+}
+# Returns the plain selector of the state selector s that the sheet holds, or
+# an empty string for none. The walk drops a class of the last compound
+# first, and then a compound at the head.
+function plain(s,   cand, up) {
+    cand = s
+    while (cand != "") {
+        if (cand in has)
+            return cand
+        up = noclass(cand)
+        if (up == "")
+            up = nolead(cand)
+        cand = up
+    }
+    return ""
+}
+BEGIN {
+    if (keepfile != "") {
+        while ((getline line < keepfile) > 0) {
+            sub(/#.*/, "", line)
+            if (line !~ /\|/)
+                continue
+            k = substr(line, 1, index(line, "|") - 1)
+            p = substr(line, index(line, "|") + 1)
+            gsub(/^ +| +$/, "", k)
+            gsub(/^ +| +$/, "", p)
+            kept[k, p] = 1
+        }
+        close(keepfile)
+    }
+}
+/\{$/ && depth == 0 {
+    sel = substr($0, 1, length($0) - 2)
+    depth = 1
+    skip = (substr(sel, 1, 1) == "@" || sel == ":root")
+    nsel = skip ? 0 : split(sel, list, /, /)
+    for (i = 1;i <= nsel;i++)
+        has[list[i]] = 1
+    next
+}
+depth > 0 && $0 == "}" {
+    depth = 0
+    next
+}
+depth > 0 && !skip && $0 ~ /^  [-a-zA-Z]+: .*;$/ {
+    prop = substr($0, 3, index($0, ":") - 3)
+    if (!isgeo(prop))
+        next
+    val = substr($0, index($0, ":") + 2, length($0) - index($0, ":") - 2)
+    for (i = 1;i <= nsel;i++) {
+        if (!((list[i], prop) in box))
+            props[list[i]] = props[list[i]] " " prop
+        box[list[i], prop] = val
+    }
+    next
+}
+END {
+    for (one in has) {
+        bare = nostate(one)
+        if (bare == "")
+            continue
+        base = plain(bare)
+        if (base == "") {
+            if (props[one] != "") {
+                printf "assert-boxes: %s: %s holds%s over no plain rule\n", \
+                    sheet, one, props[one] > "/dev/stderr"
+                bad++
+            }
+            continue
+        }
+        seen++
+        n = split(props[one], list, " ")
+        for (i = 1;i <= n;i++) {
+            prop = list[i]
+            if ((one, prop) in kept) {
+                held++
+                continue
+            }
+            want = ((base, prop) in box) ? shape(prop, box[base, prop]) : "-"
+            got = shape(prop, box[one, prop])
+            if (want == got)
+                continue
+            printf "assert-boxes: %s: %s takes %s: %s over %s: %s of %s\n", \
+                sheet, one, prop, got, prop, want, base > "/dev/stderr"
+            bad++
+        }
+    }
+    if (bad)
+        exit 1
+    if (seen < min) {
+        printf "assert-boxes: %s holds %d states, under %d\n", sheet, \
+            seen + 0, min > "/dev/stderr"
+        exit 1
+    }
+    printf "assert-boxes: %s ok, %d states hold the box of the plain rule, " \
+        "%d rows of the keep table\n", sheet, seen, held + 0
+}
+' "$sheet" || status=1
+done
+exit $status
diff --git a/gtk4/check/assert-follow.sh b/gtk4/check/assert-follow.sh
new file mode 100755
index 00000000..63c370c3
--- /dev/null
+++ b/gtk4/check/assert-follow.sh
@@ -0,0 +1,34 @@
+#!/bin/sh
+# assert-follow.sh [-r] MIN SHEET...: each SHEET must read at least MIN colour
+# names of kde-gtk-config outside the declaration block. The option -r counts
+# the :root block alone, because a GTK 4 rule repeats the name in the fallback
+# of its var().
+set -eu
+root=0
+if [ "${1:-}" = "-r" ]; then
+    root=1
+    shift
+fi
+min=${1:?usage: assert-follow.sh [-r] MIN SHEET...}
+shift
+if [ $# -eq 0 ]; then
+    echo "usage: assert-follow.sh [-r] MIN SHEET..." >&2
+    exit 1
+fi
+
+status=0
+for sheet in "$@"; do
+    if [ $root -eq 1 ]; then
+        body=$(sed -n '/^:root {/,/^}/p' "$sheet")
+    else
+        body=$(grep -v '^@define-color' "$sheet")
+    fi
+    reads=$(printf '%s\n' "$body" | grep -oE '@[a-z][a-z_0-9]*_breeze' | wc -l)
+    if [ "$reads" -lt "$min" ]; then
+        echo "assert-follow: $sheet reads $reads colour names, under $min" >&2
+        status=1
+        continue
+    fi
+    echo "assert-follow: $sheet ok, $reads colour names read"
+done
+exit $status
diff --git a/gtk4/check/assert-import.sh b/gtk4/check/assert-import.sh
new file mode 100644
index 00000000..1f54d24e
--- /dev/null
+++ b/gtk4/check/assert-import.sh
@@ -0,0 +1,15 @@
+#!/bin/sh
+# assert-import.sh SHEET TARGET: SHEET must import TARGET on its first line.
+# The dark GTK 4 sheet takes every rule from that import, and GTK drops an
+# import that stands after a rule.
+set -eu
+usage='usage: assert-import.sh SHEET TARGET'
+sheet=${1:?$usage}
+target=${2:?$usage}
+first=$(head -n 1 "$sheet")
+want="@import \"$target\";"
+if [ "$first" != "$want" ]; then
+    echo "assert-import: $sheet line 1 is '$first', and not '$want'" >&2
+    exit 1
+fi
+echo "assert-import: $sheet ok, it imports $target"
diff --git a/gtk4/check/assert-kded-names.sh b/gtk4/check/assert-kded-names.sh
new file mode 100755
index 00000000..8af5793c
--- /dev/null
+++ b/gtk4/check/assert-kded-names.sh
@@ -0,0 +1,57 @@
+#!/bin/sh
+# assert-kded-names.sh [-e] NAMES SHEET...: every _breeze colour name that a
+# SHEET declares must also stand in NAMES. NAMES is a name list of the tree or
+# of kde-gtk-config, and the option -e also asks every name of NAMES from each
+# SHEET.
+set -eu
+exact=0
+if [ "${1:-}" = "-e" ]; then
+    exact=1
+    shift
+fi
+names=${1:?usage: assert-kded-names.sh [-e] NAMES SHEET...}
+shift
+if [ $# -eq 0 ]; then
+    echo "usage: assert-kded-names.sh [-e] NAMES SHEET..." >&2
+    exit 1
+fi
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+
+grep -a -oE '[a-z][a-z_0-9]*_breeze' "$names" | sort -u > "$tmp/kded"
+if [ ! -s "$tmp/kded" ]; then
+    echo "assert-kded-names: $names holds no _breeze name" >&2
+    exit 1
+fi
+
+status=0
+for sheet in "$@"; do
+    grep -oE '^@define-color +[a-z][a-z_0-9]*_breeze' "$sheet" \
+        | awk '{print $2}' | sort -u > "$tmp/sheet"
+    if [ ! -s "$tmp/sheet" ]; then
+        echo "assert-kded-names: $sheet declares no _breeze name" >&2
+        status=1
+        continue
+    fi
+    ok=1
+    comm -23 "$tmp/sheet" "$tmp/kded" > "$tmp/gone"
+    if [ -s "$tmp/gone" ]; then
+        echo "assert-kded-names: $names has no name of $sheet for:" >&2
+        cat "$tmp/gone" >&2
+        ok=0
+    fi
+    if [ $exact -eq 1 ]; then
+        comm -13 "$tmp/sheet" "$tmp/kded" > "$tmp/miss"
+        if [ -s "$tmp/miss" ]; then
+            echo "assert-kded-names: $sheet declares no name of $names for:" >&2
+            cat "$tmp/miss" >&2
+            ok=0
+        fi
+    fi
+    if [ $ok -eq 0 ]; then
+        status=1
+        continue
+    fi
+    echo "assert-kded-names: $sheet ok, $(wc -l < "$tmp/sheet") names"
+done
+exit $status
diff --git a/gtk4/check/assert-layers.sh b/gtk4/check/assert-layers.sh
new file mode 100644
index 00000000..3770fe1c
--- /dev/null
+++ b/gtk4/check/assert-layers.sh
@@ -0,0 +1,96 @@
+#!/bin/sh
+# assert-layers.sh [-n MIN] SHEET...: every gradient and every mix() of a
+# sheet reads at most one colour name of kde-gtk-config, and each sheet holds
+# at least MIN of them. The emitter builds each one from one seed, so two
+# names inside one mark a stop that stopped following its own seed.
+usage='usage: assert-layers.sh [-n MIN] SHEET...'
+set -eu
+min=1
+if [ "${1:-}" = "-n" ]; then
+    min=${2:?$usage}
+    shift 2
+fi
+if [ $# -eq 0 ]; then
+    echo "$usage" >&2
+    exit 1
+fi
+
+status=0
+for sheet in "$@"; do
+    awk -v sheet="$sheet" -v min="$min" '
+# Returns the count of the gradient and mix() bodies of the value v, in lay[].
+# One body holds every stop of one gradient, or the two seeds of one mix.
+function layers(v,   i, j, d, ch, tok, at) {
+    n = 0
+    while (1) {
+        i = index(v, "linear-gradient(")
+        j = index(v, "mix(")
+        if (i == 0 && j == 0)
+            return n
+        if (i != 0 && (j == 0 || i < j)) {
+            at = i + 15
+        } else {
+            at = j + 3
+        }
+        v = substr(v, at + 1)
+        d = 1
+        for (i = 1;i <= length(v);i++) {
+            ch = substr(v, i, 1)
+            if (ch == "(") {
+                d++
+            } else if (ch == ")") {
+                if (--d == 0)
+                    break
+            }
+        }
+        n++
+        lay[n] = substr(v, 1, i - 1)
+        v = substr(v, i + 1)
+    }
+}
+
+# Returns the count of distinct colour names of the string s.
+function names(s,   i, k, seen, one, out) {
+    out = 0
+    delete seen
+    while (match(s, /@[a-z][a-z_0-9]*/)) {
+        one = substr(s, RSTART, RLENGTH)
+        if (!(one in seen)) {
+            seen[one] = 1
+            out++
+        }
+        s = substr(s, RSTART + RLENGTH)
+    }
+    return out
+}
+
+/^@define-color/ { next }
+/^ *[-a-zA-Z]+: .*;$/ {
+    line = $0
+    sub(/^ *[-a-zA-Z]+: /, "", line)
+    sub(/;$/, "", line)
+    k = layers(line)
+    for (i = 1;i <= k;i++) {
+        seen++
+        if (names(lay[i]) > 1) {
+            printf "assert-layers: %s: a gradient or a mix reads more than"\
+                " one colour name: %s\n", sheet, lay[i] > "/dev/stderr"
+            bad++
+        }
+    }
+}
+END {
+    if (bad) {
+        exit 1
+    }
+    if (seen < min) {
+        printf "assert-layers: %s holds %d gradients and mixes, under %d\n",
+            sheet, seen, min > "/dev/stderr"
+        exit 1
+    }
+    printf "assert-layers: %s ok, %d gradients and mixes of one colour"\
+        " name\n", sheet, seen
+}
+' "$sheet" || status=1
+done
+exit $status
diff --git a/gtk4/check/assert-names.sh b/gtk4/check/assert-names.sh
new file mode 100644
index 00000000..2998429f
