diff --git a/gtk4/check/mkfloors.sh b/gtk4/check/mkfloors.sh
new file mode 100644
index 00000000..2f39e779
--- /dev/null
+++ b/gtk4/check/mkfloors.sh
@@ -0,0 +1,164 @@
+#!/bin/sh
+# mkfloors.sh THEMEDIR ARMDIR: print the floor block of CMakeLists.txt from the
+# sheets that the writer gives. THEMEDIR holds gtk-3.0 and gtk-4.0 of the
+# shipped theme and ARMDIR holds the check arm sheets, both from one build.
+# Every floor of the build comes from a run of the shipped checker over those
+# sheets, so no floor stays hand set. A run of a lower floor reports the count
+# that the floor takes. A run over more than one sheet takes the least of
+# them.
+usage='usage: mkfloors.sh THEMEDIR ARMDIR'
+set -eu
+C=$(dirname "$0")
+T=${1:?$usage}
+A=${2:?$usage}
+
+L3=$T/gtk-3.0/gtk.css
+D3=$T/gtk-3.0/gtk-dark.css
+L4=$T/gtk-4.0/gtk.css
+D4=$T/gtk-4.0/gtk-dark.css
+
+# Returns the least of the numbers on the standard input, or 0 for none.
+least() {
+    awk 'NR == 1 || $1 < m { m = $1 } END { print (NR ? m : 0) }'
+}
+
+# The name count of assert-varnames.sh, which is the custom properties and the
+# colour names of one sheet together.
+vn() {
+    sh "$C/assert-varnames.sh" -n 0 "$@" |
+        sed -n 's/.* ok, \([0-9]*\) custom properties and \([0-9]*\) colour.*/\1 \2/p' |
+        awk '{ print $1 + $2 }'
+}
+fw() {
+    r=
+    if [ "${1:-}" = "-r" ]; then
+        r=-r
+        shift
+    fi
+    for s in "$@"; do
+        if [ -n "$r" ]; then
+            sh "$C/assert-follow.sh" -r 0 "$s"
+        else
+            sh "$C/assert-follow.sh" 0 "$s"
+        fi | sed -n 's/.* ok, \([0-9]*\) colour names read/\1/p'
+    done | least
+}
+nd() {
+    sh "$C/assert-nodes.sh" -n 0 "$1" "$2" |
+        sed -n 's/.* ok for [a-z0-9]*, \([0-9]*\) rules/\1/p'
+}
+pr() {
+    for s in "$@"; do
+        sh "$C/assert-pairs.sh" -n 0 "$s" | sed -n 's/.* ok, \([0-9]*\) rules,.*/\1/p'
+    done | least
+}
+ly() {
+    for s in "$@"; do
+        sh "$C/assert-layers.sh" -n 0 "$s" |
+            sed -n 's/.* ok, \([0-9]*\) gradients and mixes.*/\1/p'
+    done | least
+}
+# The row count and the value count of assert-alphas.sh. The first argument is
+# rows or values and the rest is the argument list of the run.
+al() {
+    want=$1
+    shift
+    sh "$C/assert-alphas.sh" -m 0 -n 0 "$@" |
+        sed -n 's/.* ok, \([0-9]*\) [a-z]* rows and \([0-9]*\) values/\1 \2/p' |
+        awk -v w="$want" '{ print (w == "rows" ? $1 : $2) }' | least
+}
+pa() {
+    sh "$C/assert-paths.sh" -n 0 "$@" |
+        sed -n 's/.* ok, \([0-9]*\) paths take.*/\1/p' | least
+}
+# The state count of assert-boxes.sh, which is the least of the sheets.
+bx() {
+    for s in "$@"; do
+        sh "$C/assert-boxes.sh" -k "$C/boxes-keep.txt" -n 0 "$s" |
+            sed -n 's/.* ok, \([0-9]*\) states hold.*/\1/p'
+    done | least
+}
+
+echo "set(qtc_names3 $(vn "$L3"))"
+echo "set(qtc_names4 $(vn "$L4"))"
+echo "set(qtc_names4_dark $(vn "$D4"))"
+echo "set(qtc_rules3 $(nd "$L3" gtk3))"
+echo "set(qtc_rules4 $(nd "$L4" gtk4))"
+echo "set(qtc_rules_opt3 $(nd "$A/opt-gtk-3.0.css" gtk3))"
+echo "set(qtc_rules_opt4 $(nd "$A/opt-gtk-4.0.css" gtk4))"
+echo "set(qtc_rules_shade3 $(nd "$A/shade-gtk-3.0.css" gtk3))"
+echo "set(qtc_rules_shade4 $(nd "$A/shade-gtk-4.0.css" gtk4))"
+echo "set(qtc_layers3 $(ly "$L3" "$D3"))"
+echo "set(qtc_layers4 $(ly "$L4"))"
+echo "set(qtc_layers4_dark $(ly "$D4"))"
+for arm in cover grad flat opt shade; do
+    echo "set(qtc_layers_${arm}3 $(ly "$A/$arm-gtk-3.0.css"))"
+    echo "set(qtc_layers_${arm}4 $(ly "$A/$arm-gtk-4.0.css"))"
+done
+echo "set(qtc_boxes3 $(bx "$L3" "$D3"))"
+echo "set(qtc_boxes4 $(bx "$L4"))"
+echo "set(qtc_boxes_arm3 $(bx "$A"/*-gtk-3.0.css))"
+echo "set(qtc_boxes_arm4 $(bx "$A"/*-gtk-4.0.css))"
+echo "set(qtc_alphas3 $(al rows -d gtk3 "$C/alphas.txt" "$L3" "$D3"))"
+echo "set(qtc_alphas4 $(al rows -d gtk4 "$C/alphas.txt" "$L4"))"
+echo "set(qtc_alphas4_arm $(al rows -a -d gtk4 "$C/alphas.txt" "$D4"))"
+echo "set(qtc_avals3 $(al values -d gtk3 "$C/alphas.txt" "$L3" "$D3"))"
+echo "set(qtc_avals4 $(al values -d gtk4 "$C/alphas.txt" "$L4"))"
+echo "set(qtc_avals4_dark $(al values -a -d gtk4 "$C/alphas.txt" "$D4"))"
+echo "set(qtc_avals3_arm $(al values -a -d gtk3 "$C/alphas.txt" \
+    "$A/cover-gtk-3.0.css" "$A/grad-gtk-3.0.css" "$A/flat-gtk-3.0.css" \
+    "$A/opt-gtk-3.0.css"))"
+echo "set(qtc_avals4_arm $(al values -a -d gtk4 "$C/alphas.txt" \
+    "$A/cover-gtk-4.0.css" "$A/grad-gtk-4.0.css" "$A/flat-gtk-4.0.css" \
+    "$A/opt-gtk-4.0.css"))"
+echo "set(qtc_avals3_shade $(al values -a -d gtk3 "$C/alphas.txt" \
+    "$A/shade-gtk-3.0.css"))"
+echo "set(qtc_avals4_shade $(al values -a -d gtk4 "$C/alphas.txt" \
+    "$A/shade-gtk-4.0.css"))"
+echo "set(qtc_shades3 $(al rows -s -d gtk3 "$C/shades.txt" "$L3" "$D3"))"
+echo "set(qtc_shades4 $(al rows -s -d gtk4 "$C/shades.txt" "$L4"))"
+echo "set(qtc_svals3 $(al values -s -d gtk3 "$C/shades.txt" "$L3" "$D3"))"
+echo "set(qtc_svals4 $(al values -s -d gtk4 "$C/shades.txt" "$L4"))"
+echo "set(qtc_svals4_dark $(al values -s -a -d gtk4 "$C/shades.txt" "$D4"))"
+echo "set(qtc_rows3 $(pa -c -d gtk3 "$C/paths.txt" "$L3"))"
+echo "set(qtc_rows4 $(pa -c -d gtk4 "$C/paths.txt" "$L4"))"
+echo "set(qtc_rows_opt3 $(pa -a -d gtk3 "$C/paths-options.txt" \
+    "$A/opt-gtk-3.0.css"))"
+echo "set(qtc_rows_opt4 $(pa -a -d gtk4 "$C/paths-options.txt" \
+    "$A/opt-gtk-4.0.css"))"
+echo "set(qtc_rows_rest3 $(pa -a -d gtk3 -x "$C/paths-options.txt" \
+    "$C/paths.txt" "$A/opt-gtk-3.0.css"))"
+echo "set(qtc_rows_rest4 $(pa -a -d gtk4 -x "$C/paths-options.txt" \
+    "$C/paths.txt" "$A/opt-gtk-4.0.css"))"
+echo "set(qtc_rows_both3 $(pa -a -c -u -d gtk3 -x "$C/paths-options.txt" \
+    "$C/paths.txt" "$A/opt-gtk-3.0.css"))"
+echo "set(qtc_rows_both4 $(pa -a -c -u -d gtk4 -x "$C/paths-options.txt" \
+    "$C/paths.txt" "$A/opt-gtk-4.0.css"))"
+echo "set(qtc_rows_cover $(pa -d gtk3 "$C/paths-cover.txt" \
+    "$A/cover-gtk-3.0.css"))"
+echo "set(qtc_rows_shade3 $(pa -c -p -d gtk3 "$C/paths-shading.txt" \
+    "$A/shade-gtk-3.0.css"))"
+echo "set(qtc_rows_shade4 $(pa -c -p -d gtk4 "$C/paths-shading.txt" \
+    "$A/shade-gtk-4.0.css"))"
+echo "set(qtc_names_distinct $(vn "$A/distinct-gtk-4.0.css"))"
+for arm in cover grad flat opt shade; do
+    echo "set(qtc_names_$arm $(vn "$A/$arm-gtk-4.0.css"))"
+done
+echo "set(qtc_follow3 $(fw "$L3" "$D3"))"
+echo "set(qtc_follow4 $(fw -r "$L4" "$D4"))"
+for arm in cover grad flat opt distinct shade; do
+    echo "set(qtc_follow_${arm}3 $(fw "$A/$arm-gtk-3.0.css"))"
+    echo "set(qtc_follow_${arm}4 $(fw -r "$A/$arm-gtk-4.0.css"))"
+done
+for arm in cover grad flat opt; do
+    echo "set(qtc_shades_${arm}3 $(al rows -s -a -d gtk3 "$C/shades-$arm.txt" \
+        "$A/$arm-gtk-3.0.css"))"
+    echo "set(qtc_shades_${arm}4 $(al rows -s -a -d gtk4 "$C/shades-$arm.txt" \
+        "$A/$arm-gtk-4.0.css"))"
+done
+# assert-names.sh takes the name count and the tie count of the distinct arm,
+# which no set() line holds.
+sh "$C/assert-names.sh" -t 0 0 "$A/distinct-gtk-4.0.css" 2>&1 |
+    sed -n 's/.*declares \([0-9]*\) names with \([0-9]*\) values.*/\1 \2/p' |
+    awk '{ printf "# assert-names.sh -t %d %d\n", $1 - $2, $1 }'
+echo "# assert-pairs.sh -n $(pr "$L4") (gtk-4.0/gtk.css)"
diff --git a/gtk4/check/options.qtcurve b/gtk4/check/options.qtcurve
new file mode 100644
index 00000000..e5e9e17b
--- /dev/null
+++ b/gtk4/check/options.qtcurve
@@ -0,0 +1,11 @@
+# The settings of the option run of assert-paths.sh. Each key below takes the
+# other arm of a branch that picks a colour role, so the build reaches both
+# arms.
+[Settings]
+lighterPopupMenuBgnd=0
