+void
+Writer::selection()
+{
+    // The focus ring rule holds the bare selector :focus-visible, which also
+    // matches a selection node. Every rule below therefore takes a rank.
+    Box box;
+    box.bg = roleCol(QStringLiteral("sel-bg"), Role::Highlight);
+    ink(box, QStringLiteral("sel-fg"), Role::HighlightText, Role::Highlight,
+        cover(box.image, box.bg));
+    box.labels = false;
+    put(ranked(QStringLiteral(
+                   "entry selection, entry > text selection, "
+                   "entry%1 selection, entry%1 > text selection, "
+                   "spinbutton:not(.vertical) selection, "
+                   "spinbutton text selection, textview text selection, "
+                   "textview%1 text selection, "
+                   ".view text selection, label selection")
+               .arg(m_nodes.focusWithin), Rank::Item),
+        box);
+
+    // kde-gtk-config writes the inactive selection pair of the colour scheme.
+    // Breeze reads that pair for a selected row, a sidebar, a spin button and
+    // an entry in a backdrop window; the rule below names the entry, so a text
+    // view or a label keeps the pair above in every state.
+    Box back;
+    back.bg = roleCol(QStringLiteral("sel-bg-back"), Role::HighlightBackdrop);
+    ink(back, QStringLiteral("sel-fg-back"), Role::HighlightTextBackdrop,
+        Role::HighlightBackdrop, QString());
+    back.labels = false;
+    put(ranked(QStringLiteral("entry:backdrop selection, "
+                              "entry:backdrop > text selection"),
+               Rank::Entry), back);
