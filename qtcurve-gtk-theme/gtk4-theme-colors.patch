diff --git a/gtk4/check/paths-cover.txt b/gtk4/check/paths-cover.txt
new file mode 100644
index 00000000..eeb0eb56
--- /dev/null
+++ b/gtk4/check/paths-cover.txt
@@ -0,0 +1,11 @@
+# The widget paths of the covered window arm and of the gradient arm. The
+# window of both arms paints an opaque gradient, and every stop of that
+# gradient shades the window colour name.
+
+# The run of this table reads no -a, so the ground class of each row holds.
+# The gradient therefore follows the colour scheme, which the shade step of
+# every stop gives.
+follow | theme_bg_color_breeze | window.background | - |
+follow | theme_bg_color_breeze | window.background label | - |
+follow | theme_bg_color_breeze | window.background label:disabled | - |
+follow | theme_bg_color_breeze | window.background box label | - |
diff --git a/gtk4/check/paths-options.txt b/gtk4/check/paths-options.txt
new file mode 100644
index 00000000..204e6181
--- /dev/null
+++ b/gtk4/check/paths-options.txt
@@ -0,0 +1,109 @@
+# The widget paths that the option run of assert-paths.sh moves to another
+# colour role. options.qtcurve holds the settings, and paths.txt holds every
+# row that the option run leaves in place.
+
+# The popup menu and the drop down list, which take the window colour with
+# lighterPopupMenuBgnd off. The caption follows that group.
+ follow| theme_bg_color_breeze | window.background dropdown popover contents | theme_fg_color_breeze |
+ follow| theme_bg_color_breeze | window.background dropdown popover contents label | theme_fg_color_breeze |
+ follow| theme_bg_color_breeze | window.background dropdown popover contents label:disabled | insensitive_fg_color_breeze |
+ follow| theme_bg_color_breeze | window.background menu | theme_fg_color_breeze | gtk3
+ follow| theme_bg_color_breeze | window.background menu menuitem | theme_fg_color_breeze | gtk3
+ follow| theme_bg_color_breeze | window.background menu label | theme_fg_color_breeze | gtk3
+ follow| theme_bg_color_breeze | window.background menu label:disabled | insensitive_fg_color_breeze | gtk3
