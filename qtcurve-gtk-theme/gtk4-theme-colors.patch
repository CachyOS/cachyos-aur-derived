+/**
+ * Returns true while a pin already reaches the selector one, and writes the
+ * colours of the longest such pin into held. A pin reaches every selector
+ * that adds a class or a state to its own, and the longest one wins.
+ */
+bool
+Writer::pinned(const QString &one, Pin &held) const
+{
+    int best = -1;
+    for (auto it = m_pins.constBegin();it != m_pins.constEnd();++it) {
+        const QString &key = it.key();
