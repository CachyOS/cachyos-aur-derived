diff --git a/gtk4/check/assert-pairs.sh b/gtk4/check/assert-pairs.sh
new file mode 100755
index 00000000..ca1806bd
--- /dev/null
+++ b/gtk4/check/assert-pairs.sh
@@ -0,0 +1,114 @@
+#!/bin/sh
+# assert-pairs.sh [-n MIN] SHEET...: no rule of a sheet may hold an opaque
+# background and read a colour name in another property. The check reads the
+# fallback of every var() of the GTK 4 dialect, and MIN is the floor of the
+# rule count.
+usage='usage: assert-pairs.sh [-n MIN] SHEET...'
+set -eu
+min=1
+if [ "${1:-}" = "-n" ]; then
+    min=${2:?$usage}
+    shift 2
+fi
+if [ $# -eq 0 ]; then
+    echo "$usage" >&2
+    exit 1
+fi
+
+status=0
+for sheet in "$@"; do
+    awk -v sheet="$sheet" -v min="$min" '
+function literal(v,   at, i, d, e, c, ch, fb) {
+    while ((at = index(v, "var(--qtc-")) > 0) {
+        d = 0
+        e = 0
+        for (i = at + 3;i <= length(v);i++) {
+            ch = substr(v, i, 1)
+            if (ch == "(") {
+                d++
+            } else if (ch == ")") {
+                if (--d == 0) {
+                    e = i
+                    break
+                }
+            }
+        }
+        if (e == 0)
+            return v
+        c = 0
+        d = 0
+        for (i = at + 3;i < e;i++) {
+            ch = substr(v, i, 1)
+            if (ch == "(") {
+                d++
+            } else if (ch == ")") {
+                d--
+            } else if (ch == "," && d == 1) {
+                c = i
+                break
+            }
+        }
+        fb = c > 0 ? substr(v, c + 1, e - c - 1) : ""
+        gsub(/^ +| +$/, "", fb)
+        v = substr(v, 1, at - 1) fb substr(v, e + 1)
+    }
+    return v
+}
+# Returns 1 while the value v paints a ground that hides the node under it.
+# Empty, none, transparent, rgba() and alpha() paint no such ground, and
+# assert-paths.sh and widgets.cpp hold the same test.
+function opaque(v) {
+    v = literal(v)
+    return v != "" && v != "none" && v != "transparent" &&
+        index(v, "rgba(") == 0 && index(v, "alpha(") == 0
+}
+# Returns 1 while the literal of the value v reads a colour name.
+function follows(v) {
+    return index(literal(v), "@") > 0
+}
+/\{$/ && depth == 0 {
+    sel = substr($0, 1, length($0) - 2)
+    depth = 1
+    skip = (substr(sel, 1, 1) == "@" || sel == ":root")
+    cover = 0
+    nread = 0
+    nrule++
+    next
+}
+depth > 0 && $0 == "}" {
+    depth = 0
+    if (!skip && cover) {
+        for (i = 1;i <= nread;i++) {
+            printf "assert-pairs: %s: %s holds %s\n", sheet, sel, reads[i] \
+                > "/dev/stderr"
+            bad++
+        }
+    }
+    next
+}
+depth > 0 && !skip && $0 ~ /^  [-a-zA-Z]+: .*;$/ {
+    prop = substr($0, 3, index($0, ":") - 3)
+    val = substr($0, index($0, ":") + 2, length($0) - index($0, ":") - 2)
+    if (prop == "background-image" || prop == "background-color") {
+        if (opaque(val) && !follows(val))
+            cover = 1
+    } else if (follows(val)) {
+        reads[++nread] = prop ": " val
+    }
+    next
+}
+END {
+    if (bad) {
+        exit 1
+    }
+    if (nrule < min) {
+        printf "assert-pairs: %s holds %d rules, under %d\n", sheet, \
+            nrule + 0, min > "/dev/stderr"
+        exit 1
+    }
+    printf "assert-pairs: %s ok, %d rules, no rule pairs an opaque background "\
+        "with a colour name\n", sheet, nrule
+}
+' "$sheet" || status=1
+done
+exit $status
diff --git a/gtk4/check/assert-paths.sh b/gtk4/check/assert-paths.sh
new file mode 100755
index 00000000..6b10cd42
--- /dev/null
+++ b/gtk4/check/assert-paths.sh
@@ -0,0 +1,940 @@
+#!/bin/sh
+# assert-paths.sh [-a] [-c] [-d DIALECT] [-n MIN] [-p] [-u] [-x DROP] TABLE
+# SHEET [ROOTSHEET] checks a table of widget paths against SHEET. A row holds
+# a ground class, a ground role, a path and a caption role, and ROOTSHEET is a
+# dark GTK 4 :root block.
+usage='usage: assert-paths.sh [-a] [-c] [-d DIALECT] [-n MIN] [-p] [-u] [-x DROP] TABLE SHEET [ROOT]'
+set -eu
+all=0
+cover=0
+dialect=
+min=1
+pinlines=0
+union=0
+drop=
+while true; do
+    case ${1:-} in
+        # -a resolves the ground class of a row in place of the table.
+        -a) all=1; shift;;
+        # -c asks that a row of TABLE read the colour of each rule that paints
+        # one. A row floor alone lets a new caption rule ship with no row.
+        -c) cover=1; shift;;
+        # -d drops every row of the other dialect, gtk3 or gtk4.
+        -d) dialect=${2:?$usage}; shift 2;;
+        # -n is the floor of the row count that the run reads. An empty table
+        # and a wrong -d value both give no row, and both then exit 0.
+        -n) min=${2:?$usage}; shift 2;;
+        # -p marks a sheet whose settings pin every derived line. A border or
+        # a ring of a scheme colour is then no fault over a ground that
+        # follows. The shading arm alone takes it.
+        -p) pinlines=1; shift;;
+        # -u holds the rows of the -x table as well, so one run reads the two
+        # tables together. A coverage run needs every row of the sheet.
+        -u) union=1; shift;;
+        # -x names a second table, and every path of it leaves TABLE. The two
+        # tables then cover one sheet with no row of the two in conflict.
+        -x) drop=${2:?$usage}; shift 2;;
+        *) break;;
+    esac
+done
+table=${1:?$usage}
+sheet=${2:?$usage}
+root=${3:-$2}
+
+awk -v sheet="$sheet" -v rootsheet="$root" -v all="$all" -v min="$min" \
+    -v dialect="$dialect" -v table="$table" -v ndrop="${drop:+1}" \
+    -v cover="$cover" -v union="$union" -v pinlines="$pinlines" '
+# Returns 1 while the compound c matches the node ni of the path.
+function compmatch(c, ni,   i, ch, t, tok, j, inner) {
+    i = 1
+    t = ""
+    while (i <= length(c)) {
+        ch = substr(c, i, 1)
+        if (ch == "." || ch == ":" || ch == "#")
+            break
+        t = t ch
+        i++
+    }
+    if (t != "" && t != "*" && t != nname[ni])
+        return 0
+    while (i <= length(c)) {
+        ch = substr(c, i, 1)
+        if (ch == ".") {
+            i++
+            tok = ""
+            while (i <= length(c) && substr(c, i, 1) ~ /[A-Za-z0-9_-]/) {
+                tok = tok substr(c, i, 1)
+                i++
+            }
+            if (index(" " ncls[ni] " ", " " tok " ") == 0)
+                return 0
+        } else if (ch == "#") {
+            return 0
+        } else if (substr(c, i, 5) == ":not(") {
+            # A compound with no closing bracket holds the rest of the string,
+            # and the offset must still reach the end. The parse is total, so
+            # no selector can hold this loop.
+            j = index(substr(c, i), ")")
+            if (j == 0)
+                j = length(c) - i + 2
+            inner = substr(c, i + 5, j - 6)
+            i = i + j
+            if (simple(inner, ni))
+                return 0
+        } else if (ch == ":") {
+            i++
+            tok = ""
+            while (i <= length(c) && substr(c, i, 1) ~ /[A-Za-z0-9_-]/) {
+                tok = tok substr(c, i, 1)
+                i++
+            }
+            if (index(" " nsta[ni] " ", " " tok " ") == 0)
+                return 0
+        } else {
+            i++
+        }
+    }
+    return 1
+}
+
+# Returns 1 while the simple selector s matches the node ni of the path.
+function simple(s, ni) {
+    if (substr(s, 1, 1) == ".")
+        return index(" " ncls[ni] " ", " " substr(s, 2) " ") > 0
+    if (substr(s, 1, 1) == "#")
+        return 0
+    if (substr(s, 1, 1) == ":")
+        return index(" " nsta[ni] " ", " " substr(s, 2) " ") > 0
+    return s == nname[ni]
+}
+
+# Splits the selector s into the compounds comp[] and the combinators comb[].
+function split_sel(s,   n, i, parts, pend) {
+    gsub(/ *> */, " > ", s)
+    n = split(s, parts, " ")
+    nc = 0
+    pend = ""
+    for (i = 1;i <= n;i++) {
+        if (parts[i] == ">") {
+            pend = ">"
+            continue
+        }
+        nc++
+        comp[nc] = parts[i]
+        comb[nc] = pend == "" ? " " : pend
+        pend = ""
+    }
+}
+
+# Returns 1 while the compounds 1 to k match the path up to the node ni.
+function matchfrom(k, ni,   j) {
+    if (ni < 1 || !compmatch(comp[k], ni))
+        return 0
+    if (k == 1)
+        return 1
+    if (comb[k] == ">")
+        return matchfrom(k - 1, ni - 1)
+    for (j = ni - 1;j >= 1;j--)
+        if (matchfrom(k - 1, j))
+            return 1
+    return 0
+}
+
+# Records the node name, the class and the state of every compound of the
+# selector s. A rank guard and the universal selector hold no such token.
+function vocab(s,   n, i, parts, c, t, j, ch, tok) {
+    gsub(/:not\([^)]*\)/, " ", s)
+    gsub(/[,>]/, " ", s)
+    n = split(s, parts, " ")
+    for (i = 1;i <= n;i++) {
+        c = parts[i]
+        t = ""
+        j = 1
+        while (j <= length(c) && substr(c, j, 1) !~ /[.:#]/) {
+            t = t substr(c, j, 1)
+            j++
+        }
+        if (t != "" && t != "*")
+            vname[t] = 1
+        while (j <= length(c)) {
+            ch = substr(c, j, 1)
+            j++
+            tok = ""
+            while (j <= length(c) && substr(c, j, 1) ~ /[A-Za-z0-9_-]/) {
+                tok = tok substr(c, j, 1)
+                j++
+            }
+            if (ch == ".")
+                vcls[tok] = 1
+            else if (ch == ":")
+                vsta[tok] = 1
+        }
+    }
+}
+
+# Returns the offset after the identifier that starts at the offset i of s.
+function ident(s, i) {
+    while (i <= length(s) && substr(s, i, 1) ~ /[A-Za-z0-9_-]/)
+        i++
+    return i
+}
+
+# Returns the offset after the bracket group that starts at the offset i of s.
+# A functional pseudo-class such as :nth-child(even) holds such a group, and
+# the offset must move over it.
+function bracket(s, i,   d) {
+    d = 0
+    while (i <= length(s)) {
+        if (substr(s, i, 1) == "(")
+            d++
+        else if (substr(s, i, 1) == ")" && --d == 0)
+            return i + 1
+        i++
+    }
+    return i + 1
+}
+
+# Returns the specificity of the selector s, as three counts of four digits.
+function spec(s,   i, j, ch, ids, cls, typ, start) {
+    ids = 0
+    cls = 0
+    typ = 0
+    start = 1
+    i = 1
+    while (i <= length(s)) {
+        ch = substr(s, i, 1)
+        if (ch == " " || ch == ">") {
+            start = 1
+            i++
+        } else if (ch == ".") {
+            cls++
+            i = ident(s, i + 1)
+            start = 0
+        } else if (ch == "#") {
+            ids++
+            i = ident(s, i + 1)
+            start = 0
+        } else if (substr(s, i, 5) == ":not(") {
+            i += 5
+            start = 1
+        } else if (ch == ":") {
+            cls++
+            i = ident(s, i + 1)
+            if (substr(s, i, 1) == "(")
+                i = bracket(s, i)
+            start = 0
+        } else if (ch == ")" || ch == "*") {
+            i++
+            start = 0
+        } else {
+            if (start)
+                typ++
+            j = ident(s, i)
+            # A character that starts no identifier, such as the bracket of an
+            # attribute selector, must still move the offset. The parse is
+            # total, so no selector can hold this loop.
+            i = j > i ? j : i + 1
+            start = 0
+        }
+    }
+    return sprintf("%04d%04d%04d", ids, cls, typ)
+}
+
+# Reads every rule that matches the node ni into mrule[] and mspec[]. A rule
+# takes the specificity of the strongest of its selectors that matches.
+function collect(ni,   r, n, i, parts, best, s) {
+    nm = 0
+    for (r = 1;r <= nrule;r++) {
+        n = split(rsel[r], parts, ", ")
+        best = ""
+        for (i = 1;i <= n;i++) {
+            split_sel(parts[i])
+            if (!matchfrom(nc, ni))
+                continue
+            s = spec(parts[i])
+            if (best == "" || s > best)
+                best = s
+        }
+        if (best == "")
+            continue
+        nm++
+        mrule[nm] = r
+        mspec[nm] = best
+    }
+}
+
+# Returns the winning value of the property prop over the rules of collect().
+# The global winrule holds the rule that gives that value, or 0 for none.
+function win(prop,   i, best, val) {
+    best = ""
+    val = ""
+    winrule = 0
+    for (i = 1;i <= nm;i++) {
+        if (!((mrule[i] SUBSEP prop) in decl))
+            continue
+        if (best == "" || mspec[i] >= best) {
+            best = mspec[i]
+            val = decl[mrule[i], prop]
+            winrule = mrule[i]
+        }
+    }
+    return expand(val, 0)
+}
+
+# Returns value with every var() read replaced by the :root value, or by the
+# fallback of the read.
+function expand(v, depth,   at, i, d, e, comma, name, fb) {
+    if (depth > 8)
+        return v
+    at = index(v, "var(--")
+    while (at > 0) {
+        d = 0
+        e = 0
+        for (i = at + 3;i <= length(v);i++) {
+            if (substr(v, i, 1) == "(")
+                d++
+            else if (substr(v, i, 1) == ")" && --d == 0) {
+                e = i
+                break
+            }
+        }
+        if (e == 0)
+            return v
+        comma = 0
+        d = 0
+        for (i = at + 3;i < e;i++) {
+            if (substr(v, i, 1) == "(")
+                d++
+            else if (substr(v, i, 1) == ")")
+                d--
+            else if (substr(v, i, 1) == "," && d == 1) {
+                comma = i
+                break
+            }
+        }
+        name = substr(v, at + 4, (comma ? comma : e) - at - 4)
+        fb = comma ? substr(v, comma + 1, e - comma - 1) : ""
+        gsub(/^ +| +$/, "", fb)
+        v = substr(v, 1, at - 1) \
+            (name in rootv ? expand(rootv[name], depth + 1) : fb) \
+            substr(v, e + 1)
+        at = index(v, "var(--")
+    }
+    return v
+}
+
+# Returns 1 while the value v paints a ground that hides the node under it.
+# Empty, none, transparent, rgba() and alpha() paint no such ground, and
+# assert-pairs.sh and widgets.cpp hold the same test.
+function opaque(v) {
+    return v != "" && v != "none" && v != "transparent" &&
+        index(v, "rgba(") == 0 && index(v, "alpha(") == 0
+}
+
+# Returns the colour token of the value v, which can hold a width and a style
+# before the colour. A value that reads a colour name goes back whole, because
+# a colour function of that value holds the name inside a bracket.
+function colourof(v,   n, i, parts) {
+    if (follows(v))
+        return v
+    n = split(v, parts, " ")
+    for (i = n;i >= 1;i--)
+        if (substr(parts[i], 1, 1) == "#")
+            return parts[i]
+    return v
+}
+
+# Returns 1 while the value v reads a colour name of kde-gtk-config.
+function follows(v) {
+    return v ~ /@[a-z]/
+}
+
+# Fills group[] with the colour group of every name of kde-gtk-config that a
+# sheet reads. A user colour file moves the names of one group together. A
+# caption of one group over a ground of another can then lose its contrast.
+function setgroups() {
+    # A colour scheme holds the window set and the button set in two groups.
+    # A user colour file can move one of the two alone.
+    group["theme_bg_color_breeze"] = "window"
+    group["theme_fg_color_breeze"] = "window"
+    group["insensitive_bg_color_breeze"] = "window"
+    group["insensitive_fg_color_breeze"] = "window"
+    group["theme_unfocused_fg_color_breeze"] = "window"
+    group["theme_button_background_normal_breeze"] = "button"
+    group["theme_button_foreground_normal_breeze"] = "button"
+    group["theme_button_background_insensitive_breeze"] = "button"
+    group["theme_button_foreground_insensitive_breeze"] = "button"
+    group["theme_button_decoration_focus_breeze"] = "button"
+    group["theme_base_color_breeze"] = "view"
+    group["theme_text_color_breeze"] = "view"
+    group["insensitive_base_fg_color_breeze"] = "view"
+    group["insensitive_base_color_breeze"] = "view"
+    group["theme_selected_bg_color_breeze"] = "selection"
+    group["theme_selected_fg_color_breeze"] = "selection"
+    group["insensitive_selected_bg_color_breeze"] = "selection"
+    group["insensitive_selected_fg_color_breeze"] = "selection"
+    group["tooltip_background_breeze"] = "tooltip"
+    group["tooltip_text_breeze"] = "tooltip"
+    group["theme_titlebar_background_breeze"] = "titlebar"
+    group["theme_titlebar_foreground_breeze"] = "titlebar"
+    # An ink carries no ground of its own, so it pairs with every group.
+    group["link_color_breeze"] = "ink"
+    group["error_color_breeze"] = "ink"
+    group["warning_color_breeze"] = "ink"
+    group["success_color_breeze"] = "ink"
+    group["borders"] = "line"
+}
+
+# Returns the colour groups that the value v reads, in one string. A name of
+# no group gives the name itself, so an unknown name never ties two groups.
+function groupsof(v,   n, i, parts, out, g) {
+    n = split(v, parts, /[^A-Za-z_0-9]/)
+    out = ""
+    for (i = 1;i <= n;i++) {
+        if (parts[i] == "" || !(parts[i] in group))
+            continue
+        g = group[parts[i]]
+        if (index(" " out " ", " " g " ") == 0)
+            out = out (out == "" ? "" : " ") g
+    }
+    return out
+}
+
+# Returns 1 while the value v holds a six digit hexadecimal colour, which is
+# a colour that no name of the colour scheme moves.
+function haslit(v,   n, i, parts) {
+    n = split(v, parts, /[^#A-Za-z_0-9]/)
+    for (i = 1;i <= n;i++)
+        if (substr(parts[i], 1, 1) == "#" && length(parts[i]) == 7)
+            return 1
+    return 0
+}
+
+# Returns the layer k of the value v, whose layers a comma at bracket depth 0
+# holds apart. A k over the layer count gives the empty string.
+function layerof(v, k,   i, d, at, n, ch) {
+    d = 0
+    at = 1
+    n = 1
+    for (i = 1;i <= length(v);i++) {
+        ch = substr(v, i, 1)
+        if (ch == "(")
+            d++
+        else if (ch == ")")
+            d--
+        else if (ch == "," && d == 0) {
+            if (n == k)
+                break
+            at = i + 1
+            n++
+        }
+    }
+    if (n != k)
+        return ""
+    v = substr(v, at, i - at)
+    gsub(/^ +| +$/, "", v)
+    return v
+}
+
+# Returns the value of the hexadecimal string h, or -1 for a bad digit.
+function hexval(h,   i, c, d, out) {
+    out = 0
+    for (i = 1;i <= length(h);i++) {
+        d = index("0123456789abcdef", tolower(substr(h, i, 1))) - 1
+        if (d < 0)
+            return -1
+        out = out * 16 + d
+    }
+    return out
+}
+
+# Returns the six digit hexadecimal form of every rgba() call of the value v,
+# with one space between two of them. A call of another form gives nothing.
+function rgbahex(v,   at, e, n, parts, out, i, one) {
+    out = ""
+    at = index(v, "rgba(")
+    while (at > 0) {
+        e = index(substr(v, at), ")")
+        if (e == 0)
+            break
+        n = split(substr(v, at + 5, e - 6), parts, ",")
+        if (n >= 3) {
+            one = "#"
+            for (i = 1;i <= 3;i++) {
+                gsub(/ /, "", parts[i])
+                one = one sprintf("%02x", parts[i] % 256)
+            }
+            out = out (out == "" ? "" : " ") one
+        }
+        v = substr(v, at + e)
+        at = index(v, "rgba(")
+    }
+    return out
+}
+
+# Returns the sign of the channel difference d, with a dead band of 12 of 255.
+# A shade of one colour can move a pair that ties across that band, so a pair
+# inside it holds no order.
+function csign(d) {
+    return d > 12 ? "+" : d < -12 ? "-" : "0"
+}
+
+# Returns the channel order of the colour c as three signs, or the empty
+# string for a value that is no six digit hexadecimal colour. Every shade of
+# one colour holds one order, and a colour of another role holds another.
+function chanorder(c,   r, g, b) {
+    if (substr(c, 1, 1) != "#" || length(c) != 7)
+        return ""
+    r = hexval(substr(c, 2, 2))
+    g = hexval(substr(c, 4, 2))
+    b = hexval(substr(c, 6, 2))
+    if (r < 0 || g < 0 || b < 0)
+        return ""
+    return csign(r - g) csign(g - b) csign(r - b)
+}
+
+# Returns the literal of the value v, which can read a colour name.
+function literal(v,   n, parts) {
+    if (substr(v, 1, 1) == "@")
+        return (substr(v, 2) in named) ? named[substr(v, 2)] : v
+    if (follows(v)) {
+        n = split(v, parts, /[^A-Za-z_0-9]/)
+        while (n > 0) {
+            if (parts[n] in named)
+                return named[parts[n]]
+            n--
+        }
+    }
+    return v
+}
+
+FNR == 1 { pass++ }
+
+pass == 1 && /^@define-color [a-z_0-9]+ #[0-9a-fA-F]{6};$/ {
+    named[$2] = tolower($3)
+    sub(/;$/, "", named[$2])
+    next
+}
+pass == 2 && /^@define-color [a-z_0-9]+ #[0-9a-fA-F]{6};$/ {
+    if (!($2 in named)) {
+        named[$2] = tolower($3)
+        sub(/;$/, "", named[$2])
+    }
+    next
+}
+pass == 1 && /^:root \{$/ { inroot = 1; next }
+pass == 1 && inroot && /^\}$/ { inroot = 0; next }
+pass == 1 && inroot {
+    line = $0
+    sub(/^  /, "", line)
+    sub(/;$/, "", line)
+    k = index(line, ": ")
+    if (k > 0)
+        rootv[substr(line, 1, k - 1)] = substr(line, k + 2)
+    next
+}
+pass == 1 { next }
+
+pass == 2 && depth == 0 && /\{$/ {
+    sel = substr($0, 1, length($0) - 2)
+    depth = 1
+    skip = (substr(sel, 1, 1) == "@" || sel == ":root")
+    if (!skip) {
+        nrule++
+        rsel[nrule] = sel
+        vocab(sel)
+    }
+    next
+}
+pass == 2 && depth > 0 && /\{$/ { depth++; next }
+pass == 2 && depth > 0 && /^ *\}$/ { depth--; next }
+pass == 2 && depth > 0 && !skip && /^  [-a-zA-Z]+: .*;$/ {
+    k = index($0, ":")
+    decl[nrule, substr($0, 3, k - 3)] = substr($0, k + 2, length($0) - k - 2)
+    next
+}
+pass == 2 { next }
+
+/^ *#/ { next }
+NF == 0 { next }
+{
+    n = split($0, field, " *[|] *")
+    gsub(/^ +| +$/, "", field[5])
+    if (field[5] != "" && dialect != "" && field[5] != dialect)
+        next
+    if (ndrop != "" && pass == 3) {
+        path = field[3]
+        gsub(/^ +| +$/, "", path)
+        gone[path] = 1
+        if (!union)
+            next
+    }
+    if (ndrop != "" && pass != 3) {
+        path = field[3]
+        gsub(/^ +| +$/, "", path)
+        if (path in gone)
+            next
+    }
+    nrow++
+    tclass[nrow] = field[1]
+    tground[nrow] = field[2]
+    tpath[nrow] = field[3]
+    trole[nrow] = field[4]
+    gsub(/^ +| +$/, "", tclass[nrow])
+    gsub(/^ +| +$/, "", tground[nrow])
+    gsub(/^ +| +$/, "", tpath[nrow])
+    gsub(/^ +| +$/, "", trole[nrow])
+}
+
+# Returns 1 while the value v carries the colour of the role want. A value
+# that follows reads the name, and a pinned value holds the literal, or that
+# literal at the alpha of an rgba() call.
+function carries(v, want,   n, parts) {
+    if (follows(v))
+        return v ~ ("@" want "([^A-Za-z0-9_]|$)")
+    if (v ~ /^rgba\(/) {
+        n = split(substr(v, 6), parts, /[,)]/)
+        if (n < 3 || !(want in named))
+            return 0
+        return named[want] == sprintf("#%02x%02x%02x", parts[1] + 0,
+                                      parts[2] + 0, parts[3] + 0)
+    }
+    return (want in named) && tolower(v) == named[want]
+}
+
+# Returns the value of the property prop at the last node of the path, or at
+# the nearest node above it that holds the property. CSS inherits the colour,
+# so a caption of a node with no rule of its own takes the value of a parent.
+function inherit(prop,   i, v) {
+    for (i = npath;i >= 1;i--) {
+        collect(i)
+        v = win(prop)
+        if (v != "")
+            return v
+    }
+    return ""
+}
+
+# Returns the caption colour of the row. A role that starts with a
+# circumflex reads the nearest parent that holds a colour, and every other row
+# reads the last node alone.
+function caption(row,   v) {
+    if (substr(trole[row], 1, 1) == "^")
+        return inherit("color")
+    collect(npath)
+    return win("color")
+}
+
+# Reports the caption colour of the row while it does not carry the role
+# of the fourth field. That field can name another property before the role,
+# such as border:error_color_breeze, and a row with no colour fails as well.
+function rolecheck(row, capcol,   v, want, prop, k) {
+    want = trole[row]
+    sub(/^\^/, "", want)
+    prop = "color"
+    k = index(want, ":")
+    if (k > 0) {
+        prop = substr(want, 1, k - 1)
+        want = substr(want, k + 1)
+    }
+    # A dash drops the check of the field, as the table header states.
+    if (want == "-")
+        return
+    v = colourof(prop == "color" ? capcol : win(prop))
+    # An arm run reads its own settings, so an arm can paint no such line at
+    # all. The shipped runs read no -a and bind the name there.
+    if (all && prop != "color" && (v == "" || v == "none"))
+        return
+    if (v == "") {
+        printf "assert-paths: %s with %s: '%s' resolves no %s\n",
+            sheet, rootsheet, tpath[row], prop > "/dev/stderr"
+        bad++
+        return
+    }
+    if (carries(v, want))
+        return
+    printf "assert-paths: %s with %s: '%s' takes %s and not the role %s\n",
+        sheet, rootsheet, tpath[row], v, want > "/dev/stderr"
+    bad++
+}
+
+# Reports the ground colour v of the row while it does not carry the
+# ground role of the second field. A dash there marks a ground that no role
+# carries, such as a shade ladder step.
+function groundcheck(row, v,   want) {
+    want = tground[row]
+    if (want == "" || want == "-")
+        return
+    if (carries(v, want))
+        return
+    printf "assert-paths: %s with %s: '%s' sits on %s and not on the ground"\
+        " role %s\n", sheet, rootsheet, tpath[row], v, want > "/dev/stderr"
+    bad++
+}
+
+# Returns 1 while the two channel orders a and b hold an opposite sign on one
+# channel pair. A pair with no order in either colour holds no such sign.
+function opposed(a, b,   i, x, y) {
+    for (i = 1;i <= 3;i++) {
+        x = substr(a, i, 1)
+        y = substr(b, i, 1)
+        if (x != "0" && y != "0" && x != y)
+            return 1
+    }
+    return 0
+}
+
+# Returns the distance of the colour c to the nearest colour name of the
+# sheet, as the largest channel difference of 255. A value that is no six
+# digit hexadecimal colour gives -1.
+function rolegap(c,   nm, i, x, y, d, best) {
+    if (substr(c, 1, 1) != "#" || length(c) != 7)
+        return -1
+    best = 255
+    for (nm in named) {
+        d = 0
+        for (i = 2;i <= 6;i += 2) {
+            x = hexval(substr(c, i, 2))
+            y = hexval(substr(named[nm], i, 2))
+            if (x < 0 || y < 0)
+                return -1
+            if (x - y > d)
+                d = x - y
+            if (y - x > d)
+                d = y - x
+        }
+        if (d < best)
+            best = d
+    }
+    return best
+}
+
+# Reports every literal colour of the row that sits over ROLE_GAP from each
+# colour name of the sheet. A literal ships where the shading model of the
+# settings gives no GTK expression, and this check holds it near the scheme.
+function ordercheck(row,   p, np, plist, v, n, i, parts, d) {
+    np = split("background-image border border-bottom border-bottom-color"\
+               " border-right-color box-shadow background-color outline",
+               plist, " ")
+    for (p = 1;p <= np;p++) {
+        v = win(plist[p])
+        if (v == "")
+            continue
+        # An rgba() call of a decoration holds the same literal colour as a
+        # hexadecimal token, so the loop below reads it in that form.
+        v = v " " rgbahex(v)
+        n = split(v, parts, /[^#A-Za-z_0-9]/)
+        for (i = 1;i <= n;i++) {
+            d = rolegap(parts[i])
+            if (d < 0 || d <= ROLE_GAP)
+                continue
+            printf "assert-paths: %s with %s: %s paints %s, which sits %d of"\
+                " 255 from every colour name\n", sheet, rootsheet, \
+                tpath[row], parts[i], d > "/dev/stderr"
+            bad++
+        }
+    }
+}
+
+# Reports the image img of the row while a colour of it does not hold the
+# channel order of the ground colour gcol. The image covers that colour, so a
+# check that reads the background colour alone cannot see the painted role.
+function imagecheck(row, img, gcol,   want, n, i, parts, got, k, lay) {
+    # The image of the row paints the ground of the row. Every layer of it
+    # that hides the layer under it reads the colour name of the ground role.
+    # A translucent layer, such as the accent tint of a button, takes its own
+    # row of the table.
+    for (k = 1;(lay = layerof(img, k)) != "";k++) {
+        if (tground[row] == "" || tground[row] == "-" || !opaque(lay) ||
+                !follows(lay) || carries(lay, tground[row]))
+            continue
+        printf "assert-paths: %s with %s: '%s' paints an image of %s and not"\
+            " of the ground role %s\n", sheet, rootsheet, tpath[row], lay, \
+            tground[row] > "/dev/stderr"
+        bad++
+    }
+    want = chanorder(literal(gcol))
+    if (want == "")
+        return
+    n = split(img, parts, /[^#A-Za-z_0-9]/)
+    for (i = 1;i <= n;i++) {
+        got = chanorder(parts[i])
+        if (got == "" || !opposed(want, got))
+            continue
+        printf "assert-paths: %s with %s: '%s' paints the image colour %s"\
+            " over the ground %s\n", sheet, rootsheet, tpath[row], parts[i], \
+            literal(gcol) > "/dev/stderr"
+        bad++
+        return
+    }
+}
+
+# Reports the token of the node ni of the row that no selector of the
+# sheet holds. A rename to a token that another selector holds passes here,
+# and it passes rolecheck() as well while the row resolves the role colour.
+function livecheck(row, ni,   i, n, parts, miss) {
+    miss = ""
+    if (nname[ni] != "" && !(nname[ni] in vname))
+        miss = "node " nname[ni]
+    n = split(ncls[ni], parts, " ")
+    for (i = 1;i <= n;i++)
+        if (!(parts[i] in vcls))
+            miss = "class " parts[i]
+    n = split(nsta[ni], parts, " ")
+    for (i = 1;i <= n;i++)
+        if (!(parts[i] in vsta))
+            miss = "state " parts[i]
+    if (miss == "")
+        return
+    printf "assert-paths: %s with %s: '%s' holds the %s, which no selector"\
+        " of the sheet holds\n", sheet, rootsheet, tpath[row], miss \
+        > "/dev/stderr"
+    bad++
+}
+
+END {
+    setgroups()
+    # The largest channel step of 255 that a literal colour of a rule takes
+    # from the colour name that seeds it. The figure comes from the shipped
+    # presets and the check arms.
+    ROLE_GAP = 96
+    if (nrow < min) {
+        printf "assert-paths: %s with %s reads %d rows of %s, under %d\n",
+            sheet, rootsheet, nrow, table, min > "/dev/stderr"
+        exit 1
+    }
+    props = "color caret-color outline box-shadow border border-bottom"\
+        " border-bottom-color border-right-color background-color"\
+        " background-image"
+    np = split(props, plist, " ")
+    for (row = 1;row <= nrow;row++) {
+        npath = split(tpath[row], tok, " ")
+        for (i = 1;i <= npath;i++) {
+            one = tok[i]
+            ncls[i] = ""
+            nsta[i] = ""
+            while (match(one, /[.:][A-Za-z0-9_-]+$/)) {
+                part = substr(one, RSTART, RLENGTH)
+                one = substr(one, 1, RSTART - 1)
+                if (substr(part, 1, 1) == ".")
+                    ncls[i] = substr(part, 2) " " ncls[i]
+                else
+                    nsta[i] = substr(part, 2) " " nsta[i]
+            }
+            nname[i] = one
+            livecheck(row, i)
+        }
+        ground = ""
+        gcol = ""
+        gimg = ""
+        band = ""
+        for (i = 1;i <= npath;i++) {
+            collect(i)
+            bg = win("background-color")
+            img = win("background-image")
+            if (opaque(img)) {
+                ground = img
+                gcol = opaque(bg) ? bg : img
+                gimg = img
+            } else if (opaque(bg)) {
+                ground = bg
+                gcol = bg
+                # A translucent layer over an opaque one leaves the image
+                # translucent as a whole. The opaque layer under it still
+                # paints the ground and still reads a seed.
+                gimg = opaque(layerof(img, 2)) ? img : ""
+            }
+            if (bg != "" && bg != "none" && bg != "transparent" && !opaque(bg))
+                band = bg
+        }
+        # A translucent band lies over the ground of the node under it, so
+        # the band takes the place of that ground for every test below. The
+        # caption of the row still pairs with either colour.
+        under = ""
+        if (band != "") {
+            under = ground
+            ground = band
+            gcol = band
+            gimg = ""
+        }
+        # A band over a ground that the settings pin mixes a colour name and
+        # a literal. Neither the class nor the group of a colour on the node
+        # then follows from that ground. The class of the band still holds.
+        mixed = (band != "" && under != "" && !follows(under))
+        # A dash in the caption field marks a ground that carries no caption.
+        # The class of the colour of that node still holds, and CSS gives it
+        # the colour of the nearest parent that holds one.
+        hascap = (trole[row] != "" && trole[row] != "-")
+        capcol = hascap ? caption(row) : inherit("color")
+        if (winrule)
+            capseen[winrule] = 1
+        collect(npath)
+        groundcheck(row, gcol)
+        imagecheck(row, gimg, gcol)
+        ordercheck(row)
+        want = follows(ground) ? "follow" : "pinned"
+        if (!all && want != tclass[row]) {
+            printf "assert-paths: %s with %s: '%s' sits on a %s ground, and"\
+                " the table says %s\n", sheet, rootsheet, tpath[row], want, \
+                tclass[row] > "/dev/stderr"
+            bad++
+        }
+        for (p = 1;p <= np;p++) {
+            v = plist[p] == "color" ? capcol : win(plist[p])
+            if (v == "")
+                continue
+            got = follows(v) ? "follow" : "pinned"
+            # A decoration that no colour name seeds, such as the etch of a
+            # button, paints a translucent black alone. A pin to a colour of
+            # the scheme still fails here.
+            if (plist[p] != "color" && got == "pinned" &&
+                    (pinlines || !haslit(v)))
+                continue
+            # A row with no caption role paints no glyph of its own, so a
+            # colour that follows over a pinned ground reaches nothing. A
+            # pinned colour over a ground that follows still fails, because a
+            # child of the node paints that colour on the new ground.
+            if (plist[p] == "color" && !hascap && got == "follow")
+                continue
+            if (!mixed && got != want) {
+                printf "assert-paths: %s with %s: '%s' takes the %s %s over"\
+                    " a %s ground\n", sheet, rootsheet, tpath[row], got, \
+                    plist[p], want > "/dev/stderr"
+                bad++
+            }
+        }
+        if (hascap)
+            rolecheck(row, capcol)
+        # A caption that follows must read the group of its ground, because a
+        # user colour file moves one group at a time. An ink pairs with every
+        # group, and a caption over a pinned ground fails above.
+        if (!mixed && hascap && follows(capcol) && follows(ground)) {
+            gg = groupsof(ground)
+            cg = groupsof(capcol)
+            ug = under == "" ? gg : groupsof(under)
+            if (cg != "ink" && cg != gg && cg != ug) {
+                printf "assert-paths: %s with %s: '%s' takes the %s caption"\
+                    " over the %s ground\n", sheet, rootsheet, tpath[row], \
+                    cg, gg > "/dev/stderr"
+                bad++
+            }
+        }
+    }
+    # A rule that paints a colour needs a row that reads it. The sheet can
+    # otherwise ship a caption that no row of this table reaches.
+    if (cover) {
+        for (r = 1;r <= nrule;r++) {
+            if (!((r SUBSEP "color") in decl) || (r in capseen))
+                continue
+            printf "assert-paths: %s with %s: no row of %s reads the colour"\
+                " of the rule '%s'\n", sheet, rootsheet, table, rsel[r] \
+                > "/dev/stderr"
+            bad++
+        }
+    }
+    if (bad)
+        exit 1
+    printf "assert-paths: %s with %s ok, %d paths take the colour of the"\
+        " ground\n", sheet, rootsheet, nrow
+}
+' "$root" "$sheet" ${drop:+"$drop"} "$table"
diff --git a/gtk4/check/assert-varnames.sh b/gtk4/check/assert-varnames.sh
index 1e2a9d60..c197fdf2 100755
--- a/gtk4/check/assert-varnames.sh
+++ b/gtk4/check/assert-varnames.sh
@@ -1,21 +1,121 @@
 #!/bin/sh
-# assert-varnames.sh SHEET [ROOTSHEET]: every var() name that SHEET uses must
-# have a declaration. The optional second file holds the :root block, for the
-# dark sheet of the shipped theme. GTK drops a declaration with an undeclared
-# name in silence, so a miss must fail the build.
+# assert-varnames.sh [-n MIN] SHEET [ROOTSHEET]: SHEET must declare every name
+# that it reads, MIN is the floor of the count, and ROOTSHEET holds the
+# declarations. An undeclared colour name paints the initial colour, and an
+# undeclared custom property paints the fallback of its read.
+usage='usage: assert-varnames.sh [-n MIN] SHEET [ROOTSHEET]'
 set -eu
-sheet=${1:?usage: assert-varnames.sh SHEET [ROOTSHEET]}
+min=1
+if [ "${1:-}" = "-n" ]; then
+    min=${2:?$usage}
+    shift 2
+fi
+sheet=${1:?$usage}
 root=${2:-$1}
 tmp=$(mktemp -d)
 trap 'rm -rf "$tmp"' EXIT
+status=0
+
 grep -o -- "var(--qtc-[A-Za-z0-9-]*" "$sheet" | sed 's/^var(//' | sort -u > "$tmp/used"
 grep -o -- "--qtc-[A-Za-z0-9-]*:" "$root" | sed 's/:$//' | sort -u > "$tmp/declared"
-if ! comm -23 "$tmp/used" "$tmp/declared" > "$tmp/missing"; then
-    exit 1
-fi
+comm -23 "$tmp/used" "$tmp/declared" > "$tmp/missing"
 if [ -s "$tmp/missing" ]; then
     echo "assert-varnames: $sheet uses names with no declaration:" >&2
     cat "$tmp/missing" >&2
-    exit 1
+    status=1
+fi
+
+grep -oE '@[a-z][a-z_0-9]*' "$sheet" | grep -vE '^@(define|import|keyframes)$' \
+    | sort -u > "$tmp/read"
+grep -oE '^@define-color +[a-z][a-z_0-9]*' "$root" | awk '{print "@" $2}' \
+    | sort -u > "$tmp/colours"
+comm -23 "$tmp/read" "$tmp/colours" > "$tmp/gone"
+if [ -s "$tmp/gone" ]; then
+    echo "assert-varnames: $sheet reads colour names with no declaration:" >&2
+    cat "$tmp/gone" >&2
+    status=1
+fi
+
+# A read of a name that the :root block declares never paints its fallback. A
+# wrong fallback then ships with no render that shows it, so the two must
+# agree.
+# The run against another declaration block skips the check, because the
+# fallback holds the value of the block of the sheet itself.
+if [ "$root" = "$sheet" ]; then
+awk -v sheet="$sheet" '
+FNR == 1 { pass++ }
+pass == 1 && /^:root \{$/ { inroot = 1; next }
+pass == 1 && inroot && /^\}$/ { inroot = 0; next }
+pass == 1 && inroot {
+    line = $0
+    sub(/^  /, "", line)
+    sub(/;$/, "", line)
+    k = index(line, ": ")
+    if (k > 0)
+        rootv[substr(line, 1, k - 1)] = substr(line, k + 2)
+    next
+}
+pass == 1 { next }
+{
+    line = $0
+    while ((at = index(line, "var(--")) > 0) {
+        d = 0
+        e = 0
+        for (i = at + 3;i <= length(line);i++) {
+            if (substr(line, i, 1) == "(")
+                d++
+            else if (substr(line, i, 1) == ")" && --d == 0) {
+                e = i
+                break
+            }
+        }
+        if (e == 0)
+            break
+        inner = substr(line, at + 4, e - at - 4)
+        line = substr(line, e + 1)
+        c = 0
+        d = 0
+        for (i = 1;i <= length(inner);i++) {
+            if (substr(inner, i, 1) == "(")
+                d++
+            else if (substr(inner, i, 1) == ")")
+                d--
+            else if (substr(inner, i, 1) == "," && d == 0) {
+                c = i
+                break
+            }
+        }
+        if (c == 0)
+            continue
+        name = substr(inner, 1, c - 1)
+        fb = substr(inner, c + 1)
+        gsub(/^ +| +$/, "", fb)
+        if (!(name in rootv))
+            continue
+        if (rootv[name] != fb) {
+            printf "assert-varnames: %s: %s falls back to %s and not to %s\n", \
+                sheet, name, fb, rootv[name] > "/dev/stderr"
+            bad++
+        }
+        seen++
+    }
+}
+END {
+    if (bad)
+        exit 1
+    printf "assert-varnames: %s ok, %d fallbacks match the :root value\n", \
+        sheet, seen + 0
+}
+' "$root" "$sheet" || status=1
+fi
+
+used=$(wc -l < "$tmp/used")
+read=$(wc -l < "$tmp/read")
+if [ $((used + read)) -lt "$min" ]; then
+    echo "assert-varnames: $sheet reads $((used + read)) names, under $min" >&2
+    status=1
 fi
-echo "assert-varnames: $sheet ok, $(wc -l < "$tmp/used") names"
+
+[ $status -eq 0 ] && echo "assert-varnames: $sheet ok, $used custom properties\
+ and $read colour names"
+exit $status
diff --git a/gtk4/check/boxes-keep.txt b/gtk4/check/boxes-keep.txt
