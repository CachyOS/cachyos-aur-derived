pkgver() {
	git -C "$_srcname" log -1 --format=%cd --date=format:%Y%m%d
}

prepare() {
	# The patch keeps the free space bar at full height in Dolphin.
	patch -Np1 -d "$_srcname" -i "$srcdir/qt6-child-layout-margin.patch"
	# The patch keeps the whole status text in Dolphin.
	patch -Np1 -d "$_srcname" -i "$srcdir/qt6-dolphin-small-status-bar.patch"
	# The patch takes the translation files from KF6, and not from KF5.
	patch -Np1 -d "$_srcname" -i "$srcdir/prefer-kf6-translations.patch"
	# The patch draws menu and tooltip shadows on Wayland as well as on X11.
	patch -Np1 -d "$_srcname" -i "$srcdir/qt6-wayland-shadows.patch"
	# The patch draws the window frame of Plasma 6 in the QtCurve look.
	patch -Np1 -d "$_srcname" -i "$srcdir/qt6-kdecoration3.patch"
	# The patch adds the settings module of the Plasma 6 window frame.
	patch -Np1 -d "$_srcname" -i "$srcdir/qt6-kdecoration3-kcm.patch"
	# The patch adds a button size option to the Plasma 6 window frame.
	patch -Np1 -d "$_srcname" -i "$srcdir/qt6-kdecoration3-button-size.patch"
	# The patch enables the window button colour pickers when their checkbox changes.
	patch -Np1 -d "$_srcname" -i "$srcdir/qt6-window-button-colors-enable.patch"
	# The patch replaces the deprecated Qt calls of the Qt 6 style.
	patch -Np1 -d "$_srcname" -i "$srcdir/qt6-deprecated-api.patch"
	# The patch loads a saved preset from its own file path.
	patch -Np1 -d "$_srcname" -i "$srcdir/qt6-preset-path.patch"
	# The patch replaces the deprecated Qt calls of the Qt 5 style.
	patch -Np1 -d "$_srcname" -i "$srcdir/qt5-deprecated-api.patch"
	# The patch stops the CMake warnings and the compiler flag notes.
	patch -Np1 -d "$_srcname" -i "$srcdir/build-cmake-warnings.patch"
	# The patch stops the compiler warnings of the library, the styles and the tests.
	patch -Np1 -d "$_srcname" -i "$srcdir/build-compiler-warnings.patch"
	# The patch adds the GTK theme generator and the fallback theme for GTK 3 and GTK 4.
	# Patch 12 puts its block directly above the guard line that this patch rewrites.
	# The three way merge of git therefore applies the patch. The sed keeps the block
	# of patch 12 with the new guard line.
	git -C "$_srcname" add -A
	git -C "$_srcname" apply --3way "$srcdir/gtk4-theme.patch" ||
		sed -i -e '/^<<<<<<< /d' -e '/^=======$/d' -e '/^>>>>>>> /d' \
			-e '/^if(ENABLE_QT4 OR ENABLE_QT5 OR ENABLE_QT6 OR ENABLE_GTK2)$/d' \
			"$_srcname/CMakeLists.txt"
	grep -q '^if(ENABLE_QT4 OR ENABLE_QT5 OR ENABLE_QT6 OR ENABLE_GTK2 OR ENABLE_GTK4)$' \
		"$_srcname/CMakeLists.txt"
	test -z "$(grep -rl '^<<<<<<< ' "$_srcname" --exclude-dir=.git)"
	# The patch reads the colour names of kde-gtk-config in the four sheets.
	# This patch and the next one add files, and a plain patch call stops on a
	# file that the run before left. Both take the three way merge of git, whose
	# index entry lets the branch reset of makepkg drop the file.
	git -C "$_srcname" add -A
	git -C "$_srcname" apply --3way "$srcdir/gtk4-theme-colors.patch"
	# The patch keeps a user sheet whole when a write fails.
	git -C "$_srcname" add -A
	git -C "$_srcname" apply --3way "$srcdir/gtk4-writer-robustness.patch"
	# The patch reads the window colour of the Qt 6 style from QPalette::Window.
	patch -Np1 -d "$_srcname" -i "$srcdir/qt6-window-palette.patch"
}

build() {
	export CFLAGS+=" -fmacro-prefix-map=$srcdir/$_srcname=$_srcname"
	export CXXFLAGS+=" -fmacro-prefix-map=$srcdir/$_srcname=$_srcname"

	cmake -S "$_srcname" -B "$_srcname/build" \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DENABLE_QT4=OFF \
		-DENABLE_QT5=OFF \
		-DENABLE_QT6=OFF \
		-DENABLE_GTK2=ON \
		-DENABLE_GTK4=ON \
		-DQTC_INSTALL_PO=OFF \
		-DBUILD_TESTING=OFF
	cmake --build "$_srcname/build"

	grep -qF "\"$(git -C "$_srcname" describe)\"" "$_srcname/build/version.cpp"
}

package() {
	local stage="$srcdir/stage"
	rm -rf "$stage"
	DESTDIR="$stage" cmake --install "$_srcname/build"

	local theme="usr/share/themes/QtCurve"
	install -d "$pkgdir/usr/share/themes"
	cp -a "$stage/$theme" "$pkgdir/$theme"

	local t="$pkgdir/$theme"
	test -s "$t/assets/qtc-arrow-down.svg"
	test -s "$t/assets/qtc-arrow-left.svg"
	test -s "$t/assets/qtc-arrow-right.svg"
	test -s "$t/assets/qtc-arrow-up.svg"
	test -s "$t/assets/qtc-bullet.svg"
	test -s "$t/assets/qtc-check.svg"
	test -s "$t/assets/qtc-dash.svg"
	test -s "$t/gtk-2.0/gtkrc"
	test -s "$t/gtk-2.0/icons3"
	test -s "$t/gtk-2.0/icons4"
	test -s "$t/gtk-2.0/kdeglobals"
	test -s "$t/gtk-2.0/map_kde_icons.pl"
	test -s "$t/gtk-3.0/gtk.css"
	test -s "$t/gtk-3.0/gtk-dark.css"
	test -s "$t/gtk-4.0/gtk.css"
	test -s "$t/gtk-4.0/gtk-dark.css"
	test -s "$t/mozilla/preferences-rev.xml"
	test -s "$t/mozilla/QtCurve.css"
	test -s "$t/mozilla/QtCurve-KDEButtonOrder.css"

	test "$(find "$t" ! -type d | wc -l)" -eq 19
	test -z "$(find "$pkgdir" ! -type d ! -path "$t/*")"
}
