_commit=519f04b08d7a1029b62b871cc8cf408d6fbefc1f
_srcname=qtcurve
pkgname=qtcurve-gtk-theme
pkgver=20260812
pkgrel=4
pkgdesc="The QtCurve theme data for GTK 2, GTK 3 and GTK 4; the engines and the writer are in qtcurve"
arch=(any)
url="https://invent.kde.org/system/qtcurve"
license=(LGPL-2.1-only LGPL-3.0-only)
depends=()
optdepends=(
	# GTK 3 reads gtk-3.0/gtk.css when the theme name is QtCurve.
	'gtk3: QtCurve look in GTK 3 applications'
	# GTK 2 reads gtk-2.0/gtkrc, which names the qtcurve engine of the qtcurve package.
	'gtk2: QtCurve look in GTK 2 applications'
	# The GTK page lists a theme directory that holds a gtk-3.* child.
	'kde-gtk-config: pick QtCurve on the GTK page of the settings'
	# The writer of qtcurve writes separate user sheets that follow the saved settings.
	'qtcurve: GTK theme that follows the QtCurve settings'
)
makedepends=(
	cmake
	extra-cmake-modules
	git
	gtk2
	kcolorscheme
	kconfig
	kcoreaddons
	qt6-base
	qt6-svg
)
# qtcurve-gtk2 and qtcurve before 20260812-5 own files of this theme; the named conflict resolves the pair in one transaction.
conflicts=('qtcurve<20260812-5' 'qtcurve-gtk2')
# The fix patches of the seven work branches, in the order that the branches
# merge. A file name states the branch and the position of the commit in that
# branch, and the header of a file holds the whole commit message. The array
# keeps the apply order, and source and prepare() both read it.
_fixes=(
	config-io-01-undo-the-kconfig-escapes-when-the-style.patch
	config-io-02-write-the-application-lists-in-one-stable.patch
	config-io-03-take-the-default-when-a-number-in-the-config.patch
	config-io-04-read-every-boolean-in-the-config-with-one.patch
	config-io-05-reject-a-non-finite-shade-or-alpha-value.patch
	config-io-06-check-every-config-value-against-the-range.patch
	config-io-07-drop-the-dead-legacy-store-of-gbfactor.patch
	config-io-08-match-a-config-name-against-the-value-set-of.patch
