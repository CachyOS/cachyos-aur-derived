	config-io-11-report-a-colour-text-that-does-not-parse.patch
	config-io-12-demote-config-values-in-the-style-build-only.patch
	config-io-13-give-each-illegal-option-pair-one-repair.patch
	config-io-14-write-sliderfill-through-the-appearance.patch
	config-io-15-copy-the-image-sidecars-from-the-default.patch
	config-io-16-reject-a-gradient-value-that-holds-a-partial.patch
	config-io-17-give-the-gradient-stop-order-a-consistent.patch
	config-io-18-skip-a-custom-gradient-with-no-stop-in-the.patch
	style-paint-01-stop-different-paints-sharing-one-cached.patch
