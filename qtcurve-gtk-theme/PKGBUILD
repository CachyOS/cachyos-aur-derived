	style-paint-18-match-the-two-lines-of-a-sunken-separator.patch
	style-paint-19-offset-a-menu-section-by-the-stripe-width.patch
	style-paint-20-etch-a-radio-button-with-the-custom-dark.patch
	style-paint-21-draw-the-border-of-a-faded-menu-item.patch
	perf-01-skip-the-widget-property-chain-for-opaque.patch
	image-dialog-01-accept-the-full-scale-range-of-the.patch
	image-dialog-02-disable-the-scale-boxes-while-the-scale-box.patch
	image-dialog-03-check-the-range-of-the-stored-image-position.patch
	image-dialog-04-build-the-image-file-url-from-the-local-path.patch
	image-dialog-05-use-one-name-rule-for-the-installed.patch
	presets-01-scan-the-preset-save-location-for-presets.patch
	presets-02-abort-the-export-when-the-archive-does-not.patch
	presets-03-set-the-version-of-a-saved-preset-record.patch
