+++ b/gtk2/common/common.h
@@ -704,6 +704,9 @@ typedef struct {
                      noMenuBgndOpacityApps,
                      noBgndImageApps;
     Strings          noMenuStripeApps;
+    // If true, QtCurve gives a drop shadow to a menu, a combo box list and a
+    // tooltip.
+    bool             popupShadow;
     // for completeness, unused:
     bool             onlyTicksInMenu;
     bool             buttonStyleMenuSections;
