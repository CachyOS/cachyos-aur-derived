index f40a3f07..41f4ed2f 100644
--- a/firefox/writer/sheet.h
+++ b/firefox/writer/sheet.h
@@ -32,8 +32,9 @@ namespace Firefox {
 /**
  * Returns the text of the sheet that the writer owns in a profile. The sheet
  * holds one header line, then one :root block of every custom property of
- * the map. A gradient of the titlebar appearance adds one rule of the tool
- * box for each state of the window. The caption rules end the sheet.
+ * the map. A titlebar gradient adds one rule of the tool box for each state
+ * of the window. The popup rule of the shadow setting and the caption rules
+ * end the sheet.
  *
  * \param opts  the QtCurve settings, which give the appearance and the ladders.
  * \param pal   the colours of the live scheme or of a colour file.
