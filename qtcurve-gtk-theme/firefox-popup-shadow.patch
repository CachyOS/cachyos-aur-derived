diff --git a/firefox/check/assert-ff-shadow.sh b/firefox/check/assert-ff-shadow.sh
new file mode 100644
index 00000000..8ef8b49c
--- /dev/null
+++ b/firefox/check/assert-ff-shadow.sh
@@ -0,0 +1,289 @@
+#!/bin/sh
+# assert-ff-shadow.sh WRITER WORKDIR: the sheet must carry one shadow rule of
+# the popups under either setting. A true key gives the blur, the spread, the
+# grey and the room of the shadowSize key. A false key holds the property at
+# none, and a file without the key gives the default. The run writes into
+# WORKDIR alone, because the writer rewrites the files of the caller.
+set -eu
+ulimit -c 0
+usage='usage: assert-ff-shadow.sh WRITER WORKDIR'
+writer=${1:?$usage}
+work=${2:?$usage}
+
+# A relative path leaves XDG_CONFIG_HOME outside the root of the file system.
+# The library of the writer then reads the configuration home of the caller.
+case $work in
+    /*) ;;
+    *) work=$PWD/$work;;
+esac
+
+owned=chrome/qtcurve-userChrome.css
+home=$work/home
+root=$home/.config/mozilla/firefox
+dir=$root/shadow.default
+qtc=$home/qtcurve
+sheet=$dir/$owned
+status=0
+
+# The rows of a true key at the shadowSize 30, which is the default of
+# lib/utils/x11helpers.cpp. sheet.cpp takes 0.220 of that key for the blur and
+# 0.088 of it for the spread, and the room is the sum of the two. The grey 102
+# is c1 of qtcX11ShadowInit(), and the opacity is the first step of the
+# gradient of lib/utils/shadow.cpp.
+shadow30='^  --panel-box-shadow: 0 0 7px 3px rgba(102,102,102,0.999)'\
+' !important;$'
+room30='^  --panel-box-shadow-margin: 10px;$'
+
+# The rows of a true key at the shadowSize 60. The two pixel figures and the
+# room double, and the grey and the opacity stay as they are.
+shadow60='^  --panel-box-shadow: 0 0 13px 5px rgba(102,102,102,0.999)'\
+' !important;$'
+room60='^  --panel-box-shadow-margin: 18px;$'
+
+# The rule of a false key. popup.css and global-shared.css of omni.ja hold the
+# same property at none for a platform that draws a shadow of its own.
+rule_off='^  --panel-box-shadow: none !important;$'
+
+fail() {
+    echo "assert-ff-shadow: $1" >&2
+    status=1
+}
+
+rm -rf "$work"
+mkdir -p "$dir/chrome" "$qtc"
+printf '[Profile0]\nName=shadow\nIsRelative=1\nPath=shadow.default\n' \
+    > "$root/profiles.ini"
+
+# settings LINES: writes the settings file of the user with the gate on and
+# the rows LINES after it. Empty LINES leave the shadow keys out.
+settings() {
+    printf '[Settings]\nfirefoxTheme=true\n%s' "$1" > "$qtc/stylerc"
+}
+
+# run NAME: runs one write pass over the private home, and holds the exit
+# code in the variable code.
+run() {
+    r_name=$1
+    code=0
+    HOME=$home XDG_CONFIG_HOME=$home/.config QTCURVE_CONFIG_DIR=$qtc \
+        "$writer" --write > "$work/$r_name.log" 2>&1 || code=$?
+}
+
+# holds FILE PATTERN: gives 0 while FILE carries PATTERN under the selector of
+# the menus and the panels.
+holds() {
+    grep -q '^menupopup, panel {$' "$1" && grep -q "$2" "$1"
+}
+
+# on FILE SHADOW ROOM: gives 0 while FILE gives the popups the two rows that
+# the caller names and no suppression. This is the check of a true setting,
+# and the controls below must fail it.
+on() {
+    if holds "$1" "$2" && grep -q "$3" "$1" &&
+        ! grep -q "$rule_off" "$1"; then
+        return 0
+    fi
+    echo "assert-ff-shadow: $1 carries no shadow rule of QtCurve" >&2
+    return 1
+}
+
+# on30 FILE and on60 FILE: the arm of each shadowSize of the run. A sheet of
+# one size must fail the arm of the other size.
+on30() {
+    on "$1" "$shadow30" "$room30"
+}
+
+on60() {
+    on "$1" "$shadow60" "$room60"
+}
+
+# off FILE: gives 0 while FILE holds the property at none, drops the shadow of
+# QtCurve and states no room. This is the check of a false setting, and the
+# controls below must fail it.
+off() {
+    if holds "$1" "$rule_off" &&
+        ! grep -q '^  --panel-box-shadow: 0 0 ' "$1" &&
+        ! grep -q '^  --panel-box-shadow-margin:' "$1"; then
+        return 0
+    fi
+    echo "assert-ff-shadow: $1 carries no suppression rule" >&2
+    return 1
+}
+
+# sums FILE: gives 0 while the room of FILE is the blur and the spread of it,
+# and the ink of it is one grey. The room is the whole room of the browser for
+# the shadow, so a room under the sum clips the blur away.
+sums() {
+    s_row=$(sed -n 's/^  --panel-box-shadow: 0 0 \([0-9]*\)px \([0-9]*\)px'\
+' rgba(\([0-9]*\),\([0-9]*\),\([0-9]*\),[0-9.]*) !important;$/\1 \2 \3 \4 \5/p' \
+        "$1")
+    s_room=$(sed -n 's/^  --panel-box-shadow-margin: \([0-9]*\)px;$/\1/p' "$1")
+    if [ -z "$s_row" ] || [ -z "$s_room" ]; then
+        echo "assert-ff-shadow: $1 holds no pair of shadow rows" >&2
+        return 1
+    fi
+    set -- $s_row
+    if [ "$s_room" -ne $(($1 + $2)) ]; then
+        echo "assert-ff-shadow: $1 px of blur and $2 px of spread need the" \
+             "room $(($1 + $2)) and not $s_room" >&2
+        return 1
+    fi
+    if [ "$3" -ne 102 ] || [ "$4" -ne 102 ] || [ "$5" -ne 102 ]; then
+        echo "assert-ff-shadow: the ink $3,$4,$5 is not the grey of" \
+             "qtcX11ShadowInit()" >&2
+        return 1
+    fi
+    return 0
+}
+
+# weight FILE: gives 0 while the shadow row of FILE carries !important and the
+# room row carries none. popup.css of omni.ja holds the room at 0px under
+# !important where the window manager gives no alpha, and that square popup
+# must stand.
+weight() {
+    if grep -q '^  --panel-box-shadow: .* !important;$' "$1" &&
+        grep -q '^  --panel-box-shadow-margin: [0-9]*px;$' "$1" &&
+        ! grep -q -- '--panel-box-shadow-margin:.*!important' "$1"; then
+        return 0
+    fi
+    echo "assert-ff-shadow: $1 holds the wrong weight on a shadow row" >&2
+    return 1
+}
+
+# 1. A true setting at the default size gives the shadow of QtCurve.
+settings 'popupShadow=true
+shadowSize=30
+'
+run true
+[ "$code" -eq 0 ] || fail "the true setting gave the code $code"
+[ -s "$sheet" ] || fail "the true setting wrote no sheet"
+on30 "$sheet" || fail "the true setting dropped the shadow rule"
+sums "$sheet" || fail "the true setting broke the room of the shadow"
+weight "$sheet" || fail "the true setting broke the weight of a row"
+cp "$sheet" "$work/on.css"
+
+# 2. The shadowSize key moves the pixel figures of the same true setting, and
+# the sheet of the profile moves with it.
+settings 'popupShadow=true
+shadowSize=60
+'
+run big
+[ "$code" -eq 0 ] || fail "the size 60 gave the code $code"
+on60 "$sheet" || fail "the size 60 dropped the shadow rule"
+sums "$sheet" || fail "the size 60 broke the room of the shadow"
+cp "$sheet" "$work/big.css"
+if cmp -s "$work/on.css" "$work/big.css"; then
+    fail "the shadowSize key left the sheet of the profile alone"
+fi
+grep -q 'restart' "$work/big.log" ||
+    fail "the shadowSize key printed no notice of a new sheet"
+
+# 3. A false setting holds the property at none, and the sheet of the profile
+# moves. The browser reads that rule for every menu and every panel, as the
+# GTK sheet of QtCurve reads none for the decoration of a popup.
+settings 'popupShadow=false
+shadowSize=30
+'
+run false
+[ "$code" -eq 0 ] || fail "the false setting gave the code $code"
+off "$sheet" || fail "the false setting wrote no suppression rule"
+cp "$sheet" "$work/off.css"
+if cmp -s "$work/on.css" "$work/off.css"; then
+    fail "the flip of the key left the sheet of the profile alone"
+fi
+grep -q 'restart' "$work/false.log" ||
+    fail "the flip of the key printed no notice of a new sheet"
+
+# 4. A settings file without the keys gives the shadow of the default size,
+# which qt6/common/config_file.cpp and lib/utils/x11helpers.cpp hold. A user
+# of an older file needs no migration.
+settings ''
+run absent
+[ "$code" -eq 0 ] || fail "the absent keys gave the code $code"
+on30 "$sheet" || fail "the absent keys dropped the shadow rule"
+cmp -s "$sheet" "$work/on.css" ||
+    fail "the absent keys and the true setting gave two sheets"
+
+# The controls below. Each one doctors a copy of a sheet of the run, and the
+# arm of that copy must fail.
+broken=0
+
+# control NAME ARM COPY: the arm that the caller names must fail over COPY.
+# The log of each control holds the line that the arm printed, so a reader of
+# the build tree sees every bite.
+control() {
+    c_name=$1
+    if "$2" "$3" 2> "$work/control-$c_name.log"; then
+        echo "assert-ff-shadow: the check passed the control copy of" \
+             "$c_name" >&2
+        exit 1
+    fi
+    broken=$((broken + 1))
+}
+
+# The sheet of one size against the arm of the other size. The pair proves
+# that the emitted figures follow the shadowSize key in both directions.
+control size30 on60 "$work/on.css"
+control size60 on30 "$work/big.css"
+
+# A sheet of a true setting that lost the block, which leaves the shadow of
+# the browser in place of the shadow of QtCurve.
+sed '/^menupopup, panel {$/,/^}$/d' "$work/on.css" > "$work/gone.css"
+control gone on30 "$work/gone.css"
+
+# A sheet of a true setting that suppresses, which is the stale sheet of a
+# user who switched the shadow back on.
+sed 's/^  --panel-box-shadow: .*$/  --panel-box-shadow: none !important;/' \
+    "$work/on.css" > "$work/flipped.css"
+control flipped on30 "$work/flipped.css"
+
+# A sheet of a false setting that paints the shadow of QtCurve, which is the
+# stale sheet of a user who switched the shadow off.
+grep "$shadow30" "$work/on.css" > "$work/alpha.line"
+sed "/$rule_off/d" "$work/off.css" > "$work/cut.css"
+sed "/^menupopup, panel {\$/r $work/alpha.line" "$work/cut.css" \
+    > "$work/kept.css"
+control kept off "$work/kept.css"
+
+# A sheet of a false setting that emits no rule at all. The browser then
+# keeps its own shadow under a key that asks for none.
+sed '/^menupopup, panel {$/,/^}$/d' "$work/off.css" > "$work/silent.css"
+control silent off "$work/silent.css"
+
+# A sheet of a false setting that keeps the room of a true setting. The room
+# widens every popup window for a shadow that no rule paints.
+sed "/^menupopup, panel {\$/a\\
+  --panel-box-shadow-margin: 10px;" "$work/off.css" > "$work/room.css"
+control room off "$work/room.css"
+
+# A sheet that paints a black shadow, which a dark theme of the user hides.
+sed 's/rgba(102,102,102,/rgba(0,0,0,/' "$work/on.css" > "$work/black.css"
+control black on30 "$work/black.css"
+control blacksum sums "$work/black.css"
+
+# A sheet with the room of the browser under the blur and the spread, which
+# clips the shadow away. This is the room of the sheet before this round.
+sed 's/^  --panel-box-shadow-margin: 10px;$/  --panel-box-shadow-margin: 4px;/' \
+    "$work/on.css" > "$work/tight.css"
+control tight on30 "$work/tight.css"
+control tightsum sums "$work/tight.css"
+
+# A sheet that holds the room under !important, which takes the square popup
+# of a window manager without alpha away.
+sed 's/^  --panel-box-shadow-margin: 10px;$/  --panel-box-shadow-margin: 10px'\
+' !important;/' "$work/on.css" > "$work/heavy.css"
+control heavy weight "$work/heavy.css"
+
+# A sheet of a true setting without the room, which leaves the browser at the
+# 4 px of tokens-shared.css and clips the blur.
+sed '/^  --panel-box-shadow-margin:/d' "$work/on.css" > "$work/noroom.css"
+control noroom on30 "$work/noroom.css"
+control noroomsum sums "$work/noroom.css"
+
+if [ $status -eq 0 ]; then
+    echo "assert-ff-shadow: the two sizes gave the pixel figures of the" \
+         "shadowSize key, the absent keys gave the default size, the false" \
+         "setting held the property at none and moved the sheet, and the" \
+         "check rejects each of the $broken control copies"
+fi
+exit $status
