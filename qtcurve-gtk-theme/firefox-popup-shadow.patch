diff --git a/firefox/writer/sheet.cpp b/firefox/writer/sheet.cpp
index 762d7ace..c9a947c4 100644
--- a/firefox/writer/sheet.cpp
+++ b/firefox/writer/sheet.cpp
@@ -83,6 +83,64 @@ toolboxImages(const Options &opts, const Palette &pal)
     return out;
 }
 
+/**
+ * The colour of the drop shadow of a popup, as one channel from 0 to 255. c1
+ * of qtcX11ShadowInit() in lib/utils/x11helpers.cpp holds 0.4 of the range,
+ * and qtcFillShadowPixel() mixes that colour beside the window. The shadow of
+ * QtCurve is a grey glow, which a dark theme shows as well as a light one.
+ */
+const int shadowGrey = 102;
+
+/**
+ * The opacity of the drop shadow of a popup, from 0.0 to 1.0. The gradient of
+ * qtcCreateShadowGradient() in lib/utils/shadow.cpp starts at this value
+ * beside the window, and the blur of the browser carries the fall of it.
+ */
+const double shadowAlpha = 0.9985;
+
+/**
+ * The blur radius of the popup shadow, in pixels for each pixel of the
+ * shadowSize key. A fit of the Gaussian of the browser to the exponential
+ * gradient of QtCurve holds the least error at this figure.
+ */
+const double shadowBlurPerSize = 0.220;
+
+/**
+ * The spread of the popup shadow, in pixels for each pixel of the shadowSize
+ * key. The spread moves the edge of the Gaussian out of the popup, because
+ * the gradient of QtCurve starts at its peak.
+ */
+const double shadowSpreadPerSize = 0.088;
+
+/**
+ * Returns the shadow rule of the popups. A true setting gives the blur, the
+ * spread and the room of the browser from the shadowSize key of the settings.
+ * A false setting holds the property at none, which is the value that
+ * popup.css of omni.ja gives a platform with a shadow of its own.
+ */
+QString
+popupShadow(const Options &opts)
+{
+    if (!opts.popupShadow) {
+        return QStringLiteral("\nmenupopup, panel {\n"
+                              "  --panel-box-shadow: none !important;\n"
+                              "}\n");
+    }
+    const int blur = qRound(shadowBlurPerSize * opts.shadowSize);
+    const int spread = qRound(shadowSpreadPerSize * opts.shadowSize);
+    // The room row below carries no weight. popup.css of omni.ja holds the
+    // same property at 0px under !important while the window manager gives no
+    // alpha. The browser must keep that square popup.
+    return QStringLiteral("\nmenupopup, panel {\n"
+                          "  --panel-box-shadow: 0 0 %1px %2px %3 !important;\n"
+                          "  --panel-box-shadow-margin: %4px;\n"
+                          "}\n")
+        .arg(blur).arg(spread)
+        .arg(Gtk::rgba(QColor(shadowGrey, shadowGrey, shadowGrey),
+                       shadowAlpha))
+        .arg(blur + spread);
+}
+
 }
 
 QString
@@ -103,6 +161,7 @@ buildSheet(const Options &opts, const Palette &pal)
     }
     out += QStringLiteral("}\n");
     out += toolboxImages(opts, pal);
+    out += popupShadow(opts);
     out += buildCaption(opts, pal);
     return out;
 }
