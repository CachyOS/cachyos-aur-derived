pkgname=firefox-esr-bin
_pkgname=${pkgname/-bin/}
pkgver=153.6.0
pkgrel=2
pkgdesc='Standalone web browser from mozilla.org - Extended Support Release'
url='https://www.mozilla.org/en-US/firefox/enterprise/'
arch=('x86_64')
depends=('dbus' 'ffmpeg' 'gtk3' 'libxt' 'nss')
provides=("firefox=${pkgver}")
license=('MPL-2.0')
source=("https://ftp.mozilla.org/pub/firefox/releases/${pkgver}esr/linux-x86_64/en-US/firefox-${pkgver}esr.tar.xz"
        "$_pkgname.desktop"
        "$_pkgname-safe.desktop"
        'policies.json')
sha256sums=('31321cd9e2cef73df678417e810cdd1b5760aa5cc8063c8465669e5869cb8498'
            '2e3409188d110acdfa3cf33cdc1dc6d2e232a357ca922bf807c2ca23fa66110f'
            '8428c11c1403cb29dbb974cab680259019d841029dc70d21250978ba05525838'
            'e977c3d690224dd727d8761d2c0a66ba41bfd02ae0fd7850c4545d06b5a8e63c')

package() {
  install -d "$pkgdir/opt" "$pkgdir/usr/bin"
  cp -r "$srcdir/firefox" "$pkgdir/opt/$_pkgname"

  ln -s "/opt/$_pkgname/firefox" "$pkgdir/usr/bin/$_pkgname"
  install -Dm644 "$srcdir/$_pkgname.desktop" "$srcdir/$_pkgname-safe.desktop" -t "$pkgdir/usr/share/applications/"
  install -Dm644 "$srcdir/firefox/browser/chrome/icons/default/default128.png" "$pkgdir/usr/share/pixmaps/$_pkgname.png"
  install -Dm644 "$srcdir/policies.json" -t "$pkgdir/opt/$_pkgname/distribution/"
}
