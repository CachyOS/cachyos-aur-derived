pkgname=gnome-shell-extension-no-overview
pkgver=51
pkgrel=2
epoch=1
pkgdesc='Disable the start up overview in Gnome 40+'
arch=('any')
url='https://github.com/fthx/no-overview'
license=('GPL-3.0-only')
depends=(gnome-shell)
makedepends=(git)
source=("git+https://github.com/fthx/no-overview.git#tag=v${pkgver}")
sha256sums=('b84a70614b1edcf408ed95a7795b89654af5c118164b03286691e0aa84ee46f9')

package() {
	cd no-overview
	destdir="${pkgdir}/usr/share/gnome-shell/extensions/no-overview@fthx"
	mkdir -p "${destdir}"
	cp -a metadata.json extension.js "${destdir}"
}
