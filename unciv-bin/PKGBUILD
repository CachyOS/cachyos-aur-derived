# Maintainer: Thyrum <adj00 (at) protonmail (dot) com>

pkgname=unciv-bin
_pkgname=Unciv
pkgver=4.22.15
pkgrel=1
pkgdesc="Open-source remake of Civilization V"
url="https://github.com/yairm210/Unciv"
license=('MPL-2.0')
depends=('java-runtime' 'bash' 'xorg-xrandr')
provides=('unciv')
conflicts=('unciv')
arch=('any')
source=(
  "$_pkgname-$pkgver.jar::https://github.com/yairm210/$_pkgname/releases/download/$pkgver/Unciv.jar"
  "$_pkgname-$pkgver.png::https://raw.githubusercontent.com/yairm210/$_pkgname/$pkgver/extraImages/Icons/Unciv%20icon%20v6.png"
  "$_pkgname-$pkgver.zip::https://github.com/yairm210/$_pkgname/releases/download/$pkgver/linuxFilesForJar.zip"
)
noextract=(
	"$_pkgname-$pkgver.jar"
)
md5sums=('e97aee19b1e0ff2c254b6d1c0c00345d'
         '4e40a32a88810cc334abd0a5485e9846'
         'a1052a12970fcda1c1a352953c10b56f')

package() {
  install -Dm755 Unciv.sh "$pkgdir/usr/bin/$_pkgname"
  install -Dm644 unciv.desktop "$pkgdir/usr/share/applications/unciv.desktop"
  install -Dm644 $_pkgname-$pkgver.png "$pkgdir/usr/share/pixmaps/unciv.png"
  install -Dm644 $_pkgname-$pkgver.jar "$pkgdir/usr/share/$_pkgname/$_pkgname.jar"
}
