# Maintainer: Kevin <github@kev314.dev>

pkgname=claude-desktop
pkgver=5.11492.5
pkgrel=2
pkgdesc="Official Claude AI desktop app from Anthropic"
arch=('x86_64' 'aarch64')
url="https://claude.ai/download"
license=('LicenseRef-Proprietary')

depends=('alsa-lib'
         'at-spi2-core'
         'cairo'
         'dbus'
         'expat'
         'gcc-libs'
         'glib2'
         'glibc'
         'gtk3'
         'hicolor-icon-theme'
         'libcap-ng'
         'libcups'
         'libdrm'
         'libnotify'
         'libseccomp'
         'libsecret'
         'libx11'
         'libxcb'
         'libxcomposite'
         'libxdamage'
         'libxext'
         'libxfixes'
         'libxkbcommon'
         'libxrandr'
         'libxtst'
         'mesa'
         'nspr'
         'nss'
         'pango'
         'socat'
         'systemd-libs'
         'util-linux-libs'
         'virtiofsd'
         'xdg-desktop-portal'
         'xdg-utils')
depends_x86_64=('qemu-system-x86' 'edk2-ovmf')
depends_aarch64=('qemu-system-aarch64' 'edk2-aarch64')

# recommended from .deb
optdepends=('bubblewrap: sandboxing for built-in Claude Code sessions'
            'gnome-keyring: credential storage via Secret Service (GNOME)'
            'kwallet: credential storage (KDE Plasma)'
            'libayatana-appindicator: system tray icon'
            'libpipewire: screen sharing on Wayland'
            'xdg-desktop-portal-gtk: portal backend for GTK desktops'
            'xdg-desktop-portal-kde: portal backend for KDE Plasma')
options=('!strip' '!debug')

_baseurl="https://downloads.claude.ai/claude-desktop/apt/stable/pool/main/c/claude-desktop"
source_x86_64=("${_baseurl}/${pkgname}_${pkgver}_amd64.deb")
source_aarch64=("${_baseurl}/${pkgname}_${pkgver}_arm64.deb")
sha256sums_x86_64=('b96208b207e450b740f7dbe304f6077fed80e7f3d37ddd545991c4e8201564cf')
sha256sums_aarch64=('fe6cd8a70f96b96eb4e6b647300cfaee6aaff4ce133a0fbbe11c2cdb775f5a6a')

package() {
  tar -xf data.tar.xz -C "$pkgdir"

  chmod 4755 "$pkgdir/usr/lib/claude-desktop/chrome-sandbox"

  rm -r "$pkgdir/usr/share/lintian"

  # The app hardcodes Debian's filesystem paths for the Cowork VM stack
  ln -s ../lib/virtiofsd "$pkgdir/usr/bin/virtiofsd"

  # the app opens /usr/share/OVMF/OVMF_CODE_4M.fd
  if [[ $CARCH == x86_64 ]]; then
    install -d "$pkgdir/usr/share/edk2"
    ln -s x64/OVMF_CODE.4m.fd "$pkgdir/usr/share/edk2/OVMF_CODE_4M.fd"
    ln -s x64/OVMF_VARS.4m.fd "$pkgdir/usr/share/edk2/OVMF_VARS_4M.fd"
  fi

  # The .deb's postinst copies these into place. On Arch they only need to be
  # packaged: shared-mime-info's pacman hook refreshes the MIME cache, and the
  # search provider and D-Bus service files are read from these paths directly.
  local _res="$pkgdir/usr/lib/claude-desktop/resources"

  # Shared MIME types for .mcpb, .dxt and .skill
  install -Dm644 "$_res/linux-mime/com.anthropic.Claude.xml" \
    "$pkgdir/usr/share/mime/packages/com.anthropic.Claude.xml"

  # GNOME Shell search provider
  install -Dm644 "$_res/gnome-search-provider/com.anthropic.Claude.search-provider.ini" \
    "$pkgdir/usr/share/gnome-shell/search-providers/com.anthropic.Claude.search-provider.ini"
  install -Dm644 "$_res/gnome-search-provider/com.anthropic.Claude.SearchProvider.service" \
    "$pkgdir/usr/share/dbus-1/services/com.anthropic.Claude.SearchProvider.service"

  # `ccd` terminal launcher, only when the build ships it (as the .deb's postinst does)
  if [[ -x "$_res/bin/ccd" ]]; then
    ln -s ../lib/claude-desktop/resources/bin/ccd "$pkgdir/usr/bin/ccd"
  fi

  install -Dm644 "$pkgdir/usr/share/doc/claude-desktop/copyright" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
