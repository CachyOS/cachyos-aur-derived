# Maintainer:
# Contributor: Patrick Northon <northon_patrick3@yahoo.ca>

_pkgname="localsend"
pkgname="$_pkgname"
pkgver=1.18.2
pkgrel=2
pkgdesc="An open source cross-platform alternative to AirDrop"
url="https://github.com/localsend/localsend"
license=('Apache-2.0')
arch=('x86_64' 'aarch64')

depends=(
  'at-spi2-core'
  'cairo'
  'fontconfig'
  'gdk-pixbuf2'
  'glib2'
  'gtk3'
  'hicolor-icon-theme'
  'libayatana-appindicator'
  'libepoxy'
  'pango'
)
makedepends=(
  'cargo'
  'clang'
  'cmake'
  'fvm'
  'git'
  'lld'
  'llvm'
  'ninja'
  'patchelf'
)

options=('!lto')

_pkgsrc="$_pkgname-$pkgver"
_pkgext="tar.gz"
source=("$_pkgsrc.$_pkgext"::"$url/archive/refs/tags/v$pkgver.$_pkgext")
sha256sums=('4425dfcf2e016d6540ea44941deb4ba6568201cc47d7f08753606e6e4b2769cd')

prepare() {
  cd "$_pkgsrc"
  cargo fetch --locked --target host-tuple

  # use the library built by cargo
  cat > packages/localsend_isolates/rust_builder/linux/CMakeLists.txt << END
cmake_minimum_required(VERSION 3.10)
project(rust_lib_localsend_app LANGUAGES CXX)
set(rust_lib_localsend_app_bundled_libraries
  "$srcdir/$_pkgsrc/target/release/librust_lib_localsend_app.so"
  PARENT_SCOPE
)
END
}

build() {
  export CXXFLAGS+=' -Wno-error=deprecated-declarations'

  cd "$_pkgsrc"
  cargo build --frozen --release --all-features

  cd app
  fvm install
  fvm flutter --disable-analytics
  fvm flutter --no-version-check pub get
  fvm flutter build linux --no-pub --release
}

package() {
  local _farch=x64
  [[ $CARCH == aarch64 ]] && _farch=arm64
  local _dest="$pkgdir/usr/lib/$_pkgname"

  # cli, server
  install -Dm755 "$_pkgsrc/target/release"/{localsend-cli,server} -t "$_dest/"

  # app, lib, data
  cd "$_pkgsrc/app/build/linux/$_farch/release/bundle"
  install -Dm755 "localsend_app" -t "$_dest"
  cp -r lib/ "$_dest/"
  cp -r data/ "$_dest/"

  # runpath
  for i in "$_dest"{,/lib}/*; do
    if [ -f "$i" ] && readelf -h "$i" &> /dev/null; then
      if [[ "$i" =~ /lib/[^/]+$ ]]; then
        printf 'Setting rpath to $ORIGIN for %s ...\n' "${i##*/}"
        patchelf --set-rpath '$ORIGIN' "$i"
      else
        printf 'Setting rpath to $ORIGIN/lib for %s ...\n' "${i##*/}"
        patchelf --set-rpath '$ORIGIN/lib' "$i"
      fi
    fi
  done

  # symlink
  install -dm755 "$pkgdir/usr/bin"
  ln -sfr "$_dest/${_pkgname}_app" "$pkgdir/usr/bin/${_pkgname}"
  ln -sfr "$_dest/${_pkgname}-cli" "$pkgdir/usr/bin/${_pkgname}-cli"

  # icon
  install -Dm644 "$srcdir/$_pkgsrc/app/build/flutter_assets/assets/img/logo-512.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/$_pkgname.png"

  # launcher
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/$_pkgname.desktop" << END
[Desktop Entry]
Type=Application
Name=LocalSend
Comment=$pkgdesc
Exec=$_pkgname
Icon=$_pkgname
Terminal=false
Categories=Utility;Network;
StartupWMClass=Org.localsend.localsend_app
END

  # license
  install -Dm644 "$srcdir/$_pkgsrc/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"

  # permissions
  chmod -R u+rwX,go+rX,go-w "$pkgdir/"
}
